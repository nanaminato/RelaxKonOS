<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PrebuiltServerAssemblyPath Condition="'$(PrebuiltServerAssemblyPath)' == ''">../RemoteOS.Server/bin/Debug/net10.0/RemoteOS.Server.dll</PrebuiltServerAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Framework/RemoteOS.Core/RemoteOS.Core.csproj" />
    <ProjectReference Include="../RemoteOS.Server/RemoteOS.Server.csproj" Condition="'$(UsePrebuiltServerAssembly)' != 'true'" />
    <!-- The local desktop SDK currently lacks workload locator SDKs. This opt-in path permits
         the smoke test to run against a just-built Server assembly without weakening CI's normal
         project-reference build. -->
    <Reference Include="RemoteOS.Server" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>$(PrebuiltServerAssemblyPath)</HintPath>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/SQLitePCLRaw.batteries_v2.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.core" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/SQLitePCLRaw.core.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/SQLitePCLRaw.provider.e_sqlite3.dll</HintPath>
    </Reference>
    <None Include="../RemoteOS.Server/bin/Debug/net10.0/runtimes/linux-x64/native/libe_sqlite3.so"
          Link="libe_sqlite3.so" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(UsePrebuiltServerAssembly)' == 'true' and '$(OS)' == 'Unix'" />
    <!-- Prebuilt mode must also expose the Server's compile-time API surface, not merely its
         implementation assembly. This keeps the local smoke suite runnable on SDKs where
         project-reference workload resolution is unavailable. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(UsePrebuiltServerAssembly)' == 'true'" />
    <Reference Include="RemoteOS.Protocol" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../Shared/RemoteOS.Protocol/bin/Debug/net10.0/RemoteOS.Protocol.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/Microsoft.EntityFrameworkCore.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Sqlite" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/Microsoft.EntityFrameworkCore.Sqlite.dll</HintPath>
    </Reference>
    <Reference Include="System.IdentityModel.Tokens.Jwt" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RemoteOS.Server/bin/Debug/net10.0/System.IdentityModel.Tokens.Jwt.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
