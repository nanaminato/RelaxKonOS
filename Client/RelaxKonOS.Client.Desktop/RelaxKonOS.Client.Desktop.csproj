<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>RelaxKonOS.Client.Desktop</RootNamespace>
        <AssemblyName>RelaxKonOS</AssemblyName>
        <AssemblyTitle>RelaxKonOS</AssemblyTitle>
        <Product>RelaxKonOS</Product>
        <Description>RelaxKonOS remote desktop client</Description>
        <ApplicationIcon>..\RelaxKonOS.Client\Assets\RelaxKonOS-client-icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RelaxKonOS.Client\RelaxKonOS.Client.csproj" />
    </ItemGroup>
</Project>
