<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>RelaxKonOS.Client.Desktop</RootNamespace>
        <AssemblyName>RelaxKonOS</AssemblyName>
        <AssemblyTitle>RelaxKonOS</AssemblyTitle>
        <Product>RelaxKonOS</Product>
        <Description>RelaxKonOS remote desktop client</Description>
        <ApplicationIcon>..\RelaxKonOS.Client\Assets\RelaxKonOS-client-icon.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RelaxKonOS.Client\RelaxKonOS.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Browser" AppId="relaxkonos.browser" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.CodeEditor" AppId="relaxkonos.codeeditor" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Docker" AppId="relaxkonos.docker" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.EventAlerts" AppId="relaxkonos.event-alerts" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.FileServices" AppId="relaxkonos.file-services" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Firewall" AppId="relaxkonos.firewall" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Git" AppId="relaxkonos.git" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.ImageViewer" AppId="relaxkonos.imageviewer" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Notepad" AppId="relaxkonos.notepad" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Registry" AppId="relaxkonos.registry" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.TaskManager" AppId="relaxkonos.taskmanager" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Certificates" AppId="relaxkonos.certificates" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Terminal" AppId="relaxkonos.terminal" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.WebServers" AppId="relaxkonos.webservers" />
        <OfficialDesktopApp Include="../../Applications/RelaxKonOS.App.Welcome" AppId="relaxkonos.welcome" />
    </ItemGroup>

    <Target Name="PublishOfficialDesktopApps" AfterTargets="Publish" Condition="'$(IncludeOfficialApps)' != 'false'">
        <PropertyGroup>
            <OfficialAppSource>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'OfficialApps'))</OfficialAppSource>
            <DesktopDevCli>$(MSBuildProjectDirectory)/../../Tools/RelaxKonOS.DevCli</DesktopDevCli>
        </PropertyGroup>
        <MakeDir Directories="$(OfficialAppSource)" />
        <Exec Command="dotnet run --project &quot;$(DesktopDevCli)&quot; --configuration $(Configuration) -- pack &quot;%(OfficialDesktopApp.FullPath)&quot; --configuration $(Configuration) --output &quot;$(OfficialAppSource)%(OfficialDesktopApp.AppId).roapp&quot;" />
        <GetFileHash Files="@(OfficialDesktopApp->'$(OfficialAppSource)%(AppId).roapp')" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="OfficialDesktopPackage" />
        </GetFileHash>
        <WriteLinesToFile File="%(OfficialDesktopPackage.Identity).sha256" Lines="%(OfficialDesktopPackage.FileHash)" Overwrite="true" />
        <Copy SourceFiles="$(MSBuildProjectDirectory)/installation-profiles.json" DestinationFolder="$(OfficialAppSource)" />
    </Target>

    <Target Name="ConfigureOfficialDesktopCatalog" AfterTargets="Publish" Condition="'$(OfficialDesktopCatalogUri)' != ''">
        <PropertyGroup>
            <OfficialCatalogConfigFolder>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'OfficialApps'))</OfficialCatalogConfigFolder>
        </PropertyGroup>
        <MakeDir Directories="$(OfficialCatalogConfigFolder)" />
        <WriteLinesToFile File="$(OfficialCatalogConfigFolder)catalog-source.json"
                          Lines="{&quot;catalogUri&quot;:&quot;$(OfficialDesktopCatalogUri)&quot;}" Overwrite="true" />
    </Target>
</Project>
