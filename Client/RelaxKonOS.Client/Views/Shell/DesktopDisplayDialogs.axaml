<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             x:Class="RelaxKonOS.Client.Views.Shell.DesktopDisplayDialogs">
    <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="16">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14" Margin="0,0,12,0">
                <TextBlock x:Name="WelcomeHeading"
                           Text="{loc:Loc shell.desktop_display.welcome_heading}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           IsVisible="False" />
                <TextBlock x:Name="DescriptionText"
                           Text="{loc:Loc shell.desktop_display.description}"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Opacity="0.85" />
                <Separator Margin="0,4,0,0" />

                <TextBlock Text="{loc:Loc shell.desktop_display.built_in_apps}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0" />
                <CheckBox x:Name="ShowAppsToggle"
                          Content="{loc:Loc shell.desktop_display.show_built_in_apps}"
                          Padding="0,2"
                          IsCheckedChanged="ShowAppsToggle_OnIsCheckedChanged" />
                <StackPanel Margin="20,4,0,0" Spacing="8">
                    <RadioButton x:Name="AllAppsRadio"
                                 GroupName="built-in-apps"
                                 Content="{loc:Loc shell.desktop_display.show_all_built_in_apps}"
                                 IsCheckedChanged="AllAppsRadio_OnIsCheckedChanged" />
                    <RadioButton x:Name="CustomAppsRadio"
                                 GroupName="built-in-apps"
                                 Content="{loc:Loc shell.desktop_display.show_selected_apps}"
                                 IsCheckedChanged="CustomAppsRadio_OnIsCheckedChanged" />
                    <ScrollViewer x:Name="AppListViewer"
                                  Background="Transparent"
                                  MaxHeight="160"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AppList" Spacing="2" />
                    </ScrollViewer>
                </StackPanel>

                <Separator Margin="0,4,0,0" />

                <TextBlock Text="{loc:Loc shell.desktop_display.server_desktop_files}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,4,0,0" />
                <CheckBox x:Name="ShowFilesToggle"
                          Content="{loc:Loc shell.desktop_display.show_server_files}"
                          Padding="0,2" />
                <CheckBox x:Name="ShowShortcutsToggle"
                          Content="{loc:Loc shell.desktop_display.show_server_shortcuts}"
                          Padding="20,2,0,2"
                          Opacity="0.92"
                          ToolTip.Tip="{loc:Loc shell.desktop_display.shortcuts_tooltip}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0"
                    Spacing="8">
            <Button x:Name="CancelOrSkipButton" Padding="16,6" Click="CancelOrSkipButton_OnClick" />
            <Button x:Name="SaveButton" Classes="primary" Padding="16,6" Click="SaveButton_OnClick" />
        </StackPanel>
    </Grid>
</UserControl>
