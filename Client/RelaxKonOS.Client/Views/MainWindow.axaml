<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
        xmlns:services="clr-namespace:RelaxKonOS.Client.Services"
        xmlns:shell="clr-namespace:RelaxKonOS.Client.Views.Shell"
        xmlns:vm="clr-namespace:RelaxKonOS.Client.ViewModels.Shell"
        x:Class="RelaxKonOS.Client.Views.MainWindow"
        x:DataType="vm:DesktopShellViewModel"
        Title="RelaxKonOS"
        Icon="/Assets/RelaxKonOS-client-icon.ico"
        WindowState="Maximized"
        WindowDecorations="None"
        CanResize="True"
        MinWidth="800"
        MinHeight="520"
        ShowInTaskbar="True"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{DynamicResource ContentFont}"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <Window.Styles>
        <Style Selector="Border.connection-bar">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" />
            <Setter Property="BoxShadow" Value="{DynamicResource ElevationShadow}" />
            <!-- The connection bar hangs below the host title bar, so only its lower corners round. -->
            <Setter Property="CornerRadius" Value="{DynamicResource OverlayBottomCornerRadius}" />
        </Style>
        <Style Selector="Button.connection-action">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="{DynamicResource WindowTitleBarHeight}" />
            <Setter Property="Height" Value="{DynamicResource WindowTitleBarHeight}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.connection-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.disconnect-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnDangerBrush}" />
        </Style>
        <Style Selector="Border.window-titlebar">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <!-- The outer desktop host draws its own caption, so its three buttons obey the same contract
             as a managed window's: nothing about the mark comes from text. A character inherits its
             weight from its designer and its ink from the font's line box, which is why the old
             minus/restore/close characters needed a hand-tuned FontSize and still landed off centre.
             The marks below are the host's own geometry (WindowCaptionMarks), sized by the style's
             mark box, so the host and a managed caption are optically the same button. -->
        <Style Selector="Button.window-control">
            <Setter Property="Width" Value="{DynamicResource WindowControlWidth}" />
            <Setter Property="Height" Value="{DynamicResource WindowTitleBarHeight}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- One button, two actions: a maximized host offers "restore". The name and the tooltip are
             declared here rather than on the button because a value set in the view outranks a style
             setter, which would pin the host caption to "restore" for the rest of its life. -->
        <Style Selector="Button.window-control.window-maximize">
            <Setter Property="AutomationProperties.Name" Value="{loc:Loc common.maximize}" />
            <Setter Property="ToolTip.Tip" Value="{loc:Loc common.maximize}" />
        </Style>
        <Style Selector="Button.window-control.window-maximize.maximized">
            <Setter Property="AutomationProperties.Name" Value="{loc:Loc common.restore}" />
            <Setter Property="ToolTip.Tip" Value="{loc:Loc common.restore}" />
        </Style>
        <!-- Exactly one of the two marks is ever painted, and the pair follows the host window's
             state rather than the last click, so a snap layout or Win+Up cannot desynchronise them. -->
        <Style Selector="Button.window-maximize Path.mark-restore">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.window-maximize.maximized Path.mark-restore">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.window-maximize.maximized Path.mark-maximize">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.window-close:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnDangerBrush}" />
        </Style>
        <!-- The host reserves its own caption area, so the desktop begins below the host title bar.
             The reservation is a style - not a literal written from code - for two reasons: a number
             typed into SetFullScreen silently drifts from WindowTitleBarHeight, and a local value
             permanently replaces the markup's own binding, so after the first full-screen round trip
             the desktop slides 8px up under an opaque title bar. A style also keeps the reservation
             live when the user switches system style. -->
        <Style Selector="Grid#Root">
            <Setter Property="Margin" Value="{DynamicResource HostTitleBarMargin}" />
        </Style>
        <Style Selector="Grid#Root.host-full-screen">
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Styles>

    <Grid PointerMoved="Root_OnPointerMoved" KeyDown="Root_OnKeyDown">
        <Grid x:Name="Root" PointerMoved="Root_OnPointerMoved">
            <LayoutTransformControl LayoutTransform="{DynamicResource DesktopInterfaceTransform}">
                <ContentControl x:Name="ShellHost" />
            </LayoutTransformControl>
            <!-- The opaque launch screen hides the empty host and partially restored desktop
                 until the selected shell has registered its surfaces and restored its state. -->
            <Border x:Name="DesktopLoadingOverlay" Background="{DynamicResource AppBackgroundBrush}" ZIndex="50">
                <Border MaxWidth="420" Margin="32" Padding="32"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="{DynamicResource ControlBorderThickness}"
                        CornerRadius="{DynamicResource OverlayCornerRadius}"
                        BoxShadow="{DynamicResource ElevationShadow}">
                    <StackPanel Spacing="20">
                        <Image Source="/Assets/RelaxKonOS-client-icon.png" Width="72" Height="72"
                               Stretch="Uniform" HorizontalAlignment="Center" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="RelaxKonOS" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="28" FontWeight="SemiBold" TextAlignment="Center" />
                            <TextBlock Text="{loc:Loc shell.desktop_loading.title}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Loc shell.desktop_loading.description}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="True" Height="4" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- The title bar and mstsc connection bar deliberately share the same top layer. -->
        <Border x:Name="WindowTitleBar" Classes="window-titlebar" Height="{DynamicResource WindowTitleBarHeight}"
                VerticalAlignment="Top" ZIndex="10" PointerPressed="TitleBar_OnPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Width="26" Height="26" Margin="8,0,6,0" VerticalAlignment="Center"
                       Source="/Assets/RelaxKonOS-client-icon.png" />
                <TextBlock Grid.Column="1" Text="{loc:Loc shell.window_title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Classes="window-control"
                            AutomationProperties.Name="{loc:Loc common.minimize}"
                            ToolTip.Tip="{loc:Loc common.minimize}"
                            Click="Minimize_OnClick">
                        <Path Classes="caption-glyph"
                              Width="{DynamicResource WindowCaptionGlyphSize}"
                              Height="{DynamicResource WindowCaptionGlyphSize}"
                              Data="{DynamicResource WindowCaptionMinimizeGlyph}"
                              Stroke="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <!-- Two marks, one button: a maximized host offers "restore", and both the mark and
                         the announced name have to say so. The mark box - not the ink - is what gets
                         the button's centre line: a 1px-tall hairline centred by its own height would
                         land on a half pixel and smear into two grey rows. -->
                    <Button x:Name="MaximizeButton" Classes="window-control window-maximize"
                            Click="Maximize_OnClick">
                        <Panel>
                            <Path Classes="caption-glyph mark-maximize"
                                  Width="{DynamicResource WindowCaptionGlyphSize}"
                                  Height="{DynamicResource WindowCaptionGlyphSize}"
                                  Data="{DynamicResource WindowCaptionMaximizeGlyph}"
                                  Stroke="{Binding $parent[Button].Foreground}" />
                            <Path Classes="caption-glyph mark-restore"
                                  Width="{DynamicResource WindowCaptionGlyphSize}"
                                  Height="{DynamicResource WindowCaptionGlyphSize}"
                                  Data="{DynamicResource WindowCaptionRestoreGlyph}"
                                  Stroke="{Binding $parent[Button].Foreground}" />
                        </Panel>
                    </Button>
                    <Button x:Name="CloseButton" Classes="window-control window-close"
                            AutomationProperties.Name="{loc:Loc common.close}"
                            ToolTip.Tip="{loc:Loc shell.connection.close}"
                            Click="CloseWindow_OnClick">
                        <Path Classes="caption-glyph"
                              Width="{DynamicResource WindowCaptionGlyphSize}"
                              Height="{DynamicResource WindowCaptionGlyphSize}"
                              Data="{DynamicResource WindowCaptionCloseGlyph}"
                              Stroke="{Binding $parent[Button].Foreground}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="NotificationBanner" x:DataType="services:DesktopNotificationService" IsVisible="{Binding HasNotification}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="400" Margin="16,16,16,60" Padding="16" ZIndex="45"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                <Button Content="{loc:Loc settings.device.dismiss}" Command="{Binding DismissCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- mstsc-style connection bar. Its centre exposes connection context and a drag handle. -->
        <Border x:Name="ConnectionBar" Classes="connection-bar"
                HorizontalAlignment="Center" VerticalAlignment="Top" Width="520" Height="{DynamicResource WindowTitleBarHeight}"
                ZIndex="20"
                PointerEntered="ConnectionBar_OnPointerEntered"
                PointerExited="ConnectionBar_OnPointerExited">
            <!-- Fixed side controls leave the centre a real, shrinkable region instead of
                 allowing long server/user names to overlap neighbouring buttons. -->
            <Grid ColumnDefinitions="150,1,42,*,42,1,42">
                <Button Grid.Column="0" Classes="connection-action" Click="ConnectionInfo_OnClick"
                        ToolTip.Tip="{loc:Loc shell.connection.info_tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock Text="●" FontSize="12" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionServer}" FontSize="12" MaxWidth="106"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,7" />
                <Button Grid.Column="2" x:Name="PinButton" Classes="connection-action" Click="Pin_OnClick"
                        Content="○" ToolTip.Tip="{loc:Loc shell.connection_bar.pin_tooltip}" />
                <Border Grid.Column="3" x:Name="ConnectionDragHandle" Cursor="SizeWestEast"
                        PointerPressed="ConnectionDragHandle_OnPointerPressed"
                        PointerMoved="ConnectionDragHandle_OnPointerMoved"
                        PointerReleased="ConnectionDragHandle_OnPointerReleased"
                        ToolTip.Tip="{loc:Loc shell.connection_bar.drag_tooltip}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="↔" FontSize="14" Opacity="0.45" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                    ToolTip.Tip="{loc:Loc shell.connection.user}">
                            <TextBlock Text="@" FontSize="12" Opacity="0.65" />
                            <TextBlock Text="{Binding ConnectionUser}" FontSize="12" MaxWidth="128"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Button Grid.Column="4" x:Name="FullScreenButton" Classes="connection-action"
                        Click="FullScreen_OnClick" Content="↗" ToolTip.Tip="{loc:Loc shell.full_screen.enter_tooltip}" />
                <Border Grid.Column="5" Width="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,7" />
                <Button Grid.Column="6" Classes="connection-action disconnect-action" Click="Disconnect_OnClick"
                        Content="×" ToolTip.Tip="{loc:Loc shell.connection.close_tooltip}" />
            </Grid>
        </Border>

        <Border x:Name="ConnectionInfo" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Width="400" Margin="{DynamicResource HostTitleBarMargin}"
                ZIndex="30"
                Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="{DynamicResource ControlBorderThickness}" CornerRadius="{DynamicResource OverlayCornerRadius}"
                BoxShadow="{DynamicResource ElevationShadow}" Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{loc:Loc shell.connection.info}" FontWeight="SemiBold" FontSize="16" />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc shell.connection.server}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionServer}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc shell.connection.user}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1"  Text="{Binding ConnectionUser}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc shell.connection.workspace}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1"  Text="{Binding ConnectionWorkspace}" TextWrapping="Wrap" Margin="0,7,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Host-owned system layer. It sits above every shell surface - including the full-screen
             window host and the connection bar - and is its own input backdrop: while it is
             visible nothing below can be clicked, so the overview needs no second shield. -->
        <LayoutTransformControl LayoutTransform="{DynamicResource DesktopInterfaceTransform}" ZIndex="100" IsVisible="{Binding #WindowOverview.IsVisible}">
            <shell:WindowOverviewView x:Name="WindowOverview" IsVisible="False" />
        </LayoutTransformControl>

        <!-- Closing a connection can briefly wait for the final workspace-layout save and server
             sign-out.  Give that wait an immediate, animated acknowledgement instead of leaving
             the desktop apparently frozen. -->
        <Border x:Name="DisconnectingOverlay" IsVisible="False" Opacity="0" ZIndex="200"
                Background="{DynamicResource OverlayScrimBrush}">
            <Border Classes="card" Width="280" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{loc:Loc shell.connection.disconnecting.title}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
                    <TextBlock Text="{loc:Loc shell.connection.disconnecting.description}" Classes="subtle" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="True" Height="4" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Transparent hit targets keep every edge and corner resizable. -->
        <Border HorizontalAlignment="Left" Width="8" Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="Resize_OnPointerPressed" Tag="West" />
        <Border HorizontalAlignment="Right" Width="8" Background="Transparent" Cursor="SizeWestEast"
                PointerPressed="Resize_OnPointerPressed" Tag="East" />
        <Border VerticalAlignment="Top" Height="8" Background="Transparent" Cursor="SizeNorthSouth"
                PointerPressed="Resize_OnPointerPressed" Tag="North" />
        <Border VerticalAlignment="Bottom" Height="8" Background="Transparent" Cursor="SizeNorthSouth"
                PointerPressed="Resize_OnPointerPressed" Tag="South" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12" Background="Transparent"
                Cursor="TopLeftCorner" PointerPressed="Resize_OnPointerPressed" Tag="NorthWest" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12" Background="Transparent"
                Cursor="TopRightCorner" PointerPressed="Resize_OnPointerPressed" Tag="NorthEast" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" Background="Transparent"
                Cursor="BottomLeftCorner" PointerPressed="Resize_OnPointerPressed" Tag="SouthWest" />
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Background="Transparent"
                Cursor="BottomRightCorner" PointerPressed="Resize_OnPointerPressed" Tag="SouthEast" />
    </Grid>
</Window>
