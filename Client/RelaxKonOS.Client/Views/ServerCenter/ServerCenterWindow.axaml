<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RelaxKonOS.Client.ViewModels.ServerCenter"
        x:Class="RelaxKonOS.Client.Views.ServerCenter.ServerCenterWindow"
        x:DataType="vm:ServerCenterViewModel"
        Title="Server centre" Width="720" Height="650" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource ContentFont}">
    <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Light" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Padding="14" CornerRadius="3" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding HostsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <ListBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" MaxHeight="130">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6" Spacing="2">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SshUserName}" />
                                <TextBlock Text="{Binding SshHost}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding EmptyHostsText}" IsVisible="{Binding !HasHosts}" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel IsVisible="{Binding SelectedHost}" Spacing="8">
                    <TextBlock Text="{Binding SelectedHost.DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedHost.SshUserName}" />
                    <TextBlock Text="{Binding SelectedHost.SshHost}" />
                    <TextBlock Text="{Binding VerifiedStateText}" IsVisible="{Binding HasVerifiedState}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding SshPassword}" PasswordChar="●" PlaceholderText="{Binding SshPasswordLabel}" />
                    <CheckBox IsChecked="{Binding SaveSshPassword}" Content="{Binding SaveSshPasswordText}" />
                    <Button Command="{Binding VerifySshCommand}" Content="{Binding VerifySshText}" HorizontalAlignment="Left" />
                    <StackPanel IsVisible="{Binding NeedsHostKeyConfirmation}" Spacing="6">
                        <TextBlock Text="{Binding HostKeyReviewText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HostKeyFingerprint}" FontFamily="Consolas" TextWrapping="Wrap" />
                        <Button Command="{Binding ConfirmHostKeyCommand}" Content="{Binding ConfirmHostKeyText}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Text="{Binding HostKeyChangedText}" IsVisible="{Binding HostKeyChanged}" TextWrapping="Wrap" Classes="error" />
                    <Separator Margin="0,4" />
                    <TextBlock Text="{Binding ProbeHelpText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}" PlaceholderText="{Binding PlatformLabel}" HorizontalAlignment="Left" MinWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Command="{Binding ProbeHostCommand}" Content="{Binding ProbeText}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding LastProbeText}" IsVisible="{Binding HasLastProbe}" TextWrapping="Wrap" />
                    <CheckBox IsChecked="{Binding DeploymentConfirmed}" Content="{Binding DeployConfirmationText}" />
                    <Button Command="{Binding DeployRecommendedCommand}" Content="{Binding DeployText}" HorizontalAlignment="Left" />
                    <StackPanel IsVisible="{Binding SelectedHost.LastVerified.Installed}" Spacing="8">
                        <Button Command="{Binding RepairCommand}" Content="{Binding RepairText}" HorizontalAlignment="Left" />
                        <Button Command="{Binding RollbackCommand}" Content="{Binding RollbackText}" HorizontalAlignment="Left" />
                        <Separator Margin="0,4" />
                        <CheckBox IsChecked="{Binding DeleteServerData}" Content="{Binding DeleteServerDataText}" />
                        <TextBox Text="{Binding UninstallNameConfirmation}" IsVisible="{Binding DeleteServerData}" PlaceholderText="{Binding UninstallNameLabel}" />
                        <Button Command="{Binding UninstallCommand}" Content="{Binding UninstallText}" HorizontalAlignment="Left" Classes="danger" />
                    </StackPanel>
                    <Separator Margin="0,4" />
                    <TextBlock Text="{Binding OperationHistoryText}" FontWeight="SemiBold" />
                    <Button Command="{Binding LoadOperationHistoryCommand}" Content="{Binding LoadOperationHistoryText}" HorizontalAlignment="Left" />
                    <ListBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" IsVisible="{Binding HasOperations}" MaxHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4" Spacing="1">
                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding State}" />
                                    <TextBlock Text="{Binding SafeMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Command="{Binding RefreshOperationCommand}" Content="{Binding RefreshOperationText}" HorizontalAlignment="Left" />
                </StackPanel>
                <TextBlock Text="{Binding CachedStateText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Command="{Binding RemoveHostCommand}" Content="{Binding RemoveText}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="14" CornerRadius="3" Background="{DynamicResource SurfaceBrush}">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding AddHostLabel}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Grid ColumnDefinitions="*,110,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <TextBox Text="{Binding Host}" PlaceholderText="{Binding HostLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Port}" PlaceholderText="{Binding PortLabel}" />
                    <TextBox Grid.Column="2" Text="{Binding UserName}" PlaceholderText="{Binding UserLabel}" />
                    <TextBox Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding DisplayName}" PlaceholderText="{Binding DisplayNameLabel}" />
                </Grid>
                <Button Command="{Binding AddHostCommand}" Content="{Binding AddText}" HorizontalAlignment="Left" />
                <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding !HasError}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Classes="error" />
            </StackPanel>
        </Border>
        <Button Grid.Row="3" Content="{Binding CloseText}" HorizontalAlignment="Right" Click="Close_Click" MinWidth="88" />
    </Grid>
</Window>
