<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RelaxKonOS.Client.Views.Login.SshHostKeyDialog"
        Width="640" MinHeight="230" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <!-- 密钥变更时左侧显示被取代的旧指纹：只看新指纹无法分辨「重装/重建过的同一台机器」
             和「这个地址被另一台机器接管」，因此两者必须并排出现。 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border x:Name="PinnedPanel" Grid.Column="0" IsVisible="False" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="PinnedLabel" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="PinnedFingerprintText" FontFamily="Consolas" TextWrapping="Wrap" />
                    <TextBlock x:Name="PinnedConfirmedText" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ObservedLabel" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="FingerprintText" FontFamily="Consolas" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Classes="primary" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
