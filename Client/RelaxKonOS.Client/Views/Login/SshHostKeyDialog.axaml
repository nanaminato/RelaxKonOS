<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RelaxKonOS.Client.Views.Login.SshHostKeyDialog"
        Width="640" MinHeight="230" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="22" />
        <!-- 每个指纹使用完整宽度，避免长指纹挤压相邻内容；旧记录仅在变更时展示。 -->
        <StackPanel Grid.Row="1" Spacing="12">
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="ObservedLabel" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <SelectableTextBlock x:Name="FingerprintText" FontFamily="Consolas,monospace" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border x:Name="PinnedPanel" IsVisible="False" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="16" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PinnedLabel" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <SelectableTextBlock x:Name="PinnedFingerprintText" FontFamily="Consolas,monospace" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
                    <TextBlock x:Name="PinnedConfirmedText" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelButton" MinWidth="80" MinHeight="40" HorizontalContentAlignment="Center" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" MinHeight="40" Padding="16,8" HorizontalContentAlignment="Center" Classes="primary" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
