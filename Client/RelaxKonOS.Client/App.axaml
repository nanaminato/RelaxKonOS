<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelaxKonOS.Client.App"
             RequestedThemeVariant="Default">

    <!-- Keep the Windows notification-area icon in sync with the window and executable icon. -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/RelaxKonOS-client-icon.ico"
                      ToolTipText="RelaxKonOS Client"
                      IsVisible="True" />
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="avares://RelaxKonOS.UI/Themes/RelaxKonOSTheme.axaml" />
        <StyleInclude Source="avares://RelaxKonOS.WindowManager/Themes/RemoteWindowTheme.axaml" />
    </Application.Styles>

</Application>
