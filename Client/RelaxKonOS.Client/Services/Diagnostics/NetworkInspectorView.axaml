<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:diagnostics="clr-namespace:RelaxKonOS.Client.Services.Diagnostics"
             x:Class="RelaxKonOS.Client.Services.Diagnostics.NetworkInspectorView" Classes="builtin-app">
    <!-- Chrome DevTools Network vocabulary: one flat toolbar, a type-filter row, a request table that
         keeps all of its columns, and a details pane that takes height instead of hiding data. -->
    <UserControl.Styles>
        <Style Selector="Button.toolbar-action">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.toolbar-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.toolbar-action:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        </Style>
        <Style Selector="Button.toolbar-action:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
        <Style Selector="Button.toolbar-action.active">
            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.toolbar-action.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerMutedBrush}" />
        </Style>
        <Style Selector="Ellipse.rec-dot">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style Selector="Ellipse.rec-dot.recording">
            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="55%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- The filter keeps the shared TextBox focus ring and only borrows the toolbar's corners. -->
        <Style Selector="TextBox.filter-input">
            <Setter Property="Padding" Value="30,5,26,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.chip.active">
            <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.chip.active:pointerover">
            <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
        </Style>
        <Style Selector="Border.method-badge">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.method-badge TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.method-badge.get TextBlock"><Setter Property="Foreground" Value="{DynamicResource InfoBrush}" /></Style>
        <Style Selector="Border.method-badge.post TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Style>
        <Style Selector="Border.method-badge.put TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
        <Style Selector="Border.method-badge.delete TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
        </Style>
        <Style Selector="Ellipse.status-dot.ok"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></Style>
        <Style Selector="Ellipse.status-dot.info"><Setter Property="Fill" Value="{DynamicResource InfoBrush}" /></Style>
        <Style Selector="Ellipse.status-dot.warn"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></Style>
        <Style Selector="Ellipse.status-dot.bad"><Setter Property="Fill" Value="{DynamicResource DangerBrush}" /></Style>
        <Style Selector="TextBlock.status-text"><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style Selector="TextBlock.status-text.warn"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
        <Style Selector="TextBlock.status-text.bad"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
        <Style Selector="Border.waterfall-track">
            <Setter Property="Height" Value="6" />
            <Setter Property="Width" Value="84" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.waterfall-bar">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Border.waterfall-bar.bad"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></Style>
        <Style Selector="TextBlock.detail-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="SelectableTextBlock.detail-value">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="SelectableTextBlock.detail-value.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBox.content-view">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="TextBox.content-view /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
        </Style>
        <Style Selector="Border.unavailable-banner">
            <Setter Property="Background" Value="{DynamicResource WarningMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="10,8,10,0" />
        </Style>
        <Style Selector="Border.details-header">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <!-- A selected row is one colour: the method badge and its verb tint would otherwise fight
             the selection fill, and status stays legible through its dot. -->
        <Style Selector="DataGridRow:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
        </Style>
        <Style Selector="DataGridRow:selected Border.method-badge">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,4" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Shell" RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Classes="app-toolbar" Padding="10,6">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                <Button x:Name="RecordButton" Classes="toolbar-action" Click="Record_Click" Padding="8,0"
                        ToolTip.Tip="{loc:Loc network_inspector.record_hint}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="RecordDot" Classes="rec-dot" />
                        <TextBlock x:Name="RecordLabel" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="ClearButton" Grid.Column="1" Classes="toolbar-action" Click="Clear_Click"
                        Width="30" Padding="0" ToolTip.Tip="{loc:Loc network_inspector.clear_hint}">
                    <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.4" StrokeLineCap="Round"
                          Stroke="{DynamicResource TextSecondaryBrush}"
                          Data="M11 2 A9 9 0 1 0 11 20 A9 9 0 1 0 11 2 Z M4.8 4.8 L17.2 17.2" />
                </Button>

                <Grid Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="FilterBox" Classes="filter-input" TextChanged="Filter_TextChanged" />
                    <Path Width="13" Height="13" Stretch="Uniform" Margin="9,0,0,0" IsHitTestVisible="False"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          StrokeThickness="1.6" StrokeLineCap="Round"
                          Stroke="{DynamicResource TextTertiaryBrush}"
                          Data="M10 3 A7 7 0 1 0 10 17 A7 7 0 1 0 10 3 Z M15.2 15.2 L20 20" />
                    <Button x:Name="ClearFilterButton" Classes="tab-close" HorizontalAlignment="Right"
                            Margin="0,0,6,0" VerticalAlignment="Center" IsVisible="False"
                            Click="ClearFilter_Click" ToolTip.Tip="{loc:Loc network_inspector.clear_filter}">
                        <Path Width="8" Height="8" Stretch="Uniform" StrokeThickness="1.6" StrokeLineCap="Round"
                              Stroke="{DynamicResource TextSecondaryBrush}" Data="M2 2 L10 10 M10 2 L2 10" />
                    </Button>
                </Grid>

                <TextBlock x:Name="RecordingStateText" Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                           Margin="6,0,2,0" Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                Background="{DynamicResource SurfaceRaisedBrush}" Padding="10,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="AllChip" Classes="chip" Content="{loc:Loc network_inspector.filter_all}" Click="Chip_Click" Tag="all" />
                    <Button x:Name="HttpChip" Classes="chip" Content="{loc:Loc network_inspector.filter_http}" Click="Chip_Click" Tag="http" />
                    <Button x:Name="SignalrChip" Classes="chip" Content="{loc:Loc network_inspector.filter_signalr}" Click="Chip_Click" Tag="signalr" />
                    <Button x:Name="MediaChip" Classes="chip" Content="{loc:Loc network_inspector.filter_media}" Click="Chip_Click" Tag="media" />
                    <Button x:Name="FailedChip" Classes="chip" Content="{loc:Loc network_inspector.filter_failed}" Click="Chip_Click" Tag="failed" />
                </StackPanel>
                <TextBlock x:Name="SummaryText" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
        </Border>

        <Grid x:Name="ContentGrid" Grid.Row="2" RowDefinitions="Auto,*,Auto,Auto">
            <Border x:Name="UnavailableBanner" Grid.Row="0" Classes="unavailable-banner" IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.5" StrokeLineCap="Round"
                          VerticalAlignment="Center" Stroke="{DynamicResource WarningBrush}"
                          Data="M12 3 L22 20 H2 Z M12 9 V14 M12 17 V17.1" />
                    <TextBlock x:Name="UnavailableText" FontSize="12" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <DataGrid x:Name="RequestsGrid" Classes="resource-table"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="None"
                          RowHeight="NaN"
                          Margin="10,8"
                          ColumnHeaderHeight="32"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc network_inspector.name}" SortMemberPath="Name" Width="*" MinWidth="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="diagnostics:NetworkInspectorRow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Border Classes="method-badge"
                                                Classes.get="{Binding IsGet}"
                                                Classes.post="{Binding IsPost}"
                                                Classes.put="{Binding IsPut}"
                                                Classes.delete="{Binding IsDelete}">
                                            <TextBlock Text="{Binding Method}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc network_inspector.status}" SortMemberPath="StatusCode" Width="92" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="diagnostics:NetworkInspectorRow">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="status-dot"
                                                 Classes.ok="{Binding IsSuccess}"
                                                 Classes.info="{Binding IsInfo}"
                                                 Classes.warn="{Binding IsWarning}"
                                                 Classes.bad="{Binding IsDanger}" />
                                        <TextBlock Text="{Binding Status}" Classes="status-text"
                                                   Classes.warn="{Binding IsWarning}"
                                                   Classes.bad="{Binding IsDanger}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc network_inspector.type}" SortMemberPath="Type" Width="146" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="diagnostics:NetworkInspectorRow">
                                    <TextBlock Text="{Binding Type}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc network_inspector.size}" SortMemberPath="SizeBytes" Width="88" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="diagnostics:NetworkInspectorRow">
                                    <TextBlock Text="{Binding Size}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc network_inspector.duration}" SortMemberPath="DurationMilliseconds" Width="96" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="diagnostics:NetworkInspectorRow">
                                    <TextBlock Text="{Binding Duration}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc network_inspector.waterfall}" SortMemberPath="DurationMilliseconds" Width="96" MinWidth="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="diagnostics:NetworkInspectorRow">
                                    <Border Classes="waterfall-track">
                                        <Border Classes="waterfall-bar"
                                                Classes.bad="{Binding IsDanger}"
                                                Width="{Binding WaterfallWidth}" HorizontalAlignment="Left" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:Loc network_inspector.source}" SortMemberPath="Source" Width="118" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="diagnostics:NetworkInspectorRow">
                                    <TextBlock Text="{Binding Source}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyState" IsVisible="False" Spacing="10" MaxWidth="420"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
                            Background="{DynamicResource SurfaceSunkenBrush}">
                        <Path Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                              StrokeThickness="1.4" StrokeLineCap="Round" Stroke="{DynamicResource TextTertiaryBrush}"
                              Data="M10 3 A7 7 0 1 0 10 17 A7 7 0 1 0 10 3 Z M15.2 15.2 L20 20" />
                    </Border>
                    <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <GridSplitter x:Name="DetailsSplitter" Grid.Row="2" Height="5" ResizeDirection="Rows" IsVisible="False" />

            <Grid x:Name="DetailsPanel" Grid.Row="3" RowDefinitions="Auto,*" IsVisible="False">
                <Border Classes="details-header">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <Border x:Name="DetailMethodBadge" Classes="method-badge">
                            <TextBlock x:Name="DetailMethodText" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailTitle" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <SelectableTextBlock x:Name="DetailSubtitle" FontSize="11" TextWrapping="NoWrap"
                                                 TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono,Consolas,monospace"
                                                 Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="DetailSummary" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="3" Classes="tab-close" Width="24" Height="24" VerticalAlignment="Center"
                                Click="CloseDetails_Click" ToolTip.Tip="{loc:Loc network_inspector.close_details}">
                            <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.6" StrokeLineCap="Round"
                                  Stroke="{DynamicResource TextSecondaryBrush}" Data="M2 2 L10 10 M10 2 L2 10" />
                        </Button>
                    </Grid>
                </Border>

                <TabControl x:Name="DetailTabs" Grid.Row="1" Padding="0" Margin="0">
                    <TabItem Header="{loc:Loc network_inspector.summary}" FontSize="12">
                        <ScrollViewer>
                            <ItemsControl x:Name="OverviewList" Margin="14,10,14,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diagnostics:NetworkInspectorDetailRow">
                                        <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" Classes="detail-label" />
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="detail-value"
                                                                 Classes.mono="{Binding IsMonospace}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Headers and bodies get a tab each: a seven-header request used to leave the
                         payload a few dozen pixels tall, which is below the point of being readable. -->
                    <TabItem Header="{loc:Loc network_inspector.request_headers}" FontSize="12">
                        <ScrollViewer>
                            <ItemsControl x:Name="RequestHeadersList" Margin="14,8,14,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diagnostics:NetworkInspectorDetailRow">
                                        <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" Classes="detail-label" />
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="detail-value mono" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Loc network_inspector.payload}" FontSize="12">
                        <Grid RowDefinitions="Auto,*" Margin="14,8,14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                <CheckBox x:Name="PayloadPrettyToggle" FontSize="12" IsChecked="True"
                                          Content="{loc:Loc network_inspector.pretty_json}"
                                          IsCheckedChanged="Pretty_IsCheckedChanged" />
                                <TextBlock x:Name="PayloadFormatText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Grid>
                            <TextBox x:Name="PayloadText" Grid.Row="1" Classes="content-view"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="{loc:Loc network_inspector.response_headers}" FontSize="12">
                        <ScrollViewer>
                            <ItemsControl x:Name="ResponseHeadersList" Margin="14,8,14,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="diagnostics:NetworkInspectorDetailRow">
                                        <Grid ColumnDefinitions="170,*" ColumnSpacing="10" Margin="0,2">
                                            <TextBlock Text="{Binding Label}" Classes="detail-label" />
                                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="detail-value mono" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{loc:Loc network_inspector.body}" FontSize="12">
                        <Grid RowDefinitions="Auto,*" Margin="14,8,14,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                <CheckBox x:Name="ResponsePrettyToggle" FontSize="12" IsChecked="True"
                                          Content="{loc:Loc network_inspector.pretty_json}"
                                          IsCheckedChanged="Pretty_IsCheckedChanged" />
                                <TextBlock x:Name="ResponseFormatText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Grid>
                            <TextBox x:Name="ResponseText" Grid.Row="1" Classes="content-view"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Classes="app-statusbar" Padding="12,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="StatusDot" Classes="rec-dot" Width="8" Height="8" />
                    <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock x:Name="DroppedText" Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
