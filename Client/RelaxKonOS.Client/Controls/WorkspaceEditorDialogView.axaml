<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:RelaxKonOS.Client.Localization"
             x:Class="RelaxKonOS.Client.Controls.WorkspaceEditorDialogView"
             x:CompileBindings="False" Classes="builtin-app">
  <UserControl.Styles>
    <Style Selector="TextBlock.field-label"><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
    <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section-hint"><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" /></Style>
    <Style Selector="TextBlock.problem"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="*,Auto" Margin="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="EditorHost" />
    </ScrollViewer>
    <StackPanel Grid.Row="1" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="{Binding OutcomeText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
      <TextBlock Text="{loc:Loc common.editor_draft_hint}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
      <Button Content="{loc:Loc common.close}" Click="Close_Click" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Right" />
    </StackPanel>
  </Grid>
</UserControl>
