<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelaxKonOS.Client.Controls.WorkspaceWindowHeader" x:Name="Root" x:CompileBindings="False">
    <Grid x:Name="HeaderContent" ColumnDefinitions="Auto,*" ColumnSpacing="8">
        <Image x:Name="HeaderIcon" Width="20" Height="20" VerticalAlignment="Center" />
        <TextBlock x:Name="HeaderTitle" Grid.Column="1" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
    </Grid>
</UserControl>
