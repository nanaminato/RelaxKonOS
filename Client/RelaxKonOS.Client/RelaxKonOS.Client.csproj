<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>RelaxKonOS.Client</RootNamespace>
        <!-- AVLN3001 只报一件事：这份 XAML 资源不能由运行时加载器按 URI 实例化（根类型没有公共无参构造）。
             DockerImageMirrorsView / ServerCenterManagementDialog / ServerInstallationWizardView 三个视图
             的构造必须拿到 ViewModel 与 ModalDialog，本来就是只能由 DI 构造的，因此这个警告描述的正是
             预期状态而非缺陷。Avalonia 的 GenerateAvaloniaResources 会把全部 AvaloniaXaml 项一并并入
             AvaloniaResource，无法按文件排除，所以只能在项目级抑制。 -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(IntermediateOutputPath)deployment-launcher/RelaxKonOS-Deploy.ps1" LogicalName="RelaxKonOS.Deployment.RelaxKonOS-Deploy.ps1" />
        <EmbeddedResource Include="$(IntermediateOutputPath)deployment-launcher/relaxkonos-deploy.sh" LogicalName="RelaxKonOS.Deployment.relaxkonos-deploy.sh" />
        <AvaloniaResource Include="Assets\**"/>
        <AvaloniaResource Include="..\..\LICENSE" Link="Assets\Legal\LICENSE.txt" />
        <AvaloniaResource Include="..\..\THIRD_PARTY_NOTICES.md" Link="Assets\Legal\THIRD_PARTY_NOTICES.md" />
        <Content Include="Localization\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Import Project="../../deployment/launcher/Launchers.targets" />

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Avalonia.Controls.DataGrid"/>
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="Svg.Controls.Avalonia" />
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"/>
        <PackageReference Include="RoyalApps.RoyalTerminal.Avalonia"/>
        <PackageReference Include="RoyalApps.RoyalTerminal.Terminal.Vt.Ghostty"/>
        <!-- Explicit runtime assets also support ordinary IDE Debug builds without a RID. -->
        <PackageReference Include="RoyalApps.RoyalTerminal.GhosttySharp.Native.Win64"/>
        <PackageReference Include="RoyalApps.RoyalTerminal.GhosttySharp.Native.Linux64"/>
        <PackageReference Include="RoyalApps.RoyalTerminal.GhosttySharp.Native.OSX"/>
        <!-- Explorer: behaviors 用于双击导航等交互；Newtonsoft 保留 Jaya 配置模型序列化 -->
        <PackageReference Include="Xaml.Behaviors.Avalonia"/>
        <PackageReference Include="Newtonsoft.Json"/>
        <!-- Browser: NativeWebView 控件 -->
        <PackageReference Include="Avalonia.Controls.WebView"/>
        <!-- 服务器中心：内置 SSH/SFTP 传输，替代对系统 ssh/scp/sftp 命令的依赖 -->
        <PackageReference Include="SSH.NET"/>
        <PackageReference Include="QRCoder" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Framework\RelaxKonOS.Core\RelaxKonOS.Core.csproj" />
      <ProjectReference Include="..\..\Shared\RelaxKonOS.Protocol\RelaxKonOS.Protocol.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.App.SDK\RelaxKonOS.App.SDK.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.Runtime\RelaxKonOS.Runtime.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.UI\RelaxKonOS.UI.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.WindowManager\RelaxKonOS.WindowManager.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.Shell\RelaxKonOS.Shell.csproj" />
    </ItemGroup>
</Project>
