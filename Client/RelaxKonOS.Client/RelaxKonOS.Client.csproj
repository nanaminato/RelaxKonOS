<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>RelaxKonOS.Client</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(IntermediateOutputPath)deployment-launcher/RelaxKonOS-Deploy.ps1" LogicalName="RelaxKonOS.Deployment.RelaxKonOS-Deploy.ps1" />
        <EmbeddedResource Include="$(IntermediateOutputPath)deployment-launcher/relaxkonos-deploy.sh" LogicalName="RelaxKonOS.Deployment.relaxkonos-deploy.sh" />
        <AvaloniaResource Include="Assets\**"/>
        <AvaloniaResource Include="..\..\LICENSE" Link="Assets\Legal\LICENSE.txt" />
        <AvaloniaResource Include="..\..\THIRD_PARTY_NOTICES.md" Link="Assets\Legal\THIRD_PARTY_NOTICES.md" />
        <Content Include="Localization\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <Import Project="../../deployment/launcher/Launchers.targets" />

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Avalonia.Controls.DataGrid"/>
        <PackageReference Include="Avalonia.AvaloniaEdit" />
        <PackageReference Include="Svg.Controls.Avalonia" />
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Http"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client"/>
        <PackageReference Include="RoyalApps.RoyalTerminal.Avalonia"/>
        <!-- Explorer: behaviors 用于双击导航等交互；Newtonsoft 保留 Jaya 配置模型序列化 -->
        <PackageReference Include="Xaml.Behaviors.Avalonia"/>
        <PackageReference Include="Newtonsoft.Json"/>
        <!-- Browser: NativeWebView 控件 -->
        <PackageReference Include="Avalonia.Controls.WebView"/>
        <!-- 服务器中心：内置 SSH/SFTP 传输，替代对系统 ssh/scp/sftp 命令的依赖 -->
        <PackageReference Include="SSH.NET"/>
        <PackageReference Include="QRCoder" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Framework\RelaxKonOS.Core\RelaxKonOS.Core.csproj" />
      <ProjectReference Include="..\..\Shared\RelaxKonOS.Protocol\RelaxKonOS.Protocol.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.App.SDK\RelaxKonOS.App.SDK.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.Runtime\RelaxKonOS.Runtime.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.UI\RelaxKonOS.UI.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.WindowManager\RelaxKonOS.WindowManager.csproj" />
      <ProjectReference Include="..\..\Framework\RelaxKonOS.Shell\RelaxKonOS.Shell.csproj" />
    </ItemGroup>
</Project>
