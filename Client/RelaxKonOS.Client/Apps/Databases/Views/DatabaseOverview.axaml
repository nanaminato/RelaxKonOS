<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:db="clr-namespace:RelaxKonOS.Client.Apps.Databases"
 x:Class="RelaxKonOS.Client.Apps.Databases.Views.DatabaseOverview" x:DataType="db:DatabaseViewModel">
 <ScrollViewer><StackPanel Spacing="16">
  <TextBlock Text="PostgreSQL" FontSize="24" />
  <TextBlock Text="{loc:Loc database.scope}" TextWrapping="Wrap" />
  <Border Classes="app-panel" Padding="20"><StackPanel Spacing="12">
   <TextBlock Text="{Binding StateText}" FontSize="20" />
   <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
   <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
    <TextBlock Text="{loc:Loc database.version}" /><TextBlock Grid.Column="1" Text="{Binding Version}" />
    <TextBlock Grid.Row="1" Text="{loc:Loc database.instance}" /><SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Instance}" />
    <TextBlock Grid.Row="2" Text="{loc:Loc database.port}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Port}" />
   </Grid>
   <TextBlock Text="{Binding ConnectionText}" />
   <TextBlock Text="{loc:Loc database.connection_hint}" TextWrapping="Wrap" />
  </StackPanel></Border>
  <WrapPanel Orientation="Horizontal">
   <Button Margin="0,0,8,8" Content="{loc:Loc database.initialize}" Command="{Binding InitializeCommand}" IsEnabled="{Binding CanInitialize}" />
   <Button Margin="0,0,8,8" Content="{loc:Loc database.start}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
   <Button Margin="0,0,8,8" Content="{loc:Loc database.stop}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" />
   <Button Margin="0,0,8,8" Content="{loc:Loc database.verify}" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanVerify}" />
  </WrapPanel>
  <Button Content="{loc:Loc database.resume}" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" HorizontalAlignment="Left" />
  <TextBlock Text="{Binding Installation.SummaryText}" TextWrapping="Wrap" />
 </StackPanel></ScrollViewer>
</UserControl>
