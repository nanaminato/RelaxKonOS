<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
 x:Class="RelaxKonOS.Client.Apps.Databases.Views.DatabaseInitializeDialog">
 <Grid RowDefinitions="*,Auto" Margin="20" RowSpacing="16">
  <ScrollViewer><StackPanel Spacing="14">
   <TextBlock Text="{loc:Loc database.initialize_hint}" TextWrapping="Wrap" />
   <TextBlock Text="{loc:Loc database.port}" />
   <NumericUpDown x:Name="Port" Minimum="1024" Maximum="65535" Value="5432" FormatString="0" />
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
   <Button Content="{loc:Loc common.cancel}" Click="Cancel" />
   <Button Content="{loc:Loc common.confirm}" Click="Accept" />
  </StackPanel>
 </Grid>
</UserControl>
