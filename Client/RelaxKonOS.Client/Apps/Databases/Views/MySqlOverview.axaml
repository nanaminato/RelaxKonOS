<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:RelaxKonOS.Protocol.Databases;assembly=RelaxKonOS.Protocol"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:db="clr-namespace:RelaxKonOS.Client.Apps.Databases"
 x:Class="RelaxKonOS.Client.Apps.Databases.Views.MySqlOverview" x:DataType="db:MySqlViewModel">
 <ScrollViewer><StackPanel Spacing="14">
  <TextBlock Text="MySQL 8.4.13 LTS" FontSize="24" />
  <TextBlock Text="{loc:Loc database.mysql_scope}" TextWrapping="Wrap" />
  <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
  <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
  <WrapPanel>
   <Button Content="{loc:Loc database.mysql_install}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Margin="0,0,8,8" />
   <Button Content="{loc:Loc database.initialize}" Command="{Binding InitializeCommand}" IsEnabled="{Binding CanInitialize}" Margin="0,0,8,8" />
   <Button Content="{loc:Loc database.start}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Margin="0,0,8,8" />
   <Button Content="{loc:Loc database.stop}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,8,8" />
   <Button Content="{loc:Loc database.verify}" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,8,8" />
   <Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
  </WrapPanel>
  <Button Content="{loc:Loc database.admin_recovery}" Command="{Binding RecoverAdministratorCommand}" IsEnabled="{Binding CanRecoverAdministrator}" />
  <TextBlock Text="{Binding AdministratorInstallation.SummaryText}" TextWrapping="Wrap" />
  <Button Content="{loc:Loc database.recover}" Command="{Binding RecoverCommand}" IsEnabled="{Binding CanRecover}" />
  <Button Content="{loc:Loc database.resume}" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
  <TextBlock Text="{Binding Installation.SummaryText}" TextWrapping="Wrap" />
  <TextBlock Text="{loc:Loc database.accounts}" FontSize="18" />
  <TextBlock Text="{loc:Loc database.mysql_accounts_scope}" TextWrapping="Wrap" />
  <StackPanel Spacing="8" IsEnabled="{Binding CanManageAccounts}">
   <TextBox Text="{Binding DatabaseName}" Watermark="{loc:Loc database.account_action.CreateDatabase}" />
   <Button Content="{loc:Loc database.account_action.CreateDatabase}" Command="{Binding CreateDatabaseCommand}" />
   <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" />
   <TextBox Text="{Binding UserName}" Watermark="user@localhost" />
   <ComboBox ItemsSource="{Binding Grants}" SelectedItem="{Binding SelectedGrant}">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="db:MySqlGrantChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <TextBox Text="{Binding AccountPassword}" PasswordChar="•" Watermark="{loc:Loc database.mysql_password_hint}" />
   <Button Content="{loc:Loc database.account_action.CreateAccount}" Command="{Binding CreateAccountCommand}" />
   <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="p:MySqlAccount"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Identity}" /><TextBlock Text="{Binding Database}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <WrapPanel>
    <Button Content="{loc:Loc database.account_action.SetGrant}" Command="{Binding SetGrantCommand}" Margin="0,0,8,8" />
    <Button Content="{loc:Loc database.account_action.ChangePassword}" Command="{Binding ChangePasswordCommand}" Margin="0,0,8,8" />
   </WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding AccountInstallation.SummaryText}" TextWrapping="Wrap" />
 </StackPanel></ScrollViewer>
</UserControl>
