<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:RelaxKonOS.Protocol.Databases;assembly=RelaxKonOS.Protocol" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:db="clr-namespace:RelaxKonOS.Client.Apps.Databases"
 xmlns:cc="clr-namespace:RelaxKonOS.Client.Apps.ComponentCenter" x:Class="RelaxKonOS.Client.Apps.Databases.Views.DatabaseMaintenance" x:DataType="db:DatabaseViewModel">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
  <StackPanel DataContext="{Binding MaintenanceManager}" x:DataType="db:PostgreSqlMaintenanceViewModel" Spacing="10">
   <TextBlock Text="{loc:Loc database.maintenance_hint}" TextWrapping="Wrap" />
   <Button Content="{loc:Loc database.maintenance_plan}" Command="{Binding PlanCommand}" HorizontalAlignment="Left" />
   <TextBlock Text="{Binding Candidate}" />
   <WrapPanel>
    <Button Content="{loc:Loc database.maintenance_action.Update}" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}" Margin="0,0,8,8" />
    <Button Content="{loc:Loc database.maintenance_action.Repair}" Command="{Binding RepairCommand}" IsEnabled="{Binding CanRepair}" Margin="0,0,8,8" />
    <Button Content="{loc:Loc database.maintenance_action.Reinstall}" Command="{Binding ReinstallCommand}" IsEnabled="{Binding CanReinstall}" Margin="0,0,8,8" />
    <Button Content="{loc:Loc database.maintenance_action.Backup}" Command="{Binding BackupCommand}" IsEnabled="{Binding CanBackup}" Margin="0,0,8,8" />
   </WrapPanel>
   <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" HorizontalAlignment="Stretch">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="p:PostgreSqlBackup"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding CreatedAt}"/><TextBlock Text="{Binding Version}"/><TextBlock Text="{Binding Id}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <Button Content="{loc:Loc database.maintenance_action.Restore}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" HorizontalAlignment="Left" />
   <Button Content="{loc:Loc database.maintenance_action.UninstallKeepData}" Command="{Binding KeepDataCommand}" IsEnabled="{Binding CanBackup}" HorizontalAlignment="Left" />
   <TextBlock Text="{loc:Loc database.delete_confirmation}" TextWrapping="Wrap" />
   <TextBox Text="{Binding DeleteConfirmation}" />
   <Button Content="{loc:Loc database.maintenance_action.UninstallDeleteData}" Command="{Binding DeleteDataCommand}" IsEnabled="{Binding CanDelete}" HorizontalAlignment="Left" />
   <Button Content="{loc:Loc database.recover}" Command="{Binding RecoverCommand}" IsEnabled="{Binding CanRecover}" HorizontalAlignment="Left" />
   <Button Content="{loc:Loc database.resume}" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" HorizontalAlignment="Left" />
   <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
   <TextBlock Text="{Binding Installation.SummaryText}" TextWrapping="Wrap" />
   <TextBox Text="{Binding Installation.OperationLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
  </StackPanel>
  <cc:ComponentDependencySettingsView DataContext="{Binding Dependency}" />
  <TextBlock Grid.Row="1" Text="{loc:Loc database.recovery_hint}" TextWrapping="Wrap" />
  <Button Grid.Row="2" Content="{loc:Loc database.recover}" Command="{Binding RecoverCommand}" IsEnabled="{Binding CanRecover}" HorizontalAlignment="Left" />
  <TextBox Grid.Row="3" Text="{Binding Installation.OperationLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
  <TextBlock Text="{loc:Loc database.admin_recovery_hint}" TextWrapping="Wrap" />
  <Button Content="{loc:Loc database.admin_recovery}" Command="{Binding AdminRecoveryCommand}" IsEnabled="{Binding CanAdminRecovery}" HorizontalAlignment="Left" />
  <Button Content="{loc:Loc database.resume}" Command="{Binding ResumeAdminRecoveryCommand}" IsVisible="{Binding CanResumeAdminRecovery}" HorizontalAlignment="Left" />
  <TextBlock Text="{Binding AdminRecoveryInstallation.SummaryText}" TextWrapping="Wrap" />
  <TextBox Text="{Binding AdminRecoveryInstallation.OperationLog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" />
 </StackPanel></ScrollViewer>
</UserControl>
