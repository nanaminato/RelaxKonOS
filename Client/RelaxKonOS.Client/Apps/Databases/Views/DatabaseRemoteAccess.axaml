<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:db="clr-namespace:RelaxKonOS.Client.Apps.Databases"
 xmlns:cert="clr-namespace:RelaxKonOS.Protocol.Certificates;assembly=RelaxKonOS.Protocol" xmlns:protocol="clr-namespace:RelaxKonOS.Protocol.Databases;assembly=RelaxKonOS.Protocol"
 x:Class="RelaxKonOS.Client.Apps.Databases.Views.DatabaseRemoteAccess" x:DataType="db:PostgreSqlRemoteViewModel">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
  <TextBlock Text="{loc:Loc database.remote_title}" FontSize="24" />
  <TextBlock Text="{loc:Loc database.remote_hint}" TextWrapping="Wrap" />
  <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
  <TextBox Text="{Binding ListenAddress}" PlaceholderText="{loc:Loc database.remote_listen}" />
  <TextBox Text="{Binding ServerName}" PlaceholderText="{loc:Loc database.remote_name}" />
  <TextBox Text="{Binding Sources}" PlaceholderText="{loc:Loc database.remote_sources}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
  <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" HorizontalAlignment="Stretch">
   <ComboBox.ItemTemplate><DataTemplate x:DataType="protocol:PostgreSqlAccount"><TextBlock><Run Text="{Binding Database}"/><Run Text=" / "/><Run Text="{Binding Name}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <Button Content="{loc:Loc database.remote_certificates}" Command="{Binding RefreshCertificatesCommand}" />
  <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedCertificate}" HorizontalAlignment="Stretch">
   <ComboBox.ItemTemplate><DataTemplate x:DataType="cert:CertificateDto"><TextBlock Text="{Binding PrimaryDomain}"/></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <WrapPanel ItemSpacing="10">
   <Button Content="{loc:Loc database.remote_enable}" Command="{Binding EnableCommand}" IsEnabled="{Binding CanEnable}" />
   <Button Content="{loc:Loc database.remote_close}" Command="{Binding CloseCommand}" IsEnabled="{Binding CanClose}" />
   <Button Content="{loc:Loc database.recover}" Command="{Binding RecoverCommand}" IsVisible="{Binding CanRecover}" />
   <Button Content="{loc:Loc database.resume}" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
  </WrapPanel>
  <SelectableTextBlock Text="{Binding ConnectionInfo}" TextWrapping="Wrap" />
  <TextBlock Text="{loc:Loc database.remote_probe_hint}" TextWrapping="Wrap" />
  <TextBlock Text="{Binding Installation.SummaryText}" TextWrapping="Wrap" />
  <TextBox Text="{Binding Installation.OperationLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" />
 </StackPanel></ScrollViewer>
</UserControl>
