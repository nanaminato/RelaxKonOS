<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:RelaxKonOS.Client.Services.ServerCenter"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.ViewModels.ServerCenter"
             x:Class="RelaxKonOS.Client.Apps.ServerCenter.Views.ServerCenterDeploymentPage"
             x:DataType="vm:ServerCenterViewModel" Classes="builtin-app">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" Margin="0,0,12,0">
        <TextBlock Text="{Binding DeploymentPageTitle}" FontSize="21" FontWeight="SemiBold" />
        <Border Classes="card" Padding="20">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding SelectedTargetLabel}" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding SelectedHost}" SelectionChanged="SelectedHost_SelectionChanged" HorizontalAlignment="Left" MinWidth="310">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SshHost}" FontSize="12" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SshUserName}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding EmptyHostsText}" IsVisible="{Binding !HasHosts}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding SelectHostHint}" IsVisible="{Binding !HasSelectedHost}" TextWrapping="Wrap" />
        <Border Classes="card" Padding="20" IsVisible="{Binding HasSelectedHost}">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding SelectedHost.DisplayName}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProbeHelpText}" FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{Binding SshPassword}" PasswordChar="●" PlaceholderText="{Binding DeploymentPasswordHint}" />
                <TextBox Text="{Binding MaintenanceSudoPassword}" IsVisible="{Binding ShowMaintenanceSudoPassword}" PasswordChar="●" PlaceholderText="{Binding MaintenanceSudoPasswordText}" />
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding PlatformLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding SelectedPlatformText}" />
                </StackPanel>
                <Button Command="{Binding ProbeHostCommand}" Content="{Binding ProbeText}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding LastProbeText}" IsVisible="{Binding HasLastProbe}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding IncompleteInstallationText}" IsVisible="{Binding HasIncompleteInstallation}" TextWrapping="Wrap" />
                <Button Command="{Binding RecoverCommand}" Content="{Binding RecoverText}" IsVisible="{Binding HasIncompleteInstallation}" HorizontalAlignment="Left" />
                <Button Command="{Binding OpenInstallationWizardCommand}" Content="{Binding DeployText}" IsVisible="{Binding !HasManagedInstallation}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
        <Border Classes="card" Padding="20" IsVisible="{Binding HasManagedInstallation}">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding InstallationInfoTitle}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VerifiedStateText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding InstallationInfoNote}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Separator />
                <ItemsControl ItemsSource="{Binding InstallationDetails}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:ServerInstallationDetail">
                            <Grid ColumnDefinitions="160,*" ColumnSpacing="18" Margin="0,5">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Border Classes="card" Padding="20" IsVisible="{Binding HasManagedInstallation}">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding DeploymentPageTitle}" FontSize="17" FontWeight="SemiBold" />
                <Button Command="{Binding UpdateCommand}" Content="{Binding UpdateText}" HorizontalAlignment="Left" />
                <CheckBox IsVisible="{Binding CanManageFirewall}" IsChecked="{Binding MaintenanceAddFirewallRule}" Content="{Binding FirewallChoiceText}" />
                <TextBlock IsVisible="{Binding CanManageFirewall}" Text="{Binding FirewallHelpText}" TextWrapping="Wrap" />
                <CheckBox IsChecked="{Binding RepairLanCertificate}" Content="{Binding RepairCertificateText}" />
                <TextBlock Text="{Binding RepairCertificateNote}" TextWrapping="Wrap" IsVisible="{Binding RepairLanCertificate}" />
                <TextBox Text="{Binding RepairCertificateIdentities}" IsVisible="{Binding RepairLanCertificate}" />
                <Button Command="{Binding RepairCommand}" Content="{Binding RepairText}" HorizontalAlignment="Left" />
                <Button Command="{Binding RollbackCommand}" Content="{Binding RollbackText}" IsVisible="{Binding HasPreviousVersion}" HorizontalAlignment="Left" />
                <Separator />
                <CheckBox IsChecked="{Binding DeleteServerData}" Content="{Binding DeleteServerDataText}" />
                <Button Command="{Binding UninstallCommand}" Content="{Binding UninstallText}" HorizontalAlignment="Left" Classes="danger" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
