<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:explorer="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Controls"
             xmlns:explorerModels="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Models"
             xmlns:ssh="clr-namespace:RelaxKonOS.Client.Apps.ServerCenter.Views"
             x:Class="RelaxKonOS.Client.Apps.ServerCenter.Views.SshFileBrowserView"
             x:Name="Root"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">
    <UserControl.Styles>
        <StyleInclude Source="avares://RelaxKonOS.Client/Apps/Explorer/Controls/FileBrowserToolbarStyles.axaml" />
    </UserControl.Styles>
    <Grid x:Name="BrowserRoot" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Grid x:Name="HeaderTabs" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="2">
            <Button x:Name="TabScrollLeft" Classes="header-action compact" IsVisible="False" Click="TabScrollLeft_Click" ToolTip.Tip="{loc:Loc explorer.tab_scroll_left}" AutomationProperties.Name="{loc:Loc explorer.tab_scroll_left}">
                <Path Width="11" Height="11" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" Data="M15.5 4 L7.5 12 L15.5 20" />
            </Button>
            <ScrollViewer Grid.Column="1" x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="FolderTabs" Classes="title-tabs" Height="{DynamicResource WindowTabHeight}"
                             SelectionChanged="FolderTabs_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate DataType="ssh:SshFileBrowserTab">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Width="{Binding #Root.TabContentWidth}" VerticalAlignment="Center">
                                <explorer:ExplorerIcon TreeIconKind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                                <Button Grid.Column="2" Classes="tab-close" Tag="{Binding}" Click="CloseTab_Click" ToolTip.Tip="{loc:Loc explorer.close_tab}" AutomationProperties.Name="{loc:Loc explorer.close_tab}">
                                    <PathIcon Width="11" Height="11" Data="{StaticResource ChromeCloseIcon}" />
                                </Button>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="NewTabButton" Classes="header-action compact" Margin="4,0,0,0" VerticalAlignment="Center" Click="NewTab_Click" ToolTip.Tip="{loc:Loc explorer.new_tab}" AutomationProperties.Name="{loc:Loc explorer.new_tab}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource ChromeAddIcon}" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Column="2" x:Name="TabScrollRight" Classes="header-action compact" IsVisible="False" Click="TabScrollRight_Click" ToolTip.Tip="{loc:Loc explorer.tab_scroll_right}" AutomationProperties.Name="{loc:Loc explorer.tab_scroll_right}">
                <Path Width="11" Height="11" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" Data="M8.5 4 L16.5 12 L8.5 20" />
            </Button>
            <Button Grid.Column="3" x:Name="FolderPickerButton" Classes="header-action compact" ToolTip.Tip="{loc:Loc explorer.all_tabs}" AutomationProperties.Name="{loc:Loc explorer.all_tabs}">
                <PathIcon Width="14" Height="14" Data="{StaticResource ChromeChevronDownIcon}" />
                <Button.Flyout><Flyout><ListBox x:Name="FolderPicker" MinWidth="220" MaxHeight="320" SelectionChanged="FolderPicker_SelectionChanged">
                    <ListBox.ItemTemplate><DataTemplate DataType="ssh:SshFileBrowserTab"><TextBlock Text="{Binding Title}" MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox></Flyout></Button.Flyout>
            </Button>
        </Grid>
        <Border Grid.Row="1" x:Name="NavigationToolbar" Padding="4,8" SizeChanged="NavigationToolbar_SizeChanged">
            <Border.Styles>
                <!-- The address field and the search field are the header's two text surfaces. The search
                     field's glyph lives inside the frame, so its TextBox stops painting a second frame of
                     its own; the address field keeps one but is dressed as the same sunken field the
                     breadcrumb uses, otherwise typing a path would swap a framed field for a bare one.
                     Every interaction state is spelled out because the platform theme styles are just as
                     specific and would otherwise repaint the field on hover or focus. -->
                <Style Selector="TextBox#AddressBox">
                    <Setter Property="Height" Value="32" />
                    <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                </Style>
                <Style Selector="TextBox#AddressBox:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                </Style>
                <Style Selector="TextBox#AddressBox:focus">
                    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                </Style>
                <Style Selector="TextBox#SearchBox">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
                <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement, TextBox#SearchBox:not(:focus) /template/ Border#PART_BorderElement">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Border#AddressDisplay:focus-within">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                </Style>
                <Style Selector="Border#InlineSearchHost:focus-within">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
                    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                </Style>
            </Border.Styles>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" ClipToBounds="True">
                <StackPanel Orientation="Horizontal" Spacing="8">
<Button x:Name="BackButton" Classes="header-action" Click="Back_Click" ToolTip.Tip="{loc:Loc common.back}" AutomationProperties.Name="{loc:Loc common.back}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeBackIcon}" /></Button>
<Button x:Name="ForwardButton" Classes="header-action" Click="Forward_Click" ToolTip.Tip="{loc:Loc common.forward}" AutomationProperties.Name="{loc:Loc common.forward}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeForwardIcon}" /></Button>
<Button x:Name="UpButton" Classes="header-action" Click="Up_Click" ToolTip.Tip="{loc:Loc explorer.up}" AutomationProperties.Name="{loc:Loc explorer.up}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeUpIcon}" /></Button>
<Button x:Name="RefreshButton" Classes="header-action" Click="Refresh_Click" ToolTip.Tip="{loc:Loc common.refresh}" AutomationProperties.Name="{loc:Loc common.refresh}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeRefreshIcon}" /></Button>
                </StackPanel>
                <Grid Grid.Column="1" MinWidth="0">
                    <TextBox x:Name="AddressBox" IsVisible="False" PlaceholderText="{loc:Loc ssh_files.address}" KeyDown="AddressBox_KeyDown" LostFocus="AddressBox_LostFocus" />
                    <Border x:Name="AddressDisplay" Height="32" CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}" Background="{DynamicResource SurfaceSunkenBrush}" Padding="2,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <ScrollViewer x:Name="BreadcrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="BreadcrumbsHost" Orientation="Horizontal" /></ScrollViewer>
                            <Button Grid.Column="1" Classes="header-action compact" Click="EditAddress_Click" ToolTip.Tip="{loc:Loc ssh_files.address}" AutomationProperties.Name="{loc:Loc ssh_files.address}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeEditIcon}" /></Button>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="2">
                    <Border x:Name="InlineSearchHost" Height="32" CornerRadius="{DynamicResource ControlCornerRadius}" Background="{DynamicResource SurfaceSunkenBrush}" BorderThickness="1" BorderBrush="Transparent" Padding="8,0,2,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Path Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2" StrokeLineCap="Round" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Data="{StaticResource ChromeSearchIcon}" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Width="180" MinWidth="0" VerticalContentAlignment="Center" Text="{Binding #Root.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Loc ssh_files.search}" KeyDown="SearchBox_KeyDown" />
                        </Grid>
                    </Border>
                    <Button x:Name="CompactSearchButton" Classes="header-action" IsVisible="False" ToolTip.Tip="{loc:Loc ssh_files.search}" AutomationProperties.Name="{loc:Loc ssh_files.search}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeSearchIcon}" />
                        <Button.Flyout><Flyout><TextBox x:Name="CompactSearchBox" Width="240" Text="{Binding #Root.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{loc:Loc ssh_files.search}" KeyDown="SearchBox_KeyDown" /></Flyout></Button.Flyout>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="2" x:Name="CommandToolbar" Classes="app-toolbar" Padding="8,6" SizeChanged="CommandToolbar_SizeChanged">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <StackPanel x:Name="FileActions" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="NewFolderButton" Classes="command-action" Click="NewFolder_Click" ToolTip.Tip="{loc:Loc ssh_files.new_folder}" AutomationProperties.Name="{loc:Loc ssh_files.new_folder}"><StackPanel Orientation="Horizontal" Spacing="6"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeNewFolderIcon}" /><TextBlock x:Name="NewFolderLabel" Text="{loc:Loc ssh_files.new_folder}" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border x:Name="EditingDivider" Classes="command-divider" />
<Button x:Name="CutButton" Classes="command-action icon-command" Click="Cut_Click" ToolTip.Tip="{loc:Loc ssh_files.cut}" AutomationProperties.Name="{loc:Loc ssh_files.cut}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeCutIcon}" /></Button>
<Button x:Name="CopyButton" Classes="command-action icon-command" Click="Copy_Click" ToolTip.Tip="{loc:Loc ssh_files.copy}" AutomationProperties.Name="{loc:Loc ssh_files.copy}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeCopyIcon}" /></Button>
<Button x:Name="PasteButton" Classes="command-action icon-command" Click="Paste_Click" ToolTip.Tip="{loc:Loc ssh_files.paste}" AutomationProperties.Name="{loc:Loc ssh_files.paste}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromePasteIcon}" /></Button>
<Button x:Name="RenameButton" Classes="command-action icon-command" Click="Rename_Click" ToolTip.Tip="{loc:Loc ssh_files.rename}" AutomationProperties.Name="{loc:Loc ssh_files.rename}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeRenameIcon}" /></Button>
<Button x:Name="DeleteButton" Classes="command-action icon-command" Click="Delete_Click" ToolTip.Tip="{loc:Loc ssh_files.delete}" AutomationProperties.Name="{loc:Loc ssh_files.delete}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="{StaticResource ChromeDeleteIcon}" /></Button>
                </StackPanel>
                <Border x:Name="ViewDivider" Classes="command-divider" />
<Button x:Name="SortAction" Classes="command-action" ToolTip.Tip="{loc:Loc explorer.sort}" AutomationProperties.Name="{loc:Loc explorer.sort}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="M7 3 V21 M3 17 L7 21 L11 17 M17 21 V3 M13 7 L17 3 L21 7" /><TextBlock x:Name="SortLabel" Text="{loc:Loc explorer.sort}" VerticalAlignment="Center" /><PathIcon x:Name="SortLabelChevron" Width="8" Height="8" Data="{StaticResource ChromeChevronDownIcon}" /></StackPanel>
                    <Button.Flyout><Flyout><StackPanel Spacing="10" MinWidth="220">
                        <ComboBox x:Name="SortBox" Width="220" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged">
                            <ComboBoxItem Content="{loc:Loc ssh_files.name}" /><ComboBoxItem Content="{loc:Loc ssh_files.modified}" /><ComboBoxItem Content="{loc:Loc ssh_files.type}" /><ComboBoxItem Content="{loc:Loc ssh_files.size}" />
                        </ComboBox>
                        <CheckBox x:Name="DescendingBox" Content="{loc:Loc ssh_files.descending}" IsCheckedChanged="DescendingBox_Changed" />
                    </StackPanel></Flyout></Button.Flyout>
                </Button>
<Button x:Name="ViewAction" Classes="command-action" ToolTip.Tip="{loc:Loc common.view}" AutomationProperties.Name="{loc:Loc common.view}">
                    <StackPanel Orientation="Horizontal" Spacing="8"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" VerticalAlignment="Center" Width="16" Height="16" Data="M3 5 H21 M3 10 H21 M3 15 H21 M3 20 H21" /><TextBlock x:Name="ViewLabel" Text="{loc:Loc common.view}" VerticalAlignment="Center" /><PathIcon x:Name="ViewLabelChevron" Width="8" Height="8" Data="{StaticResource ChromeChevronDownIcon}" /></StackPanel>
                    <Button.Flyout><Flyout><StackPanel Spacing="10" MinWidth="220">
                        <ComboBox x:Name="ViewModeBox" Width="220" SelectionChanged="ViewModeBox_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Content="{loc:Loc explorer.view.details}" /><ComboBoxItem Content="{loc:Loc explorer.view.list}" /><ComboBoxItem Content="{loc:Loc explorer.view.small_icons}" /><ComboBoxItem Content="{loc:Loc explorer.view.large_icons}" />
                        </ComboBox>
                        <CheckBox x:Name="HiddenBox" Content="{loc:Loc ssh_files.show_hidden}" IsCheckedChanged="HiddenBox_Changed" />
                    </StackPanel></Flyout></Button.Flyout>
                </Button>
                <Button x:Name="MoreActionsButton" Classes="command-action icon-command" ToolTip.Tip="{loc:Loc explorer.more}" AutomationProperties.Name="{loc:Loc explorer.more}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeMoreIcon}" />
                    <Button.Flyout><MenuFlyout>
<MenuItem x:Name="OverflowNewFolder" Header="{loc:Loc ssh_files.new_folder}" Click="NewFolder_Click" IsEnabled="{Binding #NewFolderButton.IsEnabled}" />
<MenuItem x:Name="OverflowCut" Header="{loc:Loc ssh_files.cut}" Click="Cut_Click" IsEnabled="{Binding #CutButton.IsEnabled}" />
<MenuItem x:Name="OverflowCopy" Header="{loc:Loc ssh_files.copy}" Click="Copy_Click" IsEnabled="{Binding #CopyButton.IsEnabled}" />
<MenuItem x:Name="OverflowPaste" Header="{loc:Loc ssh_files.paste}" Click="Paste_Click" IsEnabled="{Binding #PasteButton.IsEnabled}" />
<MenuItem x:Name="OverflowRename" Header="{loc:Loc ssh_files.rename}" Click="Rename_Click" IsEnabled="{Binding #RenameButton.IsEnabled}" />
<MenuItem x:Name="OverflowDelete" Header="{loc:Loc ssh_files.delete}" Click="Delete_Click" IsEnabled="{Binding #DeleteButton.IsEnabled}" />
                        <Separator />
<MenuItem x:Name="OverflowUp" Header="{loc:Loc explorer.up}" Click="Up_Click" IsEnabled="{Binding #UpButton.IsEnabled}" />
<MenuItem x:Name="OverflowRefresh" Header="{loc:Loc common.refresh}" Click="Refresh_Click" IsEnabled="{Binding #RefreshButton.IsEnabled}" />
                        <Separator />
                        <MenuItem x:Name="UploadButton" Header="{loc:Loc ssh_files.upload}" Click="Upload_Click" />
                        <MenuItem x:Name="UploadFolderButton" Header="{loc:Loc ssh_files.upload_folder}" Click="UploadFolder_Click" />
                        <MenuItem x:Name="DownloadButton" Header="{loc:Loc ssh_files.download}" Click="Download_Click" />
                        <Separator />
                        <MenuItem x:Name="OverflowProperties" Header="{loc:Loc ssh_files.properties}" Click="Properties_Click" />
                    </MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
        </Border>
        <Grid x:Name="FileContentGrid" Grid.Row="3" ColumnDefinitions="210,4,*">
            <Grid Grid.Column="0" Margin="8,4,4,4">
                <TreeView x:Name="NavigationTree" SelectionChanged="NavigationTree_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="explorerModels:TreeNodeModel" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                                        IsVisible="{Binding !IsPlaceholder}">
                                <explorer:ExplorerIcon TreeIconKind="{Binding IconKind}" Width="20" Height="20" />
                                <TextBlock Text="{Binding Label}" MaxWidth="165" MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="{DynamicResource SurfaceBrush}"
                          ResizeDirection="Columns" />

            <!-- 与 Windows 资源管理器一致的详细信息列表：列使用固定像素宽度，视口剩余的宽度
                 保持空白而不是被某一列拉伸；横向滚动由 DataGrid 自身承担，纵向滚动条始终贴在
                 整个区域的最右侧；列头分隔线可拖动调整任意列宽。 -->
            <Grid Grid.Column="2" x:Name="EntriesHost" Background="{DynamicResource SurfaceBrush}">
            <DataGrid
                      x:Name="EntriesGrid"
                      SelectionMode="Extended"
                      SelectionChanged="EntriesGrid_SelectionChanged"
                      DoubleTapped="EntriesGrid_DoubleTapped"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      RowHeight="36"
                      ColumnHeaderHeight="30"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="0" Classes="resource-table">
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                    <Style Selector="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <!-- Keep rows to the combined column width while the DataGrid itself
                         fills the viewport, leaving a non-item area beside the details table. -->
                    <Style Selector="DataGridRow">
                        <Setter Property="Width" Value="{Binding #Root.EntriesTableWidth}" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="DataGridRow:pointerover">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="DataGridRow:selected">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                    </Style>
                    <Style Selector="DataGridRow:pointerover DataGridCell">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                    </Style>
                    <Style Selector="DataGridRow:selected DataGridCell">
                        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="300" MinWidth="180">
                        <DataGridTemplateColumn.Header>
                            <Grid Tag="name" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc ssh_files.name}" />
                                <TextBlock Grid.Column="1" Text="{Binding #Root.NameSortGlyph}" Margin="6,0,0,0" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="12,2" Opacity="{Binding CutOpacity}">
                                    <explorer:ExplorerIcon EntryType="{Binding EntryType}" FileName="{Binding Name}"
                                                           Link="{Binding IsLink}" Width="20" Height="20"
                                                           VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Classes="inline-rename" IsVisible="{Binding IsEditing}"
                                             Text="{Binding RenameDraft, Mode=TwoWay}" MinWidth="0" MinHeight="0" Padding="2,0"
                                             KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus" />
                                    <TextBlock Grid.Column="1" IsVisible="{Binding !IsEditing}" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               MaxLines="1" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="164" MinWidth="150">
                        <DataGridTemplateColumn.Header>
                            <Grid Tag="modified" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc ssh_files.modified}" />
                                <TextBlock Grid.Column="1" Text="{Binding #Root.ModifiedSortGlyph}" Margin="6,0,0,0" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock Text="{Binding ModifiedText}" TextTrimming="CharacterEllipsis"
                                           Padding="8,0" FontSize="12" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="120" MinWidth="96">
                        <DataGridTemplateColumn.Header>
                            <Grid Tag="type" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc ssh_files.type}" />
                                <TextBlock Grid.Column="1" Text="{Binding #Root.TypeSortGlyph}" Margin="6,0,0,0" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock Text="{Binding Kind}" TextTrimming="CharacterEllipsis"
                                           Padding="8,0" FontSize="12" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="112" MinWidth="96">
                        <DataGridTemplateColumn.Header>
                            <Grid Tag="size" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Loc ssh_files.size}" />
                                <TextBlock Grid.Column="1" Text="{Binding #Root.SizeSortGlyph}" Margin="6,0,0,0" />
                            </Grid>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock Text="{Binding SizeText}" TextTrimming="CharacterEllipsis"
                                           Padding="8,0" FontSize="12" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu Opening="FileMenu_Opening">
                        <MenuItem x:Name="OpenMenuItem" Header="{loc:Loc ssh_files.open}" Click="Open_Click" />
                        <MenuItem x:Name="CopyMenuItem" Header="{loc:Loc ssh_files.copy}" Click="Copy_Click" />
                        <MenuItem x:Name="CutMenuItem" Header="{loc:Loc ssh_files.cut}" Click="Cut_Click" />
                        <MenuItem x:Name="PasteMenuItem" Header="{loc:Loc ssh_files.paste}" Click="Paste_Click" />
                        <MenuItem x:Name="RenameMenuItem" Header="{loc:Loc ssh_files.rename}" Click="Rename_Click" />
                        <MenuItem x:Name="DeleteMenuItem" Header="{loc:Loc ssh_files.delete}" Click="Delete_Click" />
                        <MenuItem x:Name="DownloadMenuItem" Header="{loc:Loc ssh_files.download}" Click="Download_Click" />
                        <MenuItem x:Name="PropertiesMenuItem" Header="{loc:Loc ssh_files.properties}" Click="Properties_Click" />
                        <Separator />
                        <MenuItem x:Name="NewFolderMenuItem" Header="{loc:Loc ssh_files.new_folder}" Click="NewFolder_Click" />
                        <MenuItem x:Name="UploadMenuItem" Header="{loc:Loc ssh_files.upload}" Click="Upload_Click" />
                        <MenuItem x:Name="RefreshMenuItem" Header="{loc:Loc ssh_files.refresh}" Click="Refresh_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
            </Grid>
        </Grid>

        <!-- Picker mode follows the signed-in server Explorer: folders stay navigable, only a
             matching file may be confirmed, and mutating file commands are disabled. -->
        <Border x:Name="PickerPanel" Grid.Row="4" IsVisible="False" Classes="app-statusbar">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{loc:Loc server_center.wizard.bundle_file_label}" VerticalAlignment="Center" />
                    <TextBox x:Name="PickerEntryName" Grid.Column="1" IsReadOnly="True" />
                </Grid>
                <TextBlock x:Name="PickerFilterText" Grid.Row="1" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc common.cancel}" Click="CancelPicker_Click" />
                    <Button x:Name="ConfirmPickerButton" Classes="primary" Content="{loc:Loc common.open}"
                            Click="ConfirmPicker_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Classes="app-statusbar">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="SummaryText" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="11" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
