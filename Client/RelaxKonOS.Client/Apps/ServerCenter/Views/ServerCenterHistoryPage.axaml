<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.ViewModels.ServerCenter"
             x:Class="RelaxKonOS.Client.Apps.ServerCenter.Views.ServerCenterHistoryPage"
             x:DataType="vm:ServerCenterViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18" Margin="0,0,12,0">
        <TextBlock Text="{Binding HistoryPageTitle}" FontSize="21" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectHostHint}" IsVisible="{Binding !SelectedHost}" TextWrapping="Wrap" />
        <Border Classes="card" Padding="20" IsVisible="{Binding SelectedHost}">
            <StackPanel Spacing="12">
                <TextBlock Text="{Binding SelectedHost.DisplayName}" FontSize="17" FontWeight="SemiBold" />
                <Button Command="{Binding LoadOperationHistoryCommand}" Content="{Binding LoadOperationHistoryText}" HorizontalAlignment="Left" />
                <ListBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" MinHeight="240">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="6" Spacing="3">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding StartedAtLocalText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="{Binding State}" />
                                <TextBlock Text="{Binding SafeMessage}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBox Text="{Binding SshPassword}" PasswordChar="●" PlaceholderText="{Binding SshPasswordLabel}" />
                <ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding SelectedPlatform}"
                          PlaceholderText="{Binding PlatformLabel}" HorizontalAlignment="Left" MinWidth="180">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Command="{Binding RefreshOperationCommand}" Content="{Binding RefreshOperationText}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
