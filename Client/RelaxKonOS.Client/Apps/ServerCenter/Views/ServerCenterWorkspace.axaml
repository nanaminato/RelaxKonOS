<UserControl xmlns:common="clr-namespace:RelaxKonOS.Client.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.ViewModels.ServerCenter"
             x:Class="RelaxKonOS.Client.Apps.ServerCenter.Views.ServerCenterWorkspace"
             x:DataType="vm:ServerCenterViewModel"
             Background="{DynamicResource AppBackgroundBrush}" Classes="builtin-app">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="HeaderHost" Grid.Row="0" ColumnDefinitions="*,Auto">
            <common:WorkspaceWindowHeader x:Name="Header" Title="{Binding Title}" Subtitle="{Binding Subtitle}" IconAsset="avares://RelaxKonOS.Client/Assets/AppIcons/server-center.png" />

        </Grid>

        <Grid x:Name="WorkspaceBody" Grid.Row="1" ColumnDefinitions="190,*">
            <Border Classes="app-sidebar">
                <StackPanel Margin="14,22" Spacing="4">
                    <Button x:Name="HostsButton" Classes="workspace-nav" Tag="hosts" Click="NavigationButton_Click"
                            Content="{Binding HostsPageTitle}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="deployment" Click="NavigationButton_Click"
                            Content="{Binding DeploymentPageTitle}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="history" Click="NavigationButton_Click"
                            Content="{Binding HistoryPageTitle}" HorizontalContentAlignment="Left" Padding="10,8" />
                </StackPanel>
            </Border>
            <ContentControl Grid.Column="1" x:Name="ContentHost" Margin="30,24" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" MinHeight="44" Padding="18,10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <ProgressBar IsIndeterminate="{Binding IsDeploymentProgressIndeterminate}" Value="{Binding DeploymentTransferProgress}" Width="36" MinWidth="0" Height="3" VerticalAlignment="Center" IsVisible="{Binding ShowWorkspaceProgress}" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" ToolTip.Tip="{Binding StatusMessage}" IsVisible="{Binding !HasError}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" ToolTip.Tip="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
