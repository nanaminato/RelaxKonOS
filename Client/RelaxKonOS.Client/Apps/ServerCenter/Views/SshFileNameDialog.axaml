<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
        x:Class="RelaxKonOS.Client.Apps.ServerCenter.Views.SshFileNameDialog"
        Width="390" Height="145" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="12" Spacing="12">
        <TextBox x:Name="NameEditor" KeyDown="NameEditor_KeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc ssh_files.cancel}" Click="Cancel_Click" />
            <Button Content="{loc:Loc ssh_files.ok}" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
