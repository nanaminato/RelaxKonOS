<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RelaxKonOS.Client.Apps.ServerCenter.Views" xmlns:services="clr-namespace:RelaxKonOS.Client.Services.ServerCenter" xmlns:vm="clr-namespace:RelaxKonOS.Client.ViewModels.ServerCenter" x:Class="RelaxKonOS.Client.Apps.ServerCenter.Views.ServerCenterManagementDialog" x:DataType="vm:ServerCenterViewModel" Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Styles>
        <Style Selector="Border.management-section">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style Selector="TextBlock.action-description">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style Selector="Button"><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="16,8"/></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="22" RowSpacing="16">
        <Border Classes="management-section"><StackPanel Spacing="6">
            <WrapPanel ItemSpacing="14" LineSpacing="8">
                <TextBlock Text="{Binding SelectedHost.DisplayName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center"/>
                <views:ServerStatusBadge DataContext="{Binding HostStatus}" VerticalAlignment="Center"/>
            </WrapPanel>
            <TextBlock Text="{Binding VerifiedStateText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel></Border>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border Classes="management-section" x:Name="DetailsPanelCard"><StackPanel Spacing="12" x:Name="DetailsPanel"><TextBlock Text="{Binding InstallationInfoTitle}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding InstallationInfoNote}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding InstallationDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:ServerInstallationDetail">
                                <Grid ColumnDefinitions="150,*" ColumnSpacing="18" Margin="0,8">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding !HasStatus}"/>
                                        <views:ServerStatusBadge IsVisible="{Binding HasStatus}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel></Border>
                <StackPanel Spacing="12" x:Name="ConfigurationPanel" IsEnabled="{Binding !IsBusy}">
                    <Border Classes="management-section"><StackPanel Spacing="12">
                        <TextBlock Text="{Binding CurrentConfigurationTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding CurrentConfigurationDetails}"><ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:ServerInstallationDetail">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" Margin="0,3">
                                    <TextBlock Text="{Binding Label}" Classes="action-description"/>
                                    <StackPanel Grid.Column="1">
                                        <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" IsVisible="{Binding !HasStatus}"/>
                                        <views:ServerStatusBadge IsVisible="{Binding HasStatus}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border>

                    <Border Classes="management-section" x:Name="NetworkSettingsCard"><StackPanel x:Name="NetworkSettingsPanel" Spacing="12">
                        <TextBlock Text="{Binding NetworkSettingsTitle}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ConfigurationNote}" Classes="action-description"/>
                        <StackPanel IsVisible="{Binding CanConfigureFileAccess}" Spacing="8">
                            <TextBlock Text="{Binding FileAccessText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FileAccessDescription}" Classes="action-description"/>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ConfigurationFileAccesses}" SelectedItem="{Binding ConfigurationFileAccess}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:FileAccessOption"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding FileRootsText}" IsVisible="{Binding ShowConfigurationFileRoots}"/>
                            <TextBox IsVisible="{Binding ShowConfigurationFileRoots}" TextWrapping="Wrap" Text="{Binding ConfigurationFileRoots}" AcceptsReturn="True" MinHeight="80"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ConfigurationPortText}"/>
                        <TextBox Text="{Binding ConfigurationPort}"/>
                        <Button IsVisible="{Binding CanManageFirewall}" Command="{Binding RemoveFirewallCommand}" Content="{Binding RemoveFirewallText}"/>
                        <Button IsVisible="{Binding CanManageFirewall}" Command="{Binding EnsureFirewallCommand}" Content="{Binding EnsureFirewallText}"/>
                        <CheckBox IsVisible="{Binding CanConfigureAutoStart}" IsChecked="{Binding ConfigurationAutoStart}"><TextBlock Text="{Binding AutoStartText}" TextWrapping="Wrap"/></CheckBox>
                        <CheckBox IsChecked="{Binding ConfigurationLan}"><TextBlock Text="{Binding ConfigurationLanText}" TextWrapping="Wrap"/></CheckBox>
                    </StackPanel></Border>
                    <Border Classes="management-section" x:Name="GuardianCard"><StackPanel Spacing="12">
                    <TextBlock Text="{Binding ComponentsText}" FontSize="15" FontWeight="SemiBold"/>
                    <CheckBox x:Name="GuardianChoice" IsVisible="{Binding CanConfigureGuardian}" IsChecked="{Binding ConfigurationGuardian}" Content="{Binding GuardianChoiceText}"/>
                    <TextBlock Text="{Binding GuardianDescription}" Classes="action-description"/>
                    </StackPanel></Border>
                </StackPanel>
                <Border Classes="management-section" x:Name="RepairPanelCard"><StackPanel Spacing="12" x:Name="RepairPanel" IsEnabled="{Binding !IsBusy}"><TextBlock Text="{Binding RepairText}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding RepairActionDescription}" Classes="action-description"/>
                    <TextBlock Text="{Binding RepairPlanText}" Classes="action-description"/>
                    <TextBlock Text="{Binding RepairPackageText}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding RepairPackagePath}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{Binding BrowseRepairPackageText}" Click="BrowseRepairPackage_Click"/>
                    </Grid>
                    <CheckBox IsVisible="{Binding CanManageFirewall}" IsChecked="{Binding MaintenanceAddFirewallRule}">
                        <TextBlock Text="{Binding FirewallChoiceText}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock IsVisible="{Binding CanManageFirewall}" Text="{Binding FirewallHelpText}" TextWrapping="Wrap"/>
                    <CheckBox IsVisible="{Binding CanManageCertificate}" IsChecked="{Binding RepairLanCertificate}">
                        <TextBlock Text="{Binding RepairCertificateText}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <TextBlock Text="{Binding RepairCertificateNote}" TextWrapping="Wrap" IsVisible="{Binding RepairLanCertificate}"/>
                    <TextBox Text="{Binding RepairCertificateIdentities}" IsVisible="{Binding RepairLanCertificate}"/>
                </StackPanel></Border>
                <Border Classes="management-section" x:Name="UninstallPanelCard"><StackPanel Spacing="12" x:Name="UninstallPanel" IsEnabled="{Binding !IsBusy}"><TextBlock Text="{Binding UninstallText}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding UninstallActionDescription}" Classes="action-description"/>
                    <TextBlock Text="{Binding ComponentSelectionText}" TextWrapping="Wrap"/>
                    <CheckBox IsChecked="{Binding RemoveSmb}" Content="{Binding RemoveSmbText}"/>
                    <CheckBox IsChecked="{Binding RemoveNginx}" Content="{Binding RemoveNginxText}"/>
                    <CheckBox IsChecked="{Binding RemoveFrp}" Content="{Binding RemoveFrpText}"/>
                    <CheckBox IsChecked="{Binding RemoveMihomo}" Content="{Binding RemoveMihomoText}"/>
                    <CheckBox IsChecked="{Binding DeleteServerData}">
                        <TextBlock Text="{Binding DeleteServerDataText}" TextWrapping="Wrap"/>
                    </CheckBox>
                </StackPanel></Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0"><StackPanel Spacing="10">
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3"/>
            <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding HasManagementStatus}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Classes="error"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="ConfigureButton" Command="{Binding ConfigureCommand}" Content="{Binding ApplyConfigurationText}" Classes="accent" Margin="0,0,12,8"/>
                <Button x:Name="RepairButton" Command="{Binding RepairCommand}" Content="{Binding RepairText}" Classes="accent" Margin="0,0,12,8"/>
                <Button x:Name="UninstallButton" Command="{Binding UninstallCommand}" Content="{Binding UninstallText}" Classes="danger" Margin="0,0,12,8"/>
                <Button Content="{Binding CloseText}" Click="Close_Click" IsEnabled="{Binding !IsBusy}" Margin="0,0,0,8"/>
            </WrapPanel>
        </StackPanel></Border>
    </Grid>
</UserControl>
