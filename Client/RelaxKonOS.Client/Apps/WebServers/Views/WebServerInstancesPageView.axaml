<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:webservers="clr-namespace:RelaxKonOS.Client.Apps.WebServers"
             x:Class="RelaxKonOS.Client.Apps.WebServers.Views.WebServerInstancesPageView"
             x:DataType="webservers:WebServerManagerViewModel"
             MinWidth="0"
             MinHeight="0" Classes="builtin-app">
    <UserControl.Styles>
        <Style Selector="Border.nginx-running-pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.8" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.18" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.7" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.18" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="LayoutGrid" MaxWidth="1440" HorizontalAlignment="Stretch" Margin="32,28,32,32"
              ColumnDefinitions="*" ColumnSpacing="18" MinWidth="0" MinHeight="0" ClipToBounds="True">
            <Border x:Name="ActionsPanel" Grid.Column="0" Padding="24" MinWidth="0" Classes="app-panel">
                <StackPanel Spacing="16" MinWidth="0">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding ActionsTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding ManagementHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="10" Padding="14,10" IsVisible="{Binding !IsManagedServer}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Loc webservers.runtime_status}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding SelectedStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="{loc:Loc webservers.action.test_config}" Command="{Binding TestConfigurationCommand}" HorizontalContentAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:Loc webservers.action.refresh_status}" Command="{Binding RefreshStatusCommand}" HorizontalContentAlignment="Center" />
                    </Grid>
                    <StackPanel IsVisible="{Binding IsIntegratedServer}" Spacing="8">
                        <TextBlock Text="{loc:Loc webservers.integrated.help}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="{loc:Loc webservers.action.reload}" Command="{Binding ReloadCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsIntegratedOrManagedServer}" Spacing="6">
                        <TextBlock Text="{loc:Loc webservers.acme.help}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Button Content="{loc:Loc webservers.action.enable_acme_http01}" Command="{Binding EnableAcmeHttp01Command}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsManagedServer}" Spacing="10" MinWidth="0">
                        <TextBlock Text="{loc:Loc webservers.service_controls}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="14" Padding="18">
                            <Grid ColumnDefinitions="126,*,Auto" ColumnSpacing="18">
                                <Button Grid.Column="0" Command="{Binding ToggleManagedCommand}" ToolTip.Tip="{Binding ManagedLifecycleActionText}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid Width="92" Height="92">
                                        <Border Classes="nginx-running-pulse" Background="{DynamicResource SuccessMutedBrush}" CornerRadius="46" IsVisible="{Binding IsManagedServerRunning}" />
                                        <Border Background="{DynamicResource WarningMutedBrush}" CornerRadius="46" IsVisible="{Binding !IsManagedServerRunning}" Opacity="0.55" />
                                        <Border Background="{DynamicResource SuccessBrush}" CornerRadius="37" Margin="9" IsVisible="{Binding IsManagedServerRunning}" />
                                        <Border Background="{DynamicResource WarningBrush}" CornerRadius="37" Margin="9" IsVisible="{Binding !IsManagedServerRunning}" />
                                        <Path Data="M13,3 H11 V13 H13 Z M17.83,5.17 L16.41,6.59 A7,7 0 1,1 7.59,6.59 L6.17,5.17 A9,9 0 1,0 17.83,5.17 Z"
                                              Width="34" Height="34" Stretch="Uniform" Fill="{DynamicResource TextOnAccentBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center" MinWidth="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding IsManagedServerRunning}" VerticalAlignment="Center" />
                                        <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource WarningBrush}" IsVisible="{Binding !IsManagedServerRunning}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ManagedRuntimeStateLabel}" FontSize="18" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ManagedRuntimeStateDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="primary" Content="{Binding ManagedLifecycleActionText}" Command="{Binding ToggleManagedCommand}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Content="{loc:Loc webservers.action.restart}" Command="{Binding RestartCommand}" HorizontalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="{loc:Loc webservers.action.reload}" Command="{Binding ReloadCommand}" HorizontalContentAlignment="Center" />
                        </Grid>

                    </StackPanel>
                    <TextBlock Text="{Binding TestResultText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
