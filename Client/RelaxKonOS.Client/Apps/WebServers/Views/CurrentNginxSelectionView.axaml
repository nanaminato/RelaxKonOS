<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:webservers="clr-namespace:RelaxKonOS.Client.Apps.WebServers"
             x:Class="RelaxKonOS.Client.Apps.WebServers.Views.CurrentNginxSelectionView"
             x:DataType="webservers:WebServerManagerViewModel"
             MinWidth="0"
             MinHeight="0" Classes="builtin-app">
                <StackPanel Spacing="14" MinWidth="0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc webservers.current.title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc webservers.current.hint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel ItemHeight="34" IsVisible="{Binding ShowInstanceSelection}">
                        <Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
                        <Button Content="{loc:Loc webservers.discover}" Command="{Binding DiscoverCommand}" Margin="8,0,0,0" />
                    </WrapPanel>
                    <StackPanel Spacing="4" MinWidth="0">
                        <TextBlock Text="{loc:Loc webservers.instances.discovered}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer, Mode=TwoWay}" PlaceholderText="{loc:Loc webservers.instances.placeholder}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding ManagementMode, Converter={x:Static webservers:WebServerEnumTextConverter.Instance}, ConverterParameter=management}" />
                                        <TextBlock Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Content="{loc:Loc webservers.current.use}" Command="{Binding SelectCurrentNginxCommand}" HorizontalAlignment="Left" />
                    <StackPanel Spacing="4" MinWidth="0">
                        <TextBlock Text="{loc:Loc webservers.integration.candidates}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding IntegrationCandidates}" SelectedItem="{Binding SelectedIntegrationCandidate, Mode=TwoWay}" PlaceholderText="{loc:Loc webservers.integration.candidates}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                        <TextBlock Text="{Binding Version}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="primary" Content="{loc:Loc webservers.action.integrate}" Command="{Binding IntegrateCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                    <TextBlock Text="{Binding OperationText}" TextWrapping="Wrap" IsVisible="{Binding HasOperationActivity}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
</UserControl>
