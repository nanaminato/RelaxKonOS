<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:views="clr-namespace:RelaxKonOS.Client.Apps.WebServers.Views"
             x:Class="RelaxKonOS.Client.Apps.WebServers.Views.NginxIntegrationConfirmationDialogView"
             x:DataType="views:NginxIntegrationConfirmationDialogViewModel"
             Background="{DynamicResource SurfaceBrush}"
             Width="470">
    <Grid Margin="20" RowDefinitions="Auto,Auto" RowSpacing="18">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="⚠" FontSize="28" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="385" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelCommand}" Padding="16,6" />
            <Button Classes="primary" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</UserControl>
