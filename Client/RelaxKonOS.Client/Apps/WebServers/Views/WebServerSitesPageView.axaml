<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:protocol="clr-namespace:RelaxKonOS.Protocol.WebServers;assembly=RelaxKonOS.Protocol"
             xmlns:webservers="clr-namespace:RelaxKonOS.Client.Apps.WebServers"
             x:Class="RelaxKonOS.Client.Apps.WebServers.Views.WebServerSitesPageView"
             x:DataType="webservers:WebServerManagerViewModel"
             MinWidth="0"
             MinHeight="0">
    <Grid MaxWidth="1440" HorizontalAlignment="Stretch" Margin="32,28,32,32"
          RowDefinitions="Auto,*" RowSpacing="16" MinWidth="0" MinHeight="0" ClipToBounds="True">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
            <StackPanel Spacing="14">
                <StackPanel Spacing="3">
                    <TextBlock Text="{loc:Loc webservers.sites}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc webservers.sites.subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel ItemHeight="34">
                    <Button Classes="primary" Content="{loc:Loc webservers.site.new}" Command="{Binding NewSiteCommand}" />
                    <Button Content="{loc:Loc webservers.site.edit}" Command="{Binding EditSiteCommand}" Margin="8,0,0,0" />
                    <Button Content="{loc:Loc webservers.site.delete}" Command="{Binding DeleteSiteCommand}" Margin="8,0,0,0" />
                    <Button Content="{loc:Loc webservers.site.reload}" Command="{Binding ReloadCommand}" Margin="8,0,0,0"
                            ToolTip.Tip="{loc:Loc webservers.site.reload_tooltip}" />
                </WrapPanel>
                <TextBlock Text="{Binding SiteStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20" MinWidth="0" MinHeight="0">
            <Grid RowDefinitions="Auto,*" RowSpacing="12" MinWidth="0" MinHeight="0">
                <TextBlock Text="{loc:Loc webservers.sites.deployed}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <DataGrid Grid.Row="1" ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="False"
                          GridLinesVisibility="Horizontal" SelectionMode="Single" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" MinWidth="0" MinHeight="0" VerticalAlignment="Stretch">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc webservers.site.column.name}" Binding="{ReflectionBinding Name}" Width="150" />
                        <DataGridTextColumn Header="{loc:Loc webservers.site.column.kind}" Binding="{ReflectionBinding Kind, Converter={x:Static webservers:WebServerEnumTextConverter.Instance}, ConverterParameter=site_kind}" Width="110" />
                        <DataGridTextColumn Header="{loc:Loc webservers.site.column.domain}" Binding="{ReflectionBinding DomainsDisplay}" Width="*" />
                        <DataGridTemplateColumn Header="{loc:Loc webservers.site.column.service_address}" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="protocol:WebServerSiteDto">
                                    <Button Content="{Binding ServiceAddress}" Tag="{Binding RootPath}" Click="ServiceAddress_Click"
                                            IsEnabled="{Binding HasRootPath}" HorizontalContentAlignment="Left"
                                            ToolTip.Tip="{loc:Loc webservers.site.service_address_tooltip}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="{loc:Loc webservers.site.column.https}" Binding="{ReflectionBinding HttpsEnabled}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
