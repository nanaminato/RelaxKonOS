<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:certificates="clr-namespace:RelaxKonOS.Client.Apps.Certificates"
             x:Class="RelaxKonOS.Client.Apps.Certificates.Views.CertificateManagerWorkspace"
             x:DataType="certificates:CertificateManagerViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}" Padding="28,18">
            <Grid ColumnDefinitions="Auto,*">
                <Border Width="46" Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="14">
                    <TextBlock Text="🔐" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc application.relaxkonos.certificates.display_name}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc certificates.subtitle}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" IsVisible="{Binding HasOperationActivity}"
                Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="18,12,18,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding OperationText}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Grid.Column="1" Content="{loc:Loc common.stop}" Command="{Binding CancelOperationCommand}"
                        IsVisible="{Binding IsOperationRunning}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="190,*">
            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0">
                <StackPanel Spacing="4" Margin="14,22">
                    <TextBlock Text="{loc:Loc certificates.workspace}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
                    <Button x:Name="OverviewButton" Classes="workspace-nav" Tag="overview" Click="NavigationButton_Click" Content="{loc:Loc certificates.overview}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="certificates" Click="NavigationButton_Click" Content="{loc:Loc certificates.list}" HorizontalContentAlignment="Left" Padding="10,8" />
                </StackPanel>
            </Border>
            <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="30,24" HorizontalAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
