<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:certificates="clr-namespace:RelaxKonOS.Client.Apps.Certificates"
             x:Class="RelaxKonOS.Client.Apps.Certificates.Views.CertificateOverviewView"
             x:DataType="certificates:CertificateManagerViewModel">
    <StackPanel Spacing="18">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Loc certificates.overview.total}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    <TextBlock Text="{Binding Certificates.Count}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc certificates.overview.total_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="{loc:Loc certificates.overview.actions}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                    <Button Classes="primary" Content="{loc:Loc certificates.request.title}" Click="RequestCertificate_Click" HorizontalAlignment="Left" />
                    <Button Content="{loc:Loc certificates.self_signed.title}" Click="CreateSelfSignedCertificate_Click" HorizontalAlignment="Left" />
                    <Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
            <StackPanel Spacing="8">
                <TextBlock Text="{loc:Loc certificates.overview}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{loc:Loc certificates.overview.safety_hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
