<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:app="clr-namespace:RelaxKonOS.Client.Apps"
             xmlns:notepad="clr-namespace:RelaxKonOS.Client.Apps.Notepad"
             x:Class="RelaxKonOS.Client.Apps.Notepad.NotepadSettingsView"
             x:DataType="notepad:NotepadViewModel"
             Width="420">
    <Grid RowDefinitions="Auto,Auto,Auto" Margin="20" RowSpacing="14">
        <TextBlock Text="{loc:Loc notepad.settings.title}" FontSize="18" FontWeight="SemiBold" />
        <Grid Grid.Row="1" ColumnDefinitions="150,*" ColumnSpacing="12">
            <TextBlock Text="{loc:Loc common.font_size}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize, Mode=TwoWay}" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="150,*" ColumnSpacing="12">
            <TextBlock Text="{loc:Loc notepad.settings.default_encoding}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableEncodings}" SelectedItem="{Binding DefaultEncodingName, Mode=TwoWay}" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="primary" Content="Done" Command="{Binding CloseSettingsCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
