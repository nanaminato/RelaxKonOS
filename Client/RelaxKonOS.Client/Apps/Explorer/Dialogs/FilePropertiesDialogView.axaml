<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Dialogs"
             x:Class="RelaxKonOS.Client.Apps.Explorer.Dialogs.FilePropertiesDialogView"
             x:DataType="vm:FilePropertiesDialogViewModel"
             Background="{DynamicResource SurfaceBrush}" MinWidth="0" MinHeight="0">
    <!-- The managed dialog may be resized.  Keep every section in star-sized Grid cells so
         content consumes the available client area instead of retaining the old 560px island. -->
    <Grid MinWidth="0" MinHeight="0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24" MinWidth="0" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="18">
                <Grid Grid.Row="0" RowDefinitions="Auto,Auto" RowSpacing="5" MinWidth="0">
                    <TextBlock Grid.Row="0" Text="{Binding Properties.Name}" FontSize="22" FontWeight="SemiBold"
                               TextWrapping="WrapWithOverflow" />
                    <TextBlock Grid.Row="1" Text="{Binding Properties.Path}" FontSize="12" Opacity="0.62"
                               TextWrapping="WrapWithOverflow" />
                </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{loc:Loc explorer.properties.general}" FontSize="15" FontWeight="SemiBold" />
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12" ColumnSpacing="24">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Loc common.type}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Type}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.size}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding SizeText}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.created}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Created, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.modified}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Modified, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.accessed}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Accessed, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.attributes}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Attributes}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.permissions_summary}" FontSize="12" Opacity="0.62" />
                            <TextBlock Text="{Binding Properties.Permissions}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16"
                    IsVisible="{Binding CanEditPermissions}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{loc:Loc explorer.properties.linux_permissions}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc explorer.properties.permissions_note}" FontSize="12" Opacity="0.62" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                            <TextBlock Text="{loc:Loc explorer.permissions.octal_label}" FontSize="12" Opacity="0.62" />
                            <TextBox Text="{Binding PermissionOctalInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding !IsSavingPermissions}" Width="76" HorizontalContentAlignment="Center"
                                     FontFamily="Consolas" FontWeight="SemiBold" MaxLength="4" />
                            <TextBlock Text="{Binding PermissionOctalError}" IsVisible="{Binding HasPermissionOctalError}"
                                       Foreground="{DynamicResource DangerBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="180" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{loc:Loc explorer.properties.owner}" FontWeight="SemiBold" />
                                <CheckBox Content="{loc:Loc explorer.permission.read}" IsChecked="{Binding OwnerRead}" />
                                <CheckBox Content="{loc:Loc explorer.permission.write}" IsChecked="{Binding OwnerWrite}" />
                                <CheckBox Content="{loc:Loc explorer.permission.execute}" IsChecked="{Binding OwnerExecute}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{loc:Loc explorer.properties.group}" FontWeight="SemiBold" />
                                <CheckBox Content="{loc:Loc explorer.permission.read}" IsChecked="{Binding GroupRead}" />
                                <CheckBox Content="{loc:Loc explorer.permission.write}" IsChecked="{Binding GroupWrite}" />
                                <CheckBox Content="{loc:Loc explorer.permission.execute}" IsChecked="{Binding GroupExecute}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{loc:Loc explorer.properties.others}" FontWeight="SemiBold" />
                                <CheckBox Content="{loc:Loc explorer.permission.read}" IsChecked="{Binding OthersRead}" />
                                <CheckBox Content="{loc:Loc explorer.permission.write}" IsChecked="{Binding OthersWrite}" />
                                <CheckBox Content="{loc:Loc explorer.permission.execute}" IsChecked="{Binding OthersExecute}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding PermissionStatus}" FontSize="12" Opacity="0.72" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:Loc explorer.save_permissions}" Command="{Binding SavePermissionsCommand}"
                                Classes="primary" Padding="16,7" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding !CanEditPermissions}">
                <TextBlock Text="{loc:Loc explorer.properties.permissions_unsupported}"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </Border>

                <Button Grid.Column="1" Content="{loc:Loc common.close}" Command="{Binding CloseCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="20,7" />
            </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
