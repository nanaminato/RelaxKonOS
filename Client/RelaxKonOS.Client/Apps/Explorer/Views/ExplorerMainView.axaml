<!-- 布局结构移植自 Jaya Views/Windows/MainView.xaml（BSD-3）。
     Copyright (c) 2020, Rubal Walia. 原始许可见 LICENSE-jaya.txt 与 THIRD_PARTY_NOTICES.md。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:c="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Converters"
             xmlns:controls="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Controls"
             xmlns:models="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Models"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Explorer.ViewModels"
             xmlns:d="clr-namespace:RelaxKonOS.Protocol.Files;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Explorer.Views.ExplorerMainView"
             x:Name="Root"
             x:DataType="vm:ExplorerViewModel"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">

    <UserControl.Resources>
        <c:EntrySizeToStringConverter x:Key="SizeConverter" />
        <c:EntryDescriptionConverter x:Key="TypeTextConverter" />
        <c:EntryIsEditingConverter x:Key="EntryIsEditingConverter" />
        <c:CutEntryOpacityConverter x:Key="CutEntryOpacityConverter" />

        <!-- Header-bar glyphs. The command surface is 24x24 silhouette artwork rather than bitmaps:
             it stays sharp at every display scale, follows the active appearance instead of baking
             in one palette, and needs no per-platform fallback the way a font glyph or an emoji
             would. The vocabulary matches the file-manager conventions the header imitates —
             Windows 11 Explorer's command bar and Finder's toolbar are both flat monochrome. -->
        <StreamGeometry x:Key="ChromeBackIcon">M20 11 H7.83 L13.42 5.41 L12 4 L4 12 L12 20 L13.42 18.59 L7.83 13 H20 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeForwardIcon">M12 4 L10.59 5.41 L16.17 11 H4 V13 H16.17 L10.59 18.59 L12 20 L20 12 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeUpIcon">M4 12 L5.41 13.41 L11 7.83 V20 H13 V7.83 L18.59 13.41 L20 12 L12 4 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeRefreshIcon">M17.65 6.35 C16.2 4.9 14.21 4 12 4 C7.58 4 4.01 7.58 4.01 12 C4.01 16.42 7.58 20 12 20 C15.73 20 18.84 17.45 19.73 14 H17.65 C16.83 16.33 14.61 18 12 18 C8.69 18 6 15.31 6 12 C6 8.69 8.69 6 12 6 C13.66 6 15.14 6.69 16.22 7.78 L13 11 H20 V4 L17.65 6.35 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeChevronRightIcon">M10 6 L8.59 7.41 L13.17 12 L8.59 16.59 L10 18 L16 12 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeChevronDownIcon">M16.59 8.59 L12 13.17 L7.41 8.59 L6 10 L12 16 L18 10 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeEditIcon">M3 17.25 V21 H6.75 L17.81 9.94 L14.06 6.19 L3 17.25 Z M20.71 7.04 C21.1 6.65 21.1 6.02 20.71 5.63 L18.37 3.29 C17.98 2.9 17.35 2.9 16.96 3.29 L15.13 5.12 L18.88 8.87 L20.71 7.04 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeSearchIcon">M15.5 14 H14.71 L14.43 13.73 C15.41 12.59 16 11.11 16 9.5 C16 5.91 13.09 3 9.5 3 C5.91 3 3 5.91 3 9.5 C3 13.09 5.91 16 9.5 16 C11.11 16 12.59 15.41 13.73 14.43 L14 14.71 V15.5 L19 20.49 L20.49 19 L15.5 14 Z M9.5 14 C7.01 14 5 11.99 5 9.5 C5 7.01 7.01 5 9.5 5 C11.99 5 14 7.01 14 9.5 C14 11.99 11.99 14 9.5 14 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeAddIcon">M19 13 H13 V19 H11 V13 H5 V11 H11 V5 H13 V11 H19 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeCloseIcon">M19 6.41 L17.59 5 L12 10.59 L6.41 5 L5 6.41 L10.59 12 L5 17.59 L6.41 19 L12 13.41 L17.59 19 L19 17.59 L13.41 12 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeMoreIcon">M6 10 C4.9 10 4 10.9 4 12 C4 13.1 4.9 14 6 14 C7.1 14 8 13.1 8 12 C8 10.9 7.1 10 6 10 Z M18 10 C16.9 10 16 10.9 16 12 C16 13.1 16.9 14 18 14 C19.1 14 20 13.1 20 12 C20 10.9 19.1 10 18 10 Z M12 10 C10.9 10 10 10.9 10 12 C10 13.1 10.9 14 12 14 C13.1 14 14 13.1 14 12 C14 10.9 13.1 10 12 10 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeNewFolderIcon">M20 6 H12 L10 4 H4 C2.9 4 2.11 4.9 2.11 6 L2 18 C2 19.1 2.9 20 4 20 H20 C21.1 20 22 19.1 22 18 V8 C22 6.9 21.1 6 20 6 Z M19 14 H16 V17 H14 V14 H11 V12 H14 V9 H16 V12 H19 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeCutIcon">M9.64 7.64 C9.87 7.14 10 6.59 10 6 C10 3.79 8.21 2 6 2 C3.79 2 2 3.79 2 6 C2 8.21 3.79 10 6 10 C6.59 10 7.14 9.87 7.64 9.64 L10 12 L7.64 14.36 C7.14 14.13 6.59 14 6 14 C3.79 14 2 15.79 2 18 C2 20.21 3.79 22 6 22 C8.21 22 10 20.21 10 18 C10 17.41 9.87 16.86 9.64 16.36 L12 14 L19 21 H22 V20 L9.64 7.64 Z M6 8 C4.9 8 4 7.11 4 6 C4 4.9 4.9 4 6 4 C7.1 4 8 4.9 8 6 C8 7.11 7.1 8 6 8 Z M6 20 C4.9 20 4 19.11 4 18 C4 16.9 4.9 16 6 16 C7.1 16 8 16.9 8 18 C8 19.11 7.1 20 6 20 Z M12 12.5 C11.72 12.5 11.5 12.28 11.5 12 C11.5 11.72 11.72 11.5 12 11.5 C12.28 11.5 12.5 11.72 12.5 12 C12.5 12.28 12.28 12.5 12 12.5 Z M19 3 L13 9 L15 11 L22 4 V3 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeCopyIcon">M16 1 H4 C2.9 1 2 1.9 2 3 V17 H4 V3 H16 V1 Z M19 5 H8 C6.9 5 6 5.9 6 7 V21 C6 22.1 6.9 23 8 23 H19 C20.1 23 21 22.1 21 21 V7 C21 5.9 20.1 5 19 5 Z M19 21 H8 V7 H19 V21 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromePasteIcon">M19 2 H15.82 C15.4 0.84 14.3 0 13 0 C11.7 0 10.6 0.84 10.18 2 H7 C5.9 2 5 2.9 5 4 V20 C5 21.1 5.9 22 7 22 H19 C20.1 22 21 21.1 21 20 V4 C21 2.9 20.1 2 19 2 Z M13 2 C13.55 2 14 2.45 14 3 C14 3.55 13.55 4 13 4 C12.45 4 12 3.55 12 3 C12 2.45 12.45 2 13 2 Z M19 20 H7 V4 H9 V7 H17 V4 H19 V20 Z</StreamGeometry>
        <!-- Rename is the Windows name field mark: an outlined box holding a text caret. It has to
             be drawn even-odd, otherwise the box interior would fill solid and swallow the caret. -->
        <StreamGeometry x:Key="ChromeRenameIcon">F0 M5 5 H19 V19 H5 Z M7.6 7.6 H16.4 V16.4 H7.6 Z M11 8.4 H13 V15.6 H11 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeDeleteIcon">M6 19 C6 20.1 6.9 21 8 21 H16 C17.1 21 18 20.1 18 19 V7 H6 V19 Z M19 4 H15.5 L14.5 3 H9.5 L8.5 4 H5 V6 H19 V4 Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The address field and the search field are the header's two text surfaces. The search
             field's glyph lives inside the frame, so its TextBox stops painting a second frame of
             its own; the address field keeps one but is dressed as the same sunken field the
             breadcrumb uses, otherwise typing a path would swap a framed field for a bare one.
             Every interaction state is spelled out because the platform theme styles are just as
             specific and would otherwise repaint the field on hover or focus. -->
        <Style Selector="TextBox#AddressBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
        </Style>
        <Style Selector="TextBox#AddressBox:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
        </Style>
        <Style Selector="TextBox#AddressBox:focus">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
        </Style>
        <Style Selector="TextBox#SearchBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox#SearchBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border#AddressBarFrame:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
        </Style>
        <Style Selector="Border#InlineSearchHost:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">
        <!-- Navigation stays above the command bar, matching the Explorer workflow. Neither row
             paints a surface: both are drawn inside the host's title bar, beside the caption
             cluster, so the bar stays one surface from the first tab to the close button. -->
        <Grid DockPanel.Dock="Top" x:Name="HeaderHost" RowDefinitions="Auto,Auto">
        <Grid x:Name="HeaderTabs" Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2" IsVisible="{Binding !IsPickerMode}">
            <ListBox x:Name="FolderTabs" Classes="title-tabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=OneWay}"
                     SelectionChanged="FolderTabs_SelectionChanged" IsEnabled="{Binding CanChangeTabs}"
                     Height="{DynamicResource WindowTabHeight}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <!-- Like Windows 11 and Finder, a tab states its location's own mark — the drive a
                     location is rooted on, or the folder it is — and keeps a readable floor so a
                     short name still produces a tab rather than a sliver. -->
                <ListBox.ItemTemplate><DataTemplate x:DataType="models:ExplorerTab">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" MinWidth="176" VerticalAlignment="Center">
                        <controls:ExplorerIcon TreeIconKind="{Binding IconKind}" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" IsVisible="{Binding !IsComputer}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                        <TextBlock Grid.Column="1" Text="{loc:Loc explorer.computer}" IsVisible="{Binding IsComputer}" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="tab-close"
                                Command="{ReflectionBinding $parent[ListBox].DataContext.CloseTabCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="{loc:Loc explorer.close_tab}" AutomationProperties.Name="{loc:Loc explorer.close_tab}">
                            <PathIcon Width="11" Height="11" Data="{StaticResource ChromeCloseIcon}" />
                        </Button>
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="1" Classes="header-action compact" Command="{Binding NewTabCommand}"
                    ToolTip.Tip="{loc:Loc explorer.new_tab}" AutomationProperties.Name="{loc:Loc explorer.new_tab}">
                <PathIcon Width="14" Height="14" Data="{StaticResource ChromeAddIcon}" />
            </Button>
            <Button Grid.Column="2" x:Name="FolderPickerButton" Classes="header-action compact" IsEnabled="{Binding CanChangeTabs}"
                    ToolTip.Tip="{loc:Loc explorer.all_tabs}" AutomationProperties.Name="{loc:Loc explorer.all_tabs}">
                <PathIcon Width="14" Height="14" Data="{StaticResource ChromeChevronDownIcon}" />
                <Button.Flyout><Flyout>
                    <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab, Mode=OneWay}"
                             MinWidth="220" MaxHeight="320" SelectionChanged="FolderPicker_SelectionChanged">
                        <ListBox.ItemTemplate><DataTemplate x:DataType="models:ExplorerTab">
                            <TextBlock Text="{Binding Title}" MaxWidth="300" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Flyout></Button.Flyout>
            </Button>
        </Grid>
        <Border x:Name="NavigationToolbar" IsEnabled="{Binding !IsBusy}" Grid.Row="1" Padding="0,4" SizeChanged="NavigationToolbar_SizeChanged">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" ClipToBounds="True">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="header-action" Command="{Binding GoBackCommand}" ToolTip.Tip="{loc:Loc common.back}" AutomationProperties.Name="{loc:Loc common.back}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeBackIcon}" /></Button>
                    <Button Classes="header-action" Command="{Binding GoForwardCommand}" ToolTip.Tip="{loc:Loc common.forward}" AutomationProperties.Name="{loc:Loc common.forward}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeForwardIcon}" /></Button>
                    <Button x:Name="GoUpButton" Classes="header-action" Command="{Binding GoUpCommand}" ToolTip.Tip="{loc:Loc explorer.up}" AutomationProperties.Name="{loc:Loc explorer.up}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeUpIcon}" /></Button>
                    <Button x:Name="RefreshButton" Classes="header-action" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc common.refresh}" AutomationProperties.Name="{loc:Loc common.refresh}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeRefreshIcon}" /></Button>
                </StackPanel>
                <Grid Grid.Column="1" MinWidth="0">
                    <TextBox x:Name="AddressBox" Text="{Binding AddressInput, Mode=TwoWay}"
                             IsVisible="{Binding IsEditingAddress}" PlaceholderText="{loc:Loc explorer.computer}"
                             KeyDown="AddressBox_KeyDown" LostFocus="AddressBox_LostFocus" />
                    <Border x:Name="AddressBarFrame" IsVisible="{Binding !IsEditingAddress}" Height="32"
                            CornerRadius="{DynamicResource ControlCornerRadius}" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" Background="{DynamicResource SurfaceSunkenBrush}" Padding="2,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <ScrollViewer x:Name="BreadcrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ExplorerBreadcrumb">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Label}" Tag="{Binding Path}" Click="Breadcrumb_Click" Padding="7,0" Height="26" MinHeight="0"
                                                        Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                <PathIcon Width="10" Height="10" VerticalAlignment="Center" Data="{StaticResource ChromeChevronRightIcon}"
                                                          Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Column="1" Classes="header-action compact" Click="EditAddress_Click"
                                    ToolTip.Tip="{loc:Loc explorer.edit_address}" AutomationProperties.Name="{loc:Loc explorer.edit_address}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource ChromeEditIcon}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Column="2">
                    <Border x:Name="InlineSearchHost" Height="32" CornerRadius="{DynamicResource ControlCornerRadius}"
                            Background="{DynamicResource SurfaceSunkenBrush}" BorderThickness="1" BorderBrush="Transparent" Padding="8,0,2,0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <PathIcon Width="14" Height="14" VerticalAlignment="Center" Data="{StaticResource ChromeSearchIcon}"
                                      Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Width="180" MinWidth="0" VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{loc:Loc explorer.filter_folder}" KeyDown="SearchBox_KeyDown" />
                        </Grid>
                    </Border>
                    <!-- The glyph travels with the button, so a narrow toolbar keeps the same affordance. -->
                    <Button x:Name="CompactSearchButton" Classes="header-action" IsVisible="False"
                            ToolTip.Tip="{loc:Loc explorer.filter_folder}" AutomationProperties.Name="{loc:Loc explorer.filter_folder}">
                        <PathIcon Width="16" Height="16" Data="{StaticResource ChromeSearchIcon}" />
                        <Button.Flyout><Flyout>
                            <TextBox x:Name="CompactSearchBox" Width="240" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{loc:Loc explorer.filter_folder}" KeyDown="SearchBox_KeyDown" />
                        </Flyout></Button.Flyout>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        </Grid>
        <Border DockPanel.Dock="Top" Classes="app-toolbar">
            <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                <StackPanel IsVisible="{Binding !IsPickerMode}" Orientation="Horizontal" Spacing="2" Margin="0,0,10,0">
                    <Button Classes="command-action" Command="{Binding NewFolderCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeNewFolderIcon}" /><TextBlock Text="{loc:Loc explorer.new_folder}" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="CutAction" Classes="command-action" Command="{Binding CutCommand}" ToolTip.Tip="{loc:Loc explorer.cut}" AutomationProperties.Name="{loc:Loc explorer.cut}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeCutIcon}" /></Button>
                    <Button x:Name="CopyAction" Classes="command-action" Command="{Binding CopyCommand}" ToolTip.Tip="{loc:Loc explorer.copy}" AutomationProperties.Name="{loc:Loc explorer.copy}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeCopyIcon}" /></Button>
                    <Button x:Name="PasteAction" Classes="command-action" Command="{Binding PasteCommand}" ToolTip.Tip="{loc:Loc explorer.paste}" AutomationProperties.Name="{loc:Loc explorer.paste}"><PathIcon Width="16" Height="16" Data="{StaticResource ChromePasteIcon}" /></Button>
                    <Button x:Name="RenameAction" Classes="command-action" Command="{Binding RenameCommand}" AutomationProperties.Name="{loc:Loc common.rename}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeRenameIcon}" /><TextBlock Text="{loc:Loc common.rename}" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="DeleteAction" Classes="command-action" Command="{Binding DeleteCommand}" AutomationProperties.Name="{loc:Loc common.delete}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="16" Height="16" Data="{StaticResource ChromeDeleteIcon}" /><TextBlock Text="{loc:Loc common.delete}" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button x:Name="MoreActionsButton" Classes="command-action" ToolTip.Tip="{loc:Loc explorer.more}" AutomationProperties.Name="{loc:Loc explorer.more}">
                        <Button.Content><PathIcon Width="16" Height="16" Data="{StaticResource ChromeMoreIcon}" /></Button.Content>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:Loc explorer.new_folder}" Command="{Binding NewFolderCommand}" />
                                <MenuItem Header="{loc:Loc explorer.cut}" Command="{Binding CutCommand}" />
                                <MenuItem Header="{loc:Loc explorer.copy}" Command="{Binding CopyCommand}" />
                                <MenuItem Header="{loc:Loc explorer.paste}" Command="{Binding PasteCommand}" />
                                <MenuItem Header="{loc:Loc common.rename}" Command="{Binding RenameCommand}" />
                                <MenuItem Header="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc explorer.up}" Command="{Binding GoUpCommand}" />
                                <MenuItem Header="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc explorer.operations.title}" Command="{Binding ShowOperationsCommand}" />
                                <MenuItem Header="{loc:Loc common.download}" Command="{Binding DownloadCommand}" />
                                <MenuItem Header="{loc:Loc common.upload}" Command="{Binding UploadCommand}" />
                                <MenuItem Header="{loc:Loc explorer.upload_folder}" Command="{Binding UploadFolderCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.paste_host}" Command="{Binding PasteFromHostCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.move}" Command="{Binding MoveCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                                <MenuItem Header="{loc:Loc explorer.properties}" Command="{Binding PropertiesCommand}" />
                                <MenuItem Header="{loc:Loc explorer.save_default_view}" Command="{Binding SaveDefaultViewCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.about}" Command="{Binding AboutCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.exit}" Command="{Binding CloseCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Button Classes="command-action" Content="{loc:Loc common.view}">
                    <Button.Flyout><Flyout><StackPanel Spacing="10" MinWidth="220">
                <ComboBox x:Name="ViewModeBox" Width="200" Margin="0,0,10,0" SelectionChanged="ViewModeBox_SelectionChanged" SelectedIndex="{Binding ViewModeIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{loc:Loc explorer.view.details}" />
                    <ComboBoxItem Content="{loc:Loc explorer.view.list}" />
                    <ComboBoxItem Content="{loc:Loc explorer.view.small_icons}" />
                    <ComboBoxItem Content="{loc:Loc explorer.view.large_icons}" />
                </ComboBox>
                <TextBlock Text="{loc:Loc explorer.sort}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Width="200" Margin="0,0,10,0">
                    <ComboBoxItem Content="{loc:Loc common.name}" />
                    <ComboBoxItem Content="{loc:Loc explorer.modified}" />
                    <ComboBoxItem Content="{loc:Loc common.type}" />
                    <ComboBoxItem Content="{loc:Loc explorer.size}" />
                </ComboBox>
                <CheckBox Content="{loc:Loc explorer.descending}" IsChecked="{Binding SortDescending}" Margin="0,0,12,0" />
                <CheckBox Content="{loc:Loc explorer.compact}" IsChecked="{Binding IsCompactView}" Margin="0,0,12,0" />
                <CheckBox Content="{loc:Loc explorer.show_hidden}" IsChecked="{Binding ShowHiddenFiles}" />
                    </StackPanel></Flyout></Button.Flyout>
                </Button>

            </WrapPanel>
        </Border>

        <!-- Compact operation status; details open upwards only on request. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="Auto,38">
                <TextBox Text="{Binding LastOperationDetails, Mode=OneWay}" IsVisible="{Binding #OperationDetailsToggle.IsChecked}"
                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="140" Margin="12,8,12,4" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10" Margin="12,0">
                    <TextBlock Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" TextTrimming="CharacterEllipsis" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" IsVisible="{Binding !HasTransferProgress}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                    <TextBlock Grid.Column="1" Text="{Binding TransferText}" ToolTip.Tip="{Binding TransferText}" IsVisible="{Binding HasTransferProgress}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
                    <ProgressBar Grid.Column="2" Width="36" MinWidth="0" Height="3" Minimum="0" Maximum="100" Value="{Binding TransferProgress}" IsVisible="{Binding HasTransferProgress}" VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="3" x:Name="OperationDetailsToggle" Content="{loc:Loc explorer.batch.details}" IsVisible="{Binding HasOperationDetails}" Padding="8,2" Height="28" />
                    <Button Grid.Column="4" Content="{loc:Loc explorer.batch.stop}" Command="{Binding StopBatchCommand}" IsVisible="{Binding IsBatchActive}" Padding="8,2" Height="28" />
                </Grid>
            </Grid>
        </Border>

        <!-- Picker mode reuses the full Explorer navigation surface and adds native-like confirmation fields. -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsPickerMode}" Classes="app-statusbar">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding PickerEntryLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PickerEntryName, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" IsVisible="{Binding IsFilePickerMode}"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Width="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelPickerCommand}" />
                    <Button Classes="primary" Content="{Binding PickerConfirmLabel}" Command="{Binding ConfirmPickerCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左导航树 | 分隔 | 右条目列表 -->
        <Grid x:Name="FileContentGrid" ColumnDefinitions="210,Auto,*">
            <!-- 导航树 -->
            <TreeView Grid.Column="0"
                      x:Name="NavigationTree"
                      IsEnabled="{Binding !IsBusy}"
                      ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Explorer_DragOver"
                      DragDrop.Drop="Explorer_Drop">
                <!-- TreeViewItem 的 IsExpanded 不会自动与数据项同步。没有这条绑定时，
                     仅会展开不可见的 dummy child，TreeNodeModel 无法发起目录懒加载。 -->
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <!-- 编译绑定无法在 Style setter 中推断 TreeViewItem 的 DataContext 类型，
                             会回退到页面级 x:DataType(ExplorerViewModel) 而 AVLN2000 报错。
                             这里用 ReflectionBinding 显式退化为运行时反射绑定。 -->
                        <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <!-- Do not use a stretch column here: TreeViewItem headers inherit the
                             resized pane width and a star column can visually separate icon/text. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsPlaceholder}">
                            <controls:ExplorerIcon TreeIconKind="{Binding IconKind}" Width="20" Height="20" />
                            <TextBlock Text="{Binding Label}" MaxWidth="170" MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource SurfaceBrush}" ResizeDirection="Columns" />

            <!-- File Explorer-style details view. Each column starts with a fixed width:
                 spare viewport space remains empty instead of stretching a column;
                 narrower viewports use the outer horizontal scrollbar. Users can drag
                 the header dividers to change any column width. -->
            <Grid Grid.Column="2"
                          x:Name="EntriesScrollViewer"
                          Background="{DynamicResource SurfaceBrush}"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="Explorer_DragOver"
                          DragDrop.Drop="Explorer_Drop">
                <!-- The directory background intentionally has its own menu. File-specific
                     commands remain on the DataGrid context menu below. -->
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding #EntriesScrollViewer.DataContext}" IsEnabled="{Binding !IsBusy}">
                        <MenuItem Header="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.paste}" Command="{Binding PasteCommand}" />
                        <MenuItem Header="{loc:Loc explorer.new_folder}" Command="{Binding NewFolderCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <DataGrid x:Name="EntriesGrid"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      SelectionMode="{Binding EntrySelectionMode}"
                      SelectionChanged="EntriesGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      RowHeight="{Binding EntryRowHeight}"
                      ColumnHeaderHeight="30"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="0"
                      KeyDown="EntriesGrid_KeyDown"
                      DoubleTapped="EntriesGrid_DoubleTapped"
                      PointerMoved="EntriesGrid_PointerMoved"
                      PointerReleased="EntriesGrid_PointerReleased"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Explorer_DragOver"
                      DragDrop.Drop="Explorer_Drop" Classes="resource-table">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding #EntriesGrid.DataContext}" IsEnabled="{Binding !IsBusy}">
                        <MenuItem Header="{loc:Loc common.open}" Command="{Binding OpenCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_in_new_tab}" Command="{Binding OpenFolderInTabCommand}" IsVisible="{Binding !IsPickerMode}" />
                        <MenuItem Header="{loc:Loc explorer.open_with}" Command="{Binding OpenWithSelectedCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.copy}" Command="{Binding CopyCommand}" />
                        <MenuItem Header="{loc:Loc explorer.cut}" Command="{Binding CutCommand}" />
                        <MenuItem Header="{loc:Loc explorer.paste}" Command="{Binding PasteCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.rename}" Command="{Binding RenameCommand}" />
                        <MenuItem Header="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.properties}" Command="{Binding PropertiesCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="Padding" Value="8,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                    <Style Selector="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <!-- The DataGrid fills the viewport so its scrollbar stays at the far
                         edge.  Rows are explicitly constrained to the live sum of their
                         columns, leaving the remaining viewport as genuine directory space. -->
                    <Style Selector="DataGridRow">
                        <Setter Property="Width" Value="{Binding #Root.EntriesTableWidth}" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="DataGridRow:pointerover">
                        <Setter Property="Background" Value="Transparent" />
                    </Style>
                    <Style Selector="DataGridRow:selected">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                    </Style>
                    <Style Selector="DataGridRow:pointerover DataGridCell">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                    </Style>
                    <Style Selector="DataGridRow:selected DataGridCell">
                        <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.NameColumnHeader}" Width="300" MinWidth="180" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="12,2">
                                    <Grid.Opacity>
                                        <MultiBinding Converter="{StaticResource CutEntryOpacityConverter}">
                                            <Binding Path="." />
                                            <Binding Path="#Root.DataContext.CutEntryPaths" />
                                        </MultiBinding>
                                    </Grid.Opacity>
                                    <controls:ExplorerIcon EntryType="{Binding Type}" FileName="{Binding Name}" Width="22" Height="22" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{StaticResource EntryIsEditingConverter}" ConverterParameter="inverse">
                                                <Binding Path="." />
                                                <Binding Path="#Root.DataContext.EditingEntry" />
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>
                                    <TextBox Grid.Column="1" Classes="inline-rename" Height="26" MinHeight="0"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="4,0"
                                             Text="{Binding #Root.DataContext.RenameDraft, Mode=TwoWay}"
                                             KeyDown="RenameBox_KeyDown" LostFocus="RenameBox_LostFocus">
                                        <TextBox.IsVisible>
                                            <MultiBinding Converter="{StaticResource EntryIsEditingConverter}">
                                                <Binding Path="." />
                                                <Binding Path="#Root.DataContext.EditingEntry" />
                                            </MultiBinding>
                                        </TextBox.IsVisible>
                                    </TextBox>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.ModifiedColumnHeader}" Width="164" MinWidth="150" SortMemberPath="Modified">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding Modified, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Padding="8,0"
                                           FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Opacity>
                                        <MultiBinding Converter="{StaticResource CutEntryOpacityConverter}" ConverterParameter="secondary">
                                            <Binding Path="." />
                                            <Binding Path="#Root.DataContext.CutEntryPaths" />
                                        </MultiBinding>
                                    </TextBlock.Opacity>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.TypeColumnHeader}" Width="120" MinWidth="96" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding ., Converter={StaticResource TypeTextConverter}}" Padding="8,0"
                                           FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Opacity>
                                        <MultiBinding Converter="{StaticResource CutEntryOpacityConverter}" ConverterParameter="secondary">
                                            <Binding Path="." />
                                            <Binding Path="#Root.DataContext.CutEntryPaths" />
                                        </MultiBinding>
                                    </TextBlock.Opacity>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.SizeColumnHeader}" Width="112" MinWidth="96" SortMemberPath="Size">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding Size, Converter={StaticResource SizeConverter}}" Padding="8,0"
                                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Opacity>
                                        <MultiBinding Converter="{StaticResource CutEntryOpacityConverter}" ConverterParameter="secondary">
                                            <Binding Path="." />
                                            <Binding Path="#Root.DataContext.CutEntryPaths" />
                                        </MultiBinding>
                                    </TextBlock.Opacity>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{loc:Loc explorer.empty_view}" IsVisible="{Binding IsEmpty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.6" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
