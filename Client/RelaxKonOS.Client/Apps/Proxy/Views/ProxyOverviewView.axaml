<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proxy="clr-namespace:RelaxKonOS.App.ProxyManager;assembly=RelaxKonOS.App.ProxyManager"
             xmlns:dto="clr-namespace:RelaxKonOS.Protocol.Proxy;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyOverviewView"
             x:DataType="proxy:ProxyManagerViewModel" Classes="builtin-app">
  <UserControl.Styles>
    <StyleInclude Source="avares://RelaxKonOS.Client/Apps/Proxy/ProxyStyles.axaml" />
    <!-- A resting runtime keeps one slow halo. It is the only motion on the page, so it reads as
         "this is alive" instead of as decoration. -->
    <Style Selector="Border.runtime-pulse">
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.0" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.55" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <ScrollViewer x:Name="OverviewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <!-- The code-behind gives this container the finite viewport width needed for star columns. -->
    <Border x:Name="OverviewContent" Padding="0,0,14,14">
      <StackPanel Spacing="14">
        <!-- ── Runtime ──
             One card answers the only question this page has to answer first: is the managed
             runtime up, and what is it doing. The orb is the control, the pills state the measured
             facts, and the three short facts below repeat the values a user checks most. -->
        <Border Classes="panel" Padding="20,18">
          <Grid x:Name="OverviewHero" ColumnDefinitions="Auto,*" ColumnSpacing="20">
            <StackPanel x:Name="HeroOrb" Spacing="8" VerticalAlignment="Center">
              <Button Classes="runtime-orb" Command="{Binding ToggleProxyCommand}" ToolTip.Tip="{Binding ProxyActionText}"
                      AutomationProperties.Name="{Binding ProxyActionText}">
                <Grid Width="104" Height="104">
                  <Border Classes="runtime-pulse" Background="{DynamicResource SuccessMutedBrush}" CornerRadius="52" IsVisible="{Binding ProxyIsRunning}" />
                  <Border Margin="7" CornerRadius="45" BorderThickness="2" Background="{DynamicResource SuccessMutedBrush}"
                          BorderBrush="{DynamicResource SuccessBrush}" IsVisible="{Binding ProxyIsRunning}" />
                  <Border Margin="7" CornerRadius="45" BorderThickness="2" Background="{DynamicResource SurfaceSunkenBrush}"
                          BorderBrush="{DynamicResource BorderDefaultBrush}" IsVisible="{Binding !ProxyIsRunning}" />
                  <Path Classes="glyph" Width="42" Height="42" StrokeThickness="1.7" Stroke="{DynamicResource SuccessBrush}"
                        IsVisible="{Binding ProxyIsRunning}" Data="M12 2 V12 M18.4 6.6 A9 9 0 1 1 5.6 6.64" />
                  <Path Classes="glyph" Width="42" Height="42" StrokeThickness="1.7" Stroke="{DynamicResource TextSecondaryBrush}"
                        IsVisible="{Binding !ProxyIsRunning}" Data="M12 2 V12 M18.4 6.6 A9 9 0 1 1 5.6 6.64" />
                </Grid>
              </Button>
              <TextBlock Text="{Binding ProxyActionText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="HeroBody" Grid.Column="1" Spacing="10" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="pill ok" IsVisible="{Binding ProxyIsRunning}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="dot ok" /><TextBlock Text="{Binding ProxyStateLabel}" />
                  </StackPanel>
                </Border>
                <Border Classes="pill" IsVisible="{Binding !ProxyIsRunning}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="dot idle" /><TextBlock Text="{Binding ProxyStateLabel}" />
                  </StackPanel>
                </Border>
                <Border Classes="pill accent">
                  <TextBlock Text="{Binding HealthState}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{loc:Loc proxy.runtime_control_hint}" Classes="section-hint" />
              <Border Classes="rule" Margin="0,2" />
              <WrapPanel ItemSpacing="28" LineSpacing="10">
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Loc proxy.mixed_proxy_port}" Classes="metric-label" />
                  <TextBlock Text="{Binding MixedPort}" Classes="fact-value" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Loc proxy.system_proxy}" Classes="metric-label" />
                  <TextBlock Text="{Binding SystemProxyState}" Classes="fact-value" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="{loc:Loc proxy.tun_mode}" Classes="metric-label" />
                  <TextBlock Text="{Binding TunOverviewState}" Classes="fact-value" />
                </StackPanel>
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── Subscription and the node in use ── -->
        <Grid x:Name="OverviewPairSubscriptions" ColumnDefinitions="*,*" ColumnSpacing="14">
          <!-- 订阅 -->
          <Border Classes="panel">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="icon-chip">
                  <Path Classes="glyph" Stroke="{DynamicResource AccentBrush}"
                        Data="M7 18 A4 4 0 0 1 7.6 10.05 A5.5 5.5 0 0 1 18.4 11 A3.5 3.5 0 0 1 18 18 Z M12 11 V17 M9.4 14.4 L12 17 L14.6 14.4" />
                </Border>
                <TextBlock Grid.Column="1" Text="{loc:Loc proxy.subscriptions}" Classes="section-title" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost-action" Content="{loc:Loc common.view}" Click="SubscriptionNavigation_Click" ToolTip.Tip="{loc:Loc proxy.subscriptions}" />
              </Grid>
              <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding ActiveSubscriptionName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{loc:Loc proxy.subscription_last_updated}" Classes="section-hint" />
                  <TextBlock Text="{Binding ActiveSubscriptionUpdatedAt}" Classes="section-hint" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- 当前节点 -->
          <Border x:Name="CurrentNodeCard" Grid.Column="1" Classes="panel">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Classes="icon-chip ok">
                  <Path Classes="glyph" Stroke="{DynamicResource SuccessBrush}"
                        Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8" />
                </Border>
                <TextBlock Grid.Column="1" Text="{loc:Loc proxy.current_node}" Classes="section-title" VerticalAlignment="Center" />
                <Button Grid.Column="2" Classes="ghost-action" Content="{loc:Loc common.view}" Click="ProxyNavigation_Click" ToolTip.Tip="{loc:Loc proxy.proxies}" />
              </Grid>
              <StackPanel Grid.Row="1" Spacing="8" Margin="0,2,0,0">
                <TextBlock Text="{Binding CurrentProxyGroupName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <ComboBox ItemsSource="{Binding OverviewProxyNodes}" SelectedItem="{Binding SelectedOverviewProxyNode, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <TextBlock Grid.Row="2" Text="{loc:Loc proxy.proxies_hint}" Classes="section-hint" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
        </Grid>

        <!-- ── Network modes and routing ── -->
        <Grid x:Name="OverviewPairNetwork" ColumnDefinitions="*,*" ColumnSpacing="14">
          <!-- 网络设置 -->
          <Border Classes="panel">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Classes="icon-chip">
                  <Path Classes="glyph" Stroke="{DynamicResource AccentBrush}"
                        Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M3 12 H21 M12 3 C15 6.5 15 17.5 12 21 M12 3 C9 6.5 9 17.5 12 21" />
                </Border>
                <TextBlock Grid.Column="1" Text="{loc:Loc proxy.network_settings}" Classes="section-title" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Row="1" Classes="segmented" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Classes="segment" Classes.selected="{Binding IsSystemProxySettingsSelected}"
                          Command="{Binding SelectNetworkSettingsPageCommand}">
                    <Button.CommandParameter><x:Boolean>False</x:Boolean></Button.CommandParameter>
                    <TextBlock Text="{loc:Loc proxy.system_proxy}" />
                  </Button>
                  <Button Classes="segment" Classes.selected="{Binding IsTunSettingsSelected}"
                          Command="{Binding SelectNetworkSettingsPageCommand}">
                    <Button.CommandParameter><x:Boolean>True</x:Boolean></Button.CommandParameter>
                    <TextBlock Text="{loc:Loc proxy.tun_mode}" />
                  </Button>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Classes="inset" Padding="12,10" IsVisible="{Binding IsSystemProxySettingsSelected}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc proxy.system_proxy}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding SystemProxyEndpoint}" Classes="section-hint" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon-action" Command="{Binding ShowSystemProxySettingsDialogCommand}"
                          ToolTip.Tip="{loc:Loc proxy.system_proxy_settings}" AutomationProperties.Name="{loc:Loc proxy.system_proxy_settings}">
                    <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M4 8 H20 M4 16 H20 M9 5 V11 M15 13 V19" />
                  </Button>
                  <ToggleSwitch Grid.Column="2" IsChecked="{Binding SystemProxyEnabled, Mode=OneWay}" Command="{Binding ToggleSystemProxyCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Row="2" Classes="inset" Padding="12,10" IsVisible="{Binding IsTunSettingsSelected}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc proxy.tun_mode}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="{Binding TunOverviewState}" Classes="section-hint" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="icon-action" Command="{Binding ShowTunSettingsDialogCommand}"
                          ToolTip.Tip="{loc:Loc proxy.tun_managed_settings}" AutomationProperties.Name="{loc:Loc proxy.tun_managed_settings}">
                    <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M4 8 H20 M4 16 H20 M9 5 V11 M15 13 V19" />
                  </Button>
                  <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsTunEnabled, Mode=OneWay}" Command="{Binding ToggleTunCommand}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
          </Border>

          <!-- 代理模式 -->
          <Border x:Name="RoutingCard" Grid.Column="1" Classes="panel">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Classes="icon-chip">
                  <Path Classes="glyph" Stroke="{DynamicResource AccentBrush}"
                        Data="M4 6 H8 L16 18 H20 M4 18 H8 L10 15 M14 9 L16 6 H20 M17 3 L20 6 L17 9 M17 15 L20 18 L17 21" />
                </Border>
                <TextBlock Grid.Column="1" Text="{loc:Loc proxy.routing_mode}" Classes="section-title" VerticalAlignment="Center" />
              </Grid>
              <Border Grid.Row="1" Classes="segmented" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Classes="segment" Classes.selected="{Binding IsRuleRouting}" Content="{loc:Loc proxy.routing_rule}"
                          Command="{Binding SetRoutingModeCommand}" CommandParameter="{x:Static dto:ProxyRoutingMode.Rule}" />
                  <Button Classes="segment" Classes.selected="{Binding IsGlobalRouting}" Content="{loc:Loc proxy.routing_global}"
                          Command="{Binding SetRoutingModeCommand}" CommandParameter="{x:Static dto:ProxyRoutingMode.Global}" />
                  <Button Classes="segment" Classes.selected="{Binding IsDirectRouting}" Content="{loc:Loc proxy.routing_direct}"
                          Command="{Binding SetRoutingModeCommand}" CommandParameter="{x:Static dto:ProxyRoutingMode.Direct}" />
                </StackPanel>
              </Border>
              <TextBlock Grid.Row="2" Text="{loc:Loc proxy.routing_mode_hint}" Classes="section-hint" VerticalAlignment="Top" />
            </Grid>
          </Border>
        </Grid>

        <!-- ── Traffic ──
             Six counters in one strip. The up/down marks carry the only colour; every value stays in
             the primary role so the strip is read as facts rather than as six alarm lights. -->
        <Border Classes="panel" Padding="18,14">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
              <Border Classes="icon-chip warn">
                <Path Classes="glyph" Stroke="{DynamicResource WarningBrush}" Data="M3 12 H6.5 L9.5 5 L14.5 19 L17.5 12 H21" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{loc:Loc proxy.traffic_statistics}" Classes="section-title" />
                <TextBlock Text="{loc:Loc proxy.traffic_statistics_hint}" Classes="section-hint" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <!-- Six metric chips rather than a six-column table: the row wraps on its own, so a
                 narrow window never crushes a value into a second line. -->
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Border Classes="stat-cell">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Classes="glyph small" Stroke="{DynamicResource SuccessBrush}" Data="M12 19 V5 M6 11 L12 5 L18 11" />
                    <TextBlock Text="{loc:Loc proxy.upload_speed}" Classes="metric-label" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding UploadRate}" Classes="metric-value" />
                </StackPanel>
              </Border>
              <Border Classes="stat-cell">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Classes="glyph small" Stroke="{DynamicResource AccentBrush}" Data="M12 5 V19 M6 13 L12 19 L18 13" />
                    <TextBlock Text="{loc:Loc proxy.download_speed}" Classes="metric-label" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding DownloadRate}" Classes="metric-value" />
                </StackPanel>
              </Border>
              <Border Classes="stat-cell">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Loc proxy.upload_total}" Classes="metric-label" />
                  <TextBlock Text="{Binding UploadTotal}" Classes="metric-value" />
                </StackPanel>
              </Border>
              <Border Classes="stat-cell">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Loc proxy.download_total}" Classes="metric-label" />
                  <TextBlock Text="{Binding DownloadTotal}" Classes="metric-value" />
                </StackPanel>
              </Border>
              <Border Classes="stat-cell">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Loc proxy.connections}" Classes="metric-label" />
                  <TextBlock Text="{Binding RunningConnectionCount}" Classes="metric-value" />
                </StackPanel>
              </Border>
              <Border Classes="stat-cell">
                <StackPanel Spacing="3">
                  <TextBlock Text="{loc:Loc proxy.memory_usage}" Classes="metric-label" />
                  <TextBlock Text="{Binding MemoryUsage}" Classes="metric-value" />
                </StackPanel>
              </Border>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- ── Facts ──
             Two read-only lists. Rows are separated by a rule instead of a nested card, so a long
             fact list reads as one table. -->
        <Grid x:Name="OverviewPairFacts" ColumnDefinitions="*,*" ColumnSpacing="14">
          <Border Classes="panel">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,4">
                <Border Classes="icon-chip">
                  <Path Classes="glyph" Stroke="{DynamicResource AccentBrush}"
                        Data="M9 3 V5 M15 3 V5 M9 19 V21 M15 19 V21 M3 9 H5 M3 15 H5 M19 9 H21 M19 15 H21 M6 6 H18 V18 H6 Z M10 10 H14 V14 H10 Z" />
                </Border>
                <TextBlock Grid.Column="1" Text="{loc:Loc proxy.runtime_information}" Classes="section-title" VerticalAlignment="Center" />
              </Grid>
              <Border Classes="row first"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.runtime_core_version}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding RuntimeVersion}" Classes="fact-value" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.system_proxy_address}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding SystemProxyEndpoint}" Classes="fact-value" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.mixed_proxy_port}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding MixedPort}" Classes="fact-value" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.running_time}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding RuntimeUptime}" Classes="fact-value" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.rule_count}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding RuleCount}" Classes="fact-value" /></Grid></Border>
            </StackPanel>
          </Border>
          <Border x:Name="SystemFactsCard" Grid.Column="1" Classes="panel">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,4">
                <Border Classes="icon-chip">
                  <Path Classes="glyph" Stroke="{DynamicResource AccentBrush}" Data="M3 5 H21 V16 H3 Z M9 20 H15 M12 16 V20" />
                </Border>
                <TextBlock Grid.Column="1" Text="{loc:Loc proxy.system_information}" Classes="section-title" VerticalAlignment="Center" />
              </Grid>
              <Border Classes="row first"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.operating_system}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding ServerOperatingSystem}" Classes="fact-value" TextTrimming="CharacterEllipsis" MaxWidth="260" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.start_on_boot}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding StartupState}" Classes="fact-value" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.runtime_mode}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding RuntimeServiceMode}" Classes="fact-value" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.last_configuration_update}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding ConfigurationUpdatedAt}" Classes="fact-value" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.client_version}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding ClientVersion}" Classes="fact-value" /></Grid></Border>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
