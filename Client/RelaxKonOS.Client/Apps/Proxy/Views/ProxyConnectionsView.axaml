<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:proxy="clr-namespace:RelaxKonOS.Client.Apps.Proxy" x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyConnectionsView" x:DataType="proxy:ProxyManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4"><TextBlock Text="{loc:Loc proxy.connections}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc proxy.connections_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
        <Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
      </Grid>
      <Button Grid.Row="1" Content="{loc:Loc proxy.close_connection}" Command="{Binding CloseConnectionCommand}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left" />
      <DataGrid Grid.Row="2" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="160">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc proxy.source}" Binding="{ReflectionBinding Source}" Width="190" CanUserResize="True" />
          <DataGridTextColumn Header="{loc:Loc proxy.destination}" Binding="{ReflectionBinding Destination}" Width="*" CanUserResize="True" />
          <DataGridTextColumn Header="{loc:Loc proxy.rule}" Binding="{ReflectionBinding Rule}" Width="180" CanUserResize="True" />
          <DataGridTextColumn Header="{loc:Loc proxy.chain}" Binding="{ReflectionBinding Chains}" Width="180" CanUserResize="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Border>
</UserControl>
