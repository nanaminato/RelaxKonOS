<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proxy="clr-namespace:RelaxKonOS.Client.Apps.Proxy"
             x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyManagerWorkspace"
             x:DataType="proxy:ProxyManagerViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}" Padding="28,18">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="46" Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="14">
          <TextBlock Text="⇄" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="{loc:Loc proxy.title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{loc:Loc proxy.subtitle}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        <Button Grid.Column="2" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="1" Spacing="0">
      <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1" Padding="20,9">
        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
      </Border>
      <Border IsVisible="{Binding HasControllerAuthenticationFailure}" Background="{DynamicResource WarningMutedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,0,0,1" Padding="20,12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding ControllerAuthenticationTitle}" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Text="{Binding ControllerAuthenticationHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="190,*">
      <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
        <StackPanel Spacing="4" Margin="14,22">
          <TextBlock Text="{loc:Loc proxy.workspace}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
          <Button x:Name="OverviewButton" Classes="workspace-nav" Tag="overview" Click="NavigationButton_Click" Content="{loc:Loc proxy.overview}" HorizontalContentAlignment="Left" Padding="10,8" />
          <Button x:Name="ProfilesButton" Classes="workspace-nav" Tag="profiles" Click="NavigationButton_Click" Content="{loc:Loc proxy.subscriptions}" HorizontalContentAlignment="Left" Padding="10,8" />
          <Button x:Name="ProxiesButton" Classes="workspace-nav" Tag="proxies" Click="NavigationButton_Click" Content="{loc:Loc proxy.proxies}" HorizontalContentAlignment="Left" Padding="10,8" />
          <Button Classes="workspace-nav" Tag="connections" Click="NavigationButton_Click" Content="{loc:Loc proxy.connections}" HorizontalContentAlignment="Left" Padding="10,8" />
          <Button Classes="workspace-nav" Tag="logs" Click="NavigationButton_Click" Content="{loc:Loc proxy.logs}" HorizontalContentAlignment="Left" Padding="10,8" />
          <Button x:Name="SettingsButton" Classes="workspace-nav" Tag="settings" Click="NavigationButton_Click" Content="{loc:Loc proxy.settings}" HorizontalContentAlignment="Left" Padding="10,8" />
        </StackPanel>
      </Border>
      <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="30,24"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
  </Grid>
</UserControl>
