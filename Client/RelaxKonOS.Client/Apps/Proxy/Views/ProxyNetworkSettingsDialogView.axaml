<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proxy="clr-namespace:RelaxKonOS.App.ProxyManager;assembly=RelaxKonOS.App.ProxyManager"
             x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyNetworkSettingsDialogView"
             x:DataType="proxy:ProxyManagerViewModel" Classes="builtin-app">
  <UserControl.Styles>
    <StyleInclude Source="avares://RelaxKonOS.Client/Apps/Proxy/ProxyStyles.axaml" />
  </UserControl.Styles>
  <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
      <Border Classes="icon-chip">
        <Path Classes="glyph" Stroke="{DynamicResource AccentBrush}"
              Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M3 12 H21 M12 3 C15 6.5 15 17.5 12 21 M12 3 C9 6.5 9 17.5 12 21" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock Text="{Binding NetworkSettingsDialogTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding SystemProxyScopeHint}" Classes="section-hint" IsVisible="{Binding IsSystemProxySettingsSelected}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <!-- Leave enough trailing space to scroll the final field completely above the footer. -->
      <StackPanel Spacing="12" Margin="0,0,0,16">
        <StackPanel Spacing="12" IsVisible="{Binding IsSystemProxySettingsSelected}">
          <Border Classes="notice">
            <TextBlock Text="{Binding SystemProxyModeHint}" Classes="section-hint" />
          </Border>
          <Border Classes="panel" Padding="14,10">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.runtime_state}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding SystemProxyState}" Classes="fact-value" /></Grid>
              </Border>
              <Border Classes="row">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.system_proxy_address}" Classes="fact-label" /><TextBlock Grid.Column="1" Text="{Binding SystemProxyEndpoint}" Classes="fact-value" /></Grid>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="inset">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Text="{loc:Loc proxy.system_proxy}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyEnabled, Mode=TwoWay}" />
            </Grid>
          </Border>
          <Border Classes="panel" Padding="14,10">
            <StackPanel>
              <Border Classes="row first">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <TextBlock Text="{loc:Loc proxy.proxy_host}" Classes="field-label" />
                  <TextBox Grid.Column="1" Width="200" Text="{Binding SystemProxyHost}" IsReadOnly="True" ToolTip.Tip="{loc:Loc proxy.proxy_host_follows_listener}" />
                </Grid>
              </Border>
              <StackPanel Spacing="0" IsEnabled="{Binding IsSystemProxyOptionsEditable}">
                <Border Classes="row" IsVisible="{Binding IsSystemProxyPacAvailable}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_pac}" Classes="field-label" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyUsePac, Mode=TwoWay}" /></Grid>
                </Border>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_guard}" Classes="field-label" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyGuardEnabled, Mode=TwoWay}" /></Grid>
                </Border>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_guard_interval}" Classes="field-label" /><NumericUpDown Grid.Column="1" Width="120" Minimum="5" Maximum="3600" Value="{Binding SystemProxyGuardIntervalSeconds, Mode=TwoWay}" FormatString="0 's'" /></Grid>
                </Border>
                <Border Classes="row">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_default_bypass}" Classes="field-label" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyUseDefaultBypass, Mode=TwoWay}" /></Grid>
                </Border>
                <Border Classes="row">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding SystemProxyBypassHint}" Classes="section-hint" />
                    <TextBlock Text="{loc:Loc proxy.system_proxy_bypass_list}" Classes="field-label" />
                    <TextBox Text="{Binding SystemProxyBypassList, Mode=TwoWay}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding IsTunSettingsSelected}">
          <Border Classes="notice">
            <TextBlock Text="{Binding TunModeHint}" Classes="section-hint" />
          </Border>
          <Border Classes="inset">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:Loc proxy.tun_mode}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding TunState}" Classes="section-hint" />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsTunEnabled, Mode=OneWay}" Command="{Binding ToggleTunCommand}" />
            </Grid>
          </Border>
          <Border Classes="panel" Padding="14,10">
            <StackPanel>
              <TextBlock Text="{loc:Loc proxy.tun_managed_settings}" Classes="section-title" Margin="0,0,0,4" />
              <Border Classes="row first"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_stack}" Classes="field-label" /><ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding TunStacks}" SelectedItem="{Binding TunStack, Mode=TwoWay}" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_device_name}" Classes="field-label" /><TextBox Grid.Column="1" Width="200" Text="{Binding TunDeviceName, Mode=TwoWay}" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_auto_route}" Classes="field-label" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding TunAutoRoute, Mode=TwoWay}" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_strict_route}" Classes="field-label" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding TunStrictRoute, Mode=TwoWay}" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_auto_detect_interface}" Classes="field-label" /><ToggleSwitch Grid.Column="1" IsChecked="{Binding TunAutoDetectInterface, Mode=TwoWay}" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_dns_hijack}" Classes="field-label" /><TextBox Grid.Column="1" Width="200" Text="{Binding TunDnsHijack, Mode=TwoWay}" /></Grid></Border>
              <Border Classes="row"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_mtu}" Classes="field-label" /><NumericUpDown Grid.Column="1" Width="200" Minimum="576" Maximum="9000" Value="{Binding TunMtu, Mode=TwoWay}" /></Grid></Border>
              <TextBlock Text="{loc:Loc proxy.tun_managed_settings_hint}" Classes="section-hint" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
          <Button Classes="ghost-action destructive" Content="{loc:Loc proxy.emergency_disable}" Command="{Binding EmergencyDisableCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="app-statusbar" BorderThickness="0,1,0,0" Background="Transparent">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="ghost-action" Content="{loc:Loc common.cancel}" Click="Cancel_Click" />
        <Button Classes="primary" Content="{loc:Loc common.save}" Click="Save_Click" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
