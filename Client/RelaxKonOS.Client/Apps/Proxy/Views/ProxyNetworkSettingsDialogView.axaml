<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proxy="clr-namespace:RelaxKonOS.Client.Apps.Proxy"
             x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyNetworkSettingsDialogView"
             x:DataType="proxy:ProxyManagerViewModel">
  <Grid Margin="22" RowDefinitions="Auto,*,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
      <Border Width="36" Height="36" Background="{DynamicResource AccentMutedBrush}" CornerRadius="9"><TextBlock Text="▣" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Grid.Column="1" Text="{Binding NetworkSettingsDialogTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <!-- Leave enough trailing space to scroll the final field completely above the footer. -->
      <StackPanel Margin="0,0,0,16">
      <StackPanel Spacing="12" IsVisible="{Binding IsSystemProxySettingsSelected}">
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7"><TextBlock Text="{Binding SystemProxyModeHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/></Border>
        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
          <StackPanel Spacing="5"><TextBlock Text="{loc:Loc proxy.system_proxy}" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.runtime_state}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding SystemProxyState}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc proxy.system_proxy_address}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Grid.Column="1" Text="{Binding SystemProxyEndpoint}"/></Grid></StackPanel>
        </Border>
        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="9" Padding="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy}" FontWeight="SemiBold" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyEnabled, Mode=TwoWay}"/></Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.proxy_host}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Width="190" Text="{Binding SystemProxyHost}" IsReadOnly="True" ToolTip.Tip="{loc:Loc proxy.proxy_host_follows_listener}"/></Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_pac}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyUsePac, Mode=TwoWay}"/></Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_guard}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyGuardEnabled, Mode=TwoWay}"/></Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_guard_interval}" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Width="110" Minimum="5" Maximum="3600" Value="{Binding SystemProxyGuardIntervalSeconds, Mode=TwoWay}" FormatString="0 's'"/></Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.system_proxy_default_bypass}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyUseDefaultBypass, Mode=TwoWay}"/></Grid>
        <StackPanel Spacing="5"><TextBlock Text="{loc:Loc proxy.system_proxy_bypass_list}"/><TextBox Text="{Binding SystemProxyBypassList, Mode=TwoWay}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"/></StackPanel>
      </StackPanel>
      <StackPanel Spacing="12" IsVisible="{Binding IsTunSettingsSelected}">
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,7"><TextBlock Text="{Binding TunModeHint}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/></Border>
        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="9" Padding="14">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="3"><TextBlock Text="{loc:Loc proxy.tun_mode}" FontWeight="SemiBold"/><TextBlock Text="{Binding TunState}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding IsTunEnabled, Mode=OneWay}" Command="{Binding ToggleTunCommand}"/></Grid>
        </Border>
        <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="9" Padding="14"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc proxy.tun_managed_settings}" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_stack}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Width="190" ItemsSource="{Binding TunStacks}" SelectedItem="{Binding TunStack, Mode=TwoWay}"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_device_name}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Width="190" Text="{Binding TunDeviceName, Mode=TwoWay}"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_auto_route}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding TunAutoRoute, Mode=TwoWay}"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_strict_route}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding TunStrictRoute, Mode=TwoWay}"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_auto_detect_interface}" VerticalAlignment="Center"/><ToggleSwitch Grid.Column="1" IsChecked="{Binding TunAutoDetectInterface, Mode=TwoWay}"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_dns_hijack}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Width="190" Text="{Binding TunDnsHijack, Mode=TwoWay}"/></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{loc:Loc proxy.tun_mtu}" VerticalAlignment="Center"/><NumericUpDown Grid.Column="1" Width="190" Minimum="576" Maximum="9000" Value="{Binding TunMtu, Mode=TwoWay}"/></Grid><TextBlock Text="{loc:Loc proxy.tun_managed_settings_hint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
        <Button Content="{loc:Loc proxy.emergency_disable}" Command="{Binding EmergencyDisableCommand}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Left"/>
      </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10"><Button Content="{loc:Loc common.cancel}" Click="Cancel_Click"/><Button Classes="primary" Content="{loc:Loc common.save}" Click="Save_Click"/></StackPanel>
    </Border>
  </Grid>
</UserControl>
