<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:proxy="clr-namespace:RelaxKonOS.Client.Apps.Proxy" x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxySettingsView" x:DataType="proxy:ProxyManagerViewModel">
  <UserControl.Styles>
    <Style Selector="ToggleButton.network-mode-tab"><Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style Selector="ToggleButton.network-mode-tab:checked"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}"/></Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="18">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
      <StackPanel Spacing="12">
        <TextBlock Text="{loc:Loc proxy.runtime}" FontSize="19" FontWeight="SemiBold" />
        <StackPanel IsVisible="{Binding RuntimeIsInstalled}" Spacing="14">
          <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="10" Padding="16"><StackPanel Spacing="7"><TextBlock Text="{loc:Loc proxy.runtime_install_success}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding RuntimeInstalledVersion}" FontSize="16" /></StackPanel></Border>
          <TextBlock Text="{Binding RuntimeAvailableVersion}" Foreground="{DynamicResource TextSecondaryBrush}" />
          <WrapPanel ItemHeight="34"><Button Content="{loc:Loc common.delete}" Command="{Binding UninstallRuntimeCommand}" Foreground="{DynamicResource DangerBrush}" /><Button Content="{loc:Loc proxy.runtime_rollback}" Command="{Binding RollbackRuntimeCommand}" Margin="10,0,0,0" /></WrapPanel>
        </StackPanel>
        <StackPanel IsVisible="{Binding RuntimeIsNotInstalled}" Spacing="12">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="22" RowSpacing="10"><TextBlock Text="{loc:Loc proxy.engine}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding Overview.EngineId}" /><TextBlock Grid.Row="1" Text="{loc:Loc proxy.runtime}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}" /><TextBlock Grid.Row="2" Text="{loc:Loc proxy.runtime_state}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeState}" /></Grid>
          <WrapPanel Margin="0,6,0,0"><Button Classes="primary" Content="{loc:Loc proxy.runtime_install}" Command="{Binding InstallRuntimeCommand}" Margin="0,0,8,8" /><Button Content="{loc:Loc proxy.runtime_download}" Command="{Binding ShowRuntimeDownloadCommand}" Margin="0,0,8,8" /></WrapPanel>
          <TextBlock Text="{loc:Loc proxy.runtime_server_file_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc proxy.geodata}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc proxy.geodata.hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="18"><TextBlock Text="{loc:Loc proxy.geodata.state}" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding GeoDataState}" VerticalAlignment="Center" /></Grid><Button Content="{loc:Loc proxy.geodata.select_server_file}" Command="{Binding ConfigureGeoDataFromServerFileCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
      <StackPanel Spacing="12">
        <TextBlock Text="{loc:Loc proxy.system_settings}" FontSize="19" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{loc:Loc proxy.tun_mode}" VerticalAlignment="Center"/><Button Classes="flat" Content="⚙" FontSize="17" Command="{Binding ShowTunSettingsDialogCommand}" ToolTip.Tip="{loc:Loc proxy.tun_managed_settings}"/></StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsTunEnabled, Mode=OneWay}" Command="{Binding ToggleTunCommand}" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{loc:Loc proxy.system_proxy}" VerticalAlignment="Center"/><Button Classes="flat" Content="⚙" FontSize="17" Command="{Binding ShowSystemProxySettingsDialogCommand}" ToolTip.Tip="{loc:Loc proxy.system_proxy_settings}"/></StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding SystemProxyEnabled, Mode=OneWay}" Command="{Binding ToggleSystemProxyCommand}" VerticalAlignment="Center"/>
        </Grid>
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
      <StackPanel Spacing="10">
        <TextBlock Text="{loc:Loc proxy.clash_settings}" FontSize="19" FontWeight="SemiBold"/>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Text="{loc:Loc proxy.proxy_host}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" Width="160" ItemsSource="{Binding SystemProxyHostOptions}" SelectedItem="{Binding SystemProxyHost, Mode=TwoWay}"/>
          <TextBlock Grid.Row="1" Text="{loc:Loc proxy.allow_lan}" VerticalAlignment="Center"/><ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding AllowLan, Mode=TwoWay}"/>
          <TextBlock Grid.Row="2" Text="{loc:Loc proxy.dns_override}" VerticalAlignment="Center"/><ToggleSwitch Grid.Row="2" Grid.Column="1" IsChecked="{Binding DnsEnabled, Mode=TwoWay}"/>
          <TextBlock Grid.Row="3" Text="{loc:Loc proxy.ipv6}" VerticalAlignment="Center"/><ToggleSwitch Grid.Row="3" Grid.Column="1" IsChecked="{Binding Ipv6Enabled, Mode=TwoWay}"/>
          <TextBlock Grid.Row="4" Text="{loc:Loc proxy.unified_delay}" VerticalAlignment="Center"/><ToggleSwitch Grid.Row="4" Grid.Column="1" IsChecked="{Binding UnifiedDelay, Mode=TwoWay}"/>
          <TextBlock Grid.Row="5" Text="{loc:Loc proxy.log_level}" VerticalAlignment="Center"/><ComboBox Grid.Row="5" Grid.Column="1" Width="160" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel, Mode=TwoWay}"/>
          <TextBlock Grid.Row="6" Text="{loc:Loc proxy.port}" VerticalAlignment="Center"/><NumericUpDown Grid.Row="6" Grid.Column="1" Width="160" Minimum="1" Maximum="65535" Value="{Binding MixedPort, Mode=TwoWay}"/>
          <TextBlock Grid.Row="7" Text="{loc:Loc proxy.subscription_insecure_sources}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,6,12,0"/><ToggleSwitch Grid.Row="7" Grid.Column="1" IsChecked="{Binding AllowInsecureSubscriptionSources, Mode=TwoWay}" Margin="0,6,0,0"/>
        </Grid>
        <TextBlock Text="{loc:Loc proxy.subscription_insecure_sources_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        <Button Classes="primary" Content="{loc:Loc common.save}" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
