<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proxy="clr-namespace:RelaxKonOS.Client.Apps.Proxy"
             x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxySubscriptionContentDialogView"
             x:DataType="proxy:ProxyManagerViewModel">
  <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="14">
    <TextBox Text="{Binding RuntimeSubscriptionText}"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Cascadia Mono,Consolas,monospace"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
    <Button Grid.Row="1" Content="{loc:Loc common.close}" HorizontalAlignment="Right" Click="Close_Click" />
  </Grid>
</UserControl>
