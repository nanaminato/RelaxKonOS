<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:proxy="clr-namespace:RelaxKonOS.Client.Apps.Proxy" x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyLogsView" x:DataType="proxy:ProxyManagerViewModel" Classes="builtin-app">
  <UserControl.Styles>
    <StyleInclude Source="avares://RelaxKonOS.Client/Apps/Proxy/ProxyStyles.axaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Loc proxy.logs}" Classes="page-title" />
        <TextBlock Text="{loc:Loc proxy.logs_hint}" Classes="page-hint" />
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Classes="panel" Padding="14">
      <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="160"
                BorderThickness="0" Classes="resource-table">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc proxy.time}" Binding="{ReflectionBinding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="190" CanUserResize="True" />
          <DataGridTextColumn Header="{loc:Loc proxy.level}" Binding="{ReflectionBinding Level}" Width="100" CanUserResize="True" />
          <DataGridTextColumn Header="{loc:Loc proxy.message}" Binding="{ReflectionBinding Message}" Width="*" CanUserResize="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>
</UserControl>
