<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:proxy="clr-namespace:RelaxKonOS.Client.Apps.Proxy" x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyLogsView" x:DataType="proxy:ProxyManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4"><TextBlock Text="{loc:Loc proxy.logs}" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc proxy.logs_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
        <Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
      </Grid>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="160">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc proxy.time}" Binding="{ReflectionBinding Timestamp}" Width="200" CanUserResize="True" />
          <DataGridTextColumn Header="{loc:Loc proxy.level}" Binding="{ReflectionBinding Level}" Width="100" CanUserResize="True" />
          <DataGridTextColumn Header="{loc:Loc proxy.message}" Binding="{ReflectionBinding Message}" Width="*" CanUserResize="True" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Border>
</UserControl>
