<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proxy="clr-namespace:RelaxKonOS.App.ProxyManager;assembly=RelaxKonOS.App.ProxyManager"
             xmlns:dto="clr-namespace:RelaxKonOS.Protocol.Proxy;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Proxy.Views.ProxyGroupsView"
             x:Name="Root"
             x:DataType="proxy:ProxyManagerViewModel" Classes="builtin-app">
  <UserControl.Styles>
    <StyleInclude Source="avares://RelaxKonOS.Client/Apps/Proxy/ProxyStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <StackPanel Spacing="4">
      <TextBlock Text="{loc:Loc proxy.proxies}" Classes="page-title" />
      <TextBlock Text="{loc:Loc proxy.proxies_hint}" Classes="page-hint" />
    </StackPanel>

    <!-- Routing mode is one segmented control. Each segment derives its selected state from the
         controller's reported mode, so the control can never disagree with the runtime. -->
    <Border Grid.Row="1" Classes="segmented" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="3">
        <Button Classes="segment" Classes.selected="{Binding IsRuleRouting}" Content="{loc:Loc proxy.routing_rule}"
                Command="{Binding SetRoutingModeCommand}" CommandParameter="{x:Static dto:ProxyRoutingMode.Rule}" />
        <Button Classes="segment" Classes.selected="{Binding IsGlobalRouting}" Content="{loc:Loc proxy.routing_global}"
                Command="{Binding SetRoutingModeCommand}" CommandParameter="{x:Static dto:ProxyRoutingMode.Global}" />
        <Button Classes="segment" Classes.selected="{Binding IsDirectRouting}" Content="{loc:Loc proxy.routing_direct}"
                Command="{Binding SetRoutingModeCommand}" CommandParameter="{x:Static dto:ProxyRoutingMode.Direct}" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="10">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.Styles>
            <!-- Keep every group header aligned with its expanded node area. -->
            <Style Selector="ContentPresenter">
              <Setter Property="HorizontalAlignment" Value="Stretch" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ItemsControl.Styles>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="proxy:ProxyGroupItem">
              <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                <!-- The whole header row is the disclosure: one target, one hover state, and the
                     chevron states the direction the next click moves. -->
                <Button Classes="card-tile" HorizontalAlignment="Stretch" Command="{Binding DataContext.ToggleProxyGroupCommand, ElementName=Root}" CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="14,11">
                    <Grid Width="16" Height="16" VerticalAlignment="Center">
                      <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M6 9 L12 15 L18 9" IsVisible="{Binding IsExpanded}" />
                      <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M9 6 L15 12 L9 18" IsVisible="{Binding !IsExpanded}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border Classes="pill accent"><TextBlock Text="{Binding Type}" /></Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Selected}" Classes="section-hint" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="pill"><TextBlock Text="{Binding NodeCount}" /></Border>
                  </Grid>
                </Button>

                <Border IsVisible="{Binding IsExpanded}" Classes="panel" Padding="12">
                  <StackPanel Spacing="10">
                    <!-- Node actions sit above the nodes they act on, inside the disclosed area. -->
                    <Border Classes="inset" Padding="8,6">
                      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                        <Button Classes="icon-action" Command="{Binding DataContext.TestGroupSelectedProxyLatencyCommand, ElementName=Root}" CommandParameter="{Binding}"
                                ToolTip.Tip="{loc:Loc proxy.latency_test_selected}" AutomationProperties.Name="{loc:Loc proxy.latency_test_selected}">
                          <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M4 18 A8 8 0 1 1 20 18 M12 18 L16.5 11" />
                        </Button>
                        <Button Grid.Column="1" Classes="icon-action" Command="{Binding DataContext.TestGroupProxyLatenciesCommand, ElementName=Root}" CommandParameter="{Binding}"
                                ToolTip.Tip="{loc:Loc proxy.latency_test_all}" AutomationProperties.Name="{loc:Loc proxy.latency_test_all}">
                          <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M20 10 A8 8 0 0 0 6 6 L3 9 M3 4 V9 H8 M4 14 A8 8 0 0 0 18 18 L21 15 M16 15 H21 V20" />
                        </Button>
                        <TextBox Grid.Column="2" IsVisible="{Binding DataContext.IsLatencyTestTargetVisible, ElementName=Root}"
                                 Text="{Binding DataContext.LatencyTestTarget, ElementName=Root, Mode=TwoWay}"
                                 PlaceholderText="{loc:Loc proxy.latency_test_target_placeholder}"
                                 HorizontalAlignment="Right" MinWidth="200" MaxWidth="380" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                          <Button Classes="icon-action" Command="{Binding DataContext.CycleProxyNodeSortCommand, ElementName=Root}"
                                  ToolTip.Tip="{Binding DataContext.ProxyNodeSortLabel, ElementName=Root}" AutomationProperties.Name="{Binding DataContext.ProxyNodeSortLabel, ElementName=Root}">
                            <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M7 4 V20 M4 17 L7 20 L10 17 M14 6 H20 M14 11 H18 M14 16 H16" />
                          </Button>
                          <Button Classes="icon-action" Command="{Binding DataContext.ToggleLatencyTestTargetCommand, ElementName=Root}"
                                  ToolTip.Tip="{loc:Loc proxy.latency_test_target}" AutomationProperties.Name="{loc:Loc proxy.latency_test_target}">
                            <Path Classes="glyph" Stroke="{Binding $parent[Button].Foreground}" Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 M12 2 V6 M12 18 V22 M2 12 H6 M18 12 H22" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Nodes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="proxy:ProxyNodeItem">
                          <Button Classes="card-tile node-tile" Margin="0,0,8,8" Classes.active="{Binding IsSelected}"
                                  Command="{Binding DataContext.SelectProxyNodeCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <Grid>
                              <Border Classes="tile-rail" IsVisible="{Binding IsSelected}" />
                              <Grid Margin="13,10" RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <!-- One delay label with a tone dot: the number stays in the
                                     primary role, and the dot repeats the state without relying on hue. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                  <Border Classes="dot ok" IsVisible="{Binding HasFastDelay}" />
                                  <Border Classes="dot warn" IsVisible="{Binding HasSlowDelay}" />
                                  <Border Classes="dot bad" IsVisible="{Binding HasTimeout}" />
                                  <TextBlock Text="{Binding DelayText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Row="1" Classes="pill accent" IsVisible="{Binding IsSelected}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="7,1">
                                  <TextBlock Text="{loc:Loc proxy.active}" />
                                </Border>
                              </Grid>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
