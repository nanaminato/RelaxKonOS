<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.TaskManager.ViewModels"
             xmlns:conv="clr-namespace:RelaxKonOS.Client.Apps.TaskManager.Converters"
             xmlns:charts="clr-namespace:RelaxKonOS.Client.Apps.TaskManager.Controls"
             xmlns:dto="clr-namespace:RelaxKonOS.Protocol.SystemMonitor;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.TaskManager.Views.TaskManagerMainView"
             x:DataType="vm:TaskManagerViewModel"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">

    <UserControl.Styles>
        <Style Selector="ListBox.performance-nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.performance-nav > ListBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="ListBox.performance-nav > ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
        </Style>
        <Style Selector="TextBlock.metric-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">
        <Grid x:Name="HeaderHost" DockPanel.Dock="Top" Height="0" IsVisible="False" ColumnDefinitions="Auto,*">
            <Image x:Name="HeaderLeading" Width="20" Height="20" Source="avares://RelaxKonOS.Client/Assets/AppIcons/taskmanager.png" VerticalAlignment="Center" />
            <TextBlock x:Name="HeaderCenter" Grid.Column="1" Margin="8,0,0,0" Text="{loc:Loc application.relaxkonos.taskmanager.display_name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>
        <Border DockPanel.Dock="Bottom" Classes="app-statusbar">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <TextBlock Text="{Binding ConnectionStatus}" ToolTip.Tip="{Binding ConnectionStatus}" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="196,*">
            <Border Grid.Column="0" Classes="app-sidebar" Padding="10,16">
                <StackPanel Spacing="4">
                    <Button Classes="workspace-nav" Command="{Binding SwitchToProcessesCommand}" Background="{Binding ActiveTab, Converter={x:Static conv:TabBgConverter.Instance}, ConverterParameter=Processes}" HorizontalContentAlignment="Left" Padding="10,9" ToolTip.Tip="{loc:Loc task_manager.processes}">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▤" FontSize="16" /><TextBlock Text="{loc:Loc task_manager.processes}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Command="{Binding SwitchToPerformanceCommand}" Background="{Binding ActiveTab, Converter={x:Static conv:TabBgConverter.Instance}, ConverterParameter=Performance}" HorizontalContentAlignment="Left" Padding="10,9" ToolTip.Tip="{loc:Loc task_manager.performance}">
                        <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="◷" FontSize="16" /><TextBlock Text="{loc:Loc task_manager.performance}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Margin="18,8,18,6" ColumnDefinitions="*,Auto" IsVisible="{Binding ActiveTab, Converter={x:Static conv:TabVisibilityConverter.Instance}, ConverterParameter=Performance}">
                    <TextBlock Text="{loc:Loc task_manager.performance}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="header-action header-refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc common.refresh}" AutomationProperties.Name="{loc:Loc common.refresh}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Stretch="Uniform" Width="16" Height="16" Data="M19 8 A8 8 0 1 0 20 14 M19 3 V8 H14" /></Button>
                </Grid>
                <Grid Grid.Row="0" Margin="18,8,18,6" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ActiveTab, Converter={x:Static conv:TabVisibilityConverter.Instance}, ConverterParameter=Processes}">
                    <TextBlock Text="{loc:Loc task_manager.processes}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="header-action header-refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc common.refresh}" AutomationProperties.Name="{loc:Loc common.refresh}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Stretch="Uniform" Width="16" Height="16" Data="M19 8 A8 8 0 1 0 20 14 M19 3 V8 H14" /></Button>
                    <Button Grid.Column="2" Content="{loc:Loc task_manager.end_task}" Command="{Binding KillProcessCommand}" Classes="danger" Padding="14,6" Margin="8,0,0,0" ToolTip.Tip="{loc:Loc task_manager.end_task_tooltip}" />
                </Grid>

            <Grid Grid.Row="1">
            <Grid IsVisible="{Binding ActiveTab, Converter={x:Static conv:TabVisibilityConverter.Instance}, ConverterParameter=Performance}" ColumnDefinitions="236,*">
                <Border Grid.Column="0" Padding="0,8" Classes="app-sidebar">
                    <ListBox Classes="performance-nav" ItemsSource="{Binding PerformanceItems}" SelectedItem="{Binding SelectedPerformanceItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PerformanceResourceItem">
                                <Grid ColumnDefinitions="16,*,Auto">
                                    <Ellipse Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,7,0"><Ellipse.Fill><SolidColorBrush Color="{Binding AccentColor}" /></Ellipse.Fill></Ellipse>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Metric}" FontSize="11" Opacity="0.82" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SideDetail}" FontSize="10" Opacity="0.55" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="62" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <ScrollViewer Grid.Column="1">
                    <Grid Margin="26,16,24,22" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="7" VerticalAlignment="Top">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPerformanceItem.Title}" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedPerformanceItem.Subtitle}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPerformanceItem.Metric}" FontSize="19" VerticalAlignment="Bottom" Margin="12,0,0,2" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <TextBlock Text="{loc:Loc task_manager.performance.history_window}" Classes="metric-label" />
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPerformanceItem.SideDetail}" Classes="metric-label" />
                        </Grid>
                        <Border Grid.Row="2" Height="270" ClipToBounds="True">
                            <charts:PerformanceLineChart Values="{Binding SelectedPerformanceItem.History}" Maximum="{Binding SelectedPerformanceItem.ChartMaximum}" LineColor="{Binding SelectedPerformanceItem.AccentColor}" />
                        </Border>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,4,0,10">
                            <TextBlock Text="{loc:Loc task_manager.performance.axis_start}" Classes="metric-label" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc task_manager.performance.axis_now}" Classes="metric-label" />
                        </Grid>
                        <Grid Grid.Row="4" IsVisible="{Binding SelectedPerformanceItem.IsCpu}" ColumnDefinitions="280,*" ColumnSpacing="18">
                            <Grid ColumnDefinitions="82,82,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="{Binding SelectedPerformanceItem.Detail1Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail1Value}" FontSize="21" /></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="{Binding SelectedPerformanceItem.Detail2Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail2Value}" FontSize="21" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="{Binding SelectedPerformanceItem.Detail3Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail3Value}" FontSize="19" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{Binding SelectedPerformanceItem.Detail4Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail4Value}" FontSize="19" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="{Binding SelectedPerformanceItem.Detail5Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail5Value}" FontSize="19" /></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="{Binding SelectedPerformanceItem.Detail6Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail6Value}" FontSize="19" /></StackPanel>
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="3" ColumnSpacing="10">
                                <TextBlock Grid.Row="0" Text="{Binding SelectedPerformanceItem.Detail7Label}" Classes="metric-label" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail7Value}" FontSize="12" />
                                <TextBlock Grid.Row="1" Text="{Binding SelectedPerformanceItem.Detail8Label}" Classes="metric-label" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail8Value}" FontSize="12" />
                                <TextBlock Grid.Row="2" Text="{Binding SelectedPerformanceItem.Detail9Label}" Classes="metric-label" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail9Value}" FontSize="12" />
                                <TextBlock Grid.Row="3" Text="{Binding SelectedPerformanceItem.Detail10Label}" Classes="metric-label" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail10Value}" FontSize="12" />
                                <TextBlock Grid.Row="4" Text="{Binding SelectedPerformanceItem.Detail11Label}" Classes="metric-label" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail11Value}" FontSize="12" />
                                <TextBlock Grid.Row="5" Text="{Binding SelectedPerformanceItem.Detail12Label}" Classes="metric-label" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail12Value}" FontSize="12" />
                                <TextBlock Grid.Row="6" Text="{Binding SelectedPerformanceItem.Detail13Label}" Classes="metric-label" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail13Value}" FontSize="12" />
                                <TextBlock Grid.Row="7" Text="{Binding SelectedPerformanceItem.Detail14Label}" Classes="metric-label" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail14Value}" FontSize="12" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4" IsVisible="{Binding SelectedPerformanceItem.IsMemory}" ColumnDefinitions="270,*" ColumnSpacing="22">
                            <Grid ColumnDefinitions="125,125" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="{Binding SelectedPerformanceItem.Detail1Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail1Value}" FontSize="21" TextWrapping="NoWrap" /></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="{Binding SelectedPerformanceItem.Detail2Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail2Value}" FontSize="21" TextWrapping="NoWrap" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="{Binding SelectedPerformanceItem.Detail3Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail3Value}" FontSize="21" TextWrapping="NoWrap" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{Binding SelectedPerformanceItem.Detail4Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail4Value}" FontSize="21" TextWrapping="NoWrap" /></StackPanel>
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="10">
                                <TextBlock Grid.Row="0" Text="{Binding SelectedPerformanceItem.Detail5Label}" Classes="metric-label" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail5Value}" FontSize="13" TextWrapping="NoWrap" />
                                <TextBlock Grid.Row="1" Text="{Binding SelectedPerformanceItem.Detail6Label}" Classes="metric-label" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail6Value}" FontSize="13" TextWrapping="NoWrap" />
                                <TextBlock Grid.Row="2" Text="{Binding SelectedPerformanceItem.Detail7Label}" Classes="metric-label" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPerformanceItem.Detail7Value}" FontSize="13" TextWrapping="NoWrap" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="4" IsVisible="{Binding SelectedPerformanceItem.UsesStandardDetails}" ColumnDefinitions="160,160" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="18">
                            <StackPanel Grid.Row="0" Grid.Column="0"><TextBlock Text="{Binding SelectedPerformanceItem.Detail1Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail1Value}" FontSize="21" TextWrapping="NoWrap" /></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1"><TextBlock Text="{Binding SelectedPerformanceItem.Detail2Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail2Value}" FontSize="21" TextWrapping="NoWrap" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0"><TextBlock Text="{Binding SelectedPerformanceItem.Detail3Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail3Value}" FontSize="18" TextWrapping="NoWrap" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{Binding SelectedPerformanceItem.Detail4Label}" Classes="metric-label" /><TextBlock Text="{Binding SelectedPerformanceItem.Detail4Value}" FontSize="18" TextWrapping="NoWrap" /></StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Grid IsVisible="{Binding ActiveTab, Converter={x:Static conv:TabVisibilityConverter.Instance}, ConverterParameter=Processes}" RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,6">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                        <TextBox x:Name="FilterBox" Text="{Binding ProcessFilter, Mode=TwoWay}" PlaceholderText="{loc:Loc task_manager.filter_placeholder}" KeyDown="FilterBox_KeyDown" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"><Run Text="{Binding ProcessTotalCount}" /><Run Text="{loc:Loc task_manager.process_count_suffix}" /></TextBlock>
                        <CheckBox Grid.Column="2" Content="{loc:Loc task_manager.auto_refresh}" IsChecked="{Binding IsAutoRefresh, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0" />
                        <Button Grid.Column="3" Content="{loc:Loc common.clear}" Command="{Binding ClearFilterCommand}" Padding="12,6" Margin="6,0,0,0" />
                        <Button Grid.Column="4" Content="{Binding ProcessModeLabel}" Command="{Binding ToggleProcessModeCommand}" IsEnabled="{Binding !IsLoading}" Padding="12,6" Margin="6,0,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Padding="8,4" IsVisible="{Binding KillFeedback, Converter={x:Static conv:StringNonEmptyVisibilityConverter.Instance}}"><TextBlock Text="{Binding KillFeedback}" FontSize="12" TextWrapping="Wrap" /></Border>
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}">
                    <DataGrid x:Name="ProcessesGrid" ItemsSource="{Binding FilteredProcesses}"
                              SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                              CanUserSortColumns="False" CanUserReorderColumns="False"
                              SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="None"
                              RowHeight="34" BorderThickness="0" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:Loc common.name}" SortMemberPath="Name" Width="2*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="vm:ProcessTreeItemViewModel">
                                        <Grid ColumnDefinitions="20,20,*" Margin="{Binding Indent}" ColumnSpacing="6">
                                            <Button Content="{Binding ExpandGlyph}" Command="{Binding ToggleExpandedCommand}" IsVisible="{Binding HasChildren}" Width="20" Height="24" Padding="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" />
                                            <Image Grid.Column="1" Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" DataContextChanged="ProcessIcon_DataContextChanged" AttachedToVisualTree="ProcessIcon_AttachedToVisualTree" />
                                            <Border Grid.Column="1" IsVisible="{Binding !HasIconImage}" Width="20" Height="20" VerticalAlignment="Center" Background="Transparent">
                                                <Path Width="16" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1" Data="M1,1 H17 V15 H1 Z M1,5 H17 M4,3 H5 M7,3 H8 M4,8 H8 M4,11 H11" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Process.Name}" HorizontalAlignment="Stretch" TextAlignment="Left" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PID" SortMemberPath="Id" Binding="{Binding Process.Id}" Width="80" MinWidth="70" />
                            <DataGridTextColumn Header="CPU" SortMemberPath="CpuPercent" Binding="{Binding Process.CpuPercent, StringFormat='{}{0:0.0}%'}" Width="90" MinWidth="70" />
                            <DataGridTextColumn Header="{loc:Loc task_manager.memory}" SortMemberPath="MemoryBytes" Binding="{Binding Process.MemoryBytes, Converter={x:Static conv:BytesConverter.Instance}}" Width="120" MinWidth="70" />
                            <DataGridTextColumn Header="{loc:Loc task_manager.user}" SortMemberPath="UserName" Binding="{Binding Process.UserName}" Width="120" MinWidth="70" />
                            <DataGridTextColumn Header="{loc:Loc task_manager.threads}" SortMemberPath="ThreadCount" Binding="{Binding Process.ThreadCount}" Width="85" MinWidth="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
            </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
