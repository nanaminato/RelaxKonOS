<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:codeEditor="clr-namespace:RelaxKonOS.Client.Apps.CodeEditor"
             xmlns:explorer="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Controls"
             xmlns:diff="clr-namespace:RelaxKonOS.Client.Controls.Diff"
             x:Class="RelaxKonOS.Client.Apps.CodeEditor.CodeEditorView"
             x:Name="Root"
             x:DataType="codeEditor:CodeEditorViewModel"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">

    <UserControl.Resources>
        <DrawingBrush x:Key="PreviewCanvasBrush" TileMode="Tile" DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource SurfaceRaisedBrush}">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{DynamicResource SurfaceSunkenBrush}">
                        <GeometryDrawing.Geometry><GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Header-bar glyphs. The editor chrome imitates VS Code, so the marks are the same flat
             24x24 silhouettes the file browser uses rather than emoji: an emoji is drawn by
             whichever colour font the host happens to have, which is why a title bar built from
             them changes shape and weight between platforms. -->
        <StreamGeometry x:Key="ChromeSearchIcon">M15.5 14 H14.71 L14.43 13.73 C15.41 12.59 16 11.11 16 9.5 C16 5.91 13.09 3 9.5 3 C5.91 3 3 5.91 3 9.5 C3 13.09 5.91 16 9.5 16 C11.11 16 12.59 15.41 13.73 14.43 L14 14.71 V15.5 L19 20.49 L20.49 19 L15.5 14 Z M9.5 14 C7.01 14 5 11.99 5 9.5 C5 7.01 7.01 5 9.5 5 C11.99 5 14 7.01 14 9.5 C14 11.99 11.99 14 9.5 14 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeChevronDownIcon">M16.59 8.59 L12 13.17 L7.41 8.59 L6 10 L12 16 L18 10 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeCloseIcon">M19 6.41 L17.59 5 L12 10.59 L6.41 5 L5 6.41 L10.59 12 L5 17.59 L6.41 19 L12 13.41 L17.59 19 L19 17.59 L13.41 12 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeAddIcon">M19 13 H13 V19 H11 V13 H5 V11 H11 V5 H13 V11 H19 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeRefreshIcon">M17.65 6.35 C16.2 4.9 14.21 4 12 4 C7.58 4 4.01 7.58 4.01 12 C4.01 16.42 7.58 20 12 20 C15.73 20 18.84 17.45 19.73 14 H17.65 C16.83 16.33 14.61 18 12 18 C8.69 18 6 15.31 6 12 C6 8.69 8.69 6 12 6 C13.66 6 15.14 6.69 16.22 7.78 L13 11 H20 V4 L17.65 6.35 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeRemoveIcon">M19 11 H5 V13 H19 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeMenuIcon">M3 6 H21 V8 H3 Z M3 11 H21 V13 H3 Z M3 16 H21 V18 H3 Z</StreamGeometry>
        <StreamGeometry x:Key="ChromeFolderIcon">M10 4 H4 C2.9 4 2 4.9 2 6 V18 C2 19.1 2.9 20 4 20 H20 C21.1 20 22 19.1 22 18 V8 C22 6.9 21.1 6 20 6 H12 L10 4 Z</StreamGeometry>
        <!-- The application's own mark: the editor's angle brackets. It is a flat silhouette for
             the same reason as every other header mark — the 256px application bitmap goes soft
             at header size — and it is the one header glyph drawn in the accent, because it is
             identity rather than a command. -->
        <StreamGeometry x:Key="ChromeCodeMarkIcon">M9.4 16.6 L4.8 12 L9.4 7.4 L8 6 L2 12 L8 18 Z M14.6 16.6 L19.2 12 L14.6 7.4 L16 6 L22 12 L16 18 Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- The activity bar is 48px wide, leaving a 40px button after its 4px inset.
             Do not inherit the global button's 14px horizontal padding, which clips emoji glyphs. -->
        <Style Selector="Button.activity-item">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The tab strip's own shape lives in the shared ListBox.title-tabs vocabulary. Do not
             restate it here: a view-level rule loses to Themes/Styles.axaml's
             ListBoxItem:selected template rule, and the active tab would silently take that
             surface instead of this one. -->
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" x:Name="HeaderHost" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel x:Name="HeaderLeading" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- A fused bar hides the host's own window icon, so the application states its
                     identity here, ahead of the menu it belongs to. -->
                <PathIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                          Foreground="{DynamicResource AccentBrush}" Data="{StaticResource ChromeCodeMarkIcon}" />
                <Menu x:Name="HeaderMenu" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"
                      IsEnabled="{Binding CanEditDocument}">
                    <MenuItem Header="{loc:Loc common.file}">
                        <MenuItem Header="{loc:Loc common.new}" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="{loc:Loc common.open_ellipsis}" Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                        <MenuItem Header="{loc:Loc code_editor.add_folder}" Command="{Binding AddFolderCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.save}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                        <MenuItem Header="{loc:Loc common.save_as_ellipsis}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                    </MenuItem>
                    <MenuItem Header="{loc:Loc common.settings}">
                        <MenuItem Header="{loc:Loc common.preferences_ellipsis}" Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>
                </Menu>
                <Button x:Name="CompactMenu" Classes="header-action compact" IsEnabled="{Binding CanEditDocument}" IsVisible="False"
                        ToolTip.Tip="{loc:Loc common.file}" AutomationProperties.Name="{loc:Loc common.file}">
                    <Button.Content><PathIcon Width="15" Height="15" Data="{StaticResource ChromeMenuIcon}" /></Button.Content>
                    <Button.Flyout><MenuFlyout>
                    <MenuItem Header="{loc:Loc common.file}">
                        <MenuItem Header="{loc:Loc common.new}" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="{loc:Loc common.open_ellipsis}" Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                        <MenuItem Header="{loc:Loc code_editor.add_folder}" Command="{Binding AddFolderCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.save}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                        <MenuItem Header="{loc:Loc common.save_as_ellipsis}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                    </MenuItem>
                    <MenuItem Header="{loc:Loc common.settings}">
                        <MenuItem Header="{loc:Loc common.preferences_ellipsis}" Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>

                    </MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
            <Button Grid.Column="1" x:Name="HeaderCenter" IsEnabled="{Binding CanEditDocument}"
                    Command="{Binding OpenDocumentCommand}" ToolTip.Tip="{Binding CurrentPath}"
                    MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="{Binding DocumentName}" TextTrimming="CharacterEllipsis" />
            </Button>
            <StackPanel Grid.Column="2" x:Name="HeaderTrailing" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Classes="header-action" Click="Find_Click" IsEnabled="{Binding IsTextDocument}" ToolTip.Tip="{loc:Loc code_editor.find}" AutomationProperties.Name="{loc:Loc code_editor.find}">
                    <PathIcon Width="16" Height="16" Data="{StaticResource ChromeSearchIcon}" />
                </Button>
            </StackPanel>
                    <!-- The strip and the list of what is open are one surface: the tabs run along
                         the row and the full list hangs off its trailing edge, the way IDEA's open
                         files popup does. That is why the list no longer needs a sidebar area of
                         its own. -->
                    <Grid x:Name="HeaderTabs" Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" ColumnSpacing="2" IsVisible="{Binding HasDocuments}">
                    <ListBox x:Name="DocumentTabs" Classes="title-tabs" Height="{DynamicResource WindowTabHeight}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}" SelectionMode="Single">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <!-- A tab states what the document *is*, using the file browser's own asset
                             for that name, so the same file carries the same mark in the explorer's
                             list and on the editor tab that has it open. -->
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="codeEditor:CodeEditorDocument">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6" MinWidth="128" VerticalAlignment="Center" Background="Transparent" ContextRequested="DocumentTab_ContextRequested">
                                    <explorer:ExplorerIcon Kind="{Binding Kind}" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource TextPrimaryBrush}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Classes="tab-close"
                                            Command="{ReflectionBinding $parent[ListBox].DataContext.CloseDocumentCommand}" CommandParameter="{Binding}"
                                            ToolTip.Tip="{loc:Loc common.close}" AutomationProperties.Name="{loc:Loc common.close}">
                                        <PathIcon Width="11" Height="11" Data="{StaticResource ChromeCloseIcon}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Column="1" x:Name="DocumentPickerButton" Classes="header-action compact"
                            IsEnabled="{Binding CanEditDocument}" ToolTip.Tip="{loc:Loc code_editor.sidebar.open_editors}"
                            AutomationProperties.Name="{loc:Loc code_editor.sidebar.open_editors}">
                        <Button.Content><PathIcon Width="14" Height="14" Data="{StaticResource ChromeChevronDownIcon}" /></Button.Content>
                        <Button.Flyout><Flyout>
                            <ListBox ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                                     MinWidth="220" MaxHeight="320" SelectionChanged="DocumentPicker_SelectionChanged">
                                <ListBox.ItemTemplate><DataTemplate x:DataType="codeEditor:CodeEditorDocument">
                                    <DockPanel>
                                        <explorer:ExplorerIcon DockPanel.Dock="Left" Kind="{Binding Kind}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" MaxWidth="300" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Flyout></Button.Flyout>
                    </Button>
                    </Grid>
        </Grid>

        <Grid Grid.Row="1" x:Name="EditorContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- One area, so its item is the sidebar's toggle and its tint says whether the panel
                 is open. The open-file list moved to the tab strip's trailing edge, where it states
                 the same thing without a panel of its own. -->
            <Border x:Name="ActivityBar" Grid.Column="0" Padding="4" Classes="app-sidebar">
                <StackPanel Spacing="6">
                    <Button Classes="activity-item" ToolTip.Tip="{loc:Loc code_editor.sidebar.explorer}" AutomationProperties.Name="{loc:Loc code_editor.sidebar.explorer}"
                            Command="{Binding ToggleSidebarCommand}">
                        <Grid>
                            <PathIcon Width="20" Height="20" Data="{StaticResource ChromeFolderIcon}" IsVisible="{Binding IsSidebarVisible}" Foreground="{DynamicResource AccentBrush}" />
                            <PathIcon Width="20" Height="20" Data="{StaticResource ChromeFolderIcon}" IsVisible="{Binding !IsSidebarVisible}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="FolderPanel" Grid.Column="1"
                    IsVisible="{Binding IsSidebarVisible}" Classes="app-sidebar">
                <Grid RowDefinitions="Auto,*">
                    <DockPanel x:Name="FolderToolbar" Grid.Row="0" Margin="10,8,8,6">
                        <TextBlock DockPanel.Dock="Left" Text="{loc:Loc code_editor.sidebar.folders}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel x:Name="FolderActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                            <Button Classes="header-action compact" ToolTip.Tip="{loc:Loc code_editor.add_folder}" AutomationProperties.Name="{loc:Loc code_editor.add_folder}" Command="{Binding AddFolderCommand}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource ChromeAddIcon}" />
                            </Button>
                            <Button Classes="header-action compact header-refresh" ToolTip.Tip="{loc:Loc common.refresh}" AutomationProperties.Name="{loc:Loc common.refresh}" Command="{Binding RefreshFolderCommand}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource ChromeRefreshIcon}" />
                            </Button>
                            <Button Classes="header-action compact" ToolTip.Tip="{loc:Loc code_editor.remove_folder}" AutomationProperties.Name="{loc:Loc code_editor.remove_folder}" Command="{Binding RemoveFolderCommand}">
                                <PathIcon Width="14" Height="14" Data="{StaticResource ChromeRemoveIcon}" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <TreeView Background="{DynamicResource SurfaceSunkenBrush}" x:Name="ProjectTree" Grid.Row="1" ItemsSource="{Binding WorkspaceRoots}" SelectedItem="{Binding SelectedFolderNode, Mode=TwoWay}" Margin="4,0,4,8"
                              DoubleTapped="ProjectTree_DoubleTapped" KeyDown="ProjectTree_KeyDown">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot"><Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" /></Style>
                            <Style Selector="TreeViewItem:selected"><Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
                            <Style Selector="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel x:Name="ProjectNodeHeader" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsPlaceholder}" Background="Transparent" ContextRequested="ProjectNode_ContextRequested">
                                    <explorer:ExplorerIcon Kind="{Binding Kind}" Width="18" Height="18" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter x:Name="FolderSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast"
                          IsVisible="{Binding IsSidebarVisible}" />

            <Grid Grid.Column="3" RowDefinitions="Auto,Auto,Auto,*">
                <TextBlock Grid.Row="1" IsVisible="{Binding IsTextReadOnly}" Text="{loc:Loc git.editor.readonly_large}" Margin="10,6" TextWrapping="Wrap" />
                <Border IsVisible="{Binding HasImageSourceText}" Classes="app-toolbar" Padding="10,4">
                    <Button Command="{Binding ToggleImageSourceCommand}" HorizontalAlignment="Left">
                        <Grid>
                            <TextBlock Text="{loc:Loc code_editor.preview.edit_source}" IsVisible="{Binding !ShowImageSource}" />
                            <TextBlock Text="{loc:Loc code_editor.preview.show_image}" IsVisible="{Binding ShowImageSource}" />
                        </Grid>
                    </Button>
                </Border>
                <Border Grid.Row="2" IsVisible="{Binding HasExternalChanges}" Padding="10,6" Background="{DynamicResource WarningMutedBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{loc:Loc git.editor.external_changes}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="{loc:Loc git.editor.reload}" Command="{Binding ReloadDocumentCommand}" />
                    </Grid>
                </Border>
                <editor:TextEditor Grid.Row="3" Name="Editor" IsVisible="{Binding IsTextDocument}" SearchResultsBrush="{DynamicResource AccentMutedBrush}" ShowLineNumbers="True" WordWrap="{Binding WordWrap}"
                                   BorderThickness="0" Padding="12,10" FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                   FontSize="{Binding FontSize}" />
                <Grid Grid.Row="3" IsVisible="{Binding IsImageDocument}" Background="{DynamicResource SurfaceSunkenBrush}" RowDefinitions="Auto,*">
                    <Border Classes="app-toolbar" Padding="12,6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ImageDimensionsText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding FileSizeText}" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Content="1:1" IsChecked="{Binding ImageAtActualSize, Mode=TwoWay}" ToolTip.Tip="{loc:Loc code_editor.preview.actual_size}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="24" Background="{StaticResource PreviewCanvasBrush}" ClipToBounds="True">
                        <Border IsVisible="{Binding !ImageAtActualSize}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
                        </Border>
                        <ScrollViewer IsVisible="{Binding ImageAtActualSize}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding PreviewImage}" Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="3" IsVisible="{Binding ShowProjectEmptyState}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="24">
                    <TextBlock Text="{loc:Loc git.editor.empty_title}" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{loc:Loc git.editor.empty_project}" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{loc:Loc git.editor.empty_commit}" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{loc:Loc git.editor.empty_log}" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{loc:Loc git.editor.empty_file}" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
                <Grid Grid.Row="3" IsVisible="{Binding IsComparisonDocument}" RowDefinitions="Auto,*">
                    <TextBlock Text="{Binding ComparisonNotice}" IsVisible="{Binding HasComparisonNotice}" Margin="12,6" TextWrapping="Wrap" />
                    <diff:DiffView Grid.Row="1" Document="{Binding Comparison}" />
                </Grid>
                <Grid Grid.Row="3" IsVisible="{Binding IsBinaryDocument}" Background="{DynamicResource SurfaceSunkenBrush}">
                    <Border Margin="24" Padding="28" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel Spacing="12">
                            <explorer:ExplorerIcon Kind="{Binding ActiveDocument.Kind}" Width="56" Height="56" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DocumentName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="{Binding FileSizeText}" Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Center" />
                            <TextBlock Text="{loc:Loc code_editor.preview.binary_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border x:Name="EditorStatusBar" Grid.Row="2" Classes="app-statusbar">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{Binding EncodingName}" FontSize="12" Padding="4,0"
                        IsVisible="{Binding IsTextDocument}" ToolTip.Tip="{loc:Loc common.file_encoding}"
                        IsEnabled="{Binding CanSaveDocument}"
                        Command="{Binding ChooseEncodingCommand}" />
                <TextBlock Grid.Column="2" IsVisible="{Binding IsTextDocument}" Text="{Binding LineCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="3" IsVisible="{Binding IsTextDocument}" Text="{Binding CharacterCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="4" IsVisible="{Binding IsTextDocument}" Text="{Binding NewlineText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="5" IsVisible="{Binding IsTextDocument}" Text="{Binding CaretPosition}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
