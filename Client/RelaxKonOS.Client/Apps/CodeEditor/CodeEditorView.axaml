<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:codeEditor="clr-namespace:RelaxKonOS.Client.Apps.CodeEditor"
             x:Class="RelaxKonOS.Client.Apps.CodeEditor.CodeEditorView"
             x:Name="Root"
             x:DataType="codeEditor:CodeEditorViewModel"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">
    <UserControl.Styles>
        <!-- The activity bar is 48px wide, leaving a 40px button after its 4px inset.
             Do not inherit the global button's 14px horizontal padding, which clips emoji glyphs. -->
        <Style Selector="Button.activity-item">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" x:Name="HeaderHost" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Classes="builtin-app" x:Name="HeaderLeading" Orientation="Horizontal" VerticalAlignment="Center">
                <Menu x:Name="HeaderMenu" Background="Transparent" VerticalAlignment="Center" BorderThickness="0"
                      IsEnabled="{Binding CanEditDocument}">
                    <MenuItem Header="{loc:Loc common.file}">
                        <MenuItem Header="{loc:Loc common.new}" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="{loc:Loc common.open_ellipsis}" Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                        <MenuItem Header="{loc:Loc code_editor.add_folder}" Command="{Binding AddFolderCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.save}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                        <MenuItem Header="{loc:Loc common.save_as_ellipsis}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                    </MenuItem>
                    <MenuItem Header="{loc:Loc common.settings}">
                        <MenuItem Header="{loc:Loc common.preferences_ellipsis}" Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>
                </Menu>
                <Button x:Name="CompactMenu" IsEnabled="{Binding CanEditDocument}" Content="☰" IsVisible="False" ToolTip.Tip="{loc:Loc common.file}">
                    <Button.Flyout><MenuFlyout>
                    <MenuItem Header="{loc:Loc common.file}">
                        <MenuItem Header="{loc:Loc common.new}" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="{loc:Loc common.open_ellipsis}" Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                        <MenuItem Header="{loc:Loc code_editor.add_folder}" Command="{Binding AddFolderCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.save}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                        <MenuItem Header="{loc:Loc common.save_as_ellipsis}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                    </MenuItem>
                    <MenuItem Header="{loc:Loc common.settings}">
                        <MenuItem Header="{loc:Loc common.preferences_ellipsis}" Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>

                    </MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
            <Button Grid.Column="1" x:Name="HeaderCenter" IsEnabled="{Binding CanEditDocument}"
                    Command="{Binding OpenDocumentCommand}" ToolTip.Tip="{Binding CurrentPath}"
                    MaxWidth="420" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <TextBlock Text="{Binding DocumentName}" TextTrimming="CharacterEllipsis" />
            </Button>
            <StackPanel Grid.Column="2" x:Name="HeaderTrailing" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⌕" Click="Find_Click" ToolTip.Tip="{loc:Loc code_editor.find}" />
                <Button x:Name="DocumentPickerButton" Content="⌄" ToolTip.Tip="{loc:Loc code_editor.sidebar.open_editors}">
                    <Button.Flyout><Flyout>
                        <ListBox ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}"
                                 MinWidth="220" MaxHeight="320" SelectionChanged="DocumentPicker_SelectionChanged">
                            <ListBox.ItemTemplate><DataTemplate x:DataType="codeEditor:CodeEditorDocument">
                                <TextBlock Text="{Binding DisplayName}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Flyout></Button.Flyout>
                </Button>
            </StackPanel>
                    <ListBox x:Name="HeaderTabs" Classes="editor-tabs" Grid.Row="1" Grid.ColumnSpan="3" Height="{DynamicResource WindowTabHeight}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}" SelectionMode="Single"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Height" Value="{DynamicResource WindowTabHeight}" />
                                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="codeEditor:CodeEditorDocument">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource TextPrimaryBrush}" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="×" Padding="2,0" MinHeight="0" MinWidth="20" Height="20" Background="Transparent"
                                            Command="{ReflectionBinding $parent[ListBox].DataContext.CloseDocumentCommand}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
        </Grid>

        <Grid Grid.Row="1" x:Name="EditorContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Activity bar only exposes areas that are implemented. -->
            <Border Grid.Column="0" Padding="4" Classes="app-sidebar">
                <StackPanel Spacing="6">
                    <Button Classes="activity-item" Content="📁" FontSize="17" ToolTip.Tip="{loc:Loc code_editor.sidebar.explorer}"
                            Command="{Binding SwitchSidebarCommand}" CommandParameter="explorer" />
                    <Button Classes="activity-item" Content="📄" FontSize="17" ToolTip.Tip="{loc:Loc code_editor.sidebar.open_editors}"
                            Command="{Binding SwitchSidebarCommand}" CommandParameter="openEditors" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    IsVisible="{Binding IsSidebarVisible}" Classes="app-sidebar">
                <Grid>
                    <Grid IsVisible="{Binding IsExplorerSidebar}" RowDefinitions="Auto,*">
                        <DockPanel Grid.Row="0" Margin="10,8,8,6">
                            <TextBlock DockPanel.Dock="Left" Text="{loc:Loc code_editor.sidebar.folders}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                <Button Content="＋" ToolTip.Tip="{loc:Loc code_editor.add_folder}" Command="{Binding AddFolderCommand}" />
                                <Button Content="⟳" ToolTip.Tip="{loc:Loc common.refresh}" Command="{Binding RefreshFolderCommand}" />
                                <Button Content="−" ToolTip.Tip="{loc:Loc code_editor.remove_folder}" Command="{Binding RemoveFolderCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <TreeView Grid.Row="1" ItemsSource="{Binding WorkspaceRoots}" SelectedItem="{Binding SelectedFolderNode, Mode=TwoWay}" Margin="4,0,4,8">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsPlaceholder}">
                                        <TextBlock Text="{Binding Glyph}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Grid>

                    <Grid IsVisible="{Binding IsOpenEditorsSidebar}" RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="{loc:Loc code_editor.sidebar.open_editors}" FontWeight="SemiBold" Margin="10,10,8,8" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding OpenDocuments}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}" Margin="4,0,4,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="codeEditor:CodeEditorDocument">
                                    <DockPanel Margin="6,4">
                                        <Button DockPanel.Dock="Right" Content="×" Padding="4,0"
                                                Command="{Binding DataContext.CloseDocumentCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="●" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,0,0,0" IsVisible="{Binding IsDirty}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="2" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource SurfaceBrush}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWestEast"
                          IsVisible="{Binding IsSidebarVisible}" />

            <Grid Grid.Column="3">


                <editor:TextEditor Name="Editor" SearchResultsBrush="{DynamicResource AccentMutedBrush}" ShowLineNumbers="True" WordWrap="{Binding WordWrap}"
                                   BorderThickness="0" Padding="12,10" FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                   FontSize="{Binding FontSize}" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="app-statusbar">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{Binding EncodingName}" FontSize="12" Padding="4,0"
                        IsVisible="{Binding HasOpenFile}" ToolTip.Tip="{loc:Loc common.file_encoding}"
                        IsEnabled="{Binding CanEditDocument}"
                        Command="{Binding ChooseEncodingCommand}" />
                <TextBlock Grid.Column="2" Text="{Binding LineCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding CharacterCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
