<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Browser.ViewModels"
             xmlns:conv="clr-namespace:RelaxKonOS.Client.Apps.Browser.Converters"
             xmlns:dto="clr-namespace:RelaxKonOS.Protocol.Browser;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Browser.Views.BrowserMainView"
             x:DataType="vm:BrowserViewModel"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- 侧边栏标签页按钮主题：拉伸宽度，左对齐 -->
        <ControlTheme x:Key="SidebarTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </ControlTheme>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- Application menu: commands remain available even when their toolbar shortcuts are hidden. -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="{loc:Loc common.file}">
                <MenuItem Header="{loc:Loc common.settings_ellipsis}" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="{loc:Loc common.close}" Command="{Binding CloseCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc browser.menu.navigate}">
                <MenuItem Header="{loc:Loc common.back}" Command="{Binding GoBackCommand}" InputGesture="Alt+Left" />
                <MenuItem Header="{loc:Loc common.forward}" Command="{Binding GoForwardCommand}" InputGesture="Alt+Right" />
                <MenuItem Header="{loc:Loc common.home}" Command="{Binding GoHomeCommand}" />
                <Separator />
                <MenuItem Header="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" InputGesture="Ctrl+R" />
                <MenuItem Header="{loc:Loc common.stop}" Command="{Binding StopCommand}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc browser.bookmarks}">
                <MenuItem Header="{loc:Loc browser.toggle_bookmark}" Command="{Binding ToggleBookmarkCommand}" InputGesture="Ctrl+D" />
                <Separator />
                <MenuItem Header="{loc:Loc browser.show_bookmarks}" Command="{Binding SwitchToBookmarksCommand}" />
                <MenuItem Header="{loc:Loc browser.show_history}" Command="{Binding SwitchToHistoryCommand}" InputGesture="Ctrl+H" />
            </MenuItem>
            <MenuItem Header="{loc:Loc common.view}">
                <MenuItem Header="{loc:Loc browser.toggle_sidebar}" Command="{Binding ToggleSidebarCommand}" />
                <MenuItem Header="{Binding FullScreenMenuText}" Command="{Binding ToggleFullScreenCommand}" InputGesture="F11" />
            </MenuItem>
        </Menu>

        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="icon" Content="←" Command="{Binding GoBackCommand}" ToolTip.Tip="{loc:Loc common.back}" />
                <Button Classes="icon" Content="→" Command="{Binding GoForwardCommand}" ToolTip.Tip="{loc:Loc common.forward}" />
                <Button Classes="icon" Content="⟳" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc common.refresh}" IsVisible="{Binding !IsLoading}" />
                <Button Classes="icon" Content="✕" Command="{Binding StopCommand}" ToolTip.Tip="{loc:Loc common.stop}" IsVisible="{Binding IsLoading}" />
                <Button Classes="icon" Content="🏠" Command="{Binding GoHomeCommand}" ToolTip.Tip="{loc:Loc common.home}" />
                <Separator Margin="6,0" />
                <!-- 书签星标：当前已加书签显示实心★，未加显示空心☆ -->
                <Button Classes="icon"
                        Content="{Binding IsCurrentBookmarked, Converter={x:Static conv:BookmarkStarConverter.Instance}}"
                        Command="{Binding ToggleBookmarkCommand}"
                        ToolTip.Tip="{loc:Loc browser.toggle_bookmark}" />
                <Separator Margin="6,0" />
                <Button Classes="icon" Content="📑" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{loc:Loc browser.toggle_sidebar}" />
                <Button Content="{loc:Loc browser.toolbar.full_screen}" Command="{Binding ToggleFullScreenCommand}" />
                <Button Content="{loc:Loc common.settings}" Command="{Binding OpenSettingsCommand}" />
            </StackPanel>
        </Border>

        <!-- 地址栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🔒" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13" ToolTip.Tip="{loc:Loc browser.security_indicator}" />
                <TextBox x:Name="AddressBox"
                         Text="{Binding AddressText, Mode=TwoWay}"
                         PlaceholderText="{loc:Loc browser.address_placeholder}"
                         IsReadOnly="False"
                         MinWidth="700"
                         KeyDown="AddressBox_KeyDown" />
                <Button Content="{loc:Loc common.go}" Click="GoButton_Click" Padding="16,6" />
            </StackPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="120" Height="3" IsVisible="{Binding IsLoading}" />
                    <TextBlock Text="{Binding IsLoading, Converter={x:Static conv:LoadingStatusConverter.Instance}}" FontSize="12" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左侧边栏（书签/历史） | GridSplitter | WebView -->
        <Grid x:Name="BrowserContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding IsSidebarVisible}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 标签页切换 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,*" Background="{DynamicResource SurfaceBrush}">
                        <Button Grid.Column="0" Content="{loc:Loc browser.bookmarks_tab}" Theme="{StaticResource SidebarTabButton}"
                                Command="{Binding SwitchToBookmarksCommand}"
                                Background="{Binding ActiveSidebarTab, Converter={x:Static conv:SidebarTabBgConverter.Instance}, ConverterParameter=Bookmarks, Mode=OneWay}" />
                        <Button Grid.Column="1" Content="{loc:Loc browser.history_tab}" Theme="{StaticResource SidebarTabButton}"
                                Command="{Binding SwitchToHistoryCommand}"
                                Background="{Binding ActiveSidebarTab, Converter={x:Static conv:SidebarTabBgConverter.Instance}, ConverterParameter=History, Mode=OneWay}" />
                    </Grid>

                    <!-- 书签列表 -->
                    <ListBox Grid.Row="1"
                             x:Name="BookmarksList"
                             ItemsSource="{Binding Bookmarks}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionMode="Single"
                             DoubleTapped="BookmarksList_DoubleTapped"
                             IsVisible="{Binding ActiveSidebarTab, Converter={x:Static conv:SidebarTabVisibilityConverter.Instance}, ConverterParameter=Bookmarks, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:BookmarkDto">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🔖" FontSize="13" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Vertical" Spacing="1">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                            <TextBlock Text="{Binding Url}" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Padding="6,2"
                                            Background="Transparent" BorderThickness="0"
                                            Click="DeleteItemButton_Click"
                                            Tag="bookmark"
                                            ToolTip.Tip="{loc:Loc browser.delete_bookmark}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- 历史列表 -->
                    <ListBox Grid.Row="1"
                             x:Name="HistoryList"
                             ItemsSource="{Binding History}"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionMode="Single"
                             DoubleTapped="HistoryList_DoubleTapped"
                             IsVisible="{Binding ActiveSidebarTab, Converter={x:Static conv:SidebarTabVisibilityConverter.Instance}, ConverterParameter=History, Mode=OneWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="dto:HistoryEntryDto">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🕘" FontSize="13" VerticalAlignment="Center" />
                                        <StackPanel Orientation="Vertical" Spacing="1">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                            <TextBlock Text="{Binding LastVisitedAt, StringFormat='{}{0:MM/dd HH:mm}'}" FontSize="10" Opacity="0.6" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="✕" Padding="6,2"
                                            Background="Transparent" BorderThickness="0"
                                            Click="DeleteItemButton_Click"
                                            Tag="history"
                                            ToolTip.Tip="{loc:Loc browser.delete_history}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>

                    <!-- 底部清空按钮（按当前标签页激活对应按钮） -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="8,6">
                        <StackPanel Orientation="Vertical" Spacing="4">
                            <Button Content="{loc:Loc browser.clear_bookmarks}"
                                    Command="{Binding ClearBookmarksCommand}"
                                    IsVisible="{Binding ActiveSidebarTab, Converter={x:Static conv:SidebarTabVisibilityConverter.Instance}, ConverterParameter=Bookmarks, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="12,4" />
                            <Button Content="{loc:Loc browser.clear_history}"
                                    Command="{Binding ClearHistoryCommand}"
                                    IsVisible="{Binding ActiveSidebarTab, Converter={x:Static conv:SidebarTabVisibilityConverter.Instance}, ConverterParameter=History, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="12,4" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource SurfaceBrush}" ResizeDirection="Columns"
                          IsVisible="{Binding IsSidebarVisible}" />

            <!-- Linux delegates pages to the system browser process; other platforms use
                 an embedded NativeWebView. This avoids an unsupported WebKitGTK host. -->
            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <ContentControl x:Name="WebViewHost">
                    <ContentControl.Content>
                        <Border Padding="24">
                            <TextBlock Text="{loc:Loc browser.linux.external_browser_notice}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </ContentControl.Content>
                </ContentControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
