<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.PortForwarding.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.PortForwarding.Views.PortForwardingMainView"
             x:DataType="vm:PortForwardingViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid RowDefinitions="Auto,*">
        <Border Background="{DynamicResource SurfaceSunkenBrush}" Padding="28,18">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="46" Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="14">
                    <TextBlock Text="↔" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc port_forwarding.title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc port_forwarding.description}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" Padding="12,6" CornerRadius="16" FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="190,*">
            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <StackPanel Spacing="4" Margin="14,22">
                    <TextBlock Text="{loc:Loc port_forwarding.workspace}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
                    <Button x:Name="ForwardsButton" Classes="workspace-nav" Tag="forwards" Click="NavigationButton_Click" Content="{loc:Loc port_forwarding.forwards_page}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="connection" Click="NavigationButton_Click" Content="{loc:Loc port_forwarding.connection_page}" HorizontalContentAlignment="Left" Padding="10,8" />
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="ContentHost" Margin="30,24" HorizontalAlignment="Stretch" />
                </ScrollViewer>
                <TextBlock Grid.Row="1" Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,0,30,18" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
