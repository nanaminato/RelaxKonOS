<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.PortForwarding.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.PortForwarding.Views.PortForwardingConnectionView"
             x:DataType="vm:PortForwardingViewModel">
    <StackPanel Spacing="18" MaxWidth="720">
        <StackPanel Spacing="3">
            <TextBlock Text="{loc:Loc port_forwarding.ssh_connection}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc port_forwarding.ssh_note}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Loc port_forwarding.connection_details}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,*,100" ColumnSpacing="8">
                    <TextBox Text="{Binding SshHost, Mode=TwoWay}" PlaceholderText="{loc:Loc port_forwarding.ssh_host}" />
                    <TextBox Grid.Column="1" Text="{Binding SshUser, Mode=TwoWay}" PlaceholderText="{loc:Loc port_forwarding.ssh_user}" />
                    <TextBox Grid.Column="2" Text="{Binding SshPortText, Mode=TwoWay}" PlaceholderText="22" />
                </Grid>
                <Button Content="{loc:Loc port_forwarding.save_ssh}" Command="{Binding SaveConnectionSettingsCommand}" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc port_forwarding.password_authentication}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc port_forwarding.password_note}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox Text="{Binding SshPassword, Mode=TwoWay}" PasswordChar="●" PlaceholderText="{loc:Loc port_forwarding.password}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
