<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.PortForwarding.ViewModels"
             xmlns:forward="clr-namespace:RelaxKonOS.Client.Apps.PortForwarding"
             x:Class="RelaxKonOS.Client.Apps.PortForwarding.Views.PortForwardingForwardsView"
             x:DataType="vm:PortForwardingViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="{loc:Loc port_forwarding.running}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc port_forwarding.forwards_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="{loc:Loc port_forwarding.new_forward}" Command="{Binding OpenCreateForwardCommand}" VerticalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Forwards}" SelectedItem="{Binding SelectedForward, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="forward:PortForwardInfo">
                    <Border Classes="card" Margin="0,3">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding LocalUri}" FontFamily="Consolas" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.7" />
                            <TextBlock Grid.Row="1" FontSize="12" Opacity="0.65"><Run Text="{loc:Loc port_forwarding.server_target}" /><Run Text=": " /><Run Text="{Binding Target}" /></TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Loc port_forwarding.test}" Command="{Binding TestSelectedCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{loc:Loc port_forwarding.edit}" Command="{Binding OpenEditForwardCommand}" IsEnabled="{Binding HasSelectedForward}" />
            <Button Content="{loc:Loc port_forwarding.stop}" Command="{Binding RemoveSelectedCommand}" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </Grid>
</UserControl>
