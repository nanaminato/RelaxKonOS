<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:registry="clr-namespace:RelaxKonOS.Client.Apps.Registry"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             x:Class="RelaxKonOS.Client.Apps.Registry.RegistryKeyDialogView"
             x:DataType="registry:RegistryKeyDialogViewModel"
             Classes="builtin-app">
  <Grid RowDefinitions="*,Auto" MinWidth="420">
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="{Binding ParentPath}" Opacity="0.7" TextWrapping="Wrap"/>
      <TextBox PlaceholderText="{loc:Loc registry.key.placeholder}" Text="{Binding Name, Mode=TwoWay}"/>
      <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20">
      <Button Content="{loc:Loc registry.cancel}" Command="{Binding CancelCommand}"/>
      <Button Classes="primary" Content="{loc:Loc registry.key.create}" Command="{Binding SaveCommand}"/>
    </StackPanel>
  </Grid>
</UserControl>
