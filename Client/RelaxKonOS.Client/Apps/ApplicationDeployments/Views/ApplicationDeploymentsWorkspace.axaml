<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:apps="clr-namespace:RelaxKonOS.Client.Apps.ApplicationDeployments"
             xmlns:viewModels="clr-namespace:RelaxKonOS.Client.Apps.ApplicationDeployments.ViewModels"
             xmlns:dconv="clr-namespace:RelaxKonOS.Client.Apps.ApplicationDeployments.Converters"
             x:Class="RelaxKonOS.Client.Apps.ApplicationDeployments.Views.ApplicationDeploymentsWorkspace"
             x:DataType="apps:ApplicationDeploymentsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Styles>
        <!-- A state transition is the only thing on this page that moves, so motion itself reads as
             "in progress" rather than being decoration on every row. -->
        <Style Selector="Path.deployment-spin">
            <Style.Animations>
                <Animation Duration="0:0:1.1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- The field label/value pair is this page's most repeated unit, so each half is named once
             instead of being restyled at every occurrence. -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.fieldValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- An address, a port and a container name are read character by character, so they are
             monospaced; the rest of the page is not. -->
        <Style Selector="TextBlock.fieldMono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
        </Style>
        <!-- Secondary affordances that sit inside a field stay compact. The primary actions on the
             command row keep the full control height, so the generous hit target is still the norm
             for anything an operator reaches for repeatedly. -->
        <Style Selector="Button.inline-action">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header. The subtitle states the replacement policy so a stop-and-replace is never a surprise. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}" Padding="24,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="44" Height="44" Background="{DynamicResource AccentBrush}" CornerRadius="14">
                    <TextBlock Text="&#x1F4E6;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc application_deployments.title}"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{loc:Loc application_deployments.subtitle}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                           VerticalAlignment="Center" MaxWidth="320" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
        </Border>

        <!-- Operation banner: the durable record, not an in-flight request, is what is shown here. -->
        <Border Grid.Row="1" IsVisible="{Binding HasActiveOperation}"
                Background="{DynamicResource AccentMutedBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding OperationText}"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{Binding ActiveOperation.ProgressText}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Loc application_deployments.cancel_operation}"
                        Command="{Binding CancelOperationCommand}"
                        IsVisible="{Binding ActiveOperation.CanCancel}"
                        VerticalAlignment="Center" Padding="12,6" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="320,*">
            <!-- Left: the application list and the actions that do not need a selection. -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="14,16,14,8">
                        <Button Content="{loc:Loc application_deployments.new_deployment}"
                                Command="{Binding NewDeploymentCommand}"
                                IsEnabled="{Binding CanManage}"
                                Padding="12,6" />
                        <Button Content="{loc:Loc application_deployments.refresh}"
                                Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding CanRead}"
                                Padding="12,6" />
                    </StackPanel>

                    <Border Grid.Row="1" IsVisible="{Binding HasError}" Margin="14,4,14,4"
                            Background="{DynamicResource DangerBrush}" CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextOnDangerBrush}" />
                    </Border>

                    <!-- A list row states the same three facts as the detail header, in the same order:
                         the state (dot plus its own word), the name, then what the instance is. -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Applications}"
                             SelectedItem="{Binding SelectedApplication}"
                             Background="Transparent" BorderThickness="0" Margin="6,4,6,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ApplicationRowViewModel">
                                <StackPanel Spacing="3" Margin="4,6">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock FontSize="10" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsTransitioning}"
                                                   Text="{Binding ActualState, Converter={x:Static dconv:DeploymentStateGlyphConverter.Instance}}"
                                                   Foreground="{Binding ActualState, Converter={x:Static dconv:DeploymentStateBrushConverter.Instance}, ConverterParameter=foreground}" />
                                        <Path Width="12" Height="12" VerticalAlignment="Center"
                                              IsVisible="{Binding IsTransitioning}"
                                              Data="M8,1 A7,7 0 1 1 1,8" Stretch="Uniform"
                                              StrokeThickness="2" StrokeLineCap="Round"
                                              RenderTransformOrigin="50%,50%" Classes="deployment-spin"
                                              Stroke="{Binding ActualState, Converter={x:Static dconv:DeploymentStateBrushConverter.Instance}, ConverterParameter=foreground}">
                                            <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                                        </Path>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Margin="17,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <!-- Drift is shown on the row so an externally changed instance is
                                         visible without opening it. -->
                                    <TextBlock Text="{Binding DriftText}" FontSize="11" TextWrapping="Wrap"
                                               Margin="17,0,0,0"
                                               IsVisible="{Binding HasDrift}"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: the selected application. The reading order is deliberate — what it is, whether
                 it is healthy, where to reach it, what it will do, and only then the history. -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,*" IsVisible="{Binding HasSelection}">
                <!-- 1. Identity, and the one-word answer to "is it alright?". The badge is an outline
                     plus a dot plus a glyph plus the state's own word, so colour is never the only
                     signal and the same state reads the same here as it does in the list. -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="20,16,20,0">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedApplication.Name}" FontSize="20" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding HeaderMetaText}" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="11,5"
                            Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="13"
                            BorderThickness="1"
                            BorderBrush="{Binding SelectedActualState, Converter={x:Static dconv:DeploymentStateBrushConverter.Instance}}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock FontSize="10" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsTransitioning}"
                                       Text="{Binding SelectedActualState, Converter={x:Static dconv:DeploymentStateGlyphConverter.Instance}}"
                                       Foreground="{Binding SelectedActualState, Converter={x:Static dconv:DeploymentStateBrushConverter.Instance}, ConverterParameter=foreground}" />
                            <Path Width="12" Height="12" VerticalAlignment="Center"
                                  IsVisible="{Binding IsTransitioning}"
                                  Data="M8,1 A7,7 0 1 1 1,8" Stretch="Uniform"
                                  StrokeThickness="2" StrokeLineCap="Round"
                                  RenderTransformOrigin="50%,50%" Classes="deployment-spin"
                                  Stroke="{Binding SelectedActualState, Converter={x:Static dconv:DeploymentStateBrushConverter.Instance}, ConverterParameter=foreground}">
                                <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{Binding SelectedApplication.ActualText}"
                                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding SelectedActualState, Converter={x:Static dconv:DeploymentStateBrushConverter.Instance}, ConverterParameter=foreground}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. The diagnostics an operator reads second: where to reach it, how it is judged
                     ready, what it is running as, and what was asked of it. -->
                <Border Grid.Row="1" Classes="surface" Padding="18,14" Margin="20,14,20,0">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                            <TextBlock Classes="fieldLabel"
                                       Text="{loc:Loc application_deployments.field.access_address}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="fieldValue fieldMono" VerticalAlignment="Center"
                                           IsVisible="{Binding HasEndpointAddress}"
                                           Text="{Binding EndpointAddress}" />
                                <TextBlock Classes="fieldValue" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasEndpointAddress}" Text="&#x2014;" />
                                <Button Classes="inline-action" IsVisible="{Binding HasEndpointAddress}"
                                        Command="{Binding CopyEndpointCommand}"
                                        ToolTip.Tip="{loc:Loc application_deployments.copy_address}"
                                        Content="{loc:Loc common.copy}" />
                                <Button Classes="inline-action" IsVisible="{Binding CanOpenEndpoint}"
                                        Command="{Binding OpenEndpointCommand}"
                                        ToolTip.Tip="{loc:Loc application_deployments.open_address}"
                                        Content="{loc:Loc common.open}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="fieldLabel"
                                           Text="{loc:Loc application_deployments.field.container_port}" />
                                <TextBlock Classes="fieldValue fieldMono" FontSize="12"
                                           Text="{Binding ContainerPortText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                            <TextBlock Classes="fieldLabel"
                                       Text="{loc:Loc application_deployments.field.readiness}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding IsReadinessHealthy, Converter={x:Static dconv:FlagTextConverter.Instance}, ConverterParameter=&#x2713;|&#x25CB;}"
                                           Foreground="{Binding IsReadinessHealthy, Converter={x:Static dconv:FlagBrushConverter.Instance}, ConverterParameter=SuccessBrush|TextTertiaryBrush}" />
                                <TextBlock Classes="fieldValue" FontSize="12" Text="{Binding ReadinessText}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                            <TextBlock Classes="fieldLabel"
                                       Text="{loc:Loc application_deployments.field.container}" />
                            <TextBlock Classes="fieldValue fieldMono" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding ContainerText}"
                                       Text="{Binding ContainerText}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                            <TextBlock Classes="fieldLabel"
                                       Text="{loc:Loc application_deployments.field.desired}" />
                            <TextBlock Classes="fieldValue"
                                       Text="{Binding SelectedApplication.DesiredText}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Classes="fieldLabel"
                                       Text="{loc:Loc application_deployments.field.domain}" />
                            <TextBlock Classes="fieldValue" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding DomainText}"
                                       Text="{Binding DomainText}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"
                                    IsVisible="{Binding HasSelectedDrift}">
                            <TextBlock Classes="fieldLabel"
                                       Text="{loc:Loc application_deployments.field.drift}" />
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding SelectedDriftText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Actions. Only the lifecycle buttons that apply to the observed state are offered,
                     so an operator never has to work out whether start or stop is the live one. The
                     infrequent and destructive ones move into the overflow menu. -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="20,14,20,0">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6"
                               VerticalAlignment="Center">
                        <Button Classes="primary" Content="{loc:Loc application_deployments.deploy_revision}"
                                Command="{Binding DeployRevisionCommand}" IsEnabled="{Binding CanManage}" />
                        <Button Content="{loc:Loc application_deployments.edit_definition}"
                                Command="{Binding EditDefinitionCommand}" IsEnabled="{Binding CanManage}" />
                        <Button Content="{loc:Loc application_deployments.restart}"
                                IsVisible="{Binding ShowRestartAction}"
                                Command="{Binding RestartApplicationCommand}"
                                IsEnabled="{Binding CanControlLifecycle}" />
                        <Button Content="{loc:Loc application_deployments.stop}"
                                IsVisible="{Binding ShowStopAction}"
                                Command="{Binding StopApplicationCommand}"
                                IsEnabled="{Binding CanControlLifecycle}" />
                        <Button Content="{loc:Loc application_deployments.start}"
                                IsVisible="{Binding ShowStartAction}"
                                Command="{Binding StartApplicationCommand}"
                                IsEnabled="{Binding CanControlLifecycle}" />
                    </WrapPanel>

                    <Button Grid.Column="1" Classes="inline-action" VerticalAlignment="Center" FontSize="16"
                            Content="&#x22EF;"
                            ToolTip.Tip="{loc:Loc application_deployments.more_actions}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:Loc application_deployments.rollback}"
                                          Command="{Binding RollbackCommand}"
                                          IsEnabled="{Binding CanRollback}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc application_deployments.delete}"
                                          Command="{Binding DeleteApplicationCommand}"
                                          IsEnabled="{Binding CanManage}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- 4. A rule, not more whitespace: it separates "what this instance is" from "what
                     has happened to it" without adding a third competing surface. -->
                <Border Grid.Row="3" Height="1" Margin="20,14,20,0"
                        Background="{DynamicResource BorderSubtleBrush}" />

                <TabControl Grid.Row="4" Margin="14,8,14,12">
                    <TabItem Header="{loc:Loc application_deployments.tab.revisions}">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Grid.Row="0" Text="{loc:Loc application_deployments.revisions_hint}"
                                       FontSize="12" TextWrapping="Wrap" Margin="8,4,8,8"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <ListBox Grid.Row="1" ItemsSource="{Binding Revisions}"
                                     SelectedItem="{Binding SelectedRevision}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:RevisionRowViewModel">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,6">
                                            <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontWeight="SemiBold"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding ImageText}" FontSize="12" TextWrapping="Wrap"
                                                               ToolTip.Tip="{Binding ImageTooltip}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{loc:Loc application_deployments.revision_current}"
                                                               FontSize="11" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsCurrent}"
                                                               Foreground="{DynamicResource SuccessBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding TemplateText}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding EntryText}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding ConfigurationText}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding VolumesText}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding CreatedText}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding ProblemText}" FontSize="11" TextWrapping="Wrap"
                                                           IsVisible="{Binding HasProblem}"
                                                           Foreground="{DynamicResource DangerBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem Header="{loc:Loc application_deployments.tab.operations}">
                        <ListBox ItemsSource="{Binding Operations}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:OperationRowViewModel">
                                    <StackPanel Spacing="2" Margin="4,6">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding KindText}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding StateText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding StageText}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding ProgressText}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding RevisionText}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding StartedText}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding FinishedText}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding IdentifierText}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ProblemText}" FontSize="12" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasProblem}"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <!-- A recovery outcome is reported on its own line, next to the original failure. -->
                                        <TextBlock Text="{Binding RecoveryText}" FontSize="12" TextWrapping="Wrap"
                                                   IsVisible="{Binding HasRecoveryProblem}"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                        <!-- The failed step's own output, loaded on demand: a problem code
                                             names a failure, but only the command's text explains it. -->
                                        <Button Content="{loc:Loc application_deployments.load_diagnostics}"
                                                Command="{Binding LoadDiagnosticsCommand}"
                                                IsVisible="{Binding ShowDiagnosticsAction}"
                                                IsEnabled="{Binding !IsLoadingDiagnostics}"
                                                HorizontalAlignment="Left" Padding="10,3" FontSize="11" />
                                        <StackPanel Spacing="4" IsVisible="{Binding HasDiagnostics}">
                                            <TextBox Text="{Binding DiagnosticsText}" IsReadOnly="True" AcceptsReturn="True"
                                                     TextWrapping="NoWrap" Height="180"
                                                     FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                            <TextBlock Text="{loc:Loc application_deployments.log_truncated}"
                                                       IsVisible="{Binding IsDiagnosticsTruncated}" FontSize="11"
                                                       Foreground="{DynamicResource WarningBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>

                    <TabItem Header="{loc:Loc application_deployments.tab.logs}">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="8,4,8,8">
                                <TextBlock Text="{loc:Loc application_deployments.log_tail}"
                                           VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox Text="{Binding LogTailText}" Width="80" FontSize="12" />
                                <Button Content="{loc:Loc application_deployments.load_logs}"
                                        Command="{Binding LoadLogsCommand}" Padding="12,5" />
                                <TextBlock Text="{loc:Loc application_deployments.log_truncated}"
                                           IsVisible="{Binding IsLogTruncated}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{loc:Loc application_deployments.log_empty}"
                                       IsVisible="{Binding !HasLog}" Margin="8"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBox Grid.Row="2" Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="NoWrap" Margin="8,0,8,10"
                                     FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <TextBlock Grid.Column="1" Text="{loc:Loc application_deployments.no_selection}"
                       IsVisible="{Binding !HasSelection}"
                       Margin="24" TextWrapping="Wrap" VerticalAlignment="Top"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </Grid>
    </Grid>
</UserControl>
