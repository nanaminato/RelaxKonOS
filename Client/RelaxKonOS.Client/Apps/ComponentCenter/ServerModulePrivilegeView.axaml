<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:RelaxKonOS.Client.Apps.ComponentCenter" xmlns:loc="using:RelaxKonOS.Client.Localization"
 x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ServerModulePrivilegeView" x:DataType="vm:ServerModulesViewModel"
 Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
 <!-- Privilege approval is a single task: name a plan, read what the host froze, then approve or
      refuse it. Administrator credentials live here because approving is the only thing that uses
      them, instead of sitting permanently on the security page. -->
 <UserControl.Styles>
  <StyleInclude Source="avares://RelaxKonOS.Client/Apps/ComponentCenter/ComponentCenterStyles.axaml" />
 </UserControl.Styles>
 <Grid RowDefinitions="*,Auto">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,18">
   <StackPanel Spacing="14">
    <TextBlock Classes="section-hint" Text="{loc:Loc server_modules.privilege_hint}" />

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
     <TextBox Text="{Binding PrivilegePlanId, Mode=TwoWay}" PlaceholderText="{loc:Loc server_modules.privilege_plan_id}" />
     <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc server_modules.privilege_load}"
             Command="{Binding LoadPrivilegeCommand}" VerticalAlignment="Center" />
    </Grid>

    <Border Classes="inset-block" IsVisible="{Binding HasPrivilegePlan}">
     <TextBlock Text="{Binding PrivilegeText}" TextWrapping="Wrap" FontSize="11" Classes="mono"
                LineHeight="17" Foreground="{DynamicResource TextSecondaryBrush}" />
    </Border>
    <TextBlock Text="{loc:Loc server_modules.privilege_none}" FontSize="12" IsVisible="{Binding !HasPrivilegePlan}"
               Foreground="{DynamicResource TextTertiaryBrush}" />

    <Border Classes="rule" />

    <StackPanel Spacing="6">
     <TextBlock Classes="field-label" Text="{loc:Loc server_modules.credentials.title}" />
     <TextBlock Classes="section-hint" Text="{loc:Loc server_modules.credentials.hint}" />
     <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
      <TextBox Text="{Binding PrivilegeAdministrator, Mode=TwoWay}" PlaceholderText="{loc:Loc server_modules.privilege_administrator}" />
      <TextBox Grid.Column="1" Text="{Binding PrivilegePassword, Mode=TwoWay}" PasswordChar="●"
               PlaceholderText="{loc:Loc server_modules.privilege_password}" />
     </Grid>
    </StackPanel>

    <Border Classes="notice bad" IsVisible="{Binding HasStatus}">
     <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" />
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="20,14,20,16">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <Button Classes="ghost-action" Content="{loc:Loc server_modules.privilege_cancel}"
            Command="{Binding CancelPrivilegeCommand}" HorizontalAlignment="Left" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
     <Button Classes="ghost-action" Content="{loc:Loc common.close}" Click="Close_Click" />
     <Button Classes="primary" Content="{loc:Loc server_modules.privilege_approve}"
             Command="{Binding ApprovePrivilegeCommand}" />
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
