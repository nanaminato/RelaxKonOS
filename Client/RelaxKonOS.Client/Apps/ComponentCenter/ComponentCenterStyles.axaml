<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- One visual vocabulary for the whole component workspace: the browsing page, the task dialog
       and the server-module page. It is scoped by inclusion, so nothing here changes any other
       application. Every colour is a semantic role; no page invents a literal grey. -->

  <!-- ── Type scale ──
       Three steps only: a heading for a surface, a body for facts, a label for what a value means.
       Keeping the count low is what makes a long page scan rather than shout. -->
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section-hint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.body-text">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="TextBlock.field-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.field-value">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace" />
  </Style>
  <Style Selector="TextBlock.rail-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.problem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ── Surfaces ──
       A page is a column of one surface: a raised card with a hairline edge and a generous corner.
       Rows separated by rules are used inside a card instead of a nested card, because two nested
       edges at 12px read as a table of boxes rather than a single section. -->
  <Style Selector="Border.panel-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20,18" />
  </Style>
  <Style Selector="Border.inset-block">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>
  <!-- The runtime page is a shared view: inside this workspace its own panels take the same corner
       and edge as every other card here, so a component page never mixes two card shapes. -->
  <Style Selector="Border.app-panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- ── Pills ──
       A pill states one measured fact. Its tone is carried by a muted background plus the matching
       text role, so a status stays legible at 11px in both themes instead of relying on hue alone. -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.pill.ok"><Setter Property="Background" Value="{DynamicResource SuccessMutedBrush}" /></Style>
  <Style Selector="Border.pill.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Border.pill.warn"><Setter Property="Background" Value="{DynamicResource WarningMutedBrush}" /></Style>
  <Style Selector="Border.pill.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.pill.bad"><Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" /></Style>
  <Style Selector="Border.pill.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.pill.accent"><Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" /></Style>
  <Style Selector="Border.pill.accent TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>

  <!-- ── Secondary commands ──
       A bordered command sits in a heading row without competing with the page's own primary action.
       Every command in this workspace is one height, so a primary and a secondary command on the
       same line share a baseline instead of stepping by the difference between two type sizes. -->
  <Style Selector="Button.ghost-action">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.ghost-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="Button.ghost-action:pressed">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="Button.ghost-action:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- The one committing action on a card keeps the accent role, but at the same height as the
       secondary commands beside it, so a row of commands reads as one line instead of a stack. -->
  <Style Selector="Button.primary">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- A disabled command keeps the same outline as an enabled one and loses only its ink, so a row
       of commands reads as "these three are unavailable" instead of one filled chip beside two gaps. -->
  <Style Selector="Button.primary:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextDisabledBrush}" />
  </Style>
  <!-- The narrow-layout switch for the navigation: a command, not a checked toggle button. It owns
       its own template because the theme's checked state paints the raw accent, which would read as
       the page's primary action at the top of an otherwise quiet page. -->
  <Style Selector="ToggleButton.nav-toggle">
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.nav-toggle:checked">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.nav-toggle:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <!-- A command on top of a warning surface keeps a surface of its own, so it never reads as text. -->
  <Style Selector="Button.on-notice">
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.on-notice:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <!-- ── Fields ──
       A field is a sunken well rather than an outlined box: the page already has a card edge, and a
       second outline next to it reads as a control that failed to render. -->
  <Style Selector="TextBox.search-field">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBox.search-field:not(:focus) /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.search-field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
  </Style>

  <!-- ── Navigation rail ──
       The selected page keeps the accent role on both its label and its background, and keeps it
       while hovered or pressed, so the current page is never mistaken for a transient pointer state. -->
  <Style Selector="ListBox.page-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.page-nav > ListBoxItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.page-nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.page-nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- ── Catalog tree ──
       A row is a name and, underneath it, the one measured state that name is in. Category rows are
       labels, not rows with a state, so they never reserve the second line. -->
  <Style Selector="TreeView.tree-compact">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TreeView.tree-compact TreeViewItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0,1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- ── Disclosure ──
       An expander inside this workspace is a heading that can be opened, not a box: the whole
       expander and its header toggle own no surface of their own, so an opened section shows one
       card rather than a frame around a card, and a closed one is a single quiet line. -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="2,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <!-- The chevron must be able to turn inside its slot: a tight header would clip the rotated mark
       into a corner instead of an arrow. The header's own surface element is cleared too, otherwise
       a hairline survives under a header that is supposed to be a plain line of text. -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ExpandCollapseChevronBorder">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ClipToBounds" Value="False" />
    <!-- No turning animation: a preview render can land mid-rotation and photograph a clipped
         corner instead of an arrow, which reads as a broken control. -->
    <Setter Property="Transitions" Value="{x:Null}" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,8,0,0" />
  </Style>

  <!-- ── Server-module page ──
       The module page is a master-detail workspace. Counts, state dots, selected rows and frozen
       plans each have one shape, so a module's state is read the same way in the list and in the
       detail pane. These selectors are scoped to the component-center stylesheet. -->
  <Style Selector="TextBlock.metric-value">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.stat-strip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Border.stat-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="Margin" Value="0,14" />
  </Style>

  <!-- A state dot carries the same tone as a pill without needing a second label. -->
  <Style Selector="Border.dot">
    <Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Border.dot.ok"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Border.dot.warn"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.dot.bad"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.dot.idle"><Setter Property="Background" Value="{DynamicResource TextTertiaryBrush}" /></Style>

  <!-- Page-level tabs: a segmented strip, not a second navigation rail. -->
  <Style Selector="ListBox.sub-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.sub-nav > ListBoxItem">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="13,0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.sub-nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.sub-nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Catalog filters: small pills that always fit above a narrow list. -->
  <Style Selector="ListBox.filter-nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.filter-nav > ListBoxItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="9,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.filter-nav > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.filter-nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Catalog rows: the checkbox is a batch selector; the row itself opens the detail pane. -->
  <Style Selector="ListBox.module-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.module-list > ListBoxItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.module-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.module-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
  </Style>

  <!-- Compact selection lists (versions, store releases, standing permissions). -->
  <Style Selector="ListBox.compact-list">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.compact-list > ListBoxItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.compact-list > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.compact-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
  </Style>

  <!-- A notice is a sentence with an icon slot, not a nested card. -->
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.notice.warn">
    <Setter Property="Background" Value="{DynamicResource WarningMutedBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Border.notice.bad">
    <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
  </Style>

  <!-- The frozen plan is the one surface that asks for a decision, so it carries the accent edge. -->
  <Style Selector="Border.plan-card">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20,18" />
  </Style>

  <Style Selector="Border.list-row">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,9" />
  </Style>
</Styles>
