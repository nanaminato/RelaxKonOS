<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:RelaxKonOS.Client.Apps.ComponentCenter" xmlns:loc="using:RelaxKonOS.Client.Localization"
 xmlns:mp="using:RelaxKonOS.ModuleHost.Protocol" xmlns:conv="using:Avalonia.Data.Converters"
 x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ServerModuleConsentView" x:DataType="vm:ServerModulesViewModel"
 Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
 <!-- Standing background permission is a review task, not a form to fill on every page visit:
      one module, one declared action, one exact target, one deadline. -->
 <UserControl.Styles>
  <StyleInclude Source="avares://RelaxKonOS.Client/Apps/ComponentCenter/ComponentCenterStyles.axaml" />
 </UserControl.Styles>
 <Grid RowDefinitions="*,Auto">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,18">
   <StackPanel Spacing="14">
    <TextBlock Classes="section-hint" Text="{loc:Loc server_modules.consent_summary}" />

    <Border Classes="inset-block">
     <StackPanel Spacing="2">
      <TextBlock Classes="field-label" Text="{loc:Loc server_modules.consent.module}" />
      <TextBlock Text="{Binding ConsentModuleText}" FontSize="12" TextWrapping="Wrap" />
     </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
     <ComboBox ItemsSource="{Binding ConsentKinds}" SelectedItem="{Binding ConsentKind, Mode=TwoWay}" HorizontalAlignment="Stretch"
               IsEnabled="{Binding CanPrepareConsent}">
      <ComboBox.ItemTemplate>
       <DataTemplate x:DataType="vm:ServerModuleConsentKindChoice"><TextBlock Text="{Binding Label}" /></DataTemplate>
      </ComboBox.ItemTemplate>
     </ComboBox>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <TextBlock Text="{loc:Loc server_modules.consent_hours}" VerticalAlignment="Center" FontSize="11"
                 Foreground="{DynamicResource TextTertiaryBrush}" />
      <NumericUpDown Value="{Binding ConsentHours, Mode=TwoWay}" Minimum="0.01" Maximum="720" Increment="1" Width="110" />
     </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
     <TextBox Text="{Binding ConsentTarget, Mode=TwoWay}" PlaceholderText="{loc:Loc server_modules.consent_target}" />
     <TextBox Grid.Column="1" Text="{Binding ConsentReason, Mode=TwoWay}" PlaceholderText="{loc:Loc server_modules.consent_reason}" />
    </Grid>
    <TextBox x:Name="ConsentContentDigest" Text="{Binding ConsentContentSha256, Mode=TwoWay}"
             PlaceholderText="{loc:Loc server_modules.consent_content_sha256}" IsVisible="{Binding ShowConsentContentSha256}" />

    <WrapPanel ItemSpacing="8" LineSpacing="8">
     <Button Classes="ghost-action" Content="{loc:Loc server_modules.consent_prepare}" Command="{Binding PrepareConsentCommand}" />
     <Button Classes="ghost-action" Content="{loc:Loc server_modules.consent_approve}" Command="{Binding ApproveConsentCommand}" />
     <Button Classes="ghost-action" Content="{loc:Loc server_modules.consent_refresh}" Command="{Binding RefreshConsentsCommand}"
             IsEnabled="{Binding CanManage}" />
     <Button Classes="ghost-action" Content="{loc:Loc server_modules.consent_revoke}" Command="{Binding RevokeConsentCommand}" />
    </WrapPanel>

    <Border Classes="notice bad" IsVisible="{Binding HasStatus}">
     <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" />
    </Border>
    <Border Classes="inset-block" IsVisible="{Binding ConsentText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
     <TextBlock Text="{Binding ConsentText}" TextWrapping="Wrap" FontSize="11" Classes="mono" LineHeight="17" />
    </Border>

    <StackPanel Spacing="6">
     <TextBlock Classes="field-label" Text="{Binding ConsentCountText}" />
     <ListBox Classes="compact-list" ItemsSource="{Binding Consents}" SelectedItem="{Binding SelectedConsent, Mode=TwoWay}" MaxHeight="220">
      <ListBox.ItemTemplate>
       <DataTemplate x:DataType="mp:ModulePrivilegeConsent">
        <StackPanel Spacing="2">
         <TextBlock Text="{Binding ModuleId}" FontSize="12" FontWeight="SemiBold" />
         <TextBlock Text="{Binding Target}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
         <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
   </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="20,14,20,16">
   <Button Classes="ghost-action" Content="{loc:Loc common.close}" Click="Close_Click" HorizontalAlignment="Right" />
  </Border>
 </Grid>
</UserControl>
