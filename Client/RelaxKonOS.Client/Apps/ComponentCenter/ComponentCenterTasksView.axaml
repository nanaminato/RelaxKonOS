<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:web="clr-namespace:RelaxKonOS.Client.Apps.WebServers.Views" xmlns:mr="clr-namespace:RelaxKonOS.Protocol.ManagedRuntimes;assembly=RelaxKonOS.Protocol" xmlns:loc="using:RelaxKonOS.Client.Localization" xmlns:views="using:RelaxKonOS.Client.Apps.ProxyServer.Views" xmlns:vm="using:RelaxKonOS.Client.Apps.ComponentCenter" x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ComponentCenterTasksView" x:DataType="vm:ComponentCenterViewModel" Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
 <!-- The same vocabulary as the browsing page: one heading per section, tone-coloured pills, and the
      decision row pinned to the bottom so a long plan never pushes it out of view. -->
 <UserControl.Styles>
  <StyleInclude Source="avares://RelaxKonOS.Client/Apps/ComponentCenter/ComponentCenterStyles.axaml" />
  <Style Selector="Border.step">
   <Setter Property="Padding" Value="0,9" />
   <Setter Property="BorderThickness" Value="0,1,0,0" />
   <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
  </Style>
  <Style Selector="TextBlock.step-title">
   <Setter Property="FontSize" Value="13" />
   <Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
 </UserControl.Styles>
 <Grid RowDefinitions="*,Auto,Auto">
  <ScrollViewer x:Name="DetailsScroll" HorizontalScrollBarVisibility="Disabled" Padding="20,18">
   <StackPanel Spacing="14">
    <Border Classes="panel-card">
     <StackPanel Spacing="12">
      <StackPanel Spacing="3">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.task_dialog.batch}" />
       <TextBlock Classes="section-hint" Text="{loc:Loc component_center.task_dialog.scope}" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
       <ComboBox ItemsSource="{Binding TaskWorkloads}" SelectedItem="{Binding TaskWorkload}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentTreeNode">
          <TextBlock Text="{Binding Label}" />
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
       <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc component_center.stage_workload}"
               Command="{Binding AddTaskWorkloadCommand}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Classes="problem" Text="{Binding Notice}" IsVisible="{Binding !Notice.IsEmpty}" />
      <ItemsControl ItemsSource="{Binding BatchComponents}" Classes="step-list">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComponentTreeNode">
         <Border Classes="step">
          <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" />
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>

    <Border Classes="panel-card" IsVisible="{Binding ShowInspection}">
     <StackPanel Spacing="12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
       <StackPanel Spacing="3">
        <TextBlock Classes="section-title" Text="{loc:Loc component_center.inspect_title}" />
        <TextBlock Classes="section-hint" Text="{loc:Loc component_center.inspect_hint}" />
       </StackPanel>
       <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc component_center.inspect}"
               Command="{Binding InspectCommand}" IsEnabled="{Binding CanInspect}" VerticalAlignment="Center" />
      </Grid>
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInspecting}" />
      <TextBlock Text="{Binding InspectionNotice}" TextWrapping="Wrap" FontSize="12"
                 IsVisible="{Binding !InspectionNotice.IsEmpty}" />
      <ItemsControl ItemsSource="{Binding InspectionSteps}" Classes="step-list">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComponentInspectionStep">
         <Border Classes="step">
          <StackPanel Spacing="3">
           <TextBlock Classes="step-title" Text="{Binding Title}" />
           <TextBlock Text="{Binding State}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
           <TextBlock Text="{Binding Effects}" TextWrapping="Wrap" FontSize="12" />
           <TextBlock Classes="problem" Text="{Binding Problems}" />
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>

    <Border Classes="panel-card" IsVisible="{Binding ShowBatchPlanPanel}">
     <StackPanel Spacing="12">
      <StackPanel Spacing="3">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.change_plan_title}" />
       <TextBlock Classes="section-hint" Text="{loc:Loc component_center.change_plan_hint}" />
      </StackPanel>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
       <Button Classes="primary" Content="{loc:Loc component_center.change_plan_title}" Command="{Binding PlanDraftCommand}" IsEnabled="{Binding CanPlanDraft}" />
       <Button Classes="ghost-action" Content="{loc:Loc component_center.task_approve}" Command="{Binding ApproveTaskCommand}" IsEnabled="{Binding CanApproveTask}" />
      </WrapPanel>
      <TextBlock Text="{Binding ChangePlanNotice}" TextWrapping="Wrap" FontSize="12"
                 IsVisible="{Binding !ChangePlanNotice.IsEmpty}" />
      <TextBlock Text="{Binding ChangePlanDigest}" TextWrapping="Wrap" Classes="mono" FontSize="11"
                 Foreground="{DynamicResource TextTertiaryBrush}" />
      <ItemsControl ItemsSource="{Binding ChangePlanSteps}" Classes="step-list">
       <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ComponentInspectionStep">
         <Border Classes="step">
          <StackPanel Spacing="3">
           <TextBlock Classes="step-title" Text="{Binding Title}" />
           <TextBlock Text="{Binding State}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
           <TextBlock Text="{Binding Effects}" TextWrapping="Wrap" FontSize="12" />
           <TextBlock Classes="problem" Text="{Binding Problems}" />
          </StackPanel>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>

    <StackPanel IsVisible="{Binding ShowRuntimeTaskActivity}">
     <views:ProxyServerRuntimeView x:Name="TaskRuntimeView" DataContext="{Binding DetailRuntime}" />
    </StackPanel>

    <Border Classes="panel-card" IsVisible="{Binding ShowTasks}">
     <StackPanel Spacing="12">
      <StackPanel Spacing="3">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.task_title}" />
       <TextBlock Text="{loc:Loc component_center.task_dialog.empty}" IsVisible="{Binding !HasTaskHistory}" Classes="section-hint" />
      </StackPanel>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding HasTaskHistory}">
       <ComboBox ItemsSource="{Binding TaskHistory}" SelectedItem="{Binding SelectedTask}" IsEnabled="{Binding CanSelectTask}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentTaskHistoryItem">
          <TextBlock Text="{Binding Title}" />
         </DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
       <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc component_center.task_reload}"
               Command="{Binding ReloadTaskHistoryCommand}" IsEnabled="{Binding CanSelectTask}" VerticalAlignment="Center" />
      </Grid>
      <StackPanel IsVisible="{Binding HasTaskHistory}" Spacing="12">
       <TextBlock Text="{Binding TaskState}" TextWrapping="Wrap" FontSize="12" />
       <Border Classes="inset-block" IsVisible="{Binding ShowTaskResult}">
        <StackPanel Spacing="6">
         <TextBlock Classes="field-label" Text="{loc:Loc component_center.result_title}" />
         <TextBlock Text="{Binding TaskResultSummary}" TextWrapping="Wrap" FontSize="12" />
         <TextBlock Text="{Binding TaskResultIdentity}" TextWrapping="Wrap" FontSize="11" Classes="mono"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
         <TextBlock Text="{loc:Loc component_center.result_evidence_hint}" TextWrapping="Wrap" FontSize="11"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
       </Border>
       <TextBlock Text="{Binding Runtime.OperationText}" IsVisible="{Binding ShowTaskDomainProgress}" TextWrapping="Wrap" FontSize="12" />
       <StackPanel IsVisible="{Binding ShowTaskDomainProgress}" Spacing="6">
        <TextBlock Classes="field-label" Text="{loc:Loc component_center.stage_progress}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Runtime.OperationProgress}" IsIndeterminate="{Binding Runtime.IsOperationIndeterminate}" />
        <TextBlock Text="{Binding Runtime.OperationProgress, StringFormat={}{0}%}" FontSize="11" IsVisible="{Binding !Runtime.IsOperationIndeterminate}"
                   Foreground="{DynamicResource TextTertiaryBrush}" />
       </StackPanel>
       <TextBlock Text="{Binding TaskNotice}" TextWrapping="Wrap" FontSize="12"
                  IsVisible="{Binding !TaskNotice.IsEmpty}" />
       <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Classes="ghost-action" Content="{loc:Loc component_center.evidence_read}" Command="{Binding ReadTaskEvidenceCommand}" IsEnabled="{Binding CanReadTaskEvidence}" />
        <Button Classes="ghost-action" Content="{loc:Loc component_center.task_refresh}" Command="{Binding RefreshTaskCommand}" IsEnabled="{Binding CanRefreshTask}" />
        <Button Classes="ghost-action" Content="{loc:Loc component_center.task_resume}" Command="{Binding ResumeTaskCommand}" IsEnabled="{Binding CanResumeTask}" />
        <Button Classes="ghost-action" Content="{loc:Loc component_center.task_cancel}" Command="{Binding CancelTaskCommand}" IsEnabled="{Binding CanCancelTask}" />
       </WrapPanel>
       <ItemsControl ItemsSource="{Binding TaskEvidence}">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentTaskEvidenceItem">
          <Border Classes="inset-block" Margin="0,4">
           <StackPanel Spacing="4">
            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" FontSize="12" />
            <TextBlock Text="{Binding Operation}" TextWrapping="Wrap" FontSize="11" Classes="mono" />
            <TextBlock Text="{Binding DomainState}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Observation}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Receipt}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Commit}" TextWrapping="Wrap" FontSize="12" />
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTaskBusy}" />
       <Button Classes="ghost-action" Content="{loc:Loc component_center.task_recheck_recovery}"
               Command="{Binding RecheckTaskRecoveryCommand}" IsVisible="{Binding CanRecheckTaskRecovery}" HorizontalAlignment="Left" />
       <Border Classes="inset-block" IsVisible="{Binding HasTaskRecovery}">
        <StackPanel Spacing="8">
         <TextBlock Text="{Binding TaskRecoverySummary}" TextWrapping="Wrap" FontSize="12" />
         <TextBlock Text="{Binding RecoveryServiceState}" TextWrapping="Wrap" FontSize="12" />
         <TextBlock Text="{Binding RecoveryVersions}" TextWrapping="Wrap" FontSize="12" />
         <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="ghost-action" Content="{loc:Loc component_center.task_recovery_read}" Command="{Binding ReadTaskRecoveryCommand}" IsEnabled="{Binding CanReadTaskRecovery}" />
          <Button Classes="ghost-action" Content="{loc:Loc component_center.task_recovery_action.RetryCompensation}" Command="{Binding RetryTaskCompensationCommand}" IsEnabled="{Binding CanRetryTaskCompensation}" />
          <Button Classes="ghost-action" Content="{loc:Loc component_center.task_recovery_action.EmergencyStop}" Command="{Binding StopTaskRecoveryCommand}" IsEnabled="{Binding CanStopTaskRecovery}" />
          <Button Classes="ghost-action" Content="{loc:Loc component_center.task_recovery_action.Close}" Command="{Binding CloseTaskRecoveryCommand}" IsEnabled="{Binding CanCloseTaskRecovery}" />
         </WrapPanel>
         <ItemsControl ItemsSource="{Binding RecoveryAttempts}">
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="vm:ComponentRecoveryAttemptItem">
            <StackPanel Spacing="3" Margin="0,4">
             <TextBlock Text="{Binding Action}" FontWeight="SemiBold" FontSize="12" />
             <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="12" />
             <TextBlock Text="{Binding Identity}" FontSize="11" Classes="mono" TextWrapping="Wrap"
                        Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
       <ItemsControl ItemsSource="{Binding TaskSteps}" Classes="step-list">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentTaskStepItem">
          <Border Classes="step">
           <StackPanel Spacing="3">
            <TextBlock Classes="step-title" Text="{Binding Title}" />
            <TextBlock Text="{Binding State}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding Operation}" IsVisible="{Binding HasOperation}" TextWrapping="Wrap" FontSize="11" Classes="mono" />
            <TextBlock Text="{Binding DataImpact}" IsVisible="{Binding HasDataImpact}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Classes="problem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Border x:Name="DraftFooter" Grid.Row="1" Padding="20,12" BorderThickness="0,1,0,0"
          BorderBrush="{DynamicResource BorderSubtleBrush}" Background="{DynamicResource SurfaceRaisedBrush}"
          IsVisible="{Binding ShowDraftPanel}">
   <ScrollViewer x:Name="DraftFooterScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="10">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
       <TextBlock Text="{Binding DraftSummary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
       <TextBlock Text="{Binding PersistenceNotice}" TextWrapping="Wrap" FontSize="11"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button x:Name="PreviewChanges" Classes="primary" Content="{loc:Loc component_center.preview_title}"
               Command="{Binding PlanDraftCommand}" IsEnabled="{Binding CanPlanDraft}" />
       <Button x:Name="DiscardChanges" Classes="ghost-action" Content="{loc:Loc component_center.discard}"
               Command="{Binding DiscardCommand}" IsEnabled="{Binding HasDrafts}" />
      </StackPanel>
     </Grid>
     <ItemsControl ItemsSource="{Binding Drafts}" MaxHeight="130">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="vm:ComponentDraftItem">
        <Border Classes="inset-block" Margin="0,2" Padding="12,8">
         <DockPanel>
          <Button DockPanel.Dock="Right" Classes="ghost-action" Content="{loc:Loc component_center.remove}" Click="RemoveDraft_Click" />
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0" />
         </DockPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Border>

  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="20,10">
   <TextBlock Text="{loc:Loc component_center.task_dialog.close_hint}" TextWrapping="Wrap" FontSize="11"
              Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
   <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc common.close}" Click="Close_Click" IsEnabled="{Binding CanCloseTaskDialog}" />
  </Grid>
 </Grid>
</UserControl>
