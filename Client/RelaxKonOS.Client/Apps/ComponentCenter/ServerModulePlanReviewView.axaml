<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:RelaxKonOS.Client.Apps.ComponentCenter" xmlns:loc="using:RelaxKonOS.Client.Localization"
 x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ServerModulePlanReviewView" x:DataType="vm:ServerModulesViewModel"
 Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
 <!-- The frozen plan is a decision, so it is its own surface with the decision pinned to the
      bottom. Everything above is read-only: exactly what the server froze, never a summary the
      client recomputed. Both plan kinds share the shell because both answer the same question. -->
 <UserControl.Styles>
  <StyleInclude Source="avares://RelaxKonOS.Client/Apps/ComponentCenter/ComponentCenterStyles.axaml" />
 </UserControl.Styles>
 <Grid RowDefinitions="*,Auto">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="20,18">
   <StackPanel Spacing="14">
    <TextBlock Classes="section-hint" Text="{loc:Loc server_modules.plan.hint}" />

    <!-- ── Module lifecycle plan ── -->
    <Border Classes="plan-card" IsVisible="{Binding HasPlan}">
     <StackPanel Spacing="12">
      <WrapPanel ItemSpacing="8" LineSpacing="6">
       <Border Classes="pill accent"><TextBlock Text="{Binding PlanActionText}" /></Border>
       <Border Classes="pill"><TextBlock Text="{Binding PlanRestartText}" /></Border>
       <TextBlock Text="{Binding PlanExpiresText}" FontSize="11" VerticalAlignment="Center"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
      </WrapPanel>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
       <StackPanel Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.plan.targets}" />
        <TextBlock Classes="field-value" Text="{Binding PlanTargetText}" TextWrapping="Wrap" />
       </StackPanel>
       <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.plan.service}" />
        <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding PlanServiceText}" TextWrapping="Wrap" />
       </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
       <StackPanel Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.plan.added}" />
        <TextBlock Classes="field-value" Text="{Binding PlanAddedText}" TextWrapping="Wrap" />
       </StackPanel>
       <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.plan.removed}" />
        <TextBlock Classes="field-value" Text="{Binding PlanRemovedText}" TextWrapping="Wrap" />
       </StackPanel>
      </Grid>
      <Border Classes="notice" IsVisible="{Binding PlanIsRemoval}">
       <TextBlock Text="{loc:Loc server_modules.plan.remove_data}" TextWrapping="Wrap" FontSize="12" />
      </Border>
      <Border Classes="notice bad" IsVisible="{Binding HasPlanBlockers}">
       <StackPanel Spacing="4">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.plan.blocked}" />
        <TextBlock Text="{Binding PlanBlockedText}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
       </StackPanel>
      </Border>
     </StackPanel>
    </Border>

    <!-- ── Module package plan ── -->
    <Border Classes="plan-card" IsVisible="{Binding HasPackagePlan}">
     <StackPanel Spacing="12">
      <WrapPanel ItemSpacing="8" LineSpacing="6">
       <Border Classes="pill accent"><TextBlock Text="{Binding PackagePlanModuleText}" Classes="mono" FontSize="11" /></Border>
       <TextBlock Text="{Binding PackagePlanExpiresText}" FontSize="11" VerticalAlignment="Center"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
      </WrapPanel>
      <StackPanel Spacing="3">
       <TextBlock Text="{Binding PackagePlanTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding PackagePlanSummary}" TextWrapping="Wrap" FontSize="12"
                  Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="10">
       <StackPanel Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.package_plan.version}" />
        <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding PackagePlanVersionText}" />
       </StackPanel>
       <StackPanel Grid.Column="1" Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.package_plan.publisher}" />
        <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding PackagePlanPublisherText}" TextWrapping="Wrap" />
       </StackPanel>
       <StackPanel Grid.Row="1" Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.package_plan.release}" />
        <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding PackagePlanReleaseText}" TextWrapping="Wrap" />
       </StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.package_plan.digest}" />
        <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding PackagePlanDigestText}" />
       </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
       <StackPanel Spacing="2">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.package_plan.runtime}" />
        <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding PackagePlanRuntimeText}" />
       </StackPanel>
       <StackPanel Grid.Column="1" Spacing="2" IsVisible="{Binding HasPackagePlanPrivileges}">
        <TextBlock Classes="field-label" Text="{loc:Loc server_modules.package_plan.privileges}" />
        <TextBlock Text="{Binding PackagePlanPrivilegesText}" TextWrapping="Wrap" FontSize="11" Classes="mono" />
       </StackPanel>
      </Grid>
     </StackPanel>
    </Border>

    <!-- A failed submission keeps the plan and reports here, inside the surface that is asking
         for the decision, instead of behind the blocked owner window. -->
    <Border Classes="notice bad" IsVisible="{Binding HasStatus}">
     <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" />
    </Border>
   </StackPanel>
  </ScrollViewer>

  <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="20,14,20,16">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
    <ProgressBar IsIndeterminate="True" Height="2" VerticalAlignment="Center" IsVisible="{Binding Busy}" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
     <Button Classes="ghost-action" Content="{loc:Loc server_modules.plan.discard}" Click="Discard_Click" />
     <Button Classes="primary" Content="{loc:Loc server_modules.apply}" Click="ApplyPlan_Click"
             IsVisible="{Binding HasPlan}" IsEnabled="{Binding CanApply}" />
     <Button Classes="primary" Content="{loc:Loc server_modules.apply_package}" Click="ApplyPackage_Click"
             IsVisible="{Binding HasPackagePlan}" IsEnabled="{Binding CanApplyPackagePlan}" />
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</UserControl>
