<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:web="clr-namespace:RelaxKonOS.Client.Apps.WebServers.Views"
 xmlns:mr="clr-namespace:RelaxKonOS.Protocol.ManagedRuntimes;assembly=RelaxKonOS.Protocol"
 xmlns:loc="using:RelaxKonOS.Client.Localization"
 xmlns:views="using:RelaxKonOS.Client.Apps.ProxyServer.Views"
 xmlns:vm="using:RelaxKonOS.Client.Apps.ComponentCenter"
 x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ComponentCenterWorkspace"
 x:DataType="vm:ComponentCenterViewModel" Classes="builtin-app"
 Background="{DynamicResource AppBackgroundBrush}">
 <!-- One vocabulary for the whole page, shared with the task dialog: a quiet surface, one heading per
      section, tone-coloured pills for measured state, and rows separated by rules instead of nested
      frames. Nothing here grants a capability; a disabled action stays visible and explained. -->
 <UserControl.Styles>
  <StyleInclude Source="avares://RelaxKonOS.Client/Apps/ComponentCenter/ComponentCenterStyles.axaml" />
  <!-- The task entry borrows the header's secondary-command shape so the two read as one row. The
       trailing ellipsis is part of the label ("opens a dialog"), so the button keeps a floor width. -->
  <Style Selector="Button.header-tasks">
   <Setter Property="MinWidth" Value="86" />
   <Setter Property="Height" Value="30" />
   <Setter Property="FontSize" Value="12" />
  </Style>
 </UserControl.Styles>

 <Grid RowDefinitions="Auto,*">
  <!-- App bar: identity on the left, exactly one refresh affordance on the right. -->
  <Border Classes="app-header" Padding="20,13">
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
    <Image Width="34" Height="34" VerticalAlignment="Center"
           Source="avares://RelaxKonOS.Client/Assets/AppIcons/component-center.png" />
    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
     <TextBlock Text="{loc:Loc application.relaxkonos.component-center.display_name}" FontSize="17" FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
     <WrapPanel ItemSpacing="8" LineSpacing="4">
      <TextBlock Text="{Binding HostIdentity}" FontSize="12" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
      <Border Classes="pill"><TextBlock Text="{Binding ConnectionText}" /></Border>
      <Border Classes="pill" IsVisible="{Binding HasTargetText}"><TextBlock Classes="mono" Text="{Binding HostTargetText}" /></Border>
     </WrapPanel>
     <TextBlock Text="{Binding HeaderOutcomeText}" TextWrapping="Wrap" IsVisible="{Binding HasHeaderOutcome}"
                FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Name="OpenTasksButton" Classes="ghost-action header-tasks" Command="{Binding OpenTasksCommand}"
             AutomationProperties.Name="{loc:Loc component_center.task_dialog.title}"
             ToolTip.Tip="{loc:Loc component_center.task_dialog.scope}">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
       <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}"
             StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
             Data="M3 6 L5 8 L9 4 M3 12 L5 14 L9 10 M3 18 L5 20 L9 16 M13 6 H21 M13 12 H21 M13 18 H21" />
       <TextBlock Text="{loc:Loc component_center.task_dialog.open}" VerticalAlignment="Center" />
      </StackPanel>
     </Button>
     <Button Classes="header-refresh" Height="30" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc proxy_server.refresh}"
             AutomationProperties.Name="{loc:Loc proxy_server.refresh}" IsEnabled="{Binding Runtime.CanRefreshSources}" />
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1" ColumnDefinitions="288,*" RowDefinitions="Auto,*" x:Name="WorkspaceBody">
   <ToggleButton x:Name="NavigationToggle" Grid.ColumnSpan="2" Classes="nav-toggle"
                 Content="{loc:Loc component_center.navigation_toggle}"
                 IsVisible="False" IsCheckedChanged="NavigationToggle_Changed" Margin="14,10,14,6" HorizontalAlignment="Left" />
   <Border x:Name="NavigationPane" Classes="app-sidebar" Padding="0" Grid.RowSpan="2">
    <!-- Search and the page list stay put; only the catalog scrolls. A single scroller around the
         whole rail used to carry both away as soon as the catalog outgrew the window. -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="10,12,10,12">
      <Grid IsVisible="{Binding !ShowServerModules}" Margin="2,0,2,10">
       <TextBox x:Name="Search" Classes="search-field" Padding="32,6,10,6"
                PlaceholderText="{loc:Loc component_center.search}" Text="{Binding Search, Mode=TwoWay}" />
       <Path Width="14" Height="14" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
             IsHitTestVisible="False" Stretch="Uniform" StrokeThickness="1.6" StrokeLineCap="Round"
             Stroke="{DynamicResource TextTertiaryBrush}"
             Data="M10.5 10.5 L14.5 14.5 M11 6.5 A4.5 4.5 0 1 1 2 6.5 A4.5 4.5 0 1 1 11 6.5" />
      </Grid>
      <StackPanel Grid.Row="1" Spacing="2" Margin="0,0,0,12">
       <TextBlock Classes="rail-label" Text="{loc:Loc component_center.browse}" Margin="10,0,0,6" />
       <ListBox x:Name="PageNavigation" Classes="page-nav" ItemsSource="{Binding BrowsePages}"
                SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
        <ListBox.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentCenterNavigationItem">
          <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
      <Border Grid.Row="2" Classes="rule" Margin="10,0,10,12" IsVisible="{Binding !ShowServerModules}" />
      <StackPanel Grid.Row="3" Spacing="4" Margin="10,0,10,6" IsVisible="{Binding !ShowServerModules}">
       <TextBlock Classes="rail-label" Text="{loc:Loc component_center.catalog_title}" />
       <TextBlock Text="{loc:Loc component_center.catalog_empty}" TextWrapping="Wrap" FontSize="11"
                  Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding !HasResults}" />
      </StackPanel>
      <!-- A catalog row is a name and, beneath it, the one measured state that name is in. A category
           row is a label with its own count, so it never reserves that second line. -->
      <TreeView Grid.Row="4" x:Name="ComponentTree" Classes="tree-compact" ItemsSource="{Binding VisibleRoots}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="Transparent" Padding="0,0,2,0"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True" /></Style></TreeView.Styles>
       <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:ComponentTreeNode" ItemsSource="{Binding VisibleChildren}">
         <StackPanel Spacing="3" Margin="0,3">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding !ShowStatus}">
           <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
           <TextBlock Grid.Column="1" Text="{Binding VisibleChildren.Count}" FontSize="11" VerticalAlignment="Center"
                      FontFamily="Consolas" Foreground="{DynamicResource TextTertiaryBrush}" />
          </Grid>
          <TextBlock Text="{Binding Label}" FontSize="13" TextTrimming="CharacterEllipsis" IsVisible="{Binding ShowStatus}"
                     ToolTip.Tip="{Binding Label}" />
          <WrapPanel ItemSpacing="6" LineSpacing="3" IsVisible="{Binding ShowStatus}">
           <!-- The dot belongs to the state sentence, not to the name: at the far right of the name
                row it floats a line above the words it describes. -->
           <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                    Fill="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding StatusIdle}" />
           <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                    Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding StatusOk}" />
           <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                    Fill="{DynamicResource WarningBrush}" IsVisible="{Binding StatusWarning}" />
           <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                    Fill="{DynamicResource DangerBrush}" IsVisible="{Binding StatusDanger}" />
           <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextSecondaryBrush}" />
           <TextBlock Text="·" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding ShowVersion}"
                      Foreground="{DynamicResource TextTertiaryBrush}" />
           <TextBlock Text="{Binding Version}" Classes="mono" FontSize="11" VerticalAlignment="Center"
                      IsVisible="{Binding ShowVersion}" MaxWidth="150" TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding Version}" Foreground="{DynamicResource TextTertiaryBrush}" />
           <Border Classes="pill accent" IsVisible="{Binding HasUpdate}">
            <TextBlock Text="{loc:Loc component_center.badge.updates}" />
           </Border>
           <Border Classes="pill" IsVisible="{Binding ShowRequirement}"><TextBlock Text="{Binding Requirement}" /></Border>
          </WrapPanel>
         </StackPanel>
        </TreeDataTemplate>
       </TreeView.ItemTemplate>
      </TreeView>
    </Grid>
   </Border>

   <ScrollViewer x:Name="DetailsScroll" Grid.Column="1" Grid.RowSpan="2" Padding="24,20" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <Border IsVisible="{Binding ShowServerModules}"><vm:ServerModulesView DataContext="{Binding ServerModules}" /></Border>
      <StackPanel Spacing="16" IsVisible="{Binding !ShowServerModules}">
       <!-- Component identity: what this is, the state the host reports, and where it is managed.
            Category, integration and owning application are facts about the component, so they are
            stated here instead of behind a disclosure: nothing on this page hides an identity. -->
       <Border Classes="panel-card" IsVisible="{Binding HasComponentDetails}">
        <StackPanel Spacing="14">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="7">
           <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBlock Text="{Binding SelectedComponentTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="pill ok" IsVisible="{Binding SelectedToneOk}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
            <Border Classes="pill warn" IsVisible="{Binding SelectedToneWarning}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
            <Border Classes="pill bad" IsVisible="{Binding SelectedToneDanger}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
            <Border Classes="pill" IsVisible="{Binding SelectedToneIdle}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
            <Border Classes="pill accent" IsVisible="{Binding SelectedHasUpdate}">
             <TextBlock Text="{loc:Loc component_center.badge.updates}" />
            </Border>
            <Border Classes="pill" IsVisible="{Binding HasSelectedVersion}">
             <TextBlock Text="{Binding SelectedVersionText}" FontFamily="Consolas" />
            </Border>
           </WrapPanel>
           <TextBlock Text="{Binding SelectedComponentDescription}" TextWrapping="Wrap" FontSize="13" LineHeight="19"
                      MaxWidth="680" HorizontalAlignment="Left" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost-action" VerticalAlignment="Top" Click="OpenApplication_Click"
                  IsVisible="{Binding ShowHeaderOpenApplication}">
           <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding SelectedApplicationOpenText}" VerticalAlignment="Center" />
            <Path Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"
                  Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" StrokeLineCap="Round"
                  Data="M5 11 L11 5 M6 5 H11 V10" />
           </StackPanel>
          </Button>
         </Grid>
         <Border Classes="rule" />
         <Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
          <StackPanel Spacing="3">
           <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.category}" />
           <TextBlock Classes="field-value" Text="{Binding SelectedCategoryText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="3">
           <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.integration}" />
           <TextBlock Classes="field-value" Text="{Binding SelectedIntegrationText}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="3">
           <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.application}" />
           <TextBlock Classes="field-value" Text="{Binding SelectedApplicationText}" />
          </StackPanel>
         </Grid>
         <StackPanel Spacing="6" IsVisible="{Binding HasHostPlatformSources}">
          <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.sources}" />
          <ItemsControl ItemsSource="{Binding SelectedHostSources}">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentSourceChip">
             <Border Classes="pill" Classes.accent="{Binding Ready}">
              <StackPanel Orientation="Horizontal" Spacing="6">
               <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" />
               <TextBlock Text="{Binding Text}" />
              </StackPanel>
             </Border>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
         <StackPanel Spacing="6" IsVisible="{Binding ShowOtherPlatformSources}">
          <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.sources_other}" />
          <ItemsControl ItemsSource="{Binding SelectedOtherSources}">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComponentSourceChip">
             <Border Classes="pill">
              <StackPanel Orientation="Horizontal" Spacing="6">
               <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" />
               <TextBlock Text="{Binding Text}" />
              </StackPanel>
             </Border>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </StackPanel>
       </Border>

       <Border Classes="panel-card" IsVisible="{Binding ShowNginxSelection}">
        <ContentControl Content="{Binding NginxSelection}">
         <ContentControl.ContentTemplate>
          <DataTemplate>
           <web:CurrentNginxSelectionView />
          </DataTemplate>
         </ContentControl.ContentTemplate>
        </ContentControl>
       </Border>

       <Border Classes="panel-card" IsVisible="{Binding ShowGitInstallation}">
        <StackPanel Spacing="12">
         <StackPanel Spacing="3">
          <TextBlock Text="Git" Classes="section-title" />
          <TextBlock Classes="section-hint" Text="{loc:Loc component_center.git.hint}" />
         </StackPanel>
         <Grid ColumnDefinitions="Auto,*" ColumnSpacing="20" RowDefinitions="Auto,Auto" RowSpacing="4">
          <TextBlock Classes="field-label" Text="{loc:Loc component_center.native.version_label}" />
          <TextBlock Grid.Column="1" Classes="field-value" Text="{Binding GitEngine.EngineVersion}" />
          <TextBlock Grid.Row="1" Classes="field-label" Text="{loc:Loc component_center.field.application}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="field-value mono" FontSize="12" Text="{Binding GitEngine.EnginePath}" TextWrapping="Wrap" />
         </Grid>
         <WrapPanel>
          <Button Classes="ghost-action" Content="{loc:Loc common.refresh}" Command="{Binding GitEngine.RefreshEngineStatusCommand}" />
         </WrapPanel>
         <ProgressBar IsIndeterminate="{Binding PackageInstallation.IsIndeterminate}" Value="{Binding PackageInstallation.Progress}" IsVisible="{Binding PackageInstallation.IsActive}" />
         <StackPanel Spacing="10" IsVisible="{Binding PackageInstallation.HasMessage}">
          <TextBlock Text="{Binding PackageInstallation.SummaryText}" TextWrapping="Wrap" FontSize="12" />
          <Button Classes="ghost-action" Content="{loc:Loc installation.cancel}" Command="{Binding PackageInstallation.CancelCommand}"
                  IsVisible="{Binding PackageInstallation.IsActive}" HorizontalAlignment="Left" />
          <Expander>
           <Expander.Header><TextBlock Classes="section-title" FontSize="13" Text="{loc:Loc common.operation_log}" /></Expander.Header>
           <TextBlock Text="{Binding PackageInstallation.OperationLog}" TextWrapping="Wrap" FontSize="12" Classes="mono" />
          </Expander>
         </StackPanel>
        </StackPanel>
       </Border>

       <!-- Honest stop sign for components whose lifecycle still lives in their own application. -->
       <Border Classes="panel-card" IsVisible="{Binding ShowNotIntegrated}"
               Background="{DynamicResource WarningMutedBrush}" BorderBrush="Transparent">
        <StackPanel Spacing="12">
         <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" StrokeThickness="1.6"
                StrokeLineCap="Round" StrokeJoin="Round" Stroke="{DynamicResource WarningBrush}"
                Data="M12 3 L22 20 H2 Z M12 9 V14 M12 17 V17.5" />
          <TextBlock Classes="section-title" Text="{loc:Loc component_center.not_integrated_title}" />
         </StackPanel>
         <TextBlock Text="{Binding NotIntegratedMessage}" TextWrapping="Wrap" FontSize="13" LineHeight="19" />
         <TextBlock Text="{loc:Loc component_center.not_integrated_scope}" TextWrapping="Wrap" FontSize="12"
                    Foreground="{DynamicResource TextSecondaryBrush}" />
         <Button Classes="on-notice" Content="{Binding SelectedApplicationOpenText}" Click="OpenApplication_Click"
                 IsVisible="{Binding CanOpenSelectedApplication}" HorizontalAlignment="Left" />
        </StackPanel>
       </Border>

       <!-- Read-only facts from the application that still owns this component's lifecycle. -->
       <Border Classes="panel-card" IsVisible="{Binding ShowHostObservation}">
        <StackPanel Spacing="12">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3">
           <TextBlock Classes="section-title" Text="{loc:Loc component_center.observation.title}" />
           <TextBlock Classes="section-hint" Text="{loc:Loc component_center.observation.hint}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc component_center.observation.read}"
                  Command="{Binding ObserveHostCommand}" IsEnabled="{Binding CanObserveHost}" VerticalAlignment="Center" />
         </Grid>
         <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsObservingHost}" />
         <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="6"
               IsVisible="{Binding HasHostObservation}">
          <TextBlock Classes="field-value" FontSize="12" Text="{Binding HostObservationPlatformText}" />
          <TextBlock Grid.Column="1" Classes="field-value" FontSize="12" Text="{Binding HostObservationManagementText}" />
          <TextBlock Grid.Row="1" Classes="field-value" FontSize="12" Text="{Binding HostObservationVersionText}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="field-value" FontSize="12" Text="{Binding HostObservationStateText}" />
         </Grid>
         <Border Classes="inset-block" IsVisible="{Binding HasHostObservation}">
          <TextBlock Text="{Binding HostObservationNoteText}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
         </Border>
         <TextBlock Text="{Binding HostObservationNotice}" TextWrapping="Wrap" FontSize="12"
                    IsVisible="{Binding !HostObservationNotice.IsEmpty}"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
       </Border>

       <Border Classes="panel-card" IsVisible="{Binding ShowOfficialDownloads}">
        <StackPanel Spacing="14">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3">
           <TextBlock Classes="section-title" Text="{loc:Loc component_center.download.title}" />
           <TextBlock Classes="section-hint" Text="{loc:Loc component_center.download.intro}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc common.refresh}"
                  Command="{Binding RefreshOfficialReleasesCommand}" IsEnabled="{Binding CanRefreshOfficial}" VerticalAlignment="Center" />
         </Grid>
         <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingOfficialReleases}" />
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
          <StackPanel Spacing="6">
           <TextBlock Classes="field-label" Text="{loc:Loc component_center.download.method}" />
           <ComboBox ItemsSource="{Binding DownloadMethods}" SelectedItem="{Binding SelectedDownloadMethod, Mode=TwoWay}"
                     HorizontalAlignment="Stretch" IsEnabled="{Binding !IsInstallingOfficial}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ComponentDownloadMethodChoice"><TextBlock Text="{Binding Text}" /></DataTemplate></ComboBox.ItemTemplate>
           </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding ShowOnlineVersions}">
           <TextBlock Classes="field-label" Text="{loc:Loc component_center.download.version}" />
           <ComboBox MinWidth="180" ItemsSource="{Binding OfficialReleases}" SelectedItem="{Binding SelectedOfficialRelease, Mode=TwoWay}"
                     IsEnabled="{Binding !IsInstallingOfficial}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="mr:ComponentDownloadRelease"><TextBlock Text="{Binding Version}" /></DataTemplate></ComboBox.ItemTemplate>
           </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding ShowManualVersion}">
           <TextBlock Classes="field-label" Text="{loc:Loc component_center.download.version}" />
           <TextBox MinWidth="180" Text="{Binding OfficialVersion, Mode=TwoWay}"
                    PlaceholderText="{loc:Loc component_center.download.version}" IsEnabled="{Binding !IsInstallingOfficial}" />
          </StackPanel>
         </Grid>
         <Border Classes="inset-block" IsVisible="{Binding IsFileSource}">
          <StackPanel Spacing="8">
           <TextBlock Classes="field-label" Text="{loc:Loc component_center.download.file}" />
           <TextBlock Text="{Binding SelectedPackageFileText}" TextWrapping="Wrap" FontSize="13" />
           <Button Classes="ghost-action" Content="{loc:Loc component_center.download.choose_file}"
                   Command="{Binding SelectPackageFileCommand}" HorizontalAlignment="Left" />
           <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSelectingPackageFile}" />
           <TextBlock Classes="section-hint" Text="{loc:Loc component_center.download.file_hint}" />
          </StackPanel>
         </Border>
         <TextBlock Text="{Binding OfficialDownloadNotice}" IsVisible="{Binding !OfficialDownloadNotice.IsEmpty}"
                    TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
         <Expander>
          <Expander.Header><TextBlock Classes="section-title" FontSize="13" Text="{loc:Loc component_center.download.manual}" /></Expander.Header>
          <StackPanel Spacing="8">
           <TextBlock Classes="section-hint" Text="{loc:Loc component_center.download.manual_hint}" />
           <TextBlock Text="{Binding OfficialDownloadUrl}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                      Foreground="{DynamicResource TextTertiaryBrush}" />
           <Button Classes="ghost-action" Content="{loc:Loc component_center.download.open}"
                   Command="{Binding OpenOfficialDownloadCommand}" HorizontalAlignment="Left" />
          </StackPanel>
         </Expander>
         <Border Classes="rule" />
         <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInstallingOfficial}" />
         <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="primary" Content="{loc:Loc component_center.native.action.Install}"
                  Command="{Binding InstallOfficialCommand}" IsEnabled="{Binding CanInstallOfficial}" />
         </WrapPanel>
         <StackPanel Spacing="10" IsVisible="{Binding PackageInstallation.HasMessage}">
          <TextBlock Text="{Binding PackageInstallation.SummaryText}" TextWrapping="Wrap" FontSize="12" />
          <ProgressBar IsIndeterminate="{Binding PackageInstallation.IsIndeterminate}" Value="{Binding PackageInstallation.Progress}" IsVisible="{Binding PackageInstallation.IsActive}" />
          <Button Classes="ghost-action" Content="{loc:Loc installation.cancel}" Command="{Binding PackageInstallation.CancelCommand}"
                  IsVisible="{Binding PackageInstallation.IsActive}" HorizontalAlignment="Left" />
          <Expander>
           <Expander.Header><TextBlock Classes="section-title" FontSize="13" Text="{loc:Loc common.operation_log}" /></Expander.Header>
           <TextBlock Text="{Binding PackageInstallation.OperationLog}" TextWrapping="Wrap" FontSize="11" Classes="mono" />
          </Expander>
         </StackPanel>
        </StackPanel>
       </Border>

       <!-- Platform install mode and the frozen candidate the host's own package manager resolves. -->
       <Border Classes="panel-card" IsVisible="{Binding ShowPackageFreeze}">
        <StackPanel Spacing="14">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="3">
           <TextBlock Classes="section-title" Text="{Binding PackageMethodTitle}" />
           <TextBlock Classes="section-hint" Text="{Binding PackageMethodHint}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc component_center.package.resolve}"
                  Command="{Binding ResolvePackageCommand}" IsEnabled="{Binding CanResolvePackage}" VerticalAlignment="Center" />
         </Grid>
         <!-- One host, one method: state the platform's own install path instead of both. -->
         <TextBlock Text="{Binding PlatformMethodText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                    Foreground="{DynamicResource AccentBrush}" />
         <!-- A host that answered with a problem is not a form nobody has touched: name it here. -->
         <TextBlock Text="{Binding PackageStateText}" IsVisible="{Binding HasPackageStateProblem}" TextWrapping="Wrap"
                    FontSize="12" Foreground="{DynamicResource WarningBrush}" />
         <StackPanel IsVisible="{Binding IsSystemPackage}" Spacing="6">
          <TextBlock Classes="field-label" Text="{loc:Loc component_center.native.manager}" />
          <!-- A single connected manager is stated, not offered: a one-item selector looks like a
               choice nobody has. A host that really reports several keeps the selector. -->
          <TextBlock Text="{Binding SelectedPackageManagerText}" FontSize="13" FontWeight="SemiBold"
                     IsVisible="{Binding !HasPackageManagerChoice}" />
          <ComboBox ItemsSource="{Binding PackageManagers}" SelectedItem="{Binding SelectedPackageManager, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" IsVisible="{Binding HasPackageManagerChoice}" IsEnabled="{Binding CanResolvePackage}" />
          <TextBlock Classes="section-hint" Text="{loc:Loc component_center.native.manager_hint}" />
         </StackPanel>
         <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsResolvingPackage}" />
         <Button Classes="ghost-action" Content="{Binding PackageSourceActionText}" Command="{Binding RefreshPackageSourcesCommand}"
                 IsVisible="{Binding CanRefreshPackageSources}" HorizontalAlignment="Left" />
         <StackPanel Spacing="6" IsVisible="{Binding HasPinnedArchiveCandidates}">
          <TextBlock Classes="field-label" Text="{loc:Loc component_center.native.version_label}" />
          <ComboBox ItemsSource="{Binding PinnedArchiveCandidates}" SelectedItem="{Binding SelectedPinnedArchive}"
                    IsVisible="{Binding HasPinnedArchiveCandidates}" IsEnabled="{Binding CanResolvePackage}">
           <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="mr:ComponentPinnedArchive"><TextBlock Text="{Binding Version}" /></DataTemplate>
           </ComboBox.ItemTemplate>
          </ComboBox>
         </StackPanel>
         <TextBlock Classes="section-hint" Text="{loc:Loc component_center.native.install_only}" IsVisible="{Binding ShowInstallOnlyNote}"
                    FontSize="11" />
         <StackPanel Spacing="4">
          <TextBlock Text="{Binding PackageInstalledText}" FontSize="12" />
          <TextBlock Text="{Binding PackageCandidateText}" FontSize="12" />
         </StackPanel>
         <StackPanel Spacing="8" IsVisible="{Binding HasPackageFreeze}">
          <Expander>
           <Expander.Header><TextBlock Classes="section-title" FontSize="13" Text="{loc:Loc component_center.details}" /></Expander.Header>
           <StackPanel Spacing="5">
            <TextBlock Text="{Binding PackageRepositoryText}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PackageAlsoInstallsText}" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding PackageDigestText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
           </StackPanel>
          </Expander>
          <TextBlock Text="{Binding PackageVerdictText}" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource WarningBrush}" />
         </StackPanel>
         <Border Classes="rule" />
         <WrapPanel ItemSpacing="8" LineSpacing="8">
          <Button Classes="primary" Content="{loc:Loc component_center.native.action.Install}" Command="{Binding InstallPackageCommand}"
                  IsEnabled="{Binding CanInstallPackage}" IsVisible="{Binding ShowPackageInstall}" />
          <Button Classes="ghost-action" IsVisible="{Binding ShowPackageChangeActions}" Content="{loc:Loc component_center.native.action.Update}"
                  Command="{Binding UpdatePackageCommand}" IsEnabled="{Binding CanChangeInstalledPackage}" />
          <Button Classes="ghost-action" IsVisible="{Binding ShowRegisterPackage}" Content="{Binding RegisterPackageText}"
                  Command="{Binding RegisterPackageCommand}" IsEnabled="{Binding CanRegisterPackage}" />
          <Button Classes="ghost-action" IsVisible="{Binding ShowPackageChangeActions}" Content="{loc:Loc component_center.native.action.Uninstall}"
                  Command="{Binding UninstallPackageCommand}" IsEnabled="{Binding CanChangeInstalledPackage}" />
         </WrapPanel>
         <Border Classes="inset-block" IsVisible="{Binding CanRecoverPackage}">
          <StackPanel Spacing="8">
           <TextBlock Text="{Binding PackageRecoveryText}" TextWrapping="Wrap" FontSize="12" />
           <WrapPanel ItemSpacing="8" LineSpacing="8">
            <Button Classes="ghost-action" Content="{loc:Loc component_center.package.recovery.Stop}" Command="{Binding StopPackageRecoveryCommand}" />
            <Button Classes="ghost-action" Content="{loc:Loc component_center.package.recovery.Close}" Command="{Binding ClosePackageRecoveryCommand}" />
           </WrapPanel>
          </StackPanel>
         </Border>
         <StackPanel Spacing="8" IsVisible="{Binding PackageInstallation.HasMessage}">
          <TextBlock Text="{Binding PackageInstallation.SummaryText}" TextWrapping="Wrap" FontSize="12" />
          <ProgressBar IsIndeterminate="{Binding PackageInstallation.IsIndeterminate}" Value="{Binding PackageInstallation.Progress}" IsVisible="{Binding PackageInstallation.IsActive}" />
          <Button Classes="ghost-action" Content="{loc:Loc installation.cancel}" Command="{Binding PackageInstallation.CancelCommand}"
                  IsVisible="{Binding PackageInstallation.IsActive}" HorizontalAlignment="Left" />
          <Expander>
           <Expander.Header><TextBlock Classes="section-title" FontSize="13" Text="{loc:Loc common.operation_log}" /></Expander.Header>
           <TextBlock Text="{Binding PackageInstallation.OperationLog}" TextWrapping="Wrap" FontSize="11" Classes="mono" />
          </Expander>
         </StackPanel>
         <TextBlock Text="{Binding ExternalPackageChangeText}" IsVisible="{Binding HasExternalPackageChange}" TextWrapping="Wrap"
                    FontSize="12" Foreground="{DynamicResource WarningBrush}" />
         <TextBlock Text="{Binding PackageFreezeNotice}" TextWrapping="Wrap" FontSize="11"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
       </Border>

       <!-- Domain runtime page: sources, versions, actions, uninstall, recovery. -->
       <StackPanel IsVisible="{Binding HasRuntimeDetails}">
        <views:ProxyServerRuntimeView x:Name="RuntimeView" DataContext="{Binding DetailRuntime}" />
       </StackPanel>

       <!-- Nothing matched: say what the host knows instead of leaving the page blank. This lives
            inside the component branch, so the module page never shows a component empty state. -->
       <Border HorizontalAlignment="Center" Margin="0,64,0,0" IsVisible="{Binding !HasResults}">
        <StackPanel Spacing="12" MaxWidth="380" HorizontalAlignment="Center">
         <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center"
                 Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                 BorderThickness="1">
          <Path Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                StrokeThickness="1.5" StrokeJoin="Round" Stroke="{DynamicResource TextTertiaryBrush}"
                Data="M3 3 H10 V10 H3 Z M14 3 H21 V10 H14 Z M3 14 H10 V21 H3 Z M14 14 H21 V21 H14 Z" />
         </Border>
         <TextBlock Text="{loc:Loc component_center.choose_component}" FontSize="15" FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
         <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" FontSize="12" LineHeight="18" TextAlignment="Center"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
       </Border>
      </StackPanel>
     </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
