<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:web="clr-namespace:RelaxKonOS.Client.Apps.WebServers.Views"
 xmlns:views="using:RelaxKonOS.Client.Apps.ProxyServer.Views"
 xmlns:component="using:RelaxKonOS.App.ComponentCenter"
 xmlns:vm="using:RelaxKonOS.Client.Apps.ComponentCenter"
 x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ComponentCenterWorkspace"
 x:DataType="vm:ComponentCenterViewModel" Classes="builtin-app"
 Background="{DynamicResource AppBackgroundBrush}">
 <!-- One vocabulary for the whole page, shared with the task dialog: a quiet surface, one heading per
      section, tone-coloured pills for measured state, and rows separated by rules instead of nested
      frames. Nothing here grants a capability; a disabled action stays visible and explained. -->
 <UserControl.Styles>
  <StyleInclude Source="avares://RelaxKonOS.App.ComponentCenter/ComponentCenterStyles.axaml" />
 </UserControl.Styles>

 <component:ComponentCenterLayout x:Name="WorkspaceLayout">
  <component:ComponentCenterLayout.Details>
    <StackPanel Spacing="16">
      <Border IsVisible="{Binding ShowServerModules}"><vm:ServerModulesView DataContext="{Binding ServerModules}" /></Border>
      <Border IsVisible="{Binding ShowCatalogSources}"><component:CatalogSourcesView DataContext="{Binding CatalogSources}" /></Border>
      <StackPanel Spacing="16" IsVisible="{Binding ShowComponentBrowser}">
       <component:ComponentIdentityView IsVisible="{Binding HasComponentDetails}" OpenApplicationRequested="OpenApplication_Click" />

       <component:ComponentDesktopPackageView IsVisible="{Binding ShowDesktopPackage}" />

       <Border Classes="panel-card" IsVisible="{Binding ShowNginxSelection}">
        <ContentControl Content="{Binding NginxSelection}">
         <ContentControl.ContentTemplate>
          <DataTemplate>
           <web:CurrentNginxSelectionView />
          </DataTemplate>
         </ContentControl.ContentTemplate>
        </ContentControl>
       </Border>

       <component:ComponentGitInstallationView IsVisible="{Binding ShowGitInstallation}" />

       <component:ComponentApplicationNoticeView IsVisible="{Binding ShowNotIntegrated}" OpenApplicationRequested="OpenApplication_Click" />

       <component:ComponentHostObservationView IsVisible="{Binding ShowHostObservation}" />
       <component:ComponentOfficialDownloadsView IsVisible="{Binding ShowOfficialDownloads}" />

       <component:ComponentPackageCandidateView IsVisible="{Binding ShowPackageFreeze}" />

       <!-- Domain runtime page: sources, versions, actions, uninstall, recovery. -->
       <StackPanel IsVisible="{Binding HasRuntimeDetails}">
        <views:ProxyServerRuntimeView x:Name="RuntimeView" DataContext="{Binding DetailRuntime}" />
       </StackPanel>

       <component:ComponentCenterEmptyView IsVisible="{Binding !HasResults}" />
      </StackPanel>
     </StackPanel>
  </component:ComponentCenterLayout.Details>
 </component:ComponentCenterLayout>
</UserControl>
