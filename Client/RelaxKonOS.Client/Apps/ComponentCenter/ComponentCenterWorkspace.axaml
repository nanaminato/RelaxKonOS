<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:mr="clr-namespace:RelaxKonOS.Protocol.ManagedRuntimes;assembly=RelaxKonOS.Protocol"
 xmlns:loc="using:RelaxKonOS.Client.Localization"
 xmlns:views="using:RelaxKonOS.Client.Apps.ProxyServer.Views"
 xmlns:vm="using:RelaxKonOS.Client.Apps.ComponentCenter"
 x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ComponentCenterWorkspace"
 x:DataType="vm:ComponentCenterViewModel" Classes="builtin-app"
 Background="{DynamicResource AppBackgroundBrush}">
 <!-- One vocabulary for the whole page: a quiet surface, flat section labels, and tone-coloured
      status text. Nothing here grants a capability; disabled actions stay visible and explained. -->
 <UserControl.Styles>
  <Style Selector="TextBlock.rail-label">
   <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
   <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
   <Setter Property="Margin" Value="2,0,0,4" />
  </Style>
  <Style Selector="Border.meta-chip">
   <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
   <Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="7,2" />
  </Style>
  <Style Selector="Border.meta-chip TextBlock">
   <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.meta-chip.accent TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.status-chip">
   <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
   <Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="6,1" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.status-chip TextBlock">
   <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Border.status-chip.ok TextBlock"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></Style>
  <Style Selector="Border.status-chip.warn TextBlock"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
  <Style Selector="Border.status-chip.bad TextBlock"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="Border.status-chip.accent TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBlock.field-label">
   <Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.field-value">
   <Setter Property="FontSize" Value="13" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.section-title">
   <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section-hint">
   <Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" />
   <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="Border.panel-card">
   <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="CornerRadius" Value="8" />
   <Setter Property="Padding" Value="20,18" />
  </Style>
  <Style Selector="TreeView.tree-compact TreeViewItem">
   <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.page-nav">
   <Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" />
   <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.page-nav > ListBoxItem">
   <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="10,0" />
   <Setter Property="CornerRadius" Value="6" /><Setter Property="Margin" Value="0,1" />
   <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ListBox.page-nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
   <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
  </Style>
 </UserControl.Styles>

 <Grid RowDefinitions="Auto,*,Auto">
  <!-- App bar: identity on the left, exactly one refresh affordance on the right. -->
  <Border Classes="app-header" Padding="20,14">
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentMutedBrush}" VerticalAlignment="Center">
     <TextBlock Text="⇄" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
     <TextBlock Text="{loc:Loc application.relaxkonos.component-center.display_name}" FontSize="18" FontWeight="SemiBold" />
     <WrapPanel ItemSpacing="8" LineSpacing="4">
      <TextBlock Text="{Binding HostIdentity}" FontSize="12" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
      <Border Classes="meta-chip"><TextBlock Text="{Binding ConnectionText}" /></Border>
      <Border Classes="meta-chip" IsVisible="{Binding HasTargetText}"><TextBlock Text="{Binding Runtime.TargetText}" /></Border>
     </WrapPanel>
     <TextBlock Text="{Binding HeaderOutcomeText}" TextWrapping="Wrap" IsVisible="{Binding HasHeaderOutcome}"
                FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button Classes="header-refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc proxy_server.refresh}"
             AutomationProperties.Name="{loc:Loc proxy_server.refresh}" IsEnabled="{Binding Runtime.CanRefreshSources}" />
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1" ColumnDefinitions="272,*" RowDefinitions="Auto,*" x:Name="WorkspaceBody">
   <ToggleButton x:Name="NavigationToggle" Grid.ColumnSpan="2" Content="{loc:Loc component_center.navigation_toggle}"
                 IsVisible="False" IsCheckedChanged="NavigationToggle_Changed" Margin="12,8" HorizontalAlignment="Left" />
   <Border x:Name="NavigationPane" Classes="app-sidebar" Padding="0" Grid.RowSpan="2">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
     <Grid RowDefinitions="Auto,Auto,1,Auto,Auto,*" RowSpacing="0">
      <Border Padding="12,14,12,4">
       <TextBox x:Name="Search" PlaceholderText="{loc:Loc component_center.search}" Text="{Binding Search, Mode=TwoWay}" />
      </Border>
      <StackPanel Grid.Row="1" Margin="8,6,8,12" Spacing="1">
       <TextBlock Classes="rail-label" Text="{loc:Loc component_center.browse}" Margin="10,0,0,6" />
       <ListBox x:Name="PageNavigation" Classes="page-nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}">
        <ListBox.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentCenterNavigationItem"><TextBlock Text="{Binding Label}" /></DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
      <Border Grid.Row="2" Background="{DynamicResource BorderSubtleBrush}" Margin="12,0" />
      <StackPanel Grid.Row="3" Margin="14,12,14,6" Spacing="3">
       <TextBlock Classes="rail-label" Text="{loc:Loc component_center.catalog_title}" />
       <TextBlock Text="{loc:Loc component_center.selection_hint}" TextWrapping="Wrap" FontSize="11"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>
      <TextBlock Grid.Row="4" Text="{loc:Loc component_center.catalog_empty}" TextWrapping="Wrap" FontSize="11"
                 Margin="12,0,12,6" Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding !HasResults}" />
      <TreeView Grid.Row="5" x:Name="ComponentTree" Classes="tree-compact" ItemsSource="{Binding VisibleRoots}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="Transparent">
       <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="True" /></Style></TreeView.Styles>
       <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:ComponentTreeNode" ItemsSource="{Binding VisibleChildren}">
         <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,3">
          <!-- Null is a derived aggregate. Users toggle select/clear, never request a third state. -->
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" IsEnabled="{Binding CanSelect}"
                    VerticalAlignment="Top" Margin="0,1,0,0" AutomationProperties.Name="{Binding Label}" />
          <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Left">
           <TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="164" FontSize="13" />
           <WrapPanel ItemSpacing="6" LineSpacing="2" IsVisible="{Binding ShowStatus}">
            <Border Classes="status-chip" Classes.ok="{Binding StatusOk}" Classes.warn="{Binding StatusWarning}" Classes.bad="{Binding StatusDanger}">
             <TextBlock Text="{Binding Status}" />
            </Border>
            <Border Classes="status-chip accent" IsVisible="{Binding HasUpdate}">
             <TextBlock Text="{loc:Loc component_center.badge.updates}" />
            </Border>
            <TextBlock Text="{Binding Version}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"
                       IsVisible="{Binding ShowVersion}" Foreground="{DynamicResource TextTertiaryBrush}" />
           </WrapPanel>
           <Border Classes="status-chip" IsVisible="{Binding ShowRequirement}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Requirement}" />
           </Border>
          </StackPanel>
         </Grid>
        </TreeDataTemplate>
       </TreeView.ItemTemplate>
      </TreeView>
     </Grid>
    </ScrollViewer>
   </Border>

   <ScrollViewer x:Name="DetailsScroll" Grid.Column="1" Grid.RowSpan="2" Padding="20,16" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14">
     <!-- Component identity: what this is, what state the host reports, and where it is managed. -->
     <Border Classes="panel-card" IsVisible="{Binding HasComponentDetails}">
      <StackPanel Spacing="14">
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="7">
         <WrapPanel ItemSpacing="8" LineSpacing="4">
          <TextBlock Text="{Binding SelectedComponentTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Classes="status-chip ok" IsVisible="{Binding SelectedToneOk}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
          <Border Classes="status-chip warn" IsVisible="{Binding SelectedToneWarning}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
          <Border Classes="status-chip bad" IsVisible="{Binding SelectedToneDanger}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
          <Border Classes="status-chip" IsVisible="{Binding SelectedToneIdle}"><TextBlock Text="{Binding SelectedStatusText}" /></Border>
          <Border Classes="status-chip accent" IsVisible="{Binding SelectedHasUpdate}"><TextBlock Text="{loc:Loc component_center.badge.updates}" /></Border>
          <Border Classes="status-chip" IsVisible="{Binding HasSelectedVersion}">
           <TextBlock Text="{Binding SelectedVersionText}" FontFamily="Consolas" />
          </Border>
         </WrapPanel>
         <TextBlock Text="{Binding SelectedComponentDescription}" TextWrapping="Wrap"
                    Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
         <Button Click="OpenApplication_Click" IsVisible="{Binding ShowHeaderOpenApplication}" HorizontalAlignment="Right"
                 Content="{Binding SelectedApplicationOpenText}" />
        </StackPanel>
       </Grid>
       <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" />
       <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
        <StackPanel Spacing="3">
         <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.category}" />
         <TextBlock Classes="field-value" Text="{Binding SelectedCategoryText}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="3">
         <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.integration}" />
         <TextBlock Classes="field-value" Text="{Binding SelectedIntegrationText}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="3">
         <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.application}" />
         <TextBlock Classes="field-value" Text="{Binding SelectedApplicationText}" />
        </StackPanel>
       </Grid>
       <StackPanel Spacing="6" IsVisible="{Binding HasSelectedSources}">
        <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.sources}" />
        <ItemsControl ItemsSource="{Binding SelectedHostSources}">
         <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
         <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ComponentSourceChip">
           <Border Classes="meta-chip" Classes.accent="{Binding Ready}">
            <StackPanel Orientation="Horizontal" Spacing="6">
             <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" />
             <TextBlock Text="{Binding Text}" />
            </StackPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <WrapPanel ItemSpacing="6" LineSpacing="6" IsVisible="{Binding HasOtherPlatformSources}">
         <TextBlock Classes="field-label" Text="{loc:Loc component_center.field.sources_other}" VerticalAlignment="Center" Margin="0,0,4,0" />
         <ItemsControl ItemsSource="{Binding SelectedOtherSources}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="vm:ComponentSourceChip">
            <Border Classes="meta-chip">
             <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Platform}" FontWeight="SemiBold" FontSize="11" />
              <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
             </StackPanel>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </WrapPanel>
       </StackPanel>
      </StackPanel>
     </Border>

     <!-- Honest stop sign for components whose lifecycle still lives in their own application. -->
     <Border Classes="panel-card" IsVisible="{Binding ShowNotIntegrated}" BorderBrush="{DynamicResource WarningBrush}">
      <StackPanel Spacing="10">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.not_integrated_title}" />
       <TextBlock Text="{Binding NotIntegratedMessage}" TextWrapping="Wrap" FontSize="12" />
       <TextBlock Text="{loc:Loc component_center.not_integrated_scope}" TextWrapping="Wrap" FontSize="12"
                  Foreground="{DynamicResource TextSecondaryBrush}" />
       <Button Content="{Binding SelectedApplicationOpenText}" Click="OpenApplication_Click"
               IsVisible="{Binding CanOpenSelectedApplication}" HorizontalAlignment="Left" />
      </StackPanel>
     </Border>

     <!-- Read-only facts from the application that still owns this component's lifecycle. -->
     <Border Classes="panel-card" IsVisible="{Binding ShowHostObservation}">
      <StackPanel Spacing="10">
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Classes="section-title" Text="{loc:Loc component_center.observation.title}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{loc:Loc component_center.observation.read}" Command="{Binding ObserveHostCommand}"
                IsEnabled="{Binding CanObserveHost}" />
       </Grid>
       <TextBlock Classes="section-hint" Text="{loc:Loc component_center.observation.hint}" TextWrapping="Wrap" />
       <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsObservingHost}" />
       <StackPanel Spacing="5" IsVisible="{Binding HasHostObservation}">
        <TextBlock Text="{Binding HostObservationPlatformText}" FontSize="12" />
        <TextBlock Text="{Binding HostObservationManagementText}" FontSize="12" />
        <TextBlock Text="{Binding HostObservationVersionText}" FontSize="12" />
        <TextBlock Text="{Binding HostObservationStateText}" FontSize="12" />
        <TextBlock Text="{Binding HostObservationNoteText}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
       </StackPanel>
       <TextBlock Text="{Binding HostObservationNotice}" TextWrapping="Wrap" FontSize="12"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>
     </Border>

     <!-- Platform install mode and the frozen candidate the host's own package manager resolves. -->
     <Border Classes="panel-card" IsVisible="{Binding ShowPackageFreeze}">
      <StackPanel Spacing="10">
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Classes="section-title" Text="{loc:Loc component_center.package.title}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{loc:Loc component_center.package.resolve}" Command="{Binding ResolvePackageCommand}"
                IsEnabled="{Binding CanResolvePackage}" />
       </Grid>
       <TextBlock Classes="section-hint" Text="{loc:Loc component_center.package.hint}" TextWrapping="Wrap" />
       <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsResolvingPackage}" />
       <Button Content="{loc:Loc component_center.package.recovery.RefreshSources}" Command="{Binding RefreshPackageSourcesCommand}"
               IsVisible="{Binding CanRefreshPackageSources}" />
       <ComboBox ItemsSource="{Binding PinnedArchiveCandidates}" SelectedItem="{Binding SelectedPinnedArchive}"
                 IsVisible="{Binding HasPinnedArchiveCandidates}" IsEnabled="{Binding CanResolvePackage}">
        <ComboBox.ItemTemplate>
         <DataTemplate x:DataType="mr:ComponentPinnedArchive"><TextBlock Text="{Binding Version}" /></DataTemplate>
        </ComboBox.ItemTemplate>
       </ComboBox>
       <TextBlock Text="{Binding PackageModeText}" FontSize="12" TextWrapping="Wrap" />
       <TextBlock Text="{Binding PackageInstalledText}" FontSize="12" />
       <StackPanel Spacing="5" IsVisible="{Binding HasPackageFreeze}">
        <TextBlock Text="{Binding PackageCandidateText}" FontSize="12" />
        <TextBlock Text="{Binding PackageRepositoryText}" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="{Binding PackageAlsoInstallsText}" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="{Binding PackageDigestText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" />
        <TextBlock Text="{Binding PackageVerdictText}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource WarningBrush}" />
       </StackPanel>
       <Button Content="{loc:Loc component_center.package.install}" Command="{Binding InstallPackageCommand}"
               IsEnabled="{Binding CanInstallPackage}" IsVisible="{Binding CanInstallPackage}" />
       <StackPanel Spacing="6" IsVisible="{Binding CanRecoverPackage}">
        <TextBlock Text="{Binding PackageRecoveryText}" TextWrapping="Wrap" />
        <WrapPanel>
         <Button Content="{loc:Loc component_center.package.recovery.Stop}" Command="{Binding StopPackageRecoveryCommand}" />
         <Button Content="{loc:Loc component_center.package.recovery.Close}" Command="{Binding ClosePackageRecoveryCommand}" />
        </WrapPanel>
       </StackPanel>
       <StackPanel Spacing="6" IsVisible="{Binding PackageInstallation.HasMessage}">
        <TextBlock Text="{Binding PackageInstallation.SummaryText}" TextWrapping="Wrap" />
        <ProgressBar IsIndeterminate="{Binding PackageInstallation.IsIndeterminate}" Value="{Binding PackageInstallation.Progress}"
                     IsVisible="{Binding PackageInstallation.IsActive}" />
        <TextBlock Text="{Binding PackageInstallation.OperationLog}" TextWrapping="Wrap" FontSize="11" />
       </StackPanel>
       <TextBlock Text="{Binding PackageFreezeNotice}" TextWrapping="Wrap" FontSize="12"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>
     </Border>

     <TextBlock Text="{Binding EmptyMessage}" IsVisible="{Binding !HasResults}" TextWrapping="Wrap"
                Foreground="{DynamicResource TextSecondaryBrush}" />

     <Border Classes="panel-card" Padding="20,16" IsVisible="{Binding HasWorkloadDetails}">
      <StackPanel Spacing="12">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.workload_title}" />
       <TextBlock Classes="section-hint" Text="{loc:Loc component_center.workload_hint}" TextWrapping="Wrap" />
       <StackPanel Spacing="3">
        <TextBlock Classes="field-label" Text="{loc:Loc component_center.required}" />
        <TextBlock Classes="field-value" Text="{Binding WorkloadRequirements}" />
       </StackPanel>
       <StackPanel Spacing="3">
        <TextBlock Classes="field-label" Text="{loc:Loc component_center.optional}" />
        <TextBlock Classes="field-value" Text="{Binding WorkloadOptional}" />
       </StackPanel>
       <Button Content="{loc:Loc component_center.stage_workload}" Command="{Binding SelectWorkloadCommand}" HorizontalAlignment="Left" />
      </StackPanel>
     </Border>

     <Border Classes="panel-card" IsVisible="{Binding ShowInspection}">
      <StackPanel Spacing="10">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.inspect_title}" />
       <TextBlock Classes="section-hint" Text="{loc:Loc component_center.inspect_hint}" TextWrapping="Wrap" />
       <Button Content="{loc:Loc component_center.inspect}" Command="{Binding InspectCommand}" IsEnabled="{Binding CanInspect}" HorizontalAlignment="Left" />
       <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsInspecting}" />
       <TextBlock Text="{Binding InspectionNotice}" TextWrapping="Wrap" FontSize="12" />
       <ItemsControl ItemsSource="{Binding InspectionSteps}">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentInspectionStep">
          <Border Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
           <StackPanel Spacing="3">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding State}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding Effects}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>

     <!-- The frozen plan is the outcome of a draft, so it stays above the controls that produced it. -->
     <Border Classes="panel-card" IsVisible="{Binding ShowBatchPlanPanel}">
      <StackPanel Spacing="10">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.change_plan_title}" />
       <TextBlock Classes="section-hint" Text="{loc:Loc component_center.change_plan_hint}" TextWrapping="Wrap" />
       <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="{loc:Loc component_center.change_plan_title}" Command="{Binding PlanDraftCommand}" IsEnabled="{Binding CanPlanDraft}" />
        <Button Content="{loc:Loc component_center.task_approve}" Command="{Binding ApproveTaskCommand}" IsEnabled="{Binding CanApproveTask}" />
       </WrapPanel>
       <TextBlock Text="{Binding ChangePlanNotice}" TextWrapping="Wrap" FontSize="12" />
       <TextBlock Text="{Binding ChangePlanDigest}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
       <ItemsControl ItemsSource="{Binding ChangePlanSteps}">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentInspectionStep">
          <Border Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
           <StackPanel Spacing="3">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding State}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding Effects}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Problems}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>

     <!-- Domain runtime page: sources, versions, actions, uninstall, recovery. -->
     <StackPanel IsVisible="{Binding HasRuntimeDetails}">
      <views:ProxyServerRuntimeView x:Name="RuntimeView" DataContext="{Binding DetailRuntime}" />
     </StackPanel>

     <Border Classes="panel-card" IsVisible="{Binding ShowTasks}">
      <StackPanel Spacing="10">
       <TextBlock Classes="section-title" Text="{loc:Loc component_center.task_title}" />
       <ComboBox ItemsSource="{Binding TaskHistory}" SelectedItem="{Binding SelectedTask}" IsEnabled="{Binding CanSelectTask}" HorizontalAlignment="Stretch">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ComponentTaskHistoryItem"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
       <TextBlock Text="{Binding TaskState}" TextWrapping="Wrap" FontSize="12" />
       <Border IsVisible="{Binding ShowTaskResult}" Padding="12" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
        <StackPanel Spacing="6">
         <TextBlock Text="{loc:Loc component_center.result_title}" FontWeight="SemiBold" />
         <TextBlock Text="{Binding TaskResultSummary}" TextWrapping="Wrap" FontSize="12" />
         <TextBlock Text="{Binding TaskResultIdentity}" TextWrapping="Wrap" FontSize="11" />
         <TextBlock Text="{loc:Loc component_center.result_evidence_hint}" TextWrapping="Wrap" FontSize="11"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
       </Border>
       <TextBlock Text="{Binding Runtime.OperationText}" IsVisible="{Binding ShowTaskDomainProgress}" TextWrapping="Wrap" FontSize="12" />
       <StackPanel IsVisible="{Binding ShowTaskDomainProgress}" Spacing="4">
        <TextBlock Classes="field-label" Text="{loc:Loc component_center.stage_progress}" />
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Runtime.OperationProgress}" IsIndeterminate="{Binding Runtime.IsOperationIndeterminate}" />
        <TextBlock Text="{Binding Runtime.OperationProgress, StringFormat={}{0}%}" FontSize="11" IsVisible="{Binding !Runtime.IsOperationIndeterminate}" />
       </StackPanel>
       <TextBlock Text="{Binding TaskNotice}" TextWrapping="Wrap" FontSize="12" />
       <Button Content="{loc:Loc component_center.evidence_read}" Command="{Binding ReadTaskEvidenceCommand}" IsEnabled="{Binding CanReadTaskEvidence}" HorizontalAlignment="Left" />
       <ItemsControl ItemsSource="{Binding TaskEvidence}">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentTaskEvidenceItem">
          <Border Padding="12" Margin="0,4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
           <StackPanel Spacing="4">
            <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Operation}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" />
            <TextBlock Text="{Binding DomainState}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Observation}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Receipt}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Commit}" TextWrapping="Wrap" FontSize="12" />
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
       <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTaskBusy}" />
       <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Content="{loc:Loc component_center.task_refresh}" Command="{Binding RefreshTaskCommand}" IsEnabled="{Binding CanRefreshTask}" />
        <Button Content="{loc:Loc component_center.task_resume}" Command="{Binding ResumeTaskCommand}" IsEnabled="{Binding CanResumeTask}" />
        <Button Content="{loc:Loc component_center.task_cancel}" Command="{Binding CancelTaskCommand}" IsEnabled="{Binding CanCancelTask}" />
       </WrapPanel>
       <Button Content="{loc:Loc component_center.task_reload}" Command="{Binding ReloadTaskHistoryCommand}" IsEnabled="{Binding CanSelectTask}" HorizontalAlignment="Left" />
       <Button Content="{loc:Loc component_center.task_recheck_recovery}" Command="{Binding RecheckTaskRecoveryCommand}" IsVisible="{Binding CanRecheckTaskRecovery}" HorizontalAlignment="Left" />
       <StackPanel IsVisible="{Binding HasTaskRecovery}" Spacing="8">
        <TextBlock Text="{Binding TaskRecoverySummary}" TextWrapping="Wrap" FontSize="12" />
        <TextBlock Text="{Binding RecoveryServiceState}" TextWrapping="Wrap" FontSize="12" />
        <TextBlock Text="{Binding RecoveryVersions}" TextWrapping="Wrap" FontSize="12" />
        <WrapPanel ItemSpacing="8" LineSpacing="8">
         <Button Content="{loc:Loc component_center.task_recovery_read}" Command="{Binding ReadTaskRecoveryCommand}" IsEnabled="{Binding CanReadTaskRecovery}" />
         <Button Content="{loc:Loc component_center.task_recovery_action.RetryCompensation}" Command="{Binding RetryTaskCompensationCommand}" IsEnabled="{Binding CanRetryTaskCompensation}" />
         <Button Content="{loc:Loc component_center.task_recovery_action.EmergencyStop}" Command="{Binding StopTaskRecoveryCommand}" IsEnabled="{Binding CanStopTaskRecovery}" />
         <Button Content="{loc:Loc component_center.task_recovery_action.Close}" Command="{Binding CloseTaskRecoveryCommand}" IsEnabled="{Binding CanCloseTaskRecovery}" />
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding RecoveryAttempts}">
         <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ComponentRecoveryAttemptItem">
           <StackPanel Spacing="3" Margin="0,4">
            <TextBlock Text="{Binding Action}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Result}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Identity}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
           </StackPanel>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
       <ItemsControl ItemsSource="{Binding TaskSteps}">
        <ItemsControl.ItemTemplate>
         <DataTemplate x:DataType="vm:ComponentTaskStepItem">
          <Border Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
           <StackPanel Spacing="3">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding State}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Text="{Binding Operation}" IsVisible="{Binding HasOperation}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" />
            <TextBlock Text="{Binding DataImpact}" IsVisible="{Binding HasDataImpact}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
           </StackPanel>
          </Border>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>

  <!-- Draft bar: the only place that shows unapplied intent, kept out of the detail flow. -->
  <Border x:Name="DraftFooter" Grid.Row="2" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}"
          Background="{DynamicResource SurfaceRaisedBrush}" IsVisible="{Binding ShowDraftPanel}">
   <ScrollViewer x:Name="DraftFooterScroll" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{Binding DraftSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
       <Button x:Name="PreviewChanges" Content="{loc:Loc component_center.preview_title}" Command="{Binding PlanDraftCommand}"
               IsEnabled="{Binding CanPlanDraft}" Classes="primary" />
       <Button x:Name="DiscardChanges" Content="{loc:Loc component_center.discard}" Command="{Binding DiscardCommand}" IsEnabled="{Binding HasDrafts}" />
      </StackPanel>
     </Grid>
     <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource DangerBrush}" />
     <ItemsControl ItemsSource="{Binding Drafts}" MaxHeight="130">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="vm:ComponentDraftItem">
        <Border Padding="10,6" Margin="0,2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6">
         <DockPanel>
          <Button DockPanel.Dock="Right" Content="{loc:Loc component_center.remove}" Click="RemoveDraft_Click" />
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
         </DockPanel>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding PersistenceNotice}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
