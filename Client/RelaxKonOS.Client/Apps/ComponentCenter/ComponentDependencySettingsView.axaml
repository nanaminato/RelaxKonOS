<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:cc="clr-namespace:RelaxKonOS.Client.Apps.ComponentCenter"
             x:Class="RelaxKonOS.Client.Apps.ComponentCenter.ComponentDependencySettingsView"
             x:DataType="cc:ComponentDependencySettingsViewModel">
  <!-- The one dependency area every application reuses. It observes and navigates only; install,
       update, repair, rollback and removal stay in Component Center. -->
  <Border Padding="20" Classes="app-panel">
    <StackPanel Spacing="12">
      <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Components}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="cc:ComponentDependencyItem">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="0,4">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Content="{loc:Loc component_center.manage_dependency}" Command="{Binding ManageCommand}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                 IsVisible="{Binding !Notice.IsEmpty}" />
      <Button Content="{loc:Loc component_center.dependency.refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </Border>
</UserControl>
