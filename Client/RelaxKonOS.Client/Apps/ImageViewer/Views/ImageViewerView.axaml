<UserControl xmlns:common="clr-namespace:RelaxKonOS.Client.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.ImageViewer.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.ImageViewer.Views.ImageViewerView"
             x:DataType="vm:ImageViewerViewModel"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">
    <UserControl.Styles>
        <Style Selector="Button.viewer-tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="32" />
        </Style>
        <Style Selector="Button.viewer-tool:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
        </Style>
        <Style Selector="Border.viewer-card">
            <Setter Property="BoxShadow" Value="{DynamicResource ElevationShadow}" />
        </Style>
        <Style Selector="Border.loading-pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.18" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.8" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.18" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="HeaderHost" Grid.Row="0" ColumnDefinitions="*,Auto">
            <common:WorkspaceWindowHeader x:Name="Header" Title="{Binding DocumentName}" Subtitle="{Binding DimensionsText}" IconAsset="avares://RelaxKonOS.Client/Assets/AppIcons/imageviewer.png" />
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Classes="header-action" Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{loc:Loc image_viewer.zoom_out}" AutomationProperties.Name="{loc:Loc image_viewer.zoom_out}" />
                <TextBlock x:Name="ZoomLabel" Text="{Binding ZoomPercent, StringFormat={}{0}%}" MinWidth="43" VerticalAlignment="Center" />
                <Button Classes="header-action" Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="{loc:Loc image_viewer.zoom_in}" AutomationProperties.Name="{loc:Loc image_viewer.zoom_in}" />
                <Button Classes="header-action" Content="⋯" ToolTip.Tip="{loc:Loc explorer.more}" AutomationProperties.Name="{loc:Loc explorer.more}">
                    <Button.Flyout><MenuFlyout>
                        <MenuItem Header="{loc:Loc image_viewer.fit_to_view}" Command="{Binding FitToViewCommand}" />
                        <MenuItem Header="{loc:Loc image_viewer.reset_zoom}" Command="{Binding ResetZoomCommand}" />
                    </MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="{DynamicResource SurfaceSunkenBrush}" ClipToBounds="True" RowDefinitions="Auto,*">
            <WrapPanel Margin="12,6" ItemSpacing="10">
                <TextBlock Text="{Binding SessionText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{Binding DimensionsText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding ImageFormatText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
            </WrapPanel>
            <Border Grid.Row="1" Background="{DynamicResource AccentMutedBrush}" Width="420" Height="420" CornerRadius="210" Opacity="0.20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-230,-250,0,0" />
            <Border Grid.Row="1" Background="{DynamicResource AccentMutedBrush}" Width="360" Height="360" CornerRadius="180" Opacity="0.12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-180,-210" />
            <ScrollViewer Grid.Row="1" x:Name="ImageViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="36">
                <Grid MinWidth="100" MinHeight="100">
                    <StackPanel IsVisible="{Binding !HasImage}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <Grid Width="60" Height="60" HorizontalAlignment="Center">
                            <Border Classes="loading-pulse" Background="{DynamicResource AccentMutedBrush}" CornerRadius="30" IsVisible="{Binding IsLoading}" />
                            <Border Width="46" Height="46" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="23" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="▧" FontSize="25" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="EmptyHint" Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" />
                    </StackPanel>
                    <Border Classes="viewer-card app-panel" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasImage}">
                        <Image Source="{Binding ImageSource}" Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" Stretch="Fill" />
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Classes="app-statusbar">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ShortcutHint" Grid.Column="1" Text="{loc:Loc image_viewer.shortcuts}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
