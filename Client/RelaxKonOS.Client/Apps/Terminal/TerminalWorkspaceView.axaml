<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:terminal="clr-namespace:RelaxKonOS.Client.Apps.Terminal"
             x:Class="RelaxKonOS.Client.Apps.Terminal.TerminalWorkspaceView"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">
    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2" Background="{DynamicResource SurfaceRaisedBrush}">
            <!-- The strip and the new-tab command scroll as one run: the + follows the last tab
                 instead of being pinned to the window edge, and a long strip slides sideways rather
                 than squeezing every session into an unreadable sliver. -->
            <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <ListBox x:Name="TabStrip" Classes="title-tabs" Height="36"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="terminal:TerminalViewModel">
                                <Grid ColumnDefinitions="*,Auto" Width="180" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="tab-close" Click="CloseTab_Click" ToolTip.Tip="{loc:Loc terminal.close_tab}" AutomationProperties.Name="{loc:Loc terminal.close_tab}">
                                        <Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Data="M0,0 L10,10 M10,0 L0,10" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="AddTabButton" Classes="header-action" Margin="4,0,0,0" VerticalAlignment="Center"
                            Click="AddTab_Click" ToolTip.Tip="{loc:Loc terminal.new_tab}" AutomationProperties.Name="{loc:Loc terminal.new_tab}">
                        <Path Width="14" Height="14" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Data="M7,0 V14 M0,7 H14" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <!-- Sessions that the strip has scrolled out of sight stay reachable here. -->
            <Button Grid.Column="1" x:Name="TabPickerButton" Classes="header-action" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Loc terminal.all_tabs}" AutomationProperties.Name="{loc:Loc terminal.all_tabs}">
                <Path Width="12" Height="6" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" Data="M0,0 L6,6 L12,0" />
                <Button.Flyout>
                    <Flyout Opening="TabPicker_Opening">
                        <ListBox x:Name="TabPicker" MinWidth="220" MaxHeight="320" SelectionChanged="TabPicker_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="terminal:TerminalViewModel">
                                    <TextBlock Text="{Binding Title}" ToolTip.Tip="{Binding Title}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <Grid Grid.Row="1" x:Name="SessionHost" />
    </Grid>
</UserControl>
