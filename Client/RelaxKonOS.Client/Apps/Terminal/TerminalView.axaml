<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:app="clr-namespace:RelaxKonOS.Client.Apps"
             xmlns:terminal="clr-namespace:RelaxKonOS.Client.Apps.Terminal"
             x:Class="RelaxKonOS.Client.Apps.Terminal.TerminalView"
             x:DataType="terminal:TerminalViewModel"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" MinHeight="30" Margin="4,0">
                <!-- The session menu is a flyout rather than a menu bar: a web-rendered session is a
                     native child window that sits above Avalonia's own drawing, so the view has to
                     know when chrome would be covered and withdraw the surface (see MenuOpened). -->
                <Button Grid.Column="0" x:Name="SessionMenuButton" Background="Transparent" BorderThickness="0"
                        Padding="6,4" CornerRadius="6" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Loc terminal.menu}" AutomationProperties.Name="{loc:Loc terminal.menu}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{loc:Loc terminal.menu}" FontSize="12"/>
                            <Path Width="8" Height="4" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Data="M0,0 L4,4 L8,0"/>
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout Opened="SessionMenu_Opened" Closed="SessionMenu_Closed">
                            <MenuItem x:Name="MenuCopyItem" Header="{loc:Loc terminal.context.copy}" InputGesture="Ctrl+Shift+C" Click="OnCopyClicked" IsEnabled="False"/>
                            <MenuItem Header="{loc:Loc terminal.context.paste}" InputGesture="Ctrl+Shift+V" Click="OnPasteClicked"/>
                            <MenuItem Header="{loc:Loc terminal.context.select_all}" Click="OnSelectAllClicked"/>
                            <MenuItem Header="{loc:Loc terminal.context.clear}" Click="OnClearClicked"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc terminal.open_administrator}" Command="{Binding OpenAdministratorTerminalCommand}"
                                      IsVisible="{Binding CanOpenAdministratorTerminal}" />
                            <MenuItem Header="{loc:Loc terminal.settings}" Command="{Binding OpenSettingsCommand}" />
                            <MenuItem Header="{loc:Loc settings.environment.title}" Command="{Binding OpenEnvironmentCommand}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Status}" ToolTip.Tip="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           Margin="6,0" />
            </Grid>
        </Border>
        <Border Grid.Row="1" x:Name="TerminalFrame" Padding="6,8,6,4">
            <Grid x:Name="TerminalHost" />
        </Border>
    </Grid>
</UserControl>
