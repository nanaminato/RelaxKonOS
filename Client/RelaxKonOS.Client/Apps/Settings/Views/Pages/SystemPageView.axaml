<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:nav="clr-namespace:RelaxKonOS.Client.Apps.Settings.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.Pages.SystemPageView"
             x:DataType="vm:SystemPageViewModel" Classes="builtin-app">
    <StackPanel Spacing="16">
        <StackPanel Spacing="2">
            <TextBlock Text="{loc:Loc settings.system_properties.title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc settings.system_properties.description}" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <Button Content="{loc:Loc settings.page.daily}" Click="OnDailySettingsClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Loc settings.system_properties.advanced}" Classes="title" />
                <Button nav:SettingsSearchTarget.Id="workspace.environment" Content="{loc:Loc settings.workspace_environment.title}" Command="{Binding OpenWorkspaceEnvironmentCommand}" HorizontalAlignment="Stretch" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc settings.performance.title}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc settings.system_properties.performance_hint}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Loc settings.system_properties.open}" Command="{Binding OpenPerformanceOptionsCommand}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc settings.environment.title}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc settings.system_properties.environment_hint}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button nav:SettingsSearchTarget.Id="host.environment" Grid.Column="1" Content="{loc:Loc settings.system_properties.open}" Command="{Binding OpenEnvironmentVariablesCommand}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.hostname}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.hostname.scope}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HostIdentity.TargetText}" TextWrapping="Wrap" />
                <Border IsVisible="{Binding HostIdentity.IsCompleted}" Padding="12" BorderThickness="1" CornerRadius="6"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding HostIdentity.StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding HostIdentity.PendingHostName}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <ProgressBar IsVisible="{Binding HostIdentity.IsBusy}" IsIndeterminate="True" Height="3" />
                <Grid ColumnDefinitions="180,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.hostname.current}" Opacity="0.7" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding HostIdentity.CurrentHostName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="180,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.hostname.pending}" Opacity="0.7" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding HostIdentity.PendingHostName}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{loc:Loc settings.hostname.edit}" Opacity="0.7" />
                <TextBox nav:SettingsSearchTarget.Id="host.identity.hostname" Text="{Binding HostIdentity.DraftName, Mode=TwoWay}" IsEnabled="{Binding HostIdentity.CanEdit}"
                         PlaceholderText="{loc:Loc settings.hostname.placeholder}"
                         AutomationProperties.Name="{loc:Loc settings.hostname}" />
                <TextBlock IsVisible="{Binding HostIdentity.HasNameLengthHint}" Text="{Binding HostIdentity.NameLengthHint}"
                           Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding HostIdentity.HasNameProblem}" Text="{Binding HostIdentity.NameProblem}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Text="{loc:Loc settings.hostname.restart_pending}" TextWrapping="Wrap" IsVisible="{Binding HostIdentity.RestartPending}" />
                <TextBlock IsVisible="{Binding HostIdentity.HasDraft}" Text="{loc:Loc settings.host.draft_hint}"
                           Opacity="0.7" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc settings.hostname.reload}" Command="{Binding HostIdentity.ReloadCommand}" Margin="0,0,8,8" />
                    <Button IsVisible="{Binding HostIdentity.ShowApplyAction}" Content="{loc:Loc settings.hostname.apply}" Command="{Binding HostIdentity.ApplyCommand}" Margin="0,0,8,8" />
                    <Button IsVisible="{Binding HostIdentity.ShowQueryAction}" Content="{loc:Loc settings.hostname.query}" Command="{Binding HostIdentity.QueryCommand}" Margin="0,0,8,8" />
                    <Button IsVisible="{Binding HostIdentity.HasDraft}" Content="{loc:Loc settings.host.reset_draft}" Command="{Binding HostIdentity.ResetDraftCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock IsVisible="{Binding !HostIdentity.IsCompleted}" Text="{Binding HostIdentity.StatusText}" TextWrapping="Wrap" />
                <TextBlock IsVisible="{Binding HostIdentity.HasProblem}" Text="{Binding HostIdentity.ProblemCode}" TextWrapping="Wrap" />
                <Expander IsVisible="{Binding HostIdentity.HasOperation}" Header="{loc:Loc settings.hostname.operation_details}">
                    <StackPanel Spacing="10">
                        <SelectableTextBlock Text="{Binding HostIdentity.OperationId}" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.about}" Classes="title" />
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.version}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.connection_status}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ConnectionState}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.server}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ServerUrl}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.server_mode}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ServerMode}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.execution_identity}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ExecutionIdentity}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.listener_scope}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ListenerScope}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{Binding ConnectionGuidance}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.server_https.title}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.scope.hostmachine}" Classes="subtle" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc settings.server_https.description}" TextWrapping="Wrap" />
                <Button nav:SettingsSearchTarget.Id="host.serverHttps" Content="{loc:Loc settings.server_https.replace}" Command="{Binding OpenServerHttpsCommand}" />
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.account_workspace}" Classes="title" />
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.username}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding UserName}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.host_platform}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding Platform}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.workspace}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" />
                </Grid>
            </StackPanel>
        </Border>
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.usage_memory.title}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.scope.clientdevice}" Classes="subtle" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc settings.usage_memory.description}" TextWrapping="Wrap" />
                <Button Content="{loc:Loc settings.usage_memory.clear}" Command="{Binding ClearUsageMemoryCommand}" />
                <TextBlock Text="{Binding UsageMemoryStatus}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
