<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.Pages.SystemPageView"
             x:DataType="vm:SystemPageViewModel">
    <StackPanel Spacing="16" MaxWidth="720">
        <StackPanel Spacing="2">
            <TextBlock Text="{loc:Loc settings.system_properties.title}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc settings.system_properties.description}" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <TextBlock Text="{loc:Loc settings.system_properties.advanced}" Classes="title" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc settings.performance.title}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc settings.system_properties.performance_hint}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Loc settings.system_properties.open}" Command="{Binding OpenPerformanceOptionsCommand}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:Loc settings.environment.title}" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc settings.system_properties.environment_hint}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Loc settings.system_properties.open}" Command="{Binding OpenEnvironmentVariablesCommand}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.hostname}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.hostname.scope}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HostIdentity.TargetText}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="180,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.hostname.current}" Opacity="0.7" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding HostIdentity.CurrentHostName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="180,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.hostname.pending}" Opacity="0.7" VerticalAlignment="Center" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding HostIdentity.PendingHostName}" TextWrapping="Wrap" />
                </Grid>
                <TextBox Text="{Binding HostIdentity.DraftName, Mode=TwoWay}" IsEnabled="{Binding HostIdentity.CanEdit}"
                         PlaceholderText="{loc:Loc settings.hostname.placeholder}"
                         AutomationProperties.Name="{loc:Loc settings.hostname}" />
                <TextBlock Text="{Binding HostIdentity.NameProblem}" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Text="{loc:Loc settings.hostname.restart_pending}" TextWrapping="Wrap" IsVisible="{Binding HostIdentity.RestartPending}" />
                <TextBlock Text="{Binding HostIdentity.PreviewText}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc settings.hostname.reload}" Command="{Binding HostIdentity.ReloadCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:Loc settings.hostname.preview}" Command="{Binding HostIdentity.PreviewCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:Loc settings.hostname.apply}" Command="{Binding HostIdentity.ApplyCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:Loc settings.hostname.query}" Command="{Binding HostIdentity.QueryCommand}" Margin="0,0,8,8" />
                    <Button Content="{loc:Loc settings.hostname.rollback}" Command="{Binding HostIdentity.RollbackCommand}" Margin="0,0,8,8" />
                </WrapPanel>
                <TextBlock Text="{Binding HostIdentity.StatusText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HostIdentity.ProblemCode}" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding HostIdentity.OperationId}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.about}" Classes="title" />
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.version}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.connection_status}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ConnectionState}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.server}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ServerUrl}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.server_mode}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ServerMode}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.execution_identity}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ExecutionIdentity}" TextWrapping="Wrap" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.listener_scope}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding ListenerScope}" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{Binding ConnectionGuidance}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.account_workspace}" Classes="title" />
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.username}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding UserName}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.host_platform}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding Platform}" />
                </Grid>
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.workspace}" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="{Binding WorkspaceName}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
