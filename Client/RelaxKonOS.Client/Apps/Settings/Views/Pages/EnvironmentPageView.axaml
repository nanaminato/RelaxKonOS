<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels" xmlns:protocol="clr-namespace:RelaxKonOS.Protocol.Settings;assembly=RelaxKonOS.Protocol"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" x:Class="RelaxKonOS.Client.Apps.Settings.Views.Pages.EnvironmentPageView" x:DataType="vm:EnvironmentPageViewModel"
 Background="{DynamicResource SurfaceBrush}" Width="760">
  <Grid>
  <!-- Windows hosts deliberately use the familiar two-store environment editor. -->
  <Grid IsVisible="{Binding IsWindowsEnvironment}" Margin="14" RowDefinitions="*,*,Auto" RowSpacing="16">
    <GroupBox Header="{loc:Loc settings.environment.user_variables}" Padding="10">
      <Grid RowDefinitions="*,Auto" RowSpacing="12">
        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" MinHeight="190"><ListBox ItemsSource="{Binding UserVariables}" SelectedItem="{Binding SelectedUserVariable}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="protocol:EnvironmentVariable"><Grid ColumnDefinitions="190,*" Margin="6,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding RawValue}" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="{loc:Loc common.new}" Command="{Binding NewUserVariableCommand}" /><Button Content="{loc:Loc settings.environment.edit}" Command="{Binding EditUserVariableCommand}" /><Button Content="{loc:Loc common.delete}" Command="{Binding DeleteUserVariableCommand}" /></StackPanel>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="1" Header="{loc:Loc settings.environment.system_variables}" Padding="10">
      <Grid RowDefinitions="*,Auto" RowSpacing="12">
        <Border BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" MinHeight="190"><ListBox ItemsSource="{Binding SystemVariables}" SelectedItem="{Binding SelectedSystemVariable}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="protocol:EnvironmentVariable"><Grid ColumnDefinitions="190,*" Margin="6,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding RawValue}" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="{loc:Loc common.new}" Command="{Binding NewSystemVariableCommand}" /><Button Content="{loc:Loc settings.environment.edit}" Command="{Binding EditSystemVariableCommand}" /><Button Content="{loc:Loc common.delete}" Command="{Binding DeleteSystemVariableCommand}" /></StackPanel>
      </Grid>
    </GroupBox>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="{loc:Loc settings.environment.effect}" TextWrapping="Wrap" Opacity="0.72" /><TextBlock Text="{Binding ProblemCode}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Content="{loc:Loc common.ok}" Command="{Binding CloseCommand}" MinWidth="90" /></Grid>
  </Grid>
  <!-- Non-Windows hosts retain the cross-platform batch editor. -->
  <ScrollViewer IsVisible="{Binding IsNotWindowsEnvironment}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="4"><TextBlock Text="{loc:Loc settings.environment.title}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc settings.environment.effect}" TextWrapping="Wrap" Opacity="0.72" /></StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock Text="{Binding ScopeHeading}" FontWeight="SemiBold" /><TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" FontSize="12" Opacity="0.65" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><CheckBox Content="{loc:Loc settings.environment.machine}" IsChecked="{Binding MachineScope}" IsEnabled="{Binding CanChangeScope}" /><Button Content="{loc:Loc settings.environment.load}" Command="{Binding LoadCommand}" /><Button Content="{loc:Loc settings.environment.reveal}" Command="{Binding RevealCommand}" /></StackPanel></Grid>
    <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" RowSpacing="8"><TextBox Text="{Binding Filter}" PlaceholderText="{loc:Loc settings.environment.filter}" /><Border Grid.Row="1" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" MinHeight="180"><ListBox ItemsSource="{Binding Variables}" SelectedItem="{Binding SelectedVariable}" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="protocol:EnvironmentVariable"><Grid ColumnDefinitions="210,*" Margin="4,2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding RawValue}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{loc:Loc settings.environment.masked}" IsVisible="{Binding Masked}" Opacity="0.65" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding SelectedDetails}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.7" /><Button Grid.Column="1" Content="{loc:Loc settings.environment.discard}" Command="{Binding DiscardCommand}" /></Grid></Grid>
    <StackPanel Grid.Row="3" Spacing="8"><TextBlock Text="{loc:Loc settings.environment.edit_hint}" TextWrapping="Wrap" FontSize="12" Opacity="0.72" /><Grid ColumnDefinitions="210,*" ColumnSpacing="8"><TextBox Text="{Binding VariableName}" MaxLength="255" PlaceholderText="{loc:Loc settings.environment.name}" /><TextBox Grid.Column="1" Text="{Binding VariableValue}" MaxLength="32767" PlaceholderText="{loc:Loc settings.environment.value}" /></Grid><WrapPanel ItemHeight="32"><CheckBox Content="{loc:Loc settings.environment.expand}" IsChecked="{Binding ExpandString}" Margin="0,0,14,0" /><Button Content="{loc:Loc settings.environment.set}" Command="{Binding StageSetCommand}" Margin="0,0,6,0" /><Button Content="{loc:Loc settings.environment.delete}" Command="{Binding StageDeleteCommand}" /></WrapPanel><CheckBox Content="{loc:Loc settings.environment.high_impact}" IsChecked="{Binding ConfirmHighImpact}" /><TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" /><TextBlock Text="{Binding ProblemCode}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="{loc:Loc settings.environment.preview}" Command="{Binding PreviewCommand}" /><Button Content="{loc:Loc settings.environment.apply}" Command="{Binding ApplyCommand}" /><Button Content="{loc:Loc common.cancel}" Command="{Binding CloseCommand}" /></StackPanel></StackPanel>
  </Grid></ScrollViewer>
  </Grid>
</UserControl>
