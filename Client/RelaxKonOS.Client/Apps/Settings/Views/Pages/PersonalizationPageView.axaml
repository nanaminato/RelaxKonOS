<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             xmlns:ss="clr-namespace:RelaxKonOS.Client.Services"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.Pages.PersonalizationPageView"
             x:DataType="vm:PersonalizationPageViewModel" Classes="builtin-app">
    <StackPanel Spacing="12" MaxWidth="960">
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" MinHeight="64" CornerRadius="8"
                Click="OnSectionClick" Tag="personalization/colors">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{loc:Loc settings.colors_and_mode}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="›" FontSize="22" />
            </Grid>
        </Button>
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" MinHeight="64" CornerRadius="8"
                Click="OnSectionClick" Tag="personalization/style">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{loc:Loc settings.system_style}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="›" FontSize="22" />
            </Grid>
        </Button>
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" MinHeight="64" CornerRadius="8"
                Click="OnSectionClick" Tag="personalization/layout">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{loc:Loc settings.desktop_layout}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="›" FontSize="22" />
            </Grid>
        </Button>
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" MinHeight="64" CornerRadius="8"
                Click="OnSectionClick" Tag="personalization/background">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{loc:Loc settings.wallpaper}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="›" FontSize="22" />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>
