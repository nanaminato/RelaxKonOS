<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             xmlns:ss="clr-namespace:RelaxKonOS.Client.Services"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.Pages.PersonalizationPageView"
             x:DataType="vm:PersonalizationPageViewModel">
    <StackPanel Spacing="16" MaxWidth="640">
        <TextBlock Text="{Binding LocalizedDisplayName}" FontSize="24" FontWeight="SemiBold" />

        <!-- ── 颜色与模式 ─────────────────────────────────────────────────── -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.colors_and_mode}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.colors_and_mode.description}" Opacity="0.7" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Loc settings.theme}" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                    <RadioButton Content="{loc:Loc settings.theme.light}" IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />
                    <RadioButton Content="{loc:Loc settings.theme.dark}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" />
                    <RadioButton Content="{loc:Loc settings.theme.system}" IsChecked="{Binding IsSystemTheme, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="{loc:Loc settings.theme.description}" Classes="subtle" TextWrapping="Wrap" />

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4" />

                <TextBlock Text="{loc:Loc settings.palette}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc settings.palette.description}" Classes="subtle" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding PaletteChoices}"
                          SelectedValue="{Binding PaletteId, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Id}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemePaletteChoice"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Loc settings.palette_scope_hint}" Classes="subtle" TextWrapping="Wrap" />
                <Border Background="{Binding PalettePreview.Background}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource OverlayCornerRadius}" Padding="12">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                        <TextBlock Text="{loc:Loc settings.palette.preview}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding PalettePreview.AccentValue}" Classes="subtle" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <Border Width="36" Height="24" CornerRadius="5" Background="{Binding PalettePreview.Surface}" />
                            <Border Width="36" Height="24" CornerRadius="5" Background="{Binding PalettePreview.Accent}" />
                            <Border Width="36" Height="24" CornerRadius="5" Background="{Binding PalettePreview.Success}" />
                            <Border Width="36" Height="24" CornerRadius="5" Background="{Binding PalettePreview.Danger}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="{loc:Loc settings.accent}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding AccentInput, Mode=TwoWay}"
                             PlaceholderText="{loc:Loc settings.accent.placeholder}" />
                    <Button Grid.Column="1" Content="{loc:Loc settings.accent.reset}"
                            Command="{Binding ResetAccentCommand}"
                            IsEnabled="{Binding HasAccentOverride}" />
                </Grid>
                <TextBlock Text="{Binding AccentError}" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding HasAccentError}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc settings.accent.hint}" Classes="subtle" TextWrapping="Wrap" />

                <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,4" />
                <TextBlock Text="{loc:Loc settings.custom_theme}" FontWeight="SemiBold" />
                <TextBlock Text="{loc:Loc settings.custom_theme.description}" Classes="subtle" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc settings.theme_import}" Command="{Binding ImportThemeCommand}" />
                    <Button Content="{loc:Loc settings.theme_export}" Command="{Binding ExportThemeCommand}"
                            IsEnabled="{Binding HasSelectedCustomPalette}" />
                    <Button Content="{loc:Loc settings.theme_delete}" Command="{Binding DeleteThemeCommand}"
                            IsEnabled="{Binding HasSelectedCustomPalette}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── 系统风格 ───────────────────────────────────────────────────── -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.system_style}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.system_style.description}" Opacity="0.7" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding SystemStyleChoices}"
                          SelectedValue="{Binding SelectedSystemStyleId, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Id}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SystemStyleChoice">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding SelectionDisplayName}" />
                                <TextBlock Text="{Binding UnavailableReason}" IsVisible="{Binding HasUnavailableReason}"
                                           Opacity="0.65" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding SystemStyleSummary}" Classes="subtle" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SystemStyleProblem}" Foreground="{DynamicResource DangerBrush}"
                           IsVisible="{Binding HasSystemStyleProblem}" TextWrapping="Wrap" />
                <Button Content="{loc:Loc settings.system_style.apply_recommended}"
                        Command="{Binding ApplyRecommendedStyleCommand}"
                        IsEnabled="{Binding !IsUsingRecommendedStyle}"
                        HorizontalAlignment="Left" />
                <TextBlock Text="{loc:Loc settings.system_style.independent_hint}" Classes="subtle" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ── 桌面布局 ───────────────────────────────────────────────────── -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.desktop_layout}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.shell.description}" Opacity="0.7" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding ShellChoices}"
                          SelectedValue="{Binding SelectedShellId, Mode=TwoWay}"
                          SelectedValueBinding="{Binding Id}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ShellChoice">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding SelectionDisplayName}" />
                                <TextBlock Text="{Binding UnavailableReason}" IsVisible="{Binding HasUnavailableReason}"
                                           Opacity="0.65" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Loc settings.shell.separate_hint}" Classes="subtle" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ── 壁纸 ───────────────────────────────────────────────────────── -->
        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{loc:Loc settings.wallpaper}" Classes="title" />
                <TextBlock Text="{loc:Loc settings.wallpaper.description}" Opacity="0.7" />
                <Button Content="{loc:Loc settings.wallpaper.choose_image}"
                        Command="{Binding ChooseImageCommand}"
                        HorizontalAlignment="Left" />
                <TextBlock Text="{loc:Loc settings.wallpaper.sync_hint}" Opacity="0.6" FontSize="12" />
                <ListBox ItemsSource="{Binding Wallpapers}"
                         SelectedIndex="{Binding WallpaperIndex, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="ss:WallpaperOption">
                            <Grid ColumnDefinitions="44,*" Height="40" Margin="0,2">
                                <Border Grid.Column="0" Width="36" Height="26" CornerRadius="4"
                                        Background="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
