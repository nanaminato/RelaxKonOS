<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             xmlns:pages="clr-namespace:RelaxKonOS.Client.Apps.Settings.Views.Pages"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SystemPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:SystemPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:PersonalizationPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:PersonalizationPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:TimeLanguagePageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:TimeLanguagePageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:NetworkPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:NetworkPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:AppsPageViewModel">
            <ScrollViewer  HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:AppsPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:ImageMirrorsPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:ImageMirrorsPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:DefaultAppsPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:DefaultAppsPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:DeveloperPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:DeveloperPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="220,*">
        <!-- 左侧导航 -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{loc:Loc settings.title}" FontSize="20" FontWeight="SemiBold"
                           Margin="18,18,18,12" />
                <ListBox ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="6,0,6,8"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsPageViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,2">
                                <TextBlock Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LocalizedDisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧内容 -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <DockPanel Margin="12,6" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{loc:Loc settings.save.retry}"
                        IsVisible="{Binding CanRetry}" Command="{Binding RetrySaveCommand}" />
                <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" />
        </Grid>
    </Grid>
</UserControl>
