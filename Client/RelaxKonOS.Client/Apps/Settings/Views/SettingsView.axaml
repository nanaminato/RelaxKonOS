<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:RelaxKonOS.Client.Services"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             xmlns:pages="clr-namespace:RelaxKonOS.Client.Apps.Settings.Views.Pages"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:EnvironmentPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,0,32">
                <pages:EnvironmentPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:SystemPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:SystemPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:PersonalizationPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:PersonalizationPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:TimeLanguagePageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:TimeLanguagePageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:NetworkPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:NetworkPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:AppsPageViewModel">
            <ScrollViewer  HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:AppsPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:ImageMirrorsPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:ImageMirrorsPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:DefaultAppsPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:DefaultAppsPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="vm:DeveloperPageViewModel">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,0,32">
                <pages:DeveloperPageView VerticalAlignment="Top" />
            </ScrollViewer>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid RowDefinitions="Auto,Auto,*" Margin="12">
        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Button Content="{loc:Loc settings.navigation.back}" Command="{Binding BackCommand}" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchQuery, Mode=TwoWay}"
                     PlaceholderText="{loc:Loc settings.search.placeholder}" MaxLength="256"
                     AutomationProperties.Name="{loc:Loc settings.search.placeholder}" />
        </Grid>
        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="{Binding ConnectionSummary}" TextWrapping="Wrap" FontSize="12" />
            <TextBlock Text="{Binding Breadcrumb}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <ComboBox x:Name="CompactNavigation" IsVisible="False" ItemsSource="{Binding Pages}"
                      SelectedItem="{Binding SelectedPage, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="{loc:Loc settings.search.category}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsPageViewModel"><TextBlock Text="{Binding LocalizedDisplayName}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <Grid x:Name="NavigationLayout" Grid.Row="2" ColumnDefinitions="210,*">
            <Border x:Name="Sidebar" Grid.Column="0" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,1,0" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,6,8"
                         AutomationProperties.Name="{loc:Loc settings.search.category}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsPageViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,2">
                                <Path Data="{Binding Icon}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5"
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LocalizedDisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <StackPanel Spacing="4" Margin="0,0,0,8">
                    <WrapPanel>
                        <Button Content="{loc:Loc settings.save.retry}" IsVisible="{Binding CanRetry}" Command="{Binding RetrySaveCommand}" Margin="0,0,6,4" />
                        <Button Content="{loc:Loc settings.save.discard}" IsVisible="{Binding CanDiscard}" Command="{Binding DiscardDraftCommand}" Margin="0,0,6,4" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SaveStatus}" TextWrapping="Wrap" />
                </StackPanel>
                <ContentControl Grid.Row="1" Content="{Binding SelectedPage}" IsVisible="{Binding !HasSearch}" />
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" IsVisible="{Binding HasSearch}">
                    <TextBlock Text="{Binding CatalogProblem}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="{loc:Loc settings.search.no_results}" IsVisible="{Binding HasNoResults}" TextWrapping="Wrap" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding SearchResults}" DoubleTapped="OnSearchResultDoubleTapped" KeyDown="OnSearchResultKeyDown"
                             AutomationProperties.Name="{loc:Loc settings.search.results}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:SettingsSearchEntry">
                                <StackPanel Spacing="3" Margin="4,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Category}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Scope}" Opacity="0.7" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
