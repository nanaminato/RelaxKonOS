<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             xmlns:views="clr-namespace:RelaxKonOS.Client.Apps.Settings.Views"
             xmlns:settingsApp="clr-namespace:RelaxKonOS.App.Settings.Views;assembly=RelaxKonOS.App.Settings"
             xmlns:pages="clr-namespace:RelaxKonOS.Client.Apps.Settings.Views.Pages"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.SettingsPageTemplates">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:PersonalizationColorsPageViewModel">
                <pages:PersonalizationColorsView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:PersonalizationStylePageViewModel">
                <pages:PersonalizationStyleView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:PersonalizationLayoutPageViewModel">
                <pages:PersonalizationLayoutView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:PersonalizationBackgroundPageViewModel">
                <pages:PersonalizationBackgroundView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>

        <DataTemplate DataType="vm:SettingsHomePageViewModel">
            <settingsApp:SettingsHomePageView DataContext="{Binding Content}" RouteRequested="OnHomeRouteRequested" />
        </DataTemplate>
        <DataTemplate DataType="vm:AccountSecurityPageViewModel">
                <pages:AccountSecurityPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:SystemPageViewModel">
                <pages:SystemPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:PersonalizationPageViewModel">
                <pages:PersonalizationPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:TimeLanguagePageViewModel">
                <pages:TimeLanguagePageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:NetworkAdapterPageViewModel">
            <pages:HostNetworkView DataContext="{Binding Editor}" IsAdapterDetailPage="True" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:NetworkPageViewModel">
                <pages:NetworkPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:ApplicationDetailPageViewModel">
            <pages:AppsPageView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:ApplicationPermissionsPageViewModel">
            <ContentControl Content="{Binding Editor}"><ContentControl.DataTemplates>
                <DataTemplate DataType="vm:AppPermissionDialogViewModel"><settingsApp:AppPermissionDialogView /></DataTemplate>
            </ContentControl.DataTemplates></ContentControl>
        </DataTemplate>
        <DataTemplate DataType="vm:AppsPageViewModel">
                <pages:AppsPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:DefaultAppsPageViewModel">
                <settingsApp:DefaultAppsPageView DataContext="{Binding Content}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:DeveloperPageViewModel">
                <pages:DeveloperPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:AccessibilityPageViewModel">
            <settingsApp:AccessibilityPageView DataContext="{Binding Content}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:DailySettingsPageViewModel">
            <settingsApp:DailySettingsPageView DataContext="{Binding Content}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:AboutPageViewModel">
                <settingsApp:AboutPageView DataContext="{Binding Content}" VerticalAlignment="Top" />
        </DataTemplate>
    </UserControl.DataTemplates>
</UserControl>
