<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.LegalTextDialogView"
             x:DataType="vm:LegalTextDialogViewModel">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox Grid.Row="1" Text="{Binding Text}" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Top"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <Button Grid.Row="2" Content="{loc:Loc common.close}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" MinWidth="88" />
    </Grid>
</UserControl>
