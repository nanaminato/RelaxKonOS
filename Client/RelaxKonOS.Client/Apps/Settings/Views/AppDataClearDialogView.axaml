<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.AppDataClearDialogView"
             x:DataType="vm:AppDataClearDialogViewModel"
             Background="{DynamicResource SurfaceBrush}" Width="520">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="5">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.72" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="12">
            <CheckBox Content="{Binding LocalDataLabel}" IsChecked="True" IsEnabled="False" />
            <TextBlock Text="{Binding LocalDataHint}" FontSize="12" Opacity="0.62" Margin="24,-8,0,0" TextWrapping="Wrap" />
            <CheckBox Content="{Binding PermissionsLabel}" IsChecked="{Binding ClearPermissionDecisions, Mode=TwoWay}" />
            <TextBlock Text="{Binding PermissionsHint}" FontSize="12" Opacity="0.62" Margin="24,-8,0,0" TextWrapping="Wrap" />
            <CheckBox Content="{Binding ServerDataLabel}" IsChecked="{Binding ClearServerData, Mode=TwoWay}" />
            <TextBlock Text="{Binding ServerDataHint}" FontSize="12" Opacity="0.62" Margin="24,-8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelCommand}" Padding="16,6" />
            <Button Classes="primary" Content="{Binding ClearLabel}" Command="{Binding ClearCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</UserControl>
