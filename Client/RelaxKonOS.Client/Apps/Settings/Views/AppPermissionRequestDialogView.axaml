<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Settings.ViewModels"
             x:Class="RelaxKonOS.Client.Apps.Settings.Views.AppPermissionRequestDialogView"
             x:DataType="vm:AppPermissionRequestDialogViewModel"
             Background="{DynamicResource SurfaceBrush}" Width="460">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="5">
            <TextBlock Text="{Binding AppName}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Prompt}" FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="{Binding PermissionName}" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding PermissionDescription}" FontSize="13" Opacity="0.72" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DeferredHint}" FontSize="12" Opacity="0.58" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{Binding LaterText}" Command="{Binding LaterCommand}" Padding="14,6" />
            <Button Content="{Binding DenyText}" Command="{Binding DenyCommand}" Padding="14,6" />
            <Button Classes="primary" Content="{Binding AllowText}" Command="{Binding AllowCommand}" Padding="14,6" />
        </StackPanel>
    </Grid>
</UserControl>
