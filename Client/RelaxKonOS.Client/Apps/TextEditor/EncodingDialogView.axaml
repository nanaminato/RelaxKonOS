<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:app="clr-namespace:RelaxKonOS.Client.Apps.TextEditor"
             x:Class="RelaxKonOS.Client.Apps.TextEditor.EncodingDialogView"
             x:DataType="app:EncodingDialogViewModel"
             Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <TextBlock Grid.Row="0" Text="{loc:Loc common.encoding_selection_hint}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        <ListBox Grid.Row="1" ItemsSource="{Binding AvailableEncodings}"
                 SelectedItem="{Binding SelectedEncoding, Mode=TwoWay}" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelCommand}" Padding="16,6" />
            <Button Classes="primary" Content="{loc:Loc common.ok}" Command="{Binding SelectCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</UserControl>
