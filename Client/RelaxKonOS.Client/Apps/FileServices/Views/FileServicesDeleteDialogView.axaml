<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:fs="clr-namespace:RelaxKonOS.Client.Apps.FileServices"
             xmlns:views="clr-namespace:RelaxKonOS.Client.Apps.FileServices.Views"
             x:Class="RelaxKonOS.Client.Apps.FileServices.Views.FileServicesDeleteDialogView">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{loc:Loc common.cancel}" Click="Cancel_Click" />
            <Button Content="{loc:Loc file_services.delete}" Click="Delete_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
