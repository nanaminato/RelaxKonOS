<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tailscale.Views"
 x:Class="RelaxKonOS.Client.Apps.Tailscale.Views.TailscaleRecoveryDialog" x:DataType="vm:TailscaleRecoveryText"
 Classes="builtin-app" Background="{DynamicResource SurfaceBrush}">
 <Grid RowDefinitions="*,Auto" Margin="20" RowSpacing="16">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="12">
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
    <TextBlock Text="{loc:Loc tailscale.recovery.confirm_effect}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding OperationId}" TextWrapping="Wrap" />
   </StackPanel>
  </ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
   <Button Content="{loc:Loc common.cancel}" Click="Cancel" />
   <Button Content="{loc:Loc tailscale.recovery.confirm_close}" Classes="primary" Click="Confirm" />
  </StackPanel>
 </Grid>
</UserControl>
