<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:common="clr-namespace:RelaxKonOS.Client.Controls"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tailscale"
 x:Class="RelaxKonOS.Client.Apps.Tailscale.Views.TailscaleWorkspace" x:DataType="vm:TailscaleViewModel"
 Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
 <Grid RowDefinitions="Auto,*,Auto">
  <Grid x:Name="HeaderHost" ColumnDefinitions="*,Auto">
   <common:WorkspaceWindowHeader x:Name="Header" Title="{loc:Loc tailscale.title}" Subtitle="{Binding Target}" />
   <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,8,0">
    <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
      CornerRadius="999" Padding="9,3" VerticalAlignment="Center" ToolTip.Tip="{Binding ConnectionDetailText}">
     <StackPanel Orientation="Horizontal" Spacing="6">
      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsConnected}" />
      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding IsDisconnected}" />
      <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource WarningBrush}" IsVisible="{Binding IsAttention}" />
      <TextBlock Text="{Binding ConnectionBadge}" FontSize="12" VerticalAlignment="Center" MaxWidth="140" TextTrimming="CharacterEllipsis" />
     </StackPanel>
    </Border>
    <Button Classes="header-action header-refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
      ToolTip.Tip="{loc:Loc tailscale.refresh}" AutomationProperties.Name="{loc:Loc tailscale.refresh}" />
   </StackPanel>
  </Grid>

  <Grid x:Name="WorkspaceBody" Grid.Row="1" ColumnDefinitions="210,*" ClipToBounds="True">
   <Border Classes="app-sidebar">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
     <StackPanel Spacing="4" Margin="14,22">
      <TextBlock Text="{loc:Loc tailscale.workspace}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
      <Button x:Name="Devices" Classes="workspace-nav" Tag="devices" Click="NavigationButton_Click"
        Content="{loc:Loc tailscale.devices}" HorizontalContentAlignment="Left" Padding="10,8" />
      <Button x:Name="Control" Classes="workspace-nav" Tag="control" Click="NavigationButton_Click"
        Content="{loc:Loc tailscale.control}" HorizontalContentAlignment="Left" Padding="10,8" />
      <Button x:Name="Login" Classes="workspace-nav" Tag="login" Click="NavigationButton_Click"
        Content="{loc:Loc tailscale.login.title}" HorizontalContentAlignment="Left" Padding="10,8" />
      <Button x:Name="Operations" Classes="workspace-nav" Tag="operations" Click="NavigationButton_Click"
        Content="{loc:Loc tailscale.operations}" HorizontalContentAlignment="Left" Padding="10,8" />
     </StackPanel>
    </ScrollViewer>
   </Border>
   <ContentControl x:Name="Page" Grid.Column="1" Margin="24,20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>

  <Border Grid.Row="2" Classes="app-statusbar">
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="36" MinWidth="0" Height="3" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
    <TextBlock Grid.Column="2" Text="{Binding LastUpdatedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
      VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
   </Grid>
  </Border>
 </Grid>
</UserControl>
