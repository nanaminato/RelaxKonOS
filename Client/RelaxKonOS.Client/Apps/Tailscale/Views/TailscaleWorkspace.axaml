<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tailscale"
 x:Class="RelaxKonOS.Client.Apps.Tailscale.Views.TailscaleWorkspace" x:DataType="vm:TailscaleViewModel"
 Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
 <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto">
   <StackPanel><TextBlock Classes="section-title" Text="{loc:Loc tailscale.title}" /><TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" /></StackPanel>
   <Button Grid.Column="1" Classes="header-action header-refresh" Command="{Binding RefreshCommand}"
     ToolTip.Tip="{loc:Loc tailscale.refresh}" AutomationProperties.Name="{loc:Loc tailscale.refresh}" />
  </Grid>
  <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="170,*" ColumnSpacing="16">
   <WrapPanel x:Name="Navigation" Orientation="Vertical" ItemSpacing="8" LineSpacing="8">
    <Button x:Name="Devices" Classes="workspace-nav" Content="{loc:Loc tailscale.devices}" Tag="devices" Click="Navigate" />
    <Button x:Name="Control" Classes="workspace-nav" Content="{loc:Loc tailscale.control}" Tag="control" Click="Navigate" />
    <Button x:Name="Login" Classes="workspace-nav" Content="{loc:Loc tailscale.login.title}" Tag="login" Click="Navigate" />
    <Button x:Name="Operations" Classes="workspace-nav" Content="{loc:Loc tailscale.operations}" Tag="operations" Click="Navigate" />
   </WrapPanel>
   <ContentControl x:Name="Page" Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
   <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="36" MinWidth="0" Height="3" />
    <TextBlock Grid.Column="1" Text="{Binding StatusText}" TextWrapping="Wrap" />
   </Grid>
  </Border>
 </Grid>
</UserControl>
