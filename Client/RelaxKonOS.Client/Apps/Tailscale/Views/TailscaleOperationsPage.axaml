<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tailscale"
 x:Class="RelaxKonOS.Client.Apps.Tailscale.Views.TailscaleOperationsPage" x:DataType="vm:TailscaleViewModel">
 <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
  <TextBlock Text="{loc:Loc tailscale.operations_intro}" TextWrapping="Wrap" />
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
   <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedReference}" IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Stretch"
     AutomationProperties.Name="{loc:Loc tailscale.operations}" />
   <Button Grid.Column="1" Content="{loc:Loc tailscale.reopen}" Command="{Binding ReopenCommand}" />
  </Grid>
  <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel Spacing="12">
    <TextBlock Text="{Binding OperationText}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding OperationProblem}" TextWrapping="Wrap" />
    <TextBlock Text="{loc:Loc tailscale.receipt_updated}" />
    <TextBlock Text="{Binding OperationUpdatedAt}" />
    <Separator />
    <TextBlock Text="{loc:Loc tailscale.recovery.intro}" TextWrapping="Wrap" />
    <WrapPanel ItemSpacing="8" LineSpacing="8">
     <Button Content="{loc:Loc tailscale.recovery.inspect}" Command="{Binding InspectRecoveryCommand}" />
     <Button Content="{loc:Loc tailscale.recovery.close}" Command="{Binding CloseRecoveryCommand}" />
    </WrapPanel>
    <TextBlock Text="{Binding RecoveryText}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding RecoveryProblem}" TextWrapping="Wrap" />
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
