<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tailscale"
 x:Class="RelaxKonOS.Client.Apps.Tailscale.Views.TailscaleControlPage" x:DataType="vm:TailscaleViewModel">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="16">
   <Border Classes="app-panel" Padding="20">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
     <StackPanel Spacing="6">
      <TextBlock Text="{loc:Loc tailscale.connection_section}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" IsVisible="{Binding IsConnected}" />
       <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding IsDisconnected}" />
       <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource WarningBrush}" IsVisible="{Binding IsAttention}" />
       <TextBlock Text="{Binding ConnectionStateText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
      </StackPanel>
      <TextBlock Text="{Binding ConnectionDetailText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SelfLine}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
      <TextBlock Text="{Binding ConnectionHint}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" IsVisible="{Binding HasConnectionHint}" />
      <TextBlock Text="{Binding ControlProblem}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" IsVisible="{Binding HasControlProblem}" />
     </StackPanel>
     <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
      <Button Content="{loc:Loc tailscale.disconnect}" Command="{Binding DisconnectCommand}" IsVisible="{Binding CanDisconnect}" Classes="primary" MinWidth="96" />
      <Button Content="{loc:Loc tailscale.connect}" Command="{Binding ConnectCommand}" IsVisible="{Binding CanConnect}" Classes="primary" MinWidth="96" />
     </StackPanel>
    </Grid>
   </Border>

   <Border Classes="app-panel" Padding="20">
    <StackPanel Spacing="12">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{loc:Loc tailscale.preferences_section}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{loc:Loc tailscale.preferences.edit}" Command="{Binding EditPreferencesCommand}"
        Classes="command-action" Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
        BorderThickness="1" Padding="10,4" VerticalAlignment="Center" />
     </Grid>
     <ItemsControl ItemsSource="{Binding PreferenceRows}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="vm:TailscalePreferenceRow">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,3">
         <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
         <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{Binding PreferencesHint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
   </Border>

   <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
    <TextBlock Text="{loc:Loc tailscale.boundary_note}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
