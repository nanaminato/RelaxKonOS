<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tailscale"
 x:Class="RelaxKonOS.Client.Apps.Tailscale.Views.TailscaleLoginPage" x:DataType="vm:TailscaleLoginViewModel">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <StackPanel Spacing="16">
   <Border Classes="app-panel" Padding="20">
    <StackPanel Spacing="10">
     <TextBlock Text="{loc:Loc tailscale.login.title}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
     <TextBlock Text="{loc:Loc tailscale.login.intro}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Target}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
     <TextBlock Text="{Binding AccountLine}" IsVisible="{Binding HasAccountLine}" FontSize="12" TextWrapping="Wrap" />
     <Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
      <TextBlock Text="{Binding AvailabilityText}" TextWrapping="Wrap" />
     </Border>
     <Button Content="{loc:Loc tailscale.login.start_and_open}" Command="{Binding StartCommand}" Classes="primary" HorizontalAlignment="Left" />
     <TextBlock Text="{loc:Loc tailscale.login.start_hint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
   </Border>

   <Border Classes="app-panel" Padding="20">
    <StackPanel Spacing="10">
     <TextBlock Text="{loc:Loc tailscale.login.progress}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
     <TextBlock Text="{loc:Loc tailscale.login.no_operations}" IsVisible="{Binding NoOperations}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Result}" FontSize="14" TextWrapping="Wrap" />
     <Border Background="{DynamicResource SuccessMutedBrush}" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="8"
       Padding="12" IsVisible="{Binding CompletionDetected}">
      <TextBlock Text="{loc:Loc tailscale.login.completed_detected}" TextWrapping="Wrap" />
     </Border>
     <TextBlock Text="{Binding Observation}" TextWrapping="Wrap" />
     <TextBlock Text="{Binding Message}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding MessageIsError}" />
     <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding MessageIsInfo}" />
     <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
     <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Content="{loc:Loc tailscale.login.reopen_browser}" Command="{Binding OpenCommand}" />
      <Button Content="{loc:Loc tailscale.login.finish}" Command="{Binding FinishCommand}" Classes="primary" />
     </WrapPanel>
     <TextBlock Text="{loc:Loc tailscale.login.finish_hint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
   </Border>

   <Border Classes="app-panel" Padding="20">
    <StackPanel Spacing="10">
     <TextBlock Text="{loc:Loc tailscale.login.records_title}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
     <TextBlock Text="{loc:Loc tailscale.login.records}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
     <TextBlock Text="{loc:Loc tailscale.login.no_operations}" IsVisible="{Binding NoOperations}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
     <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Selected}" IsEnabled="{Binding Ready}" HorizontalAlignment="Stretch"
       AutomationProperties.Name="{loc:Loc tailscale.login.records_title}" />
     <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Content="{loc:Loc tailscale.reopen}" Command="{Binding ReadCommand}" />
      <Button Content="{loc:Loc tailscale.recovery.inspect}" Command="{Binding InspectCommand}" />
      <Button Content="{loc:Loc tailscale.login.close}" Command="{Binding CloseCommand}" />
     </WrapPanel>
     <TextBlock Text="{loc:Loc tailscale.login.waiting_boundary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
