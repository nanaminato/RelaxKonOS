<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelLogWindowView" x:DataType="vm:TunnelLogViewModel">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{Binding ProfileName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}"/></Grid><TextBox Grid.Row="1" Margin="0,12" Text="{Binding LogsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono,Consolas,monospace" PlaceholderText="{loc:Loc tunnels.logs_placeholder}"/><TextBlock Grid.Row="2" Text="{loc:Loc tunnels.logs_live_hint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/></Grid>
</UserControl>
