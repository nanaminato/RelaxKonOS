<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelProfileEditorView" x:DataType="vm:TunnelProfileEditorViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12" Margin="22"><TextBlock Text="{loc:Loc tunnels.server_editor}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="9"><StackPanel><TextBlock Text="{loc:Loc tunnels.field.name}"/><TextBox Text="{Binding Name, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.host}"/><TextBox Text="{Binding Host, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="{loc:Loc tunnels.field.port}"/><TextBox Text="{Binding Port, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.runtime_mode}"/><ComboBox ItemsSource="{Binding RuntimeModes}" SelectedItem="{Binding RuntimeMode, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="{loc:Loc tunnels.field.auth}"/><ComboBox ItemsSource="{Binding AuthKinds}" SelectedItem="{Binding AuthKind, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.tls}"/><ComboBox ItemsSource="{Binding TlsModes}" SelectedItem="{Binding TlsMode, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding !IsManagedRuntime}"><TextBlock Text="{loc:Loc tunnels.field.external_path}"/><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding ExternalPath, Mode=TwoWay}"/><Button Grid.Column="1" Content="{loc:Loc tunnels.probe}" Command="{Binding ProbeExternalRuntimeCommand}" Margin="8,0,0,0"/></Grid></StackPanel></Grid><StackPanel IsVisible="{Binding IsTokenAuth}" Spacing="4"><TextBlock Text="{loc:Loc tunnels.field.token}"/><TextBox Text="{Binding Token, Mode=TwoWay}" PlaceholderText="{loc:Loc tunnels.token_hint}"/><TextBlock Text="{loc:Loc tunnels.token_safety}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><WrapPanel Margin="0,6,0,0"><Button Classes="primary" Content="{loc:Loc common.save}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="{loc:Loc common.cancel}" Command="{Binding CloseCommand}" Margin="0,0,12,0"/><Button Content="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditing}" Foreground="{DynamicResource DangerBrush}"/></WrapPanel></StackPanel></ScrollViewer>
</UserControl>
