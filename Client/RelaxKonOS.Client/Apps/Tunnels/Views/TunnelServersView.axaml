<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelServersView" x:DataType="vm:TunnelManagerViewModel">
  <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{loc:Loc tunnels.servers}" FontSize="19" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{loc:Loc tunnels.edit_server}" Command="{Binding EditProfileCommand}"/><Button Grid.Column="2" Classes="primary" Content="{loc:Loc tunnels.new_server}" Command="{Binding NewProfileCommand}"/></Grid><TextBlock Grid.Row="1" Text="{loc:Loc tunnels.servers_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><DataGrid Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="180"><DataGrid.Columns><DataGridTextColumn Header="{loc:Loc tunnels.table.name}" Binding="{ReflectionBinding Name}" Width="*" MinWidth="120" CanUserResize="True"/><DataGridTextColumn Header="{loc:Loc tunnels.table.host}" Binding="{ReflectionBinding Host}" Width="180" MinWidth="120" CanUserResize="True"/><DataGridTextColumn Header="{loc:Loc tunnels.table.port}" Binding="{ReflectionBinding Port}" Width="90" MinWidth="70" CanUserResize="True"/><DataGridTextColumn Header="{loc:Loc tunnels.table.runtime}" Binding="{ReflectionBinding RuntimeMode}" Width="120" MinWidth="100" CanUserResize="True"/><DataGridTemplateColumn Header="{loc:Loc tunnels.table.actions}" Width="190" MinWidth="130" CanUserResize="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{loc:Loc tunnels.view_logs}" Click="OpenLogsButton_Click"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><WrapPanel Grid.Row="3"><Button Classes="primary" Content="{loc:Loc tunnels.apply}" Command="{Binding ApplySelectedCommand}" Margin="0,0,8,0"/><Button Content="{loc:Loc tunnels.stop}" Command="{Binding StopSelectedCommand}"/></WrapPanel></Grid></Border>
</UserControl>
