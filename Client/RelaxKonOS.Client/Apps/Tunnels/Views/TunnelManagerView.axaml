<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelManagerView" x:DataType="vm:TunnelManagerViewModel" Background="{DynamicResource AppBackgroundBrush}" Classes="builtin-app">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="app-header"><Grid ColumnDefinitions="Auto,*,Auto"><Border Width="46" Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="14"><TextBlock Text="↔" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc tunnels.title}" Classes="app-title" /><TextBlock Text="{loc:Loc tunnels.subtitle}" FontSize="13" Classes="app-description" /></StackPanel><Button Grid.Column="2" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" Padding="12,6" CornerRadius="16" FontSize="12" /></Grid></Border>
    <Grid Grid.Row="1" ClipToBounds="True" ColumnDefinitions="190,*"><Border Classes="app-sidebar"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="4" Margin="14,22"><TextBlock Text="{loc:Loc tunnels.workspace}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" /><Button x:Name="OverviewButton" Classes="workspace-nav" Tag="overview" Click="NavigationButton_Click" Content="{loc:Loc tunnels.overview}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="tunnels" Click="NavigationButton_Click" Content="{loc:Loc tunnels.items}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="servers" Click="NavigationButton_Click" Content="{loc:Loc tunnels.servers}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="frps" Click="NavigationButton_Click" Content="{loc:Loc tunnels.frps}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="runtime" Click="NavigationButton_Click" Content="{loc:Loc tunnels.runtime_page}" HorizontalContentAlignment="Left" Padding="10,8" /></StackPanel></ScrollViewer></Border><ContentControl x:Name="ContentHost" Grid.Column="1" Margin="30,24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></Grid>
<Border Grid.Row="2"  Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
 <Grid RowDefinitions="Auto,38">
  <TextBox Text="{Binding OperationLog, Mode=OneWay}" IsVisible="{Binding IsOperationLogExpanded}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="180" Margin="12,8,12,4" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto" />
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="12,0">
   <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="36" MinWidth="0" Height="3" VerticalAlignment="Center" />
   <TextBlock Grid.Column="1" Text="{Binding StatusText}" ToolTip.Tip="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" />
   <ToggleButton Grid.Column="2" Content="{loc:Loc common.operation_log}" IsChecked="{Binding IsOperationLogExpanded, Mode=TwoWay}" Padding="8,2" Height="28" />

  </Grid>
 </Grid>
</Border>
  </Grid>
</UserControl>
