<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelManagerView" x:DataType="vm:TunnelManagerViewModel" Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,*">
    <Border Background="{DynamicResource SurfaceSunkenBrush}" Padding="28,18"><Grid ColumnDefinitions="Auto,*,Auto"><Border Width="46" Height="46" Background="{DynamicResource AccentBrush}" CornerRadius="14"><TextBlock Text="↔" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc tunnels.title}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" /><TextBlock Text="{loc:Loc tunnels.subtitle}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" /></StackPanel><Button Grid.Column="2" Content="{Binding StatusText}" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" Padding="12,6" CornerRadius="16" FontSize="12" /></Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="190,*"><Border Background="{DynamicResource SurfaceSunkenBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0"><StackPanel Spacing="4" Margin="14,22"><TextBlock Text="{loc:Loc tunnels.workspace}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" /><Button x:Name="OverviewButton" Classes="workspace-nav" Tag="overview" Click="NavigationButton_Click" Content="{loc:Loc tunnels.overview}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="tunnels" Click="NavigationButton_Click" Content="{loc:Loc tunnels.items}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="servers" Click="NavigationButton_Click" Content="{loc:Loc tunnels.servers}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="frps" Click="NavigationButton_Click" Content="{loc:Loc tunnels.frps}" HorizontalContentAlignment="Left" Padding="10,8" /><Button Classes="workspace-nav" Tag="runtime" Click="NavigationButton_Click" Content="{loc:Loc tunnels.runtime_page}" HorizontalContentAlignment="Left" Padding="10,8" /></StackPanel></Border><ContentControl x:Name="ContentHost" Grid.Column="1" Margin="30,24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></Grid>
  </Grid>
</UserControl>
