<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelManagedFrpsView" x:DataType="vm:TunnelManagerViewModel">
  <UserControl.Styles><Style Selector="Border.frps-running-pulse"><Style.Animations><Animation Duration="0:0:1.8" IterationCount="INFINITE"><KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.18"/></KeyFrame><KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.7"/></KeyFrame><KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.18"/></KeyFrame></Animation></Style.Animations></Style></UserControl.Styles>
  <StackPanel Spacing="18">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><StackPanel Spacing="5"><TextBlock Text="{loc:Loc tunnels.frps}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc tunnels.frps_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Content="{loc:Loc tunnels.frps.diagnostics}" Command="{Binding OpenManagedFrpsDiagnosticsCommand}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="{loc:Loc tunnels.frps.configure}" Command="{Binding OpenManagedFrpsConfigurationCommand}" VerticalAlignment="Center"/></Grid>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="26" IsVisible="{Binding IsFrpsLoading}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><ProgressBar IsIndeterminate="True" Width="180"/><TextBlock Text="{loc:Loc tunnels.frps.loading}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/></StackPanel></Border>
    <Border Background="{DynamicResource WarningMutedBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="16" Padding="22" IsVisible="{Binding FrpsLoadFailed}"><StackPanel Spacing="8"><TextBlock Text="{loc:Loc tunnels.frps.load_failed}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="26" IsVisible="{Binding IsFrpsLoaded}"><Grid ColumnDefinitions="250,*" ColumnSpacing="28">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><Button Classes="frps-power" Command="{Binding ToggleManagedFrpsCommand}" IsEnabled="{Binding CanManage}" ToolTip.Tip="{Binding FrpsActionText}"><Grid Width="132" Height="132"><Border Classes="frps-running-pulse" Background="{DynamicResource SuccessMutedBrush}" CornerRadius="66" IsVisible="{Binding FrpsIsRunning}"/><Border Background="{DynamicResource WarningMutedBrush}" CornerRadius="66" IsVisible="{Binding !FrpsIsRunning}" Opacity="0.55"/><Border Background="{DynamicResource SuccessBrush}" CornerRadius="54" Margin="12" IsVisible="{Binding FrpsIsRunning}"/><Border Background="{DynamicResource WarningBrush}" CornerRadius="54" Margin="12" IsVisible="{Binding !FrpsIsRunning}"/><Path Data="M13,3 H11 V13 H13 Z M17.83,5.17 L16.41,6.59 A7,7 0 1,1 7.59,6.59 L6.17,5.17 A9,9 0 1,0 17.83,5.17 Z" Width="48" Height="48" Stretch="Uniform" Fill="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button><TextBlock Text="{Binding FrpsActionText}" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
      <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource SuccessBrush}" IsVisible="{Binding FrpsIsRunning}" VerticalAlignment="Center"/><Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource WarningBrush}" IsVisible="{Binding !FrpsIsRunning}" VerticalAlignment="Center"/><TextBlock Text="{Binding FrpsStateLabel}" FontSize="20" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding FrpsStateText}" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !FrpsIsRunning}" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="16"><StackPanel><TextBlock Text="{loc:Loc tunnels.frps.connections}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding FrpsConnectionCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc tunnels.frps.connections_hint}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.frps.endpoint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding FrpsEndpoint}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc tunnels.frps.listen_hint}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="{loc:Loc tunnels.frps.allow_ports_short}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding FrpsAllowedPortsSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.frps.started_at}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding FrpsStartedAtText}" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel>
    </Grid></Border>
    <Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" Padding="16"><StackPanel Spacing="5"><TextBlock Text="{loc:Loc tunnels.frps.overview_note}" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc tunnels.frps.overview_note_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border>
  </StackPanel>
</UserControl>
