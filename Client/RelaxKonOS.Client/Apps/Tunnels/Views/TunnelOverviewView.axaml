<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelOverviewView" x:DataType="vm:TunnelManagerViewModel">
  <StackPanel Spacing="18"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="18"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="6"><TextBlock Text="{loc:Loc tunnels.runtime_page}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding RuntimeText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="6"><TextBlock Text="{loc:Loc tunnels.connected}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding ConnectedTunnelCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc tunnels.connected_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="6"><TextBlock Text="{loc:Loc tunnels.saved}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><TextBlock Text="{Binding SavedTunnelCount}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc tunnels.saved_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></StackPanel></Border></Grid><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc tunnels.overview}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc tunnels.overview_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel><TextBlock Text="{loc:Loc tunnels.servers}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Profiles.Count}" FontSize="22" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.items}" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding Tunnels.Count}" FontSize="22" FontWeight="SemiBold"/></StackPanel></Grid><Button Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/></StackPanel></Border><Border Background="{DynamicResource AccentMutedBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="14" Padding="18"><TextBlock Text="{loc:Loc tunnels.safety_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/></Border></StackPanel>
</UserControl>
