<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" xmlns:tunnels="clr-namespace:RelaxKonOS.Protocol.Tunnels;assembly=RelaxKonOS.Protocol" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelDefinitionEditorView" x:DataType="vm:TunnelDefinitionEditorViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12" Margin="22"><TextBlock Text="{loc:Loc tunnels.tunnel_editor}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="9"><StackPanel><TextBlock Text="{loc:Loc tunnels.field.name}"/><TextBox Text="{Binding Name, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.server}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="tunnels:TunnelServerProfileDto"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="{loc:Loc tunnels.field.protocol}"/><ComboBox ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{loc:Loc tunnels.field.local_host}"/><TextBox Text="{Binding LocalHost, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="{loc:Loc tunnels.field.local_port}"/><TextBox Text="{Binding LocalPort, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" IsVisible="{Binding UsesRemotePort}"><TextBlock Text="{loc:Loc tunnels.field.remote_port}"/><TextBox Text="{Binding RemotePort, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding UsesDomain}"><TextBlock Text="{loc:Loc tunnels.field.domain}"/><TextBox Text="{Binding Domain, Mode=TwoWay}"/></StackPanel></Grid><WrapPanel ItemHeight="32" Margin="0,4,0,0"><CheckBox Content="{loc:Loc tunnels.field.enabled}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,14,0"/><CheckBox Content="{loc:Loc tunnels.field.encryption}" IsChecked="{Binding Encryption, Mode=TwoWay}" Margin="0,0,14,0"/><CheckBox Content="{loc:Loc tunnels.field.compression}" IsChecked="{Binding Compression, Mode=TwoWay}"/></WrapPanel><WrapPanel Margin="0,6,0,0"><Button Classes="primary" Content="{loc:Loc common.save}" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="{loc:Loc common.cancel}" Command="{Binding CloseCommand}" Margin="0,0,12,0"/><Button Content="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditing}" Foreground="{DynamicResource DangerBrush}"/></WrapPanel></StackPanel></ScrollViewer>
</UserControl>
