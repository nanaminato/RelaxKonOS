<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization" xmlns:vm="clr-namespace:RelaxKonOS.Client.Apps.Tunnels" x:Class="RelaxKonOS.Client.Apps.Tunnels.Views.TunnelRuntimeView" x:DataType="vm:TunnelManagerViewModel" Classes="builtin-app">
  <StackPanel Spacing="18">
    <Border Padding="20" Classes="app-panel">
      <StackPanel Spacing="12">
        <TextBlock Text="{loc:Loc tunnels.runtime_page}" FontSize="19" FontWeight="SemiBold"/>

        <StackPanel IsVisible="{Binding RuntimeIsInstalled}" Spacing="14">
          <Border Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="10" Padding="16">
            <StackPanel Spacing="7">
              <TextBlock Text="{loc:Loc tunnels.runtime.install_state.Succeeded}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding RuntimeInstalledVersion}" FontSize="16"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding RuntimeText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock Text="{Binding RuntimeText}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc tunnels.runtime.manage_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
