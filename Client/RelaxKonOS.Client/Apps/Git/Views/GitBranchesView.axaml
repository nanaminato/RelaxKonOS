<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitBranchesView"
             x:DataType="git:GitClientViewModel">
    <Grid RowDefinitions="Auto,*" MinHeight="300">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Command="{Binding CreateBranchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="➕" />
                    <TextBlock Text="{loc:Loc git.branches.new_branch}" />
                </StackPanel>
            </Button>
            <Button Click="Checkout_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🔄" />
                    <TextBlock Text="{loc:Loc git.branches.checkout}" />
                </StackPanel>
            </Button>
            <Button Click="Delete_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="🗑" />
                    <TextBlock Text="{loc:Loc git.branches.delete}" />
                </StackPanel>
            </Button>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="4">
            <DataGrid x:Name="BranchGrid" ItemsSource="{Binding Branches}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                      CanUserResizeColumns="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc git.branches.col_name}" Binding="{Binding Name}" Width="160" CanUserResize="True" />
                    <DataGridCheckBoxColumn Header="{loc:Loc git.branches.col_current}" Binding="{Binding IsCurrent}" IsReadOnly="True" Width="70" CanUserResize="True" />
                    <DataGridCheckBoxColumn Header="{loc:Loc git.branches.col_remote}" Binding="{Binding IsRemote}" IsReadOnly="True" Width="70" CanUserResize="True" />
                    <DataGridTextColumn Header="{loc:Loc git.branches.col_upstream}" Binding="{Binding Tracking}" Width="*" CanUserResize="True" />
                    <DataGridTextColumn Header="{loc:Loc git.branches.col_ahead}" Binding="{Binding Ahead}" Width="70" CanUserResize="True" />
                    <DataGridTextColumn Header="{loc:Loc git.branches.col_behind}" Binding="{Binding Behind}" Width="70" CanUserResize="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
