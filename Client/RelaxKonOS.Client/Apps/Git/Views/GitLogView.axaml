<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:gitViews="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitLogView"
             x:Name="LogViewRoot"
             x:DataType="git:GitClientViewModel"
             x:CompileBindings="False"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Styles>
        <Style Selector="ComboBox.historyFilter">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="MaxDropDownHeight" Value="320" />
        </Style>
        <Style Selector="Border.historyField">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.historyField:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.historyField TextBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.historyField ToggleButton">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.historyField Button">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid x:Name="LogLayoutRoot" ColumnDefinitions="190,6,*,6,280" MinHeight="380">

        <!-- ============================================================
             LEFT PANE : Branch / Tag Tree (Fork-style)
             ============================================================ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="8"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- 搜索框 -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="🔍" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" PlaceholderText="{loc:Loc git.log.branch_search_watermark}" BorderThickness="0" Background="Transparent"
                                 Text="{Binding BranchSearchText, Mode=TwoWay}"
                                 FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 快捷操作按钮栏 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,6">
                    <Button Content="➕" Command="{Binding CreateBranchCommand}"
                            ToolTip.Tip="{loc:Loc git.branches.new_branch}" FontSize="12" Padding="6,2" />
                    <Button Content="⬇" Command="{Binding FetchCommand}"
                            ToolTip.Tip="{loc:Loc git.log.menu.fetch_all}" FontSize="12" Padding="6,2" />
                    <Button Content="⟳" Command="{Binding RefreshCommand}"
                            ToolTip.Tip="{loc:Loc git.refresh}" FontSize="12" Padding="6,2" />
                </StackPanel>

                <!-- 分支 TreeView -->
                <TreeView Grid.Row="2" x:Name="BranchTree"
                          SelectionChanged="BranchTree_SelectionChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Background="Transparent" MinHeight="28"
                                        DoubleTapped="BranchNode_DoubleTapped"
                                        ToolTip.Tip="{Binding DisplayName}">
                                <ContentPresenter Content="{Binding Icon}" />
                                <!-- Branch names must remain readable in every palette.  The
                                     node-specific brush is static and can become white after a
                                     theme change, so use the live theme foreground here. -->
                                <TextBlock Text="{Binding DisplayName}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontWeight="{Binding FontWeight}" />
                                <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"
                                           IsVisible="{Binding HasBadge}" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.Styles>
                        <!-- 给每个 TreeViewItem 挂上右键菜单，DataContext 为 BranchTreeNode -->
                        <Style Selector="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="ContextMenu">
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc git.log.menu.checkout}"
                                              Command="{Binding $parent[UserControl].DataContext.CheckoutBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="👉"
                                              IsVisible="{Binding CanCheckout}" />
                                    <MenuItem Header="{loc:Loc git.log.menu.checkout_and_update}"
                                              Command="{Binding $parent[UserControl].DataContext.CheckoutAndUpdateBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="🔄"
                                              IsVisible="{Binding CanCheckoutAndUpdate}" />
                                    <MenuItem Header="{Binding NewBranchMenuText}"
                                              Command="{Binding $parent[UserControl].DataContext.CreateBranchFromHereCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="🌿"
                                              IsVisible="{Binding IsActionableBranch}" />
                                    <MenuItem Header="{loc:Loc git.log.menu.diff_working_tree}"
                                              Command="{Binding $parent[UserControl].DataContext.CompareBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="↔"
                                              IsVisible="{Binding IsActionableBranch}" />
                                    <MenuItem Header="{Binding CompareMenuText}"
                                              Command="{Binding $parent[UserControl].DataContext.CompareBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="↔"
                                              IsVisible="{Binding CanMergeIntoCurrent}" />
                                    <MenuItem Header="{Binding MergeMenuText}"
                                              Command="{Binding $parent[UserControl].DataContext.MergeBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="⊕"
                                              IsVisible="{Binding CanMergeIntoCurrent}" />
                                    <Separator IsVisible="{Binding IsActionableBranch}" />
                                    <MenuItem Header="{Binding PullMenuText}"
                                              Command="{Binding $parent[UserControl].DataContext.PullBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="🔄"
                                              IsVisible="{Binding CanUpdate}" />
                                    <MenuItem Header="{loc:Loc git.log.menu.push}"
                                              Command="{Binding $parent[UserControl].DataContext.PushBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="⬆"
                                              IsVisible="{Binding CanPush}" />
                                    <MenuItem Header="{loc:Loc git.log.menu.tracked_branch}"
                                              Command="{Binding $parent[UserControl].DataContext.SetUpstreamBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="🔗"
                                              IsVisible="{Binding IsCurrentLocalBranch}" />
                                    <Separator IsVisible="{Binding IsActionableBranch}" />
                                    <MenuItem Header="{loc:Loc git.log.menu.rename}"
                                              Command="{Binding $parent[UserControl].DataContext.RenameBranchCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="✏"
                                              IsVisible="{Binding CanRename}" />
                                    <MenuItem Header="{loc:Loc git.log.menu.delete_branch}"
                                              Command="{Binding $parent[UserControl].DataContext.DeleteBranchContextCommand}"
                                              CommandParameter="{Binding Branch}"
                                              Icon="🗑"
                                              IsVisible="{Binding CanDelete}" />
                                </ContextMenu>
                            </Setter>
                        </Style>
                    </TreeView.Styles>
                </TreeView>
            </Grid>
        </Border>

        <!-- 分隔条（占位，5px 宽） -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ============================================================
             MIDDLE PANE : Commit list (history) with toolbar
             ============================================================ -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="0"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <!-- 顶部筛选工具栏 -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}" Padding="12,8,4,4" CornerRadius="8,8,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Loc git.page.log}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="⟳" Command="{Binding RefreshCommand}"
                                    ToolTip.Tip="{loc:Loc git.refresh}" Padding="8,4" />
                        </Grid>
                        <WrapPanel Orientation="Horizontal">
                            <!-- 搜索框 -->
                            <Border Classes="historyField" Width="240">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                    <TextBlock Text="🔍" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" PlaceholderText="{loc:Loc git.log.commit_search_watermark}" BorderThickness="0" Background="Transparent"
                                             Text="{Binding CommitSearchText, Mode=TwoWay}"
                                             FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0"
                                             VerticalContentAlignment="Center" />
                                    <ToggleButton Grid.Column="2" Content=".*" ToolTip.Tip="{loc:Loc git.log.regex}" FontSize="11" Padding="6,0"
                                                  IsChecked="{Binding IsLogRegex, Mode=TwoWay}"
                                                  Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" />
                                    <ToggleButton Grid.Column="3" Content="Cc" ToolTip.Tip="{loc:Loc git.log.case_sensitive}" FontSize="11" Padding="4,0"
                                                  IsChecked="{Binding IsLogCaseSensitive, Mode=TwoWay}"
                                                  Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" />
                                    <Button Grid.Column="4" Content="🔍" ToolTip.Tip="{loc:Loc git.log.search_history}"
                                            Command="{Binding ApplyLogFiltersCommand}" FontSize="11" Padding="4,0"
                                            Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" />
                                </Grid>
                            </Border>
                            <!-- These controls issue a server-side git log query. -->
                            <ComboBox x:Name="LogBranchFilter" Classes="historyFilter" Width="180"
                                      ToolTip.Tip="{Binding SelectedLogBranch.Label}"
                                      ItemsSource="{Binding LogBranchOptions}" SelectedItem="{Binding SelectedLogBranch, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="LogAuthorFilter" Classes="historyFilter" Width="140"
                                      ToolTip.Tip="{Binding SelectedLogAuthor.Label}"
                                      ItemsSource="{Binding LogAuthorOptions}" SelectedItem="{Binding SelectedLogAuthor, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox x:Name="LogDateFilter" Classes="historyFilter" Width="120"
                                      ItemsSource="{Binding LogDateOptions}" SelectedItem="{Binding SelectedLogDate, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <Border x:Name="LogPathFilter" Classes="historyField" Width="180">
                                <TextBox PlaceholderText="{loc:Loc git.log.filter_path}" BorderThickness="0" Background="Transparent"
                                         Text="{Binding LogPathFilter, Mode=TwoWay}" FontSize="12" Padding="0"
                                         VerticalContentAlignment="Center" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 提交列表（ListBox 自定义 item，Fork 样式） -->
                <ListBox Grid.Row="1" x:Name="CommitList" ItemsSource="{Binding Commits}"
                         SelectedItem="{Binding SelectedCommit, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto" MinHeight="52"
                                  HorizontalAlignment="Stretch" Margin="4,3" ToolTip.Tip="{Binding Subject}">
                                <Ellipse Grid.RowSpan="2" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"
                                         VerticalAlignment="Top" Margin="0,6,0,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                <Grid Grid.Column="1" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,5,0,0">
                                    <TextBlock Text="{Binding ShortSha}" FontSize="11" Margin="0,0,10,0"
                                               FontFamily="Cascadia Code,Consolas,monospace" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Author}" FontSize="11" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding AuthorDate, Converter={x:Static gitViews:GitLogConverters.CommitDateConverter}}"
                                               ToolTip.Tip="{Binding AuthorDate}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerTheme>
                        <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="ContextMenu">
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc git.log.menu.copy_sha}"
                                              Command="{Binding $parent[UserControl].DataContext.CopyShaCommand}"
                                              CommandParameter="{Binding}" Icon="📋" />
                                    <MenuItem Header="{loc:Loc git.log.menu.create_patch}"
                                              Command="{Binding $parent[UserControl].DataContext.CreatePatchFromCommitCommand}"
                                              CommandParameter="{Binding}" Icon="🧵" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc git.log.menu.cherry_pick}" IsEnabled="False" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <MenuItem Header="{loc:Loc git.log.menu.checkout_revision}"
                                                  Command="{Binding $parent[UserControl].DataContext.CheckoutCommitCommand}"
                                                  CommandParameter="{Binding}" Icon="👉" />
                                        <MenuItem Header="{loc:Loc git.log.menu.show_in_revision}"
                                                  Command="{Binding $parent[UserControl].DataContext.ShowFileHistoryCommand}"
                                                  CommandParameter="{Binding}" Icon="📁" />
                                        <MenuItem Header="{loc:Loc git.log.menu.compare_local}"
                                                  Command="{Binding $parent[UserControl].DataContext.ResetToCommitCommand}"
                                                  CommandParameter="{Binding}" Icon="↔" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="{loc:Loc git.log.menu.reset_to_here}"
                                              Command="{Binding $parent[UserControl].DataContext.ResetToCommitCommand}"
                                              CommandParameter="{Binding}" Icon="↺" />
                                    <MenuItem Header="{loc:Loc git.log.menu.revert_commit}"
                                              Command="{Binding $parent[UserControl].DataContext.RevertCommitContextCommand}"
                                              CommandParameter="{Binding}" Icon="↩" />
                                    <MenuItem Header="{loc:Loc git.log.menu.undo_commit}"
                                              Command="{Binding $parent[UserControl].DataContext.UndoCommitCommand}"
                                              CommandParameter="{Binding}" Icon="⏪" />
                                    <MenuItem Header="{loc:Loc git.log.menu.edit_message}"
                                              Command="{Binding $parent[UserControl].DataContext.EditCommitMessageCommand}"
                                              CommandParameter="{Binding}" Icon="✏" />
                                    <MenuItem Header="{loc:Loc git.log.menu.fixup}"
                                              Command="{Binding $parent[UserControl].DataContext.SquashFromHereCommand}"
                                              CommandParameter="{Binding}" Icon="🔧" />
                                    <MenuItem Header="{loc:Loc git.log.menu.squash_into}"
                                              Command="{Binding $parent[UserControl].DataContext.SquashFromHereCommand}"
                                              CommandParameter="{Binding}" Icon="📦" />
                                    <MenuItem Header="{loc:Loc git.log.menu.delete_commit}"
                                              Command="{Binding $parent[UserControl].DataContext.UndoCommitCommand}"
                                              CommandParameter="{Binding}" Icon="🗑" />
                                    <MenuItem Header="{loc:Loc git.log.menu.squash_commits}"
                                              Command="{Binding $parent[UserControl].DataContext.SquashFromHereCommand}"
                                              CommandParameter="{Binding}" Icon="🗃" />
                                    <MenuItem Header="{loc:Loc git.log.menu.rebase_interactive}"
                                              Command="{Binding $parent[UserControl].DataContext.RebaseInteractiveFromHereCommand}"
                                              CommandParameter="{Binding}" Icon="♻" />
                                    <MenuItem Header="{loc:Loc git.log.menu.push_all_before}"
                                              Command="{Binding $parent[UserControl].DataContext.PushAllBeforeCommand}"
                                              CommandParameter="{Binding}" Icon="⬆" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc git.log.menu.branch_origin_master}" IsEnabled="False" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <MenuItem Header="{loc:Loc git.log.menu.new_branch}"
                                              Command="{Binding $parent[UserControl].DataContext.CreateBranchAtCommitCommand}"
                                              CommandParameter="{Binding}" Icon="🌿" />
                                    <MenuItem Header="{loc:Loc git.log.menu.new_tag}"
                                              Command="{Binding $parent[UserControl].DataContext.CreateTagFromCommitCommand}"
                                              CommandParameter="{Binding}" Icon="🏷" />
                                </ContextMenu>
                            </Setter>
                        </ControlTheme>
                    </ListBox.ItemContainerTheme>
                </ListBox>
                <TextBlock Grid.Row="1" Text="{loc:Loc git.log.no_results}" IsVisible="{Binding !Commits.Count}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ============================================================
             RIGHT PANE : Changed files + Commit details
             ============================================================ -->
        <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="0"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1">
            <Grid RowDefinitions="Auto,*,5,*">
                <!-- 文件树标题栏 -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}" Padding="10,6" CornerRadius="8,8,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="📁" />
                            <Run Text="  " />
                            <Run Text="{Binding CommitChangedFiles.Count, Converter={x:Static git:GitPickerConverters.LocalizedFormat}, ConverterParameter='git.log.file_count_format'}" />
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 变更文件树（按路径分层展示） -->
                <TreeView Grid.Row="1" x:Name="ChangedFileTree"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionChanged="ChangedFileTree_SelectionChanged">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="gitViews:CommitFileTreeNode" ItemsSource="{Binding Children}">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="24">
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Border Grid.Column="2" IsVisible="{Binding IsFile}"
                                        Background="{Binding Status, Converter={x:Static gitViews:GitLogConverters.StatusBgConverter}}"
                                        CornerRadius="3" Padding="4,0" Margin="4,0,0,0">
                                    <TextBlock Text="{Binding Status, Converter={x:Static gitViews:GitLogConverters.StatusLabelConverter}}"
                                               FontSize="10" Foreground="{DynamicResource TextOnAccentBrush}" />
                                </Border>
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>

                    <TreeView.Styles>
                        <Style Selector="TreeViewItem">
                            <Setter Property="ContextMenu">
                                <ContextMenu>
                                    <MenuItem Header="{loc:Loc git.log.menu.show_diff}"
                                              Command="{Binding $parent[UserControl].DataContext.ShowCommitFileDiffCommand}"
                                              CommandParameter="{Binding File}" Icon="↔" />
                                    <MenuItem Header="{loc:Loc git.log.menu.diff_new_tab}"
                                              Command="{Binding $parent[UserControl].DataContext.ShowCommitFileDiffCommand}"
                                              CommandParameter="{Binding File}" Icon="🗐" />
                                    <MenuItem Header="{loc:Loc git.log.menu.compare_with_local}"
                                              Command="{Binding $parent[UserControl].DataContext.ShowFileDiffContextCommand}"
                                              CommandParameter="{Binding File}" Icon="🆚" />
                                    <MenuItem Header="{loc:Loc git.log.menu.compare_previous_local}"
                                              Command="{Binding $parent[UserControl].DataContext.ShowFileHistoryCommand}"
                                              CommandParameter="{Binding File}" Icon="⏳" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc git.log.menu.edit_source}"
                                              Command="{Binding $parent[UserControl].DataContext.OpenFileInEditorCommand}"
                                              CommandParameter="{Binding File}" Icon="📝" />
                                    <MenuItem Header="{loc:Loc git.log.menu.open_repo_version}"
                                              Command="{Binding $parent[UserControl].DataContext.OpenFileInEditorCommand}"
                                              CommandParameter="{Binding File}" Icon="📂" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc git.log.menu.revert_selected}"
                                              Command="{Binding $parent[UserControl].DataContext.RevertFileChangeCommand}"
                                              CommandParameter="{Binding File}" Icon="↺" />
                                    <MenuItem Header="{loc:Loc git.log.menu.cherry_pick_selected}"
                                              Command="{Binding $parent[UserControl].DataContext.StageFileContextCommand}"
                                              CommandParameter="{Binding File}" Icon="✅" />
                                    <MenuItem Header="{loc:Loc git.log.menu.extract_to_commit}"
                                              Command="{Binding $parent[UserControl].DataContext.CreatePatchFromFileCommand}"
                                              CommandParameter="{Binding File}" Icon="✂" />
                                    <MenuItem Header="{loc:Loc git.log.menu.delete_selected}"
                                              Command="{Binding $parent[UserControl].DataContext.RevertFileChangeCommand}"
                                              CommandParameter="{Binding File}" Icon="🗑" />
                                    <Separator />
                                    <MenuItem Header="{loc:Loc git.log.menu.create_patch}"
                                              Command="{Binding $parent[UserControl].DataContext.CreatePatchFromFileCommand}"
                                              CommandParameter="{Binding File}" Icon="🧵" />
                                    <MenuItem Header="{loc:Loc git.log.menu.get_from_revision}"
                                              Command="{Binding $parent[UserControl].DataContext.ShowCommitFileDiffCommand}"
                                              CommandParameter="{Binding File}" Icon="⬇" />
                                    <MenuItem Header="{loc:Loc git.log.menu.history_so_far}"
                                              Command="{Binding $parent[UserControl].DataContext.ShowFileHistoryCommand}"
                                              CommandParameter="{Binding File}" Icon="📜" />
                                    <MenuItem Header="{loc:Loc git.log.menu.show_changes_to_parent}"
                                              Command="{Binding $parent[UserControl].DataContext.ShowCommitFileDiffCommand}"
                                              CommandParameter="{Binding File}" Icon="↔" />
                                </ContextMenu>
                            </Setter>
                        </Style>
                    </TreeView.Styles>
                </TreeView>

                <GridSplitter Grid.Row="2"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource SurfaceBrush}"/>

                <!-- 选中提交详情 -->
                <Border Grid.Row="3" Background="Transparent" Padding="12" CornerRadius="0,0,8,8"
                        IsVisible="{Binding SelectedCommit, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SelectedCommit.Subject}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedCommit.ShortSha}" FontSize="11"
                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc git.log.author}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedCommit.Author}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="&lt;" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedCommit.AuthorEmail}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="&gt;" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="," FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedCommit.AuthorDate}" FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SelectedCommit.Body}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" IsVisible="{Binding SelectedCommit.Body, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
