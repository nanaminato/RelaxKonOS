<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git" xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
 xmlns:ui="clr-namespace:RelaxKonOS.Client.Controls" xmlns:explorer="clr-namespace:RelaxKonOS.Client.Apps.Explorer.Controls"
 xmlns:gitViews="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
 x:Class="RelaxKonOS.Client.Apps.Git.Views.GitLogView" x:Name="LogViewRoot" x:DataType="git:GitClientViewModel"
 x:CompileBindings="False" Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">
 <UserControl.Styles>
  <Style Selector="ListBox#CommitList:not(:focus-within) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/></Style>
  <Style Selector="ListBox#CommitList ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="26"/><Setter Property="Height" Value="26"/></Style>
  <Style Selector="Button.log-tool"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="27"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="5"/></Style>
  <Style Selector="ToggleButton.log-tool"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Width" Value="27"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="5"/></Style>
  <Style Selector="ComboBox.historyFilter"><Setter Property="MinHeight" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="6,0"/><Setter Property="FontSize" Value="12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="MaxDropDownHeight" Value="320"/></Style>
  <Style Selector="Border.historyField"><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="8,0"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.historyField TextBox"><Setter Property="MinHeight" Value="0"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="4,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <!-- The surrounding field owns the border and focus ring, including the search icon. -->
  <Style Selector="Border.historyField TextBox:not(:focus) /template/ Border#PART_BorderElement"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Border.historyField TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="Border.historyField:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/></Style>
  <Style Selector="Button.history-path"><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style Selector="TreeViewItem"><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/></Style>
 </UserControl.Styles>
 <Grid x:Name="LogLayoutRoot" ColumnDefinitions="280,4,*,4,260,0,0">
  <Border x:Name="BranchPane" Grid.Column="0" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
   <Grid ColumnDefinitions="30,*">
    <StackPanel Margin="1,5,1,0" Spacing="1">
     <Button Classes="log-tool" Click="HideBranches_Click" ToolTip.Tip="{loc:Loc git.dock.hide_branches}"><ui:WorkspaceIcon Kind="Back"/></Button>
     <Button Classes="log-tool" IsEnabled="{Binding CanManage}" Command="{Binding CreateBranchFromHereCommand}" CommandParameter="{Binding SelectedBranch}" ToolTip.Tip="{loc:Loc git.branches.new_branch}"><ui:WorkspaceIcon Kind="Plus"/></Button>
     <Button Classes="log-tool" Command="{Binding FetchCommand}" ToolTip.Tip="{loc:Loc git.log.menu.fetch_all}"><ui:WorkspaceIcon Kind="Download"/></Button>
     <Button x:Name="DeleteBranchButton" Classes="log-tool" Command="{Binding DeleteBranchContextCommand}" CommandParameter="{Binding SelectedBranch}" ToolTip.Tip="{loc:Loc git.log.menu.delete_branch}"><ui:WorkspaceIcon Kind="Delete"/></Button>
     <Button x:Name="CompareBranchButton" Classes="log-tool" Click="CompareSelectedBranch_Click" ToolTip.Tip="{loc:Loc git.log.menu.diff_working_tree}"><ui:WorkspaceIcon Kind="Compare"/></Button>
     <Button x:Name="FavoriteBranchButton" Classes="log-tool" Click="FavoriteBranch_Click" ToolTip.Tip="{loc:Loc git.workspace.favorite}"><ui:WorkspaceIcon Kind="Star"/></Button>
     <Button Classes="log-tool" Click="BranchOptions_Click" ToolTip.Tip="{loc:Loc git.editor.tool_options}"><ui:WorkspaceIcon Kind="Settings"/></Button>
     <Button Classes="log-tool" Click="ExpandBranches_Click" ToolTip.Tip="{loc:Loc git.dock.expand_all}"><ui:WorkspaceIcon Kind="Expand"/></Button>
     <Button Classes="log-tool" Click="CollapseBranches_Click" ToolTip.Tip="{loc:Loc git.dock.collapse_all}"><ui:WorkspaceIcon Kind="Collapse"/></Button>
    </StackPanel>
    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="4,4,4,0">
     <Border Classes="historyField" Margin="0,0,0,6"><Grid ColumnDefinitions="18,*" ColumnSpacing="4"><ui:WorkspaceIcon Kind="Search" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Grid.Column="1" PlaceholderText="{loc:Loc git.log.branch_search_watermark}" Text="{Binding BranchSearchText, Mode=TwoWay}"/></Grid></Border>
     <TreeView Grid.Row="1" x:Name="BranchTree" SelectionChanged="BranchTree_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}">
       <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="24" DoubleTapped="BranchNode_DoubleTapped" ToolTip.Tip="{Binding Branch.Name}">
        <ui:WorkspaceIcon Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="{Binding FontWeight}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Badge}" IsVisible="{Binding HasBadge}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
       </StackPanel>
      </TreeDataTemplate></TreeView.ItemTemplate>
      <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="ContextMenu"><ContextMenu>
       <MenuItem Header="{loc:Loc git.log.menu.checkout}" Command="{Binding $parent[UserControl].DataContext.CheckoutBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanCheckout}"/>
       <MenuItem Header="{loc:Loc git.log.menu.checkout_and_update}" Command="{Binding $parent[UserControl].DataContext.CheckoutAndUpdateBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanCheckoutAndUpdate}"/>
       <MenuItem Header="{loc:Loc git.log.menu.create_branch_here}" Command="{Binding $parent[UserControl].DataContext.CreateBranchFromHereCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding IsBranch}"/>
       <MenuItem Header="{loc:Loc git.workspace.merge}" Command="{Binding $parent[UserControl].DataContext.MergeBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanMergeIntoCurrent}"/>
       <MenuItem Header="{loc:Loc git.workspace.rebase}" Command="{Binding $parent[UserControl].DataContext.RebaseBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanMergeIntoCurrent}"/>
       <MenuItem Header="{loc:Loc git.log.menu.diff_working_tree}" Command="{Binding $parent[UserControl].DataContext.CompareBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding IsBranch}"/>
       <MenuItem Header="{loc:Loc git.log.menu.push}" Command="{Binding $parent[UserControl].DataContext.PushBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanPush}"/>
       <MenuItem Header="{loc:Loc git.log.menu.tracked_branch}" Command="{Binding $parent[UserControl].DataContext.SetUpstreamBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanRename}"/>
       <MenuItem Header="{loc:Loc git.log.menu.rename}" Command="{Binding $parent[UserControl].DataContext.RenameBranchCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanRename}"/>
       <MenuItem Header="{loc:Loc git.log.menu.delete_branch}" Command="{Binding $parent[UserControl].DataContext.DeleteBranchContextCommand}" CommandParameter="{Binding Branch}" IsVisible="{Binding CanDelete}"/>
      </ContextMenu></Setter></Style></TreeView.Styles>
     </TreeView>
    </Grid>
   </Grid>
  </Border>
  <GridSplitter x:Name="BranchSplitter" Grid.Column="1" Width="4" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
  <Grid Grid.Column="2" RowDefinitions="Auto,*" ClipToBounds="True">
   <Grid ColumnDefinitions="Auto,*,Auto" Margin="3,4,3,4">
    <Button x:Name="ShowBranchesButton" Classes="log-tool" Click="ShowBranches_Click" ToolTip.Tip="{loc:Loc git.editor.branches}"><ui:WorkspaceIcon Kind="Branch"/></Button>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
     <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
      <Border Classes="historyField" Width="210"><Grid ColumnDefinitions="18,*,Auto,Auto" ColumnSpacing="4"><ui:WorkspaceIcon Kind="Search" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="CommitSearch" Grid.Column="1" PlaceholderText="{loc:Loc git.log.commit_search_watermark}" Text="{Binding CommitSearchText, Mode=TwoWay}" KeyDown="CommitSearch_KeyDown"/><ToggleButton Grid.Column="2" IsChecked="{Binding IsLogRegex}" Content=".*" FontSize="11" BorderThickness="0" Background="Transparent" Padding="4,0" MinHeight="0" ToolTip.Tip="{loc:Loc git.log.regex}"/><ToggleButton Grid.Column="3" IsChecked="{Binding IsLogCaseSensitive}" Content="Cc" FontSize="11" BorderThickness="0" Background="Transparent" Padding="4,0" MinHeight="0" ToolTip.Tip="{loc:Loc git.log.case_sensitive}"/></Grid></Border>
      <TextBlock Text="{loc:Loc git.log.branch_label}" VerticalAlignment="Center" FontSize="12" Margin="5,0,0,0"/><ComboBox x:Name="LogBranchFilter" Classes="historyFilter" Width="150" ToolTip.Tip="{Binding SelectedLogBranch.Label}" ItemsSource="{Binding LogBranchOptions}" SelectedItem="{Binding SelectedLogBranch, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="{loc:Loc git.log.author_label}" VerticalAlignment="Center" FontSize="12" Margin="5,0,0,0"/><ComboBox x:Name="LogAuthorFilter" Classes="historyFilter" Width="100" ItemsSource="{Binding LogAuthorOptions}" SelectedItem="{Binding SelectedLogAuthor, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="{loc:Loc git.log.date_label}" VerticalAlignment="Center" FontSize="12" Margin="5,0,0,0"/><ComboBox x:Name="LogDateFilter" Classes="historyFilter" Width="90" ItemsSource="{Binding LogDateOptions}" SelectedItem="{Binding SelectedLogDate, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Button Classes="history-path" Content="{loc:Loc git.dock.paths}" Background="Transparent" BorderThickness="0" Padding="5,0" FontSize="12" ToolTip.Tip="{Binding LogPathFilter}"><Button.Flyout><Flyout><StackPanel Width="250" Spacing="8"><TextBlock Text="{loc:Loc git.log.filter_path}"/><Border x:Name="LogPathFilter" Classes="historyField"><TextBox Text="{Binding LogPathFilter, Mode=TwoWay}"/></Border><Button Content="{loc:Loc git.dock.clear_filter}" Click="ClearPathFilter_Click"/></StackPanel></Flyout></Button.Flyout></Button>
     </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Classes="log-tool" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc git.refresh}"><ui:WorkspaceIcon Kind="Refresh"/></Button>
     <Button x:Name="CherryPickButton" Classes="log-tool" Command="{Binding CherryPickCommitCommand}" CommandParameter="{Binding SelectedCommit}" ToolTip.Tip="{loc:Loc git.log.menu.cherry_pick}"><ui:WorkspaceIcon Kind="CherryPick"/></Button>
     <Button Classes="log-tool" ToolTip.Tip="{loc:Loc git.dock.presentation}"><ui:WorkspaceIcon Kind="Eye"/><Button.Flyout><Flyout><StackPanel Spacing="8"><CheckBox x:Name="AuthorsOption" Content="{loc:Loc git.dock.show_authors}" IsChecked="True" IsCheckedChanged="Presentation_Changed"/><CheckBox x:Name="DatesOption" Content="{loc:Loc git.dock.show_dates}" IsChecked="True" IsCheckedChanged="Presentation_Changed"/><CheckBox x:Name="ReferencesOption" Content="{loc:Loc git.dock.show_refs}" IsChecked="True" IsCheckedChanged="Presentation_Changed"/></StackPanel></Flyout></Button.Flyout></Button>
    </StackPanel>
   </Grid>
   <ListBox Grid.Row="1" x:Name="CommitList" SelectionChanged="CommitList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="Transparent" Padding="0">
    <ListBox.ItemTemplate><DataTemplate>
     <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Height="26" ToolTip.Tip="{Binding ToolTip}">
      <gitViews:GitCommitGraphCell Row="{Binding Graph}" Width="{Binding #LogViewRoot.GraphWidth}" Height="26"/>
      <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,6,0" Opacity="{Binding IsMerge, Converter={x:Static gitViews:GitLogConverters.MergeOpacityConverter}}"/>
      <ItemsControl Grid.Column="2" ItemsSource="{Binding References}" IsVisible="{Binding #LogViewRoot.ShowReferences}" MaxWidth="170" VerticalAlignment="Center" Margin="0,0,5,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="3" Padding="3,1" BorderThickness="1" BorderBrush="{Binding Foreground}"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground}" FontSize="10" MaxWidth="120" TextTrimming="CharacterEllipsis"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Grid.Column="3" Text="{Binding Author}" Width="92" IsVisible="{Binding #LogViewRoot.ShowAuthors}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock Grid.Column="4" Text="{Binding AuthorDate, Converter={x:Static gitViews:GitLogConverters.CommitDateConverter}}" Width="118" IsVisible="{Binding #LogViewRoot.ShowDates}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
    <ListBox.ItemContainerTheme><ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="26"/><Setter Property="CornerRadius" Value="3"/><Setter Property="ContextMenu"><ContextMenu>
     <MenuItem Header="{loc:Loc git.log.menu.copy_sha}" Command="{Binding $parent[UserControl].DataContext.CopyShaCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.create_patch}" Command="{Binding $parent[UserControl].DataContext.CreatePatchFromCommitCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.cherry_pick}" Command="{Binding $parent[UserControl].DataContext.CherryPickCommitCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.checkout_revision}" Command="{Binding $parent[UserControl].DataContext.CheckoutCommitCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.reset_to_here}" Command="{Binding $parent[UserControl].DataContext.ResetToCommitCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.revert_commit}" Command="{Binding $parent[UserControl].DataContext.RevertCommitContextCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.undo_commit}" Command="{Binding $parent[UserControl].DataContext.UndoCommitCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.new_branch}" Command="{Binding $parent[UserControl].DataContext.CreateBranchAtCommitCommand}" CommandParameter="{Binding Commit}"/>
     <MenuItem Header="{loc:Loc git.log.menu.new_tag}" Command="{Binding $parent[UserControl].DataContext.CreateTagFromCommitCommand}" CommandParameter="{Binding Commit}"/>
    </ContextMenu></Setter></ControlTheme></ListBox.ItemContainerTheme>
   </ListBox>
   <TextBlock Grid.Row="1" Text="{loc:Loc git.log.no_results}" IsVisible="{Binding !Commits.Count}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>
  </Grid>
  <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent"/>
  <Border Grid.Column="4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0">
   <Grid RowDefinitions="Auto,3*,4,*">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="5,4" Height="30">
     <TextBlock x:Name="CommitFileCount" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
     <ToggleButton x:Name="DiffPreviewToggle" Grid.Column="1" Classes="log-tool" Click="PreviewDiff_Click" ToolTip.Tip="{loc:Loc git.dock.diff_preview}"><ui:WorkspaceIcon Kind="Eye"/></ToggleButton>
     <Button Grid.Column="2" Classes="log-tool" Click="ExpandFiles_Click" ToolTip.Tip="{loc:Loc git.dock.expand_all}"><ui:WorkspaceIcon Kind="Expand"/></Button>
     <Button Grid.Column="3" Classes="log-tool" Click="CollapseFiles_Click" ToolTip.Tip="{loc:Loc git.dock.collapse_all}"><ui:WorkspaceIcon Kind="Collapse"/></Button>
    </Grid>
    <TreeView Grid.Row="1" x:Name="ChangedFileTree" SelectionChanged="ChangedFileTree_SelectionChanged" DoubleTapped="ChangedFileTree_DoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
     <TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Spacing="5" MinHeight="24"><ui:WorkspaceIcon Kind="Folder" IsVisible="{Binding !IsFile}" Width="15" Height="15" Foreground="{DynamicResource TextSecondaryBrush}"/><explorer:ExplorerIcon FileName="{Binding Name}" EntryType="{Binding EntryType}" IsVisible="{Binding IsFile}" Width="15" Height="15"/><TextBlock Text="{Binding Name}" Foreground="{Binding Status, Converter={x:Static gitViews:GitLogConverters.StatusBgConverter}}" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="{Binding CountLabel}" IsVisible="{Binding !IsFile}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Status, Converter={x:Static gitViews:GitLogConverters.StatusLabelConverter}}" IsVisible="{Binding IsFile}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></StackPanel></TreeDataTemplate></TreeView.ItemTemplate>
     <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="ContextMenu"><ContextMenu>
      <MenuItem Header="{loc:Loc git.log.menu.show_diff}" Command="{Binding $parent[UserControl].DataContext.ShowCommitFileDiffCommand}" CommandParameter="{Binding File}" IsVisible="{Binding IsFile}"/>
      <MenuItem Header="{loc:Loc git.log.menu.diff_new_tab}" Command="{Binding $parent[UserControl].DataContext.ShowFileDiffContextCommand}" CommandParameter="{Binding File}" IsVisible="{Binding IsFile}"/>
      <MenuItem Header="{loc:Loc git.editor.open_file}" Command="{Binding $parent[UserControl].DataContext.OpenFileInEditorCommand}" CommandParameter="{Binding File}" IsVisible="{Binding IsFile}"/>
      <MenuItem Header="{loc:Loc git.log.menu.create_patch}" Command="{Binding $parent[UserControl].DataContext.CreatePatchFromFileCommand}" CommandParameter="{Binding File}" IsVisible="{Binding IsFile}"/>
      <MenuItem Header="{loc:Loc git.workspace.file_history}" Command="{Binding $parent[UserControl].DataContext.ShowFileHistoryCommand}" CommandParameter="{Binding File}" IsVisible="{Binding IsFile}"/>
     </ContextMenu></Setter></Style></TreeView.Styles>
    </TreeView>
    <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="{DynamicResource SurfaceSunkenBrush}"/>
    <Border Grid.Row="3" Padding="12,9" IsVisible="{Binding !!SelectedCommit}"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="8"><TextBlock Text="{Binding SelectedCommit.Subject}" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedCommit.Body}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !!SelectedCommit.Body}"/><TextBlock Text="{Binding SelectedCommit.Sha}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SelectedCommit.Author}" FontSize="11"/><TextBlock Text="{Binding SelectedCommit.AuthorDate}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></ScrollViewer></Border>
   </Grid>
  </Border>
  <GridSplitter Grid.Column="5" Width="4" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="{Binding IsInlineDiffOpen}"/>
  <Border Grid.Column="6" IsVisible="{Binding IsInlineDiffOpen}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1,0,0,0"><Panel><gitViews:GitDiffPane DataContext="{Binding InlineDiff}" CanClose="True" CloseRequested="DiffPane_CloseRequested"/><TextBlock Text="{loc:Loc git.log.diff_pane.loading}" IsVisible="{Binding IsInlineDiffLoading}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Panel></Border>
 </Grid>
</UserControl>
