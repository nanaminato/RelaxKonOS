<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proto="clr-namespace:RelaxKonOS.Protocol.Git;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitCredentialAccountsView"
             x:DataType="git:GitClientViewModel" Classes="builtin-app"
             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="18" Spacing="10">
            <TextBlock Text="{loc:Loc git.accounts.notice}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !CredentialAccountsBusy}">
                <Button Content="{loc:Loc git.accounts.new}" Command="{Binding NewCredentialAccountCommand}" />
                <Button Content="{loc:Loc git.remotes.refresh}" Command="{Binding RefreshCredentialAccountsCommand}" />
                <Button Content="{loc:Loc git.accounts.default}" Command="{Binding DefaultCredentialAccountCommand}" />
                <Button Content="{loc:Loc git.remotes.delete}" Command="{Binding DeleteCredentialAccountCommand}" />
            </StackPanel>
            <ListBox Height="180" ItemsSource="{Binding CredentialAccounts}"
                     SelectedItem="{Binding SelectedCredentialAccount, Mode=TwoWay}"
                     IsEnabled="{Binding !CredentialAccountsBusy}">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="proto:GitCredentialAccountDto">
                        <Grid ColumnDefinitions="*,*,Auto" Margin="4">
                            <TextBlock Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Username}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{loc:Loc git.accounts.default_badge}" IsVisible="{Binding IsDefault}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Spacing="8" IsEnabled="{Binding !CredentialAccountsBusy}">
                <TextBlock Text="{loc:Loc git.accounts.host}" />
                <TextBox Text="{Binding CredentialHost, Mode=TwoWay}" PlaceholderText="git.example.com:8443" />
                <TextBlock Text="{loc:Loc git.dialog.credentials.username}" />
                <TextBox Text="{Binding CredentialUsername, Mode=TwoWay}" />
                <TextBlock Text="{loc:Loc git.dialog.credentials.token}" />
                <TextBox Text="{Binding CredentialToken, Mode=TwoWay}" PasswordChar="•"
                         PlaceholderText="{loc:Loc git.accounts.token_hint}" />
                <CheckBox Content="{loc:Loc git.accounts.use_default}" IsChecked="{Binding CredentialDefault, Mode=TwoWay}" />
                <Button Content="{loc:Loc git.accounts.save}" Command="{Binding SaveCredentialAccountCommand}" HorizontalAlignment="Right" />
            </StackPanel>
            <ProgressBar Height="3" IsIndeterminate="{Binding CredentialAccountsBusy}" IsVisible="{Binding CredentialAccountsBusy}" />
            <TextBlock Text="{Binding CredentialAccountsMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
