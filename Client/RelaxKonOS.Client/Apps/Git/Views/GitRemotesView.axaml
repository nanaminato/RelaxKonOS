<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proto="clr-namespace:RelaxKonOS.Protocol.Git;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitRemotesView"
             x:DataType="git:GitClientViewModel">
    <Grid RowDefinitions="Auto,*,Auto" MinHeight="300">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Command="{Binding AddRemoteCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="➕" />
                    <TextBlock Text="{loc:Loc git.remotes.add}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding RefreshRemotesCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="⟳" />
                    <TextBlock Text="{loc:Loc git.remotes.refresh}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="4">
            <DataGrid x:Name="RemoteGrid" ItemsSource="{Binding Remotes}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectedItem="{Binding SelectedRemote, Mode=TwoWay}"
                      CanUserResizeColumns="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc git.remotes.col_name}" Binding="{Binding Name}" Width="130" CanUserResize="True" />
                    <DataGridTextColumn Header="{loc:Loc git.remotes.col_fetch_url}" Binding="{Binding FetchUrl}" Width="2*" CanUserResize="True" />
                    <DataGridTextColumn Header="{loc:Loc git.remotes.col_push_url}" Binding="{Binding PushUrl}" Width="2*" CanUserResize="True" />
                    <DataGridTemplateColumn Header="{loc:Loc git.remotes.col_actions}" Width="130" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="proto:GitRemoteDto">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Click="Edit_Click" Tag="{Binding}"
                                            Padding="6,2" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="✎" />
                                            <TextBlock Text="{loc:Loc git.remotes.edit}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="Remove_Click" Tag="{Binding}"
                                            Padding="6,2" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="✕" />
                                            <TextBlock Text="{loc:Loc git.remotes.delete}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{loc:Loc git.remotes.empty}"
                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,8"
                   IsVisible="{Binding Remotes.Count, Converter={x:Static git:GitPickerConverters.IsZeroToVisible}}" />
    </Grid>
</UserControl>
