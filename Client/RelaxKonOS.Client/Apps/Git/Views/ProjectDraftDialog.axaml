<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:views="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.ProjectDraftDialog"
             x:DataType="views:ProjectDraftPrompt" Classes="builtin-app">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <TextBlock Text="{loc:Loc git.editor.drafts_message}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="1" MaxHeight="220">
            <ItemsControl ItemsSource="{Binding Paths}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
            <Button Content="{loc:Loc common.save}" Click="Save_Click" Margin="0,0,6,4" />
            <Button Content="{loc:Loc common.discard}" Click="Discard_Click" Margin="0,0,6,4" />
            <Button Content="{loc:Loc common.cancel}" Click="Cancel_Click" Margin="0,0,0,4" />
        </WrapPanel>
    </Grid>
</UserControl>
