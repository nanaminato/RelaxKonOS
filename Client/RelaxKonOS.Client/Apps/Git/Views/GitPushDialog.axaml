<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proto="clr-namespace:RelaxKonOS.Protocol.Git;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitPushDialog"
             x:DataType="git:GitClientViewModel">
    <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <!-- Row 0: Branch line + commit count -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="BranchLineText"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Cursor="Hand"
                       Text="{Binding PushBranchLineText}"
                       PointerPressed="BranchLine_PointerPressed"/>
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="8,0,0,0"
                       Text="{Binding PushCommitCount, Converter={x:Static git:GitPickerConverters.LocalizedFormat}, ConverterParameter='git.dialog.push.n_commits_format'}"/>
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="8,0,0,0"
                       Text="{Binding PushStatusMessage}"/>
        </StackPanel>

        <!-- Row 1: Resizable commit list and file tree -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="120"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: commit list -->
            <StackPanel Grid.Column="0">
                <Button x:Name="AllCommitsButton"
                        Content="{loc:Loc git.dialog.push.all_commits}"
                        Classes.active="{Binding PushAllCommitsActive}"
                        FontSize="12"
                        Padding="8,6"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,4"
                        Click="AllCommits_Click">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                        <Style Selector="Button.active">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        </Style>
                    </Button.Styles>
                </Button>
                <ListBox x:Name="CommitList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ItemsSource="{Binding PushCommits}"
                         SelectionChanged="CommitList_SelectionChanged">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="proto:GitCommitDto">
                            <Border Padding="8,6">
                                <TextBlock FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center"
                                           Text="{Binding Subject}"/>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="Transparent"/>

            <!-- Right: file-change tree, with commit metadata only for a concrete commit selection. -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="8" MinWidth="180">
                <Grid x:Name="PushPreviewGrid" RowDefinitions="Auto,*,0,0" RowSpacing="0">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,4,0,0"
                               Text="{Binding PushFileCount, Converter={x:Static git:GitPickerConverters.LocalizedFormat}, ConverterParameter='git.dialog.push.n_files_format'}"/>

                    <TreeView Grid.Row="1"
                              x:Name="PushFileTreeView"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              ItemsSource="{Binding PushFileTree}"
                              SelectionChanged="PushFileTree_SelectionChanged">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate x:DataType="git:PushFileTreeNode" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="2">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Border IsVisible="{Binding IsFile}"
                                            CornerRadius="3"
                                            Padding="4,0"
                                            Background="{DynamicResource SurfaceBrush}">
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextOnAccentBrush}" Text="{Binding Status}"/>
                                    </Border>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <GridSplitter Grid.Row="2"
                                  Height="5"
                                  HorizontalAlignment="Stretch"
                                  ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext"
                                  Background="{DynamicResource SurfaceBrush}"
                                  IsVisible="{Binding PushHasSelectedCommit}"/>

                    <!-- Never shown for the aggregate all-commits activity. -->
                    <Border Grid.Row="3"
                            x:Name="CommitInfoBorder"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0"
                            IsVisible="{Binding PushHasSelectedCommit}">
                        <StackPanel Spacing="2" VerticalAlignment="Top">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding PushSelectedCommit.Subject}"/>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,4,0,0"
                                       Text="{Binding PushSelectedCommit, Converter={x:Static git:GitPickerConverters.CommitMeta}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Row 2: Push button + Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Loc git.dialog.push.push}"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextOnAccentBrush}"
                    Padding="20,6"
                    Click="Push_Click"/>
            <Button Content="{loc:Loc git.dialog.push.cancel}"
                    Padding="14,6"
                    Margin="8,0,0,0"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
