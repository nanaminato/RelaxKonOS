<UserControl xmlns:common="clr-namespace:RelaxKonOS.Client.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:views="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitClientWorkspace"
             x:DataType="git:GitClientViewModel"
             Background="{DynamicResource AppBackgroundBrush}" Classes="builtin-app">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top title bar -->
        <Grid x:Name="HeaderHost" Grid.Row="0" ColumnDefinitions="*,Auto" IsVisible="{Binding !IsPickerMode}">
            <common:WorkspaceWindowHeader x:Name="Header" Title="{loc:Loc git.title}" Subtitle="{loc:Loc git.subtitle}" IconAsset="avares://RelaxKonOS.Client/Assets/AppIcons/git.png" />
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsPickerMode}" VerticalAlignment="Center">
                <Border x:Name="BranchBadge" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="6,3"><TextBlock Text="{Binding Status.Branch}" MaxWidth="120" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status.Branch}" /></Border>
                <Button Classes="header-action" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc git.refresh}" AutomationProperties.Name="{loc:Loc git.refresh}"><Path Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Stretch="Uniform" Width="16" Height="16" Data="M19 8 A8 8 0 1 0 20 14 M19 3 V8 H14" /></Button>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid x:Name="WorkspaceBody" Grid.Row="1" ColumnDefinitions="190,*" IsVisible="{Binding !IsPickerMode}">
            <!-- Left navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}">
                <StackPanel Spacing="0" Margin="0,8">
                    <Button Classes="workspace-nav" Tag="overview" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📋" />
                            <TextBlock Text="{loc:Loc git.page.overview}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="workspace" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📝" />
                            <TextBlock Text="{loc:Loc git.page.workspace}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="log" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📜" />
                            <TextBlock Text="{loc:Loc git.page.log}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="remotes" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🌐" />
                            <TextBlock Text="{loc:Loc git.page.remotes}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="conflicts" Command="{Binding OpenConflictResolutionCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10"
                            IsVisible="{Binding ShowConflictPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚠" />
                            <TextBlock Text="{loc:Loc git.page.conflicts}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right content area: 不使用外层 ScrollViewer，避免给子元素无限宽高；
                 横向滚动与列表纵向滚动统一交给内部 DataGrid 自带的 ScrollViewer -->
            <Border Grid.Column="1" Padding="16">
                <ContentControl x:Name="ContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- 项目选择视图：IsPickerMode=true 时显示 -->
        <views:GitProjectPickerView Grid.Row="1" IsVisible="{Binding IsPickerMode}" x:Name="PickerHost" />

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" Padding="16,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
