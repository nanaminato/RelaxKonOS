<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:views="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitClientWorkspace"
             x:DataType="git:GitClientViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
    <!-- 顶部标题栏次级按钮：保留显式深色 Background，
         hover/pressed 时仅微调亮度，避免被默认 Button:pointerover 样式覆盖成浅色背景导致浅色文字不可辨识 -->
    <UserControl.Styles>
        <!-- 基础状态 -->
        <Style Selector="Button.titlebarAction">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- 悬停状态 (使用 /template/ 穿透默认模板防线) -->
        <Style Selector="Button.titlebarAction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- 禁用状态 -->
        <Style Selector="Button.titlebarAction:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="Button.titlebarAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top title bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSunkenBrush}" Padding="24,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="🌿" FontSize="22" VerticalAlignment="Center" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="{loc:Loc git.title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc git.subtitle}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding !IsPickerMode}">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding Status.Branch}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                    </Border>
                    <Button Content="{loc:Loc git.refresh}" Command="{Binding RefreshCommand}" Classes="titlebarAction" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" ColumnDefinitions="190,*" IsVisible="{Binding !IsPickerMode}">
            <!-- Left navigation -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceSunkenBrush}">
                <StackPanel Spacing="0" Margin="0,8">
                    <Button Classes="workspace-nav" Tag="overview" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📋" />
                            <TextBlock Text="{loc:Loc git.page.overview}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="workspace" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📝" />
                            <TextBlock Text="{loc:Loc git.page.workspace}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="log" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="📜" />
                            <TextBlock Text="{loc:Loc git.page.log}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="remotes" Click="NavigationButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🌐" />
                            <TextBlock Text="{loc:Loc git.page.remotes}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="workspace-nav" Tag="conflicts" Command="{Binding OpenConflictResolutionCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,10"
                            IsVisible="{Binding ShowConflictPage}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚠" />
                            <TextBlock Text="{loc:Loc git.page.conflicts}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right content area: 不使用外层 ScrollViewer，避免给子元素无限宽高；
                 横向滚动与列表纵向滚动统一交给内部 DataGrid 自带的 ScrollViewer -->
            <Border Grid.Column="1" Padding="16">
                <ContentControl x:Name="ContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- 项目选择视图：IsPickerMode=true 时显示 -->
        <views:GitProjectPickerView Grid.Row="1" IsVisible="{Binding IsPickerMode}" x:Name="PickerHost" />

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" Padding="16,6">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
