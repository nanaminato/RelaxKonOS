<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RelaxKonOS.Client.Controls"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:proto="clr-namespace:RelaxKonOS.Protocol.Git;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitProjectPickerView"
             x:DataType="git:GitClientViewModel" Background="{DynamicResource SurfaceSunkenBrush}" Classes="builtin-app">
    <UserControl.Styles>
        <Style Selector="Button.project-card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /></Style>
        <Style Selector="Button.project-card:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto" MaxWidth="980" HorizontalAlignment="Stretch">
        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="Transparent" Padding="28,28,28,16">
            <StackPanel Spacing="4">
                <Button Content="{loc:Loc git.accounts.title}" Command="{Binding ManageCredentialAccountsCommand}" HorizontalAlignment="Right" />
                <TextBlock Text="{loc:Loc git.picker.title}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{loc:Loc git.picker.description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 主体 -->
        <ScrollViewer Grid.Row="1" Padding="24,12" Background="Transparent">
            <StackPanel Spacing="14">
                <!-- 已注册项目列表 -->
                <Border Padding="12" Classes="app-panel">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{loc:Loc git.picker.registered_section}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Button Grid.Column="1" Classes="header-action header-refresh" Command="{Binding RefreshRepositoriesCommand}"
                                    IsEnabled="{Binding !IsLoadingProjects}" ToolTip.Tip="{loc:Loc git.refresh}"
                                    AutomationProperties.Name="{loc:Loc git.refresh}" />
                        </Grid>

                        <Border IsVisible="{Binding IsLoadingProjects}" Background="{DynamicResource SurfaceSunkenBrush}"
                                CornerRadius="8" Padding="20" Margin="0,4">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Loc git.picker.loading}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{loc:Loc git.picker.loading_hint}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ProgressBar IsIndeterminate="{Binding IsLoadingProjects}" Height="4"
                                             HorizontalAlignment="Stretch" Foreground="{DynamicResource AccentBrush}"
                                             AutomationProperties.Name="{loc:Loc git.picker.loading}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding RepositoryLoadError}" TextWrapping="Wrap" Margin="4,8"
                                   Foreground="{DynamicResource DangerBrush}"
                                   IsVisible="{Binding RepositoryLoadError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <ItemsControl ItemsSource="{Binding Repositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="proto:GitRepositoryDto">
                                    <Button Classes="project-card" Click="OpenProject_Click" Tag="{Binding}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="14,12" Margin="0,3">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ui:WorkspaceIcon Kind="Folder" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" Margin="28,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border IsVisible="{Binding !IsLoadingProjects}">
                            <Border IsVisible="{Binding HasLoadedRepositories}">
                                <TextBlock Text="{loc:Loc git.picker.empty_hint}"
                                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,8"
                                   IsVisible="{Binding Repositories.Count, Converter={x:Static git:GitPickerConverters.IsZeroToVisible}}" />
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 探测提示 -->
                <Border Padding="12"
                        IsVisible="{Binding IsProbing}" Classes="app-panel">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding ProbeHint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <ProgressBar IsIndeterminate="True" Height="4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作按钮 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="24,10">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Command="{Binding OpenFolderCommand}"
                        Background="{DynamicResource AccentMutedBrush}" Foreground="{DynamicResource AccentBrush}" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:WorkspaceIcon Kind="Folder" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Text="{loc:Loc git.picker.open_folder}" Foreground="{DynamicResource AccentBrush}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RegisterRepositoryCommand}"
                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" Padding="14,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:WorkspaceIcon Kind="Edit" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{loc:Loc git.picker.register_path}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
