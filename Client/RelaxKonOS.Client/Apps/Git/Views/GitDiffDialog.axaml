<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gitViews="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
             xmlns:diff="clr-namespace:RelaxKonOS.Client.Controls.Diff"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitDiffDialog"
             x:DataType="gitViews:GitDiffDialogModel" Classes="builtin-app">
    <Grid Margin="14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" MinWidth="640" MinHeight="400">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SuccessMutedBrush}" CornerRadius="4" Padding="7,3">
                <TextBlock Text="{Binding AdditionsText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource DangerMutedBrush}" CornerRadius="4" Padding="7,3">
                <TextBlock Text="{Binding DeletionsText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" IsVisible="{Binding IsTruncated}" Background="{DynamicResource WarningMutedBrush}" CornerRadius="4" Padding="8,5">
            <TextBlock Text="{Binding TruncatedMessage}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" ClipToBounds="True">
            <Panel>
                <diff:DiffView Document="{Binding Document}" IsVisible="{Binding HasTextPatch}" />
                <TextBlock IsVisible="{Binding IsBinary}" Text="{Binding BinaryMessage}" Margin="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock IsVisible="{Binding IsEmpty}" Text="{Binding EmptyMessage}" Margin="20"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Panel>
        </Border>

        <Button Grid.Row="3" HorizontalAlignment="Right" Content="{Binding CloseText}" Padding="16,6" Click="Close_Click" />
    </Grid>
</UserControl>
