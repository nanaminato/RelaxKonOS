<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:git="clr-namespace:RelaxKonOS.Client.Apps.Git"
             xmlns:gitViews="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitDiffDialog"
             x:DataType="git:GitDiffPresentation" Classes="builtin-app">
    <Grid Margin="14" RowDefinitions="*,Auto" RowSpacing="10" MinWidth="640" MinHeight="400">
        <gitViews:GitDiffPane Grid.Row="0" />
        <Button Grid.Row="1" HorizontalAlignment="Right" Content="{loc:Loc git.dialog.diff.close}"
                Padding="16,6" Click="Close_Click" />
    </Grid>
</UserControl>
