<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gitViews="clr-namespace:RelaxKonOS.Client.Apps.Git.Views"
             x:Class="RelaxKonOS.Client.Apps.Git.Views.GitDiffDialog"
             x:DataType="gitViews:GitDiffDialogModel">
    <Grid Margin="14" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" MinWidth="640" MinHeight="400">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding DisplayPath}" FontWeight="SemiBold" FontSize="14"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Background="#2416A34A" CornerRadius="4" Padding="7,3">
                <TextBlock Text="{Binding AdditionsText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
            <Border Grid.Column="2" Background="#24DC2626" CornerRadius="4" Padding="7,3">
                <TextBlock Text="{Binding DeletionsText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" IsVisible="{Binding IsTruncated}" Background="#2CF59E0B" CornerRadius="4" Padding="8,5">
            <TextBlock Text="{Binding TruncatedMessage}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Border>

        <Grid Grid.Row="2">
            <Border IsVisible="{Binding IsBinary}" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="20">
                <TextBlock Text="{Binding BinaryMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <Border IsVisible="{Binding IsEmpty}" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="6" Padding="20">
                <TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
            <ListBox IsVisible="{Binding HasTextPatch}" ItemsSource="{Binding Lines}" BorderThickness="0" Background="{DynamicResource SurfaceSunkenBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
                    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="Transparent" /></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="gitViews:GitDiffLine">
                        <Border Background="{Binding Background}" Padding="0,1">
                            <Grid ColumnDefinitions="50,50,22,*">
                                <TextBlock Grid.Column="0" Text="{Binding OldLine}" TextAlignment="Right" Margin="0,0,8,0"
                                           FontSize="12" FontFamily="Cascadia Code,Consolas,Menlo,monospace" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding NewLine}" TextAlignment="Right" Margin="0,0,8,0"
                                           FontSize="12" FontFamily="Cascadia Code,Consolas,Menlo,monospace" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Marker}" TextAlignment="Center" FontSize="12"
                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace" Foreground="{Binding Foreground}" />
                                <TextBlock Grid.Column="3" Text="{Binding Text}" TextWrapping="NoWrap" FontSize="12"
                                           FontFamily="Cascadia Code,Consolas,Menlo,monospace" Foreground="{Binding Foreground}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Button Grid.Row="3" HorizontalAlignment="Right" Content="{Binding CloseText}" Padding="16,6" Click="Close_Click" />
    </Grid>
</UserControl>
