<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:docker="clr-namespace:RelaxKonOS.Client.Apps.Docker"
             x:Class="RelaxKonOS.Client.Apps.Docker.Views.DockerUnavailableDialogView"
             x:DataType="docker:DockerManagerViewModel">
    <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="16">
        <TextBlock Text="{loc:Loc docker.unavailable_dialog.message}" TextWrapping="Wrap" HorizontalAlignment="Left" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.refresh}" Click="Refresh_Click" HorizontalContentAlignment="Center" />
            <Button Classes="primary" Content="{loc:Loc common.ok}" Click="Confirm_Click" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
