<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:docker="clr-namespace:RelaxKonOS.Client.Apps.Docker"
             x:Class="RelaxKonOS.Client.Apps.Docker.Views.DockerNetworksView"
             x:DataType="docker:DockerManagerViewModel" Classes="builtin-app">
    <Border Padding="20" Classes="app-panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Loc docker.networks}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
                <Button Grid.Column="2" Classes="primary" Content="{loc:Loc common.create}" Click="CreateNetwork_Click" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{loc:Loc docker.networks_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <DataGrid Grid.Row="2" HorizontalAlignment="Stretch" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="False" SelectionMode="Single" HorizontalScrollBarVisibility="Auto" Classes="resource-table">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc docker.table.name}" Binding="{ReflectionBinding Name}" Width="300" />
                    <DataGridTextColumn Header="{loc:Loc docker.table.driver}" Binding="{ReflectionBinding Driver}" Width="200" />
                    <DataGridTextColumn Header="{loc:Loc docker.table.scope}" Binding="{ReflectionBinding Scope}" Width="160" />
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="3">
                <Button Content="{loc:Loc docker.resource.details}" Command="{Binding LoadNetworkDetailsCommand}" Margin="0,0,8,4" />
                <Button Content="{loc:Loc common.delete}" Command="{Binding DeleteNetworkCommand}" Foreground="{DynamicResource DangerBrush}" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
