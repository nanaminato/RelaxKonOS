<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:docker="clr-namespace:RelaxKonOS.Client.Apps.Docker"
             x:Class="RelaxKonOS.Client.Apps.Docker.Views.DockerNetworksView"
             x:DataType="docker:DockerManagerViewModel">
    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20">
        <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Loc docker.networks}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Button Grid.Column="1" Content="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
            </Grid>
            <TextBlock Text="{loc:Loc docker.networks_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <Button Content="{loc:Loc common.create}" Click="CreateNetwork_Click" HorizontalAlignment="Left" />
            <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,2" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DataGrid HorizontalAlignment="Left" ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserReorderColumns="False" GridLinesVisibility="Horizontal" SelectionMode="Single" HorizontalScrollBarVisibility="Disabled" MinWidth="700" Height="230">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc docker.table.name}" Binding="{ReflectionBinding Name}" Width="300" />
                        <DataGridTextColumn Header="{loc:Loc docker.table.driver}" Binding="{ReflectionBinding Driver}" Width="200" />
                        <DataGridTextColumn Header="{loc:Loc docker.table.scope}" Binding="{ReflectionBinding Scope}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button Content="{loc:Loc docker.resource.details}" Command="{Binding LoadNetworkDetailsCommand}" />
                <Button Content="{loc:Loc common.delete}" Command="{Binding DeleteNetworkCommand}" Foreground="{DynamicResource DangerBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
