<UserControl xmlns:common="clr-namespace:RelaxKonOS.Client.Controls" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:docker="clr-namespace:RelaxKonOS.Client.Apps.Docker"
             x:Class="RelaxKonOS.Client.Apps.Docker.Views.DockerManagerWorkspace"
             x:DataType="docker:DockerManagerViewModel"
             Background="{DynamicResource AppBackgroundBrush}" Classes="builtin-app">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="HeaderHost" Grid.Row="0" ColumnDefinitions="*,Auto">
            <common:WorkspaceWindowHeader x:Name="Header" Title="{loc:Loc application.relaxkonos.docker.display_name}" Subtitle="{loc:Loc docker.subtitle}" IconAsset="avares://RelaxKonOS.Client/Assets/AppIcons/docker.png" />
            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                <PathIcon Width="16" Height="16" Data="M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 M11 6 H13 V13 H11 Z M11 16 H13 V18 H11 Z" />
                <TextBlock x:Name="HeaderStatusLabel" Text="{Binding StatusText}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <docker:DockerOperationActivityView Grid.Row="2" />

        <Grid x:Name="WorkspaceBody" Grid.Row="1" ClipToBounds="True" ColumnDefinitions="190,*">
            <Border Grid.Column="0" Classes="app-sidebar">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="4" Margin="14,22">
                    <TextBlock Text="{loc:Loc docker.workspace}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,6" />
                    <Button x:Name="OverviewButton" Classes="workspace-nav" Tag="overview" Click="NavigationButton_Click" Content="{loc:Loc docker.overview}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="containers" Click="NavigationButton_Click" Content="{loc:Loc docker.containers}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="stacks" Click="NavigationButton_Click" Content="{loc:Loc docker.orchestration}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="images" Click="NavigationButton_Click" Content="{loc:Loc docker.images}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="mirrors" Click="NavigationButton_Click" Content="{loc:Loc docker.mirrors.title}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="proxy" Click="NavigationButton_Click" Content="{loc:Loc docker.proxy.title}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="networks" Click="NavigationButton_Click" Content="{loc:Loc docker.networks}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="volumes" Click="NavigationButton_Click" Content="{loc:Loc docker.volumes}" HorizontalContentAlignment="Left" Padding="10,8" />
                    <Button Classes="workspace-nav" Tag="settings" Click="NavigationButton_Click" Content="{loc:Loc common.settings}" HorizontalContentAlignment="Left" Padding="10,8" />
                </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- Pages with DataGrid columns must be measured against the workspace width.  An
                 unconstrained horizontal ScrollViewer lets their desired width grow indefinitely. -->
            <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="24,20"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</UserControl>
