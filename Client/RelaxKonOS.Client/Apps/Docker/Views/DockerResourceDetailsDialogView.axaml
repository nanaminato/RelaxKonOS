<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:docker="clr-namespace:RelaxKonOS.Client.Apps.Docker"
             x:Class="RelaxKonOS.Client.Apps.Docker.Views.DockerResourceDetailsDialogView"
             x:DataType="docker:DockerManagerViewModel">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14" Margin="20">
        <TextBlock Text="{loc:Loc docker.resource.details_copy_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
        <TextBox Grid.Row="1" Text="{Binding ResourceDetailsText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono,Consolas,monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.copy}" Click="Copy_Click" />
            <Button Content="{loc:Loc common.close}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</UserControl>
