<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.Client.Localization"
             xmlns:docker="clr-namespace:RelaxKonOS.Client.Apps.Docker"
             x:Class="RelaxKonOS.Client.Apps.Docker.Views.DockerPullImageDialogView"
             x:DataType="docker:DockerManagerViewModel">
    <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="16">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="4" VerticalAlignment="Top">
            <TextBlock Text="{loc:Loc docker.image.reference}" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox Grid.Row="1" Text="{Binding ImageReference, Mode=TwoWay}" PlaceholderText="{loc:Loc docker.image.placeholder}" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.cancel}" Click="Cancel_Click" HorizontalContentAlignment="Center" />
            <Button Classes="primary" Content="{loc:Loc docker.image.pull}" Click="Pull_Click" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
