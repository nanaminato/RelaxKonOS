<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:c="clr-namespace:Client.Apps.Explorer.Converters"
             xmlns:models="clr-namespace:Client.Apps.Explorer.Models"
             xmlns:vm="clr-namespace:Client.Apps.Explorer.ViewModels"
             xmlns:d="clr-namespace:RemoteOS.Protocol.Files;assembly=RemoteOS.Protocol"
             x:Class="Client.Apps.Explorer.Views.ExplorerMainView"
             x:Name="Root"
             x:DataType="vm:ExplorerViewModel"
             Background="{DynamicResource SurfaceBrush}">

    <UserControl.Resources>
        <!-- 文件/目录图标 -->
        <c:EntryTypeToGlyphConverter x:Key="TypeGlyphConverter" />
        <c:EntrySizeToStringConverter x:Key="SizeConverter" />
        <c:EntryDescriptionConverter x:Key="TypeTextConverter" />
        <c:TreeNodeIconKindToGlyphConverter x:Key="NodeGlyphConverter" />
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <!-- Navigation stays above the command bar, matching the Explorer workflow. -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="icon" Content="←" Command="{Binding GoBackCommand}" ToolTip.Tip="{loc:Loc common.back}" />
                    <Button Classes="icon" Content="→" Command="{Binding GoForwardCommand}" ToolTip.Tip="{loc:Loc common.forward}" />
                    <Button Classes="icon" Content="↑" Command="{Binding GoUpCommand}" ToolTip.Tip="{loc:Loc explorer.up}" />
                    <Button Classes="icon" Content="⟳" Command="{Binding RefreshCommand}" ToolTip.Tip="{loc:Loc common.refresh}" />
                </StackPanel>
                <Grid Grid.Column="1" MinWidth="100">
                    <TextBox x:Name="AddressBox" Text="{Binding AddressInput, Mode=TwoWay}"
                             IsVisible="{Binding IsEditingAddress}" PlaceholderText="{loc:Loc explorer.computer}"
                             KeyDown="AddressBox_KeyDown" LostFocus="AddressBox_LostFocus" />
                    <Border IsVisible="{Binding !IsEditingAddress}" CornerRadius="5" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderDefaultBrush}" Padding="4,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ExplorerBreadcrumb">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Label}" Tag="{Binding Path}" Click="Breadcrumb_Click" Padding="8,5" Background="Transparent" BorderThickness="0" />
                                                <TextBlock Text="›" VerticalAlignment="Center" Opacity="0.5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Column="1" Content="✎" Click="EditAddress_Click" ToolTip.Tip="{loc:Loc explorer.edit_address}" Background="Transparent" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
                <TextBox Grid.Column="2" x:Name="SearchBox" Width="180" Text="{Binding SearchText, Mode=TwoWay}"
                         PlaceholderText="{loc:Loc explorer.filter_folder}" KeyDown="SearchBox_KeyDown" />
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                <StackPanel IsVisible="{Binding !IsPickerMode}" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0">
                    <Button Content="{loc:Loc explorer.new_folder}" Command="{Binding NewFolderCommand}" />
                    <Button Content="✂" Command="{Binding CutCommand}" ToolTip.Tip="{loc:Loc explorer.cut}" />
                    <Button Content="⧉" Command="{Binding CopyCommand}" ToolTip.Tip="{loc:Loc explorer.copy}" />
                    <Button Content="▣" Command="{Binding PasteCommand}" ToolTip.Tip="{loc:Loc explorer.paste}" />
                    <Button Content="{loc:Loc common.rename}" Command="{Binding RenameCommand}" />
                    <Button Content="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" />
                    <Button Content="•••" ToolTip.Tip="{loc:Loc explorer.more}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="{loc:Loc common.download}" Command="{Binding DownloadCommand}" />
                                <MenuItem Header="{loc:Loc common.upload}" Command="{Binding UploadCommand}" />
                                <MenuItem Header="{loc:Loc explorer.upload_folder}" Command="{Binding UploadFolderCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.paste_host}" Command="{Binding PasteFromHostCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.move}" Command="{Binding MoveCommand}" />
                                <Separator />
                                <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                                <MenuItem Header="{loc:Loc explorer.properties}" Command="{Binding PropertiesCommand}" />
                                <MenuItem Header="{loc:Loc explorer.save_default_view}" Command="{Binding SaveDefaultViewCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.about}" Command="{Binding AboutCommand}" />
                                <MenuItem Header="{loc:Loc explorer.menu.exit}" Command="{Binding CloseCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock Text="{loc:Loc explorer.sort}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox SelectedIndex="{Binding SortIndex, Mode=TwoWay}" Width="112" Margin="0,0,10,0">
                    <ComboBoxItem Content="{loc:Loc common.name}" />
                    <ComboBoxItem Content="{loc:Loc explorer.modified}" />
                    <ComboBoxItem Content="{loc:Loc common.type}" />
                    <ComboBoxItem Content="{loc:Loc explorer.size}" />
                </ComboBox>
                <CheckBox Content="{loc:Loc explorer.descending}" IsChecked="{Binding SortDescending}" Margin="0,0,12,0" />
                <CheckBox Content="{loc:Loc explorer.compact}" IsChecked="{Binding IsCompactView}" Margin="0,0,12,0" />
                <CheckBox Content="{loc:Loc explorer.show_hidden}" IsChecked="{Binding ShowHiddenFiles}" />
            </WrapPanel>
        </Border>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Text="{Binding SelectionSummary}" FontSize="12" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding IsBusy, Converter={x:Static c:ExplorerLoadingStatusConverter.Instance}}"
                           FontSize="12" Opacity="0.6" />
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" IsVisible="{Binding HasTransferProgress}">
                    <Button Content="{loc:Loc explorer.batch.stop}" Command="{Binding StopBatchCommand}"
                            IsVisible="{Binding IsBatchActive}" HorizontalAlignment="Left" Padding="8,3" />
                    <TextBlock Text="{Binding TransferText}" FontSize="12" Opacity="0.75"
                               Margin="0,5,10,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ProgressBar Grid.Row="1" Grid.Column="1" Width="180" Height="6" Minimum="0" Maximum="100"
                             Value="{Binding TransferProgress}" Margin="0,7,0,0"
                             IsVisible="{Binding HasTransferProgress}" />
                <Expander Grid.Row="2" Grid.ColumnSpan="2" Header="{loc:Loc explorer.batch.details}"
                          IsVisible="{Binding HasOperationDetails}" HorizontalAlignment="Stretch">
                    <ScrollViewer MaxHeight="140"><TextBlock Text="{Binding LastOperationDetails}" TextWrapping="Wrap" /></ScrollViewer>
                </Expander>
            </Grid>
        </Border>

        <!-- Picker mode reuses the full Explorer navigation surface and adds native-like confirmation fields. -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding IsPickerMode}"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding PickerEntryLabel}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding PickerEntryName, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" IsVisible="{Binding IsFilePickerMode}"
                              ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" Width="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelPickerCommand}" />
                    <Button Classes="primary" Content="{Binding PickerConfirmLabel}" Command="{Binding ConfirmPickerCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左导航树 | 分隔 | 右条目列表 -->
        <Grid ColumnDefinitions="210,Auto,*">
            <!-- 导航树 -->
            <TreeView Grid.Column="0"
                      x:Name="NavigationTree"
                      IsEnabled="{Binding !IsBusy}"
                      ItemsSource="{Binding Nodes}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Explorer_DragOver"
                      DragDrop.Drop="Explorer_Drop">
                <!-- TreeViewItem 的 IsExpanded 不会自动与数据项同步。没有这条绑定时，
                     仅会展开不可见的 dummy child，TreeNodeModel 无法发起目录懒加载。 -->
                <TreeView.Styles>
                    <Style Selector="TreeViewItem">
                        <!-- 编译绑定无法在 Style setter 中推断 TreeViewItem 的 DataContext 类型，
                             会回退到页面级 x:DataType(ExplorerViewModel) 而 AVLN2000 报错。
                             这里用 ReflectionBinding 显式退化为运行时反射绑定。 -->
                        <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <!-- Do not use a stretch column here: TreeViewItem headers inherit the
                             resized pane width and a star column can visually separate icon/text. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                                    IsVisible="{Binding !IsPlaceholder}">
                            <TextBlock Text="{Binding IconKind, Converter={StaticResource NodeGlyphConverter}}"
                                       FontSize="13" Width="18" />
                            <TextBlock Text="{Binding Label}" MaxWidth="170" MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource SurfaceBrush}" ResizeDirection="Columns" />

            <!-- File Explorer-style details view. Each column starts with a fixed width:
                 spare viewport space remains empty instead of stretching a column;
                 narrower viewports use the outer horizontal scrollbar. Users can drag
                 the header dividers to change any column width. -->
            <Grid Grid.Column="2"
                          x:Name="EntriesScrollViewer"
                          Background="{DynamicResource SurfaceBrush}"
                          DragDrop.AllowDrop="True"
                          DragDrop.DragOver="Explorer_DragOver"
                          DragDrop.Drop="Explorer_Drop">
                <!-- The directory background intentionally has its own menu. File-specific
                     commands remain on the DataGrid context menu below. -->
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding #EntriesScrollViewer.DataContext}" IsEnabled="{Binding !IsBusy}">
                        <MenuItem Header="{loc:Loc common.refresh}" Command="{Binding RefreshCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.paste}" Command="{Binding PasteCommand}" />
                        <MenuItem Header="{loc:Loc explorer.new_folder}" Command="{Binding NewFolderCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <DataGrid x:Name="EntriesGrid"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      SelectionMode="{Binding EntrySelectionMode}"
                      SelectionChanged="EntriesGrid_SelectionChanged"
                      Sorting="EntriesGrid_Sorting"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      GridLinesVisibility="None"
                      RowHeight="{Binding EntryRowHeight}"
                      ColumnHeaderHeight="30"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="0"
                      KeyDown="EntriesGrid_KeyDown"
                      DoubleTapped="EntriesGrid_DoubleTapped"
                      PointerMoved="EntriesGrid_PointerMoved"
                      PointerReleased="EntriesGrid_PointerReleased"
                      DragDrop.AllowDrop="True"
                      DragDrop.DragOver="Explorer_DragOver"
                      DragDrop.Drop="Explorer_Drop">
                <DataGrid.ContextMenu>
                    <ContextMenu DataContext="{Binding #EntriesGrid.DataContext}" IsEnabled="{Binding !IsBusy}">
                        <MenuItem Header="{loc:Loc common.open}" Command="{Binding OpenCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_with}" Command="{Binding OpenWithSelectedCommand}" />
                        <MenuItem Header="{loc:Loc explorer.open_terminal}" Command="{Binding OpenTerminalCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.copy}" Command="{Binding CopyCommand}" />
                        <MenuItem Header="{loc:Loc explorer.cut}" Command="{Binding CutCommand}" />
                        <MenuItem Header="{loc:Loc explorer.paste}" Command="{Binding PasteCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc common.rename}" Command="{Binding RenameCommand}" />
                        <MenuItem Header="{loc:Loc common.delete}" Command="{Binding DeleteCommand}" />
                        <Separator />
                        <MenuItem Header="{loc:Loc explorer.properties}" Command="{Binding PropertiesCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Styles>
                    <Style Selector="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="12" />
                    </Style>
                    <Style Selector="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </DataGrid.Styles>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.NameColumnHeader}" Width="300" MinWidth="180" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="12,2">
                                    <TextBlock Text="💾" FontSize="14" IsVisible="{Binding Type, Converter={StaticResource TypeGlyphConverter}, ConverterParameter=drive}" />
                                    <TextBlock Text="📁" FontSize="14" IsVisible="{Binding Type, Converter={StaticResource TypeGlyphConverter}, ConverterParameter=dir}" />
                                    <TextBlock Text="📄" FontSize="14" IsVisible="{Binding Type, Converter={StaticResource TypeGlyphConverter}, ConverterParameter=file}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.ModifiedColumnHeader}" Width="164" MinWidth="150" SortMemberPath="Modified">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding Modified, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}" Padding="8,0"
                                           FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.TypeColumnHeader}" Width="120" MinWidth="96" SortMemberPath="Type">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding ., Converter={StaticResource TypeTextConverter}}" Padding="8,0"
                                           FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{Binding #Root.DataContext.SizeColumnHeader}" Width="112" MinWidth="96" SortMemberPath="Size">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="d:FileSystemEntryDto">
                                <TextBlock Text="{Binding Size, Converter={StaticResource SizeConverter}}" Padding="8,0"
                                           FontSize="12" Opacity="0.8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="{loc:Loc explorer.empty_view}" IsVisible="{Binding IsEmpty}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.6" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
