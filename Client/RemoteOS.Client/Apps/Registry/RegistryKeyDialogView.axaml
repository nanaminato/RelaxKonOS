<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:registry="clr-namespace:Client.Apps.Registry" x:Class="Client.Apps.Registry.RegistryKeyDialogView" x:DataType="registry:RegistryKeyDialogViewModel">
  <Grid RowDefinitions="*,Auto" MinWidth="420">
    <StackPanel Margin="20" Spacing="12">
      <TextBlock Text="{Binding ParentPath}" Opacity="0.7" TextWrapping="Wrap"/>
      <TextBox PlaceholderText="Key name" Text="{Binding Name, Mode=TwoWay}"/>
      <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20"><Button Content="Cancel" Command="{Binding CancelCommand}"/><Button Classes="primary" Content="Create" Command="{Binding SaveCommand}"/></StackPanel>
  </Grid>
</UserControl>
