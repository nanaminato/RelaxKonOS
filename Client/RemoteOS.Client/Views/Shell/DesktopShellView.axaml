<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Client.Localization"
             xmlns:vm="clr-namespace:Client.ViewModels.Shell"
             xmlns:wm="clr-namespace:RemoteOS.WindowManager;assembly=RemoteOS.WindowManager"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Client.Views.Shell.DesktopShellView"
             x:DataType="vm:DesktopShellViewModel"
             Background="{Binding Settings.CurrentWallpaper}"
             FontFamily="{DynamicResource ContentFont}">

    <UserControl.Styles>
        <Style Selector="Button.desktop-icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.desktop-icon:pointerover">
            <Setter Property="Background" Value="{DynamicResource DesktopIconHoverBrush}" />
        </Style>
        <Style Selector="Button.desktop-icon:pressed">
            <Setter Property="Background" Value="{DynamicResource DesktopIconSelectedBrush}" />
        </Style>
        <Style Selector="Button.desktop-icon.desktop-selected">
            <Setter Property="Background" Value="{DynamicResource DesktopIconSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.start-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.start-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.start-button:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        </Style>

        <Style Selector="Button.taskbar-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.taskbar-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.taskbar-item:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        </Style>

        <Style Selector="Border.taskbar-preview">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.window-preview">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.window-preview:pointerover /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.window-preview-close">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.window-preview-close:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>

        <Style Selector="Button.start-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Button.start-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.start-item:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
        </Style>

        <Style Selector="Border.start-menu">
            <Setter Property="Background" Value="{DynamicResource StartMenuBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="ContextMenu.shell-context-menu">
            <Setter Property="MinWidth" Value="220" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Root" x:DataType="vm:DesktopShellViewModel">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Workspace: desktop icons behind, managed windows in front -->
        <Grid Grid.Row="0" ClipToBounds="True" Background="Transparent">
            <!-- This is a sibling behind icons and managed windows. Its menu can therefore open
                 only on actual desktop background, never from a child application window. -->
            <Border Background="Transparent" PointerPressed="DesktopBackground_OnPointerPressed">
            <Border.ContextMenu>
                <ContextMenu Classes="shell-context-menu"
                             DataContext="{Binding DataContext, ElementName=Root}">
                    <MenuItem Header="查看">
                        <MenuItem Header="显示桌面图标" ToggleType="CheckBox"
                                  IsChecked="{Binding AreDesktopIconsVisible, Mode=TwoWay}" />
                    </MenuItem>
                    <MenuItem Header="刷新" Command="{Binding RefreshDesktopCommand}" />
                    <MenuItem Header="粘贴" Click="DesktopPasteMenuItem_OnClick" />
                    <Separator />
                    <MenuItem Header="{loc:Loc shell.desktop_display.configure_ellipsis}" Command="{Binding OpenDesktopDisplaySettingsCommand}"
                              InputGesture="Ctrl+Shift+D" />
                    <Separator />
                    <MenuItem Header="打开桌面文件夹" Command="{Binding OpenDesktopFolderCommand}" />
                    <MenuItem Header="打开资源管理器" Command="{Binding OpenFileExplorerCommand}" />
                    <MenuItem Header="打开终端" Command="{Binding OpenTerminalCommand}" />
                    <Separator />
                    <MenuItem Header="个性化" Command="{Binding OpenPersonalizationCommand}" />
                </ContextMenu>
            </Border.ContextMenu>

                <Border.KeyBindings>
                    <KeyBinding Command="{Binding OpenDesktopDisplaySettingsCommand}" Gesture="Ctrl+Shift+D" />
                </Border.KeyBindings>
            </Border>

            <ItemsControl ItemsSource="{Binding DesktopItems}" IsVisible="{Binding AreDesktopIconsVisible}"
                          Focusable="False" Padding="10" Margin="6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="{x:Type vm:AppEntryViewModel}" x:DataType="vm:AppEntryViewModel">
                        <Button Classes="desktop-icon" Width="120" Height="104" Margin="2"
                                Classes.desktop-selected="{Binding IsDesktopSelected}"
                                Command="{Binding DataContext.SelectDesktopItemCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                PointerPressed="DesktopIcon_OnPointerPressed"
                                DoubleTapped="DesktopAppIcon_OnDoubleTapped"
                                ToolTip.Tip="{Binding DisplayName}"
                                ToolTip.IsOpen="{Binding IsDesktopSelected}">
                            <Button.ContextMenu>
                                <ContextMenu Opened="DesktopAppContextMenu_OnOpened">
                                    <MenuItem Header="打开" Click="DesktopAppOpenMenuItem_OnClick" />
                                    <Separator />
                                    <MenuItem Header="应用详情" Click="DesktopAppDetailsMenuItem_OnClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                        HorizontalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Stretch="Uniform" Margin="4" />
                                        <TextBlock Text="{Binding IconGlyph}" IsVisible="{Binding !HasIconImage}" FontSize="26"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource OverlayScrimBrush}" CornerRadius="4" Padding="4,1">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="White"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="108" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:DesktopFileEntryViewModel}" x:DataType="vm:DesktopFileEntryViewModel">
                        <Button Classes="desktop-icon" Width="120" Height="104" Margin="2"
                                Classes.desktop-selected="{Binding IsDesktopSelected}"
                                Command="{Binding DataContext.SelectDesktopItemCommand, ElementName=Root}"
                                CommandParameter="{Binding}"
                                PointerPressed="DesktopIcon_OnPointerPressed"
                                DoubleTapped="DesktopFileIcon_OnDoubleTapped"
                                ToolTip.Tip="{Binding DisplayName}"
                                ToolTip.IsOpen="{Binding IsDesktopSelected}">
                            <Button.ContextMenu>
                                <ContextMenu Opened="DesktopFileContextMenu_OnOpened">
                                    <MenuItem Header="打开" Click="DesktopFileOpenMenuItem_OnClick" />
                                    <MenuItem Header="打开方式..." Click="DesktopFileOpenWithMenuItem_OnClick" />
                                    <Separator />
                                    <MenuItem Header="复制" Click="DesktopFileCopyMenuItem_OnClick" />
                                    <MenuItem Header="剪切" Click="DesktopFileCutMenuItem_OnClick" />
                                    <MenuItem Header="删除" Click="DesktopFileDeleteMenuItem_OnClick" />
                                    <Separator />
                                    <MenuItem Header="在资源管理器中显示" Click="DesktopFileOpenInExplorerMenuItem_OnClick" />
                                    <MenuItem Header="属性" Click="DesktopFilePropertiesMenuItem_OnClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="26"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Background="{DynamicResource OverlayScrimBrush}" CornerRadius="4" Padding="4,1">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="White"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="108" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ShortcutEntryViewModel}" x:DataType="vm:ShortcutEntryViewModel">
                        <Button Classes="desktop-icon" Width="120" Height="104" Margin="2"
                                Classes.desktop-selected="{Binding IsDesktopSelected}"
                                Command="{Binding ActivateCommand}" ToolTip.Tip="{Binding DisplayName}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding IconGlyph}" FontSize="26"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Background="{DynamicResource OverlayScrimBrush}" CornerRadius="4" Padding="4,1">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="White"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxLines="1" MaxWidth="108" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>

            <!-- Managed windows are parented here by the WindowManager -->
            <Canvas x:Name="PART_WindowHost" ClipToBounds="True" />
        </Grid>

        <!-- Click-away backdrop for the start menu (workspace only) -->
        <Border Grid.Row="0" Background="Transparent"
                IsVisible="{Binding IsStartOpen}"
                PointerPressed="StartBackdrop_OnPointerPressed" />

        <!-- Taskbar -->
        <Border Grid.Row="1" Height="48" Background="{DynamicResource TaskbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0">
            <Border.ContextMenu>
                <ContextMenu Classes="shell-context-menu"
                             DataContext="{Binding DataContext, ElementName=Root}">
                    <MenuItem Header="打开任务管理器" Command="{Binding OpenTaskManagerCommand}" />
                    <Separator />
                    <MenuItem Header="显示桌面" Command="{Binding ShowDesktopCommand}" />
                    <Separator />
                    <MenuItem Header="任务栏设置" Command="{Binding OpenSettingsCommand}" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid ColumnDefinitions="56,*,Auto">
                <Button Grid.Column="0" Classes="start-button"
                        Command="{Binding ToggleStartCommand}">
                    <Grid Width="20" Height="20">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="1.5" />
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="1.5" />
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="1.5" />
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="1.5" />
                    </Grid>
                </Button>

                <ItemsControl Grid.Column="1" ItemsSource="{Binding TaskbarGroups}"
                              VerticalAlignment="Center" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskbarGroupViewModel">
                            <Button Classes="taskbar-item"
                                    Command="{Binding DataContext.ToggleTaskbarGroupCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding DisplayName}">
                                <Grid RowDefinitions="*,4">
                                    <Image Grid.Row="0" Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Stretch="Uniform" Margin="12" />
                                    <TextBlock Grid.Row="0" Text="{Binding IconGlyph}" IsVisible="{Binding !HasIconImage}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TaskbarForegroundBrush}" />
                                    <Border Grid.Row="0" Width="16" Height="16" CornerRadius="8"
                                            Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,4,4,0" IsVisible="{Binding HasMultipleWindows}">
                                        <TextBlock Text="{Binding WindowCount}" FontSize="10" Foreground="{DynamicResource TextOnAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Grid.Row="1" Height="2" CornerRadius="1" Width="16"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource AccentBrush}"
                                            IsVisible="{Binding IsActive}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0" Spacing="10">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Clock}" FontSize="13" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TaskbarForegroundBrush}" />
                        <TextBlock Text="{Binding DateText}" FontSize="11" HorizontalAlignment="Right" Opacity="0.7"
                                   Foreground="{DynamicResource TaskbarForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Click-away surface and multi-window preview strip, similar to the Windows taskbar. -->
        <Border Grid.Row="0" Background="Transparent"
                IsVisible="{Binding IsTaskbarPreviewOpen}"
                PointerPressed="TaskbarPreviewBackdrop_OnPointerPressed" />
        <Border Grid.Row="0" Classes="taskbar-preview"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="66,0,0,58" Padding="10"
                MaxWidth="760" IsVisible="{Binding IsTaskbarPreviewOpen}">
            <ItemsControl ItemsSource="{Binding OpenTaskbarGroup.Windows}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="wm:ManagedWindow">
                        <Grid Width="180" Height="126" Margin="4">
                            <Button Classes="window-preview" Grid.Column="0"
                                    Command="{Binding DataContext.ActivateTaskbarWindowCommand, ElementName=Root}"
                                    CommandParameter="{Binding}">
                                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10">
                                    <Grid RowDefinitions="*,Auto">
                                        <Image Grid.Row="0" Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Stretch="Uniform" Margin="12" />
                                        <TextBlock Grid.Row="0" Text="{Binding IconGlyph}" IsVisible="{Binding !HasIconImage}" FontSize="34"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding State}" FontSize="10" Opacity="0.6"
                                                       IsVisible="{Binding !IsOnScreen}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                            <Button Classes="window-preview-close"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                                    Command="{Binding DataContext.CloseTaskbarWindowCommand, ElementName=Root}"
                                    CommandParameter="{Binding}" ToolTip.Tip="Close window">
                                <TextBlock Text="&#x00D7;" FontSize="16" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Start menu overlay -->
        <Border x:Name="StartMenu" Grid.Row="0" Grid.RowSpan="2" Classes="start-menu"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="8,0,0,56" Width="380" Height="460"
                IsVisible="{Binding IsStartOpen}">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="RemoteOS" FontSize="16" FontWeight="SemiBold"
                           Margin="18,16,0,10" />
                <ScrollViewer Grid.Row="1" Padding="10,0">
                    <ItemsControl ItemsSource="{Binding StartApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppEntryViewModel">
                                <Button Classes="start-item" Command="{Binding LaunchCommand}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                    <Grid ColumnDefinitions="40,*">
                                        <Grid Grid.Column="0" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Stretch="Uniform" />
                                            <TextBlock Text="{Binding IconGlyph}" IsVisible="{Binding !HasIconImage}" FontSize="20"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                    <Button Classes="start-item" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding ShutdownCommand}">
                        <Grid ColumnDefinitions="40,*">
                            <Path Grid.Column="0"
                                  Data="M 12,2 L 12,12 M 6.34,4.34 A 8,8 0 1 0 17.66,4.34"
                                  Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2" StrokeLineCap="Round"
                                  Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{loc:Loc shell.shutdown}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <!-- Full-screen managed windows sit above every shell surface, including the taskbar. -->
        <Canvas x:Name="PART_FullScreenWindowHost" Grid.Row="0" Grid.RowSpan="2" ClipToBounds="True"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
