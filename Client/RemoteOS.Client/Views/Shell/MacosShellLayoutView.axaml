<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Client.Views.Shell.MacosShellLayoutView">
    <!-- Layout-only: a floating bottom dock and centred launcher. -->
    <Grid RowDefinitions="*,Auto">
        <ContentControl x:Name="DesktopHost" Grid.Row="0" />
        <ContentControl x:Name="DockHost"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10" />
        <ContentControl x:Name="LauncherHost"
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
    </Grid>
</UserControl>
