<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Client.Views.Shell.WindowsShellLayoutView">
    <!-- Layout-only: taskbar height, launcher anchoring and layer order are intentionally
         kept here so the Windows shell can be tuned without changing Shell runtime code. -->
    <Grid RowDefinitions="*,Auto">
        <ContentControl x:Name="DesktopHost" Grid.Row="0" />
        <ContentControl x:Name="TaskbarHost" Grid.Row="1" />
        <ContentControl x:Name="LauncherHost"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
