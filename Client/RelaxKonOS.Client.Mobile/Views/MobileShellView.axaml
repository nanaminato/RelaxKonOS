<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RelaxKonOS.Client.Mobile.ViewModels"
             x:Class="RelaxKonOS.Client.Mobile.Views.MobileShellView"
             x:DataType="vm:MobileShellViewModel"
             Background="#10151F">
  <Grid RowDefinitions="*,Auto">
    <Grid x:Name="LoginPanel" Margin="24" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" RowSpacing="14">
      <Border Background="#1B2433" CornerRadius="20" Padding="28">
        <StackPanel Spacing="14">
          <TextBlock Text="RelaxKonOS" FontSize="32" FontWeight="SemiBold" />
          <TextBlock Text="Mobile control center" Opacity="0.7" />
          <TextBox PlaceholderText="Server address" Text="{Binding ServerUrl, Mode=TwoWay}" MinHeight="48" />
          <TextBox PlaceholderText="Username" Text="{Binding Identifier, Mode=TwoWay}" MinHeight="48" />
          <TextBox PlaceholderText="Password" PasswordChar="●" Text="{Binding Password, Mode=TwoWay}" MinHeight="48" />
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.75" />
          <Button Content="Connect" Click="ConnectOnClick" MinHeight="48" HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="ShellPanel" IsVisible="False" ColumnDefinitions="Auto,*,300" RowDefinitions="*" Margin="16">
      <Border x:Name="WideNavigation" Background="#1B2433" CornerRadius="16" Padding="16" Width="180">
        <StackPanel Spacing="12"><TextBlock Text="RelaxKonOS" FontSize="20" FontWeight="Bold" /><Button Content="Home" /><Button Content="Files" /><Button Content="Terminal" /><Button Content="Manage" /><Button Content="More" /></StackPanel>
      </Border>
      <StackPanel Grid.Column="1" Margin="24" Spacing="18"><TextBlock Text="{Binding ServerName}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="Connected. M0 provides the responsive shell and authenticated session foundation; Files, Terminal, and management pages follow in M1–M3." TextWrapping="Wrap" MaxWidth="600" /><WrapPanel ItemWidth="160" ItemHeight="100"><Border Background="#1B2433" CornerRadius="12" Margin="4"><TextBlock Text="System status" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><Border Background="#1B2433" CornerRadius="12" Margin="4"><TextBlock Text="Server capabilities" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border></WrapPanel></StackPanel>
      <Border x:Name="DetailPane" Grid.Column="2" Background="#1B2433" CornerRadius="16" Padding="16"><TextBlock Text="Details" FontSize="18" /></Border>
    </Grid>
    <Border x:Name="CompactNavigation" Grid.Row="1" IsVisible="False" Background="#1B2433" Padding="8"><Grid ColumnDefinitions="*,*,*,*,*"><Button Content="Home" /><Button Grid.Column="1" Content="Files" /><Button Grid.Column="2" Content="Terminal" /><Button Grid.Column="3" Content="Manage" /><Button Grid.Column="4" Content="More" /></Grid></Border>
  </Grid>
</UserControl>
