<?xml version="1.0" encoding="utf-8" ?>
<resources>
  <!--
    Avalonia.Android.AvaloniaActivity derives from AppCompatActivity, and AppCompat refuses to
    inflate content unless the activity uses a Theme.AppCompat descendant. The Android host must
    therefore declare this theme; the Avalonia.Android package ships no styles of its own.

    windowBackground is pinned to the Mobile Shell surface color so the window never flashes a
    platform-default (light) background before Avalonia renders its first frame.
  -->
  <style name="RelaxKonOSMobileTheme" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowBackground">#10151F</item>
  </style>
</resources>
