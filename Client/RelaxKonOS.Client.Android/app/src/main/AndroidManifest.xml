<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Strong biometrics gate the local credential vault; no biometric data leaves the device. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- API 23-27 fall back to the legacy fingerprint API; availability is probed at runtime. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!--
      A large upload must survive the app going to the background, which is exactly what a data-sync
      foreground service is for. Android 14 and later require the transfer to be stoppable from its
      notification; the cancel action is part of the design rather than a concession to the platform.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Progress is only useful if it is visible: the notification is the transfer's own status. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".RelaxKonApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RelaxKonOS"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Per-app language below API 33 is implemented by AppCompat, which needs a locale storage of its
          own. The app also keeps its own copy in `relaxkonos.appearance`, so a device where this
          mechanism is unavailable still starts in the system language instead of failing to start.
        -->
        <meta-data
            android:name="androidx.appcompat.app.AppCompatDelegate.autoStoreLocales"
            android:value="true" />

        <!--
          Keeps one upload alive and visible while the app is in the background. The transfer itself is
          owned by the process-wide coordinator, so nothing here holds state that a restart would lose.
        -->
        <service
            android:name=".service.UploadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
