<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Strong biometrics gate the local credential vault; no biometric data leaves the device. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- API 23-27 fall back to the legacy fingerprint API; availability is probed at runtime. -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <application
        android:name=".RelaxKonApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.RelaxKonOS"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Per-app language below API 33 is implemented by AppCompat, which needs a locale storage of its
          own. The app also keeps its own copy in `relaxkonos.appearance`, so a device where this
          mechanism is unavailable still starts in the system language instead of failing to start.
        -->
        <meta-data
            android:name="androidx.appcompat.app.AppCompatDelegate.autoStoreLocales"
            android:value="true" />

        <!-- Exposes only cache downloads selected by the user, for the duration of a share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
