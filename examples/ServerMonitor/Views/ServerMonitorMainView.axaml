<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:charts="clr-namespace:RelaxKonOS.Examples.ServerMonitor.Controls"
             x:Class="RelaxKonOS.Examples.ServerMonitor.Views.ServerMonitorMainView"
             Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.cpu"><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /></Style>
    <Style Selector="Border.memory"><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /></Style>
    <Style Selector="Border.network"><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /></Style>
    <Style Selector="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /></Style>
    <Style Selector="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
    <Style Selector="ComboBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></Style>
    <Style Selector="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True">
    <Grid DockPanel.Dock="Top" Margin="20,18,20,10" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Text="Server Monitor" FontSize="25" FontWeight="SemiBold" />
        <TextBlock Text="远程服务器性能和资源概览" Classes="muted" />
      </StackPanel>
      <Button Grid.Column="1" Content="立即刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>

    <TabControl Margin="20,0,20,20">
      <TabItem Header="性能">
        <ScrollViewer Padding="0,10,0,0">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding StatusText}" Classes="muted" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Classes="card cpu">
                <StackPanel Spacing="4"><TextBlock Text="CPU" Classes="muted" /><TextBlock Text="{Binding CpuPercentText}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{Binding UptimeText}" Classes="muted" /></StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="card memory">
                <StackPanel Spacing="4"><TextBlock Text="内存" Classes="muted" /><TextBlock Text="{Binding MemoryPercentText}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="物理内存使用率" Classes="muted" /></StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card network">
                <StackPanel Spacing="4"><TextBlock Text="网络" Classes="muted" /><TextBlock Text="{Binding NetworkRateText}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="所有网卡的上下行总计" Classes="muted" /></StackPanel>
              </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
              <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="CPU 利用率" FontWeight="SemiBold" /><TextBlock Text="最近采样" Classes="muted" /><charts:HistoryChart Values="{Binding CpuHistory}" LineColor="{DynamicResource AccentColor}" /></StackPanel></Border>
              <Border Grid.Column="1" Classes="card"><StackPanel Spacing="8"><TextBlock Text="内存利用率" FontWeight="SemiBold" /><TextBlock Text="最近采样" Classes="muted" /><charts:HistoryChart Values="{Binding MemoryHistory}" LineColor="{DynamicResource AccentColor}" /></StackPanel></Border>
              <Border Grid.Row="1" Classes="card"><StackPanel Spacing="8"><TextBlock Text="网络吞吐量" FontWeight="SemiBold" /><TextBlock Text="刻度上限：1 MB/s" Classes="muted" /><charts:HistoryChart Values="{Binding NetworkHistory}" LineColor="{DynamicResource AccentColor}" Maximum="1048576" /></StackPanel></Border>
              <Border Grid.Row="1" Grid.Column="1" Classes="card"><StackPanel Spacing="8"><TextBlock Text="CPU 核心" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding CpuCores}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,6,6"><StackPanel><TextBlock Text="{Binding Name}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding Value}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="磁盘" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Disks}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="muted" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
              <StackPanel Grid.Column="1" Spacing="12">
                <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="网络适配器" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Networks}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="muted" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <Border Classes="card"><StackPanel Spacing="8"><TextBlock Text="GPU" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Gpus}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="0,3"><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Value}" Classes="muted" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding GpuHint}" Classes="muted" /></StackPanel></Border>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding LastUpdatedText}" Classes="muted" FontSize="12" Margin="2,0,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="设置">
        <StackPanel Margin="4,20" Spacing="14" MaxWidth="720">
          <TextBlock Text="监控设置" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="设置仅保存于本机的 Server Monitor 应用配置中。" Classes="muted" />
          <Grid ColumnDefinitions="*,Auto" Margin="0,6"><StackPanel Spacing="3"><TextBlock Text="刷新频率" FontWeight="SemiBold" /><TextBlock Text="服务器端最低允许每秒一次采样。" Classes="muted" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding RefreshOptions}" SelectedItem="{Binding SelectedRefreshOption}" MinWidth="210" /></Grid>
          <Grid ColumnDefinitions="*,Auto" Margin="0,6"><StackPanel Spacing="3"><TextBlock Text="图形历史记录" FontWeight="SemiBold" /><TextBlock Text="各项图形保留的采样数量。" Classes="muted" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding HistoryOptions}" SelectedItem="{Binding SelectedHistoryOption}" MinWidth="210" /></Grid>
          <Button Content="清空图形历史记录" Command="{Binding ClearHistoryCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
