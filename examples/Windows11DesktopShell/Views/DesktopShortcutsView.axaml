<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:RemoteOS.Shell;assembly=RemoteOS.Shell"
             x:Class="Example.Windows11DesktopShell.Views.DesktopShortcutsView"
             x:Name="DesktopShortcutsRoot">
    <UserControl.Styles>
        <Style Selector="Button.desktop-shortcut">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="94" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.desktop-shortcut:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
        </Style>
        <Style Selector="Button.desktop-shortcut.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#5279B8F3" />
            <Setter Property="BorderBrush" Value="#AAFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.desktop-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
        <Style Selector="TextBlock.desktop-icon">
            <Setter Property="FontSize" Value="38" />
            <Setter Property="Height" Value="48" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ItemsControl ItemsSource="{Binding DesktopEntries}" IsVisible="{Binding AreDesktopIconsVisible}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Vertical" Height="570" ItemWidth="96" ItemHeight="94" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:ShellDesktopEntry">
                <Button Classes="desktop-shortcut" Classes.selected="{Binding IsSelected}"
                        PointerPressed="DesktopShortcut_OnPointerPressed"
                        DoubleTapped="DesktopShortcut_OnDoubleTapped"
                        ToolTip.Tip="{Binding DisplayName}">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="desktop-icon" Text="{Binding IconGlyph}" />
                        <TextBlock Classes="desktop-label" Text="{Binding DisplayName}" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
