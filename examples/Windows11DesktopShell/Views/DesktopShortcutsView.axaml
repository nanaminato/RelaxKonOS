<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:RelaxKonOS.Shell;assembly=RelaxKonOS.Shell"
             x:Class="RelaxKonOS.Example.Windows11DesktopShell.Views.DesktopShortcutsView"
             x:Name="DesktopShortcutsRoot">
    <UserControl.Styles>
        <Style Selector="Button.desktop-shortcut">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="98" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="Button.desktop-shortcut:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DesktopIconHoverBrush}" />
            <Setter Property="BorderBrush" Value="#70FFFFFF" />
        </Style>
        <Style Selector="Button.desktop-shortcut.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DesktopIconSelectedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DesktopIconSelectedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.desktop-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxLines" Value="2" />
        </Style>
        <Style Selector="TextBlock.desktop-icon">
            <Setter Property="FontSize" Value="38" />
            <Setter Property="Height" Value="48" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <ItemsControl ItemsSource="{Binding DesktopEntries}" IsVisible="{Binding AreDesktopIconsVisible}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel Orientation="Vertical" ItemWidth="102" ItemHeight="104" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="shell:ShellDesktopEntry">
                <Button Classes="desktop-shortcut" Classes.selected="{Binding IsSelected}"
                        AttachedToVisualTree="DesktopShortcut_OnAttachedToVisualTree"
                        DoubleTapped="DesktopShortcut_OnDoubleTapped"
                        KeyDown="DesktopShortcut_OnKeyDown"
                        ToolTip.Tip="{Binding DisplayName}">
                    <StackPanel Spacing="4">
                        <Grid Width="48" Height="48">
                            <Image Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Stretch="Uniform" />
                            <TextBlock Classes="desktop-icon" Text="{Binding IconGlyph}" IsVisible="{Binding !HasIconImage}" />
                            <Border IsVisible="{Binding IsShortcut}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="White" CornerRadius="2">
                                <TextBlock Text="↗" Foreground="Black" FontSize="13" Margin="1,0" />
                            </Border>
                            <Border IsVisible="{Binding HasAvailability}" ToolTip.Tip="{Binding Availability.Label}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="3,0">
                                <TextBlock Text="•" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" />
                            </Border>
                        </Grid>
                        <TextBlock Classes="desktop-label" Text="{Binding DisplayName}"
                                   Foreground="{Binding DataContext.DesktopItemLabelForeground, ElementName=DesktopShortcutsRoot}" />
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
