<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RelaxKonOS.Example.Windows11DesktopShell.Views"
             x:Class="RelaxKonOS.Example.Windows11DesktopShell.Views.Windows11ShellView">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://RelaxKonOS.Example.Windows11DesktopShell/Styles/IconGeometries.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.taskbar">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="Button.taskbar:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>
        <Style Selector="Button.start-tile">
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="6,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        </Style>
        <Style Selector="TextBlock.primary">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" PointerPressed="Desktop_OnPointerPressed">
        <Grid x:Name="DesktopArea" Focusable="True" Grid.Row="0" ClipToBounds="True" Background="{Binding Wallpaper}">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding View}">
                        <MenuItem Header="{Binding ShowDesktopIcons}" ToggleType="CheckBox"
                                  IsChecked="{Binding AreDesktopIconsVisible}"
                                  Command="{Binding ToggleDesktopIconsCommand}" />
                    </MenuItem>
                    <MenuItem Header="{Binding RefreshDesktop}" Command="{Binding RefreshDesktopCommand}" />
                    <MenuItem Header="{Binding Paste}" Command="{Binding PasteDesktopCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding ConfigureDesktopDisplay}" Command="{Binding OpenDisplaySettingsCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding OpenDesktopFolder}" Command="{Binding OpenDesktopFolderCommand}" />
                    <MenuItem Header="{Binding OpenFileExplorer}" Command="{Binding OpenFileExplorerCommand}" />
                    <MenuItem Header="{Binding OpenTerminal}" Command="{Binding OpenTerminalCommand}" />
                    <Separator />
                    <MenuItem Header="{Binding Personalization}" Command="{Binding OpenPersonalizationCommand}" />
                </ContextMenu>
            </Grid.ContextMenu>
            <!-- This is a required surface for shell-hosted modal input. It must not consume
                 ordinary desktop clicks while no modal dialog is active. -->
            <Border x:Name="InputBackdrop" IsHitTestVisible="False" />

            <views:DesktopShortcutsView Margin="14" />

            <Border Margin="0,16,20,0" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasDesktopStyles}"
                    Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource OverlayCornerRadius}" Padding="8">
                <StackPanel Width="96" Spacing="4">
                    <TextBlock Text="{Binding DesktopStylesTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding DesktopStyleEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="desktop-shortcut" Height="86"
                                        Command="{Binding $parent[UserControl].DataContext.OpenDesktopStyleCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding DisplayName}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="▣" FontSize="32" Height="40" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" />
                                        <TextBlock Classes="desktop-label" Text="{Binding DisplayName}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Canvas IsHitTestVisible="False">
                <Border x:Name="SelectionRectangle" IsVisible="False" BorderThickness="1"
                        BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource DesktopIconSelectedBrush}" />
            </Canvas>
            <Canvas x:Name="WindowHost" ClipToBounds="True" />
        </Grid>

        <Border Grid.Row="1" Height="{DynamicResource TaskbarHeight}" Background="{DynamicResource TaskbarBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="0,1,0,0" BoxShadow="{DynamicResource WindowShadow}">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                    <Button Classes="taskbar" Command="{Binding ToggleStartCommand}" ToolTip.Tip="{Binding Start}">
                        <UniformGrid Columns="2" Rows="2" Width="20" Height="20">
                            <Border Background="{DynamicResource AccentBrush}" Margin="1" />
                            <Border Background="{DynamicResource AccentBrush}" Margin="1" />
                            <Border Background="{DynamicResource AccentBrush}" Margin="1" />
                            <Border Background="{DynamicResource AccentBrush}" Margin="1" />
                        </UniformGrid>
                    </Button>
                    <Button Classes="taskbar" Command="{Binding ToggleStartCommand}" ToolTip.Tip="{Binding Search}">
                        <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button Classes="taskbar" Command="{Binding ShowDesktopCommand}" ToolTip.Tip="{Binding TaskView}">
                        <Path Data="{StaticResource IconTaskView}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Fill="Transparent" Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <ScrollViewer x:Name="TaskbarApplicationScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="500">
                        <ItemsControl ItemsSource="{Binding TaskbarEntries}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="taskbar" ToolTip.Tip="{Binding DisplayName}" Command="{Binding $parent[UserControl].DataContext.ToggleTaskbarApplicationCommand}" CommandParameter="{Binding}"
                                            AttachedToVisualTree="TaskbarApplication_OnAttachedToVisualTree">
                                        <Grid RowDefinitions="*,3" Width="32" Height="34">
                                            <Image Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Width="24" Height="24" />
                                            <TextBlock Text="{Binding IconGlyph}" IsVisible="{Binding !HasIconImage}" FontSize="23" HorizontalAlignment="Center" />
                                            <Border Grid.Row="1" IsVisible="{Binding IsRunning}" Height="3" Width="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Classes="taskbar" Width="34" Command="{Binding ToggleQuickSettingsCommand}" ToolTip.Tip="{Binding HiddenIcons}">
                        <Path Data="{StaticResource IconChevronUp}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Fill="Transparent" Width="15" Height="15" Stretch="Uniform" />
                    </Button>
                    <Button Classes="taskbar" Width="68" Command="{Binding ToggleQuickSettingsCommand}" ToolTip.Tip="{Binding QuickSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Data="{StaticResource IconWifi}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" />
                            <Path Data="{StaticResource IconVolume}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Fill="Transparent" Width="18" Height="18" Stretch="Uniform" />
                        </StackPanel>
                    </Button>
                    <Button Classes="taskbar" Width="88" Command="{Binding ToggleQuickSettingsCommand}" ToolTip.Tip="{Binding QuickSettings}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="primary" Text="{Binding Clock}" FontSize="11" HorizontalAlignment="Right" />
                            <TextBlock Classes="primary" Text="{Binding Date}" FontSize="11" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Button>
                    <Button Width="7" Padding="0" Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1,0,0,0" Command="{Binding ShowDesktopCommand}" ToolTip.Tip="{Binding ShowDesktop}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="2" IsVisible="{Binding IsStartOpen}">
            <Button Command="{Binding CloseFlyoutsCommand}" Background="Transparent" BorderBrush="Transparent" />
            <Border Width="590" Height="610" Margin="0,0,0,62" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Background="{DynamicResource StartMenuBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource OverlayCornerRadius}" BoxShadow="{DynamicResource ElevationShadow}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBox Text="{Binding SearchQuery, Mode=TwoWay}" PlaceholderText="{Binding SearchPlaceholder}" Margin="32,28,32,18" Height="38" CornerRadius="{DynamicResource ControlCornerRadius}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="38,0,38,12">
                        <TextBlock Classes="primary" Text="{Binding StartSectionTitle}" FontSize="15" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="{Binding AllAppsButtonText}" Padding="12,5" Command="{Binding ToggleAllAppsCommand}" />
                    </Grid>
                    <UniformGrid Grid.Row="2" Columns="3" Rows="2" Margin="30,0,30,26" IsVisible="{Binding IsPinnedOpen}">
                        <Button Classes="start-tile" Command="{Binding OpenSettingsCommand}">
                            <StackPanel Spacing="7"><Path Data="{StaticResource IconSettings}" Fill="{DynamicResource AccentBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="primary" Text="{Binding Settings}" FontSize="12" TextAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Classes="start-tile" Command="{Binding OpenPersonalizationCommand}">
                            <StackPanel Spacing="7"><Path Data="{StaticResource IconSun}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="primary" Text="{Binding Personalization}" FontSize="12" TextAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Classes="start-tile" Command="{Binding OpenDisplaySettingsCommand}">
                            <StackPanel Spacing="7"><Path Data="{StaticResource IconDisplay}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="27" Height="27" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="primary" Text="{Binding DisplaySettings}" FontSize="12" TextAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Classes="start-tile" Command="{Binding RefreshDesktopCommand}">
                            <StackPanel Spacing="7"><Path Data="{StaticResource IconRefresh}" Fill="{DynamicResource AccentBrush}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="primary" Text="{Binding RefreshDesktop}" FontSize="12" TextAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Classes="start-tile" Command="{Binding ShowDesktopCommand}">
                            <StackPanel Spacing="7"><Path Data="{StaticResource IconTaskView}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="primary" Text="{Binding ShowDesktop}" FontSize="12" TextAlignment="Center" /></StackPanel>
                        </Button>
                        <Button Classes="start-tile" Command="{Binding OpenSettingsCommand}">
                            <StackPanel Spacing="7"><Path Data="{StaticResource IconInfo}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" /><TextBlock Classes="primary" Text="{Binding About}" FontSize="12" TextAlignment="Center" /></StackPanel>
                        </Button>
                    </UniformGrid>
                    <ScrollViewer Grid.Row="2" Margin="30,0,30,26" IsVisible="{Binding IsApplicationListOpen}"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredApplications}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemWidth="150" ItemHeight="96" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="start-tile" Width="142" Height="88" AttachedToVisualTree="AllApplication_OnAttachedToVisualTree"
                                        Command="{Binding $parent[UserControl].DataContext.OpenApplicationCommand}"
                                        CommandParameter="{Binding}">
                                        <StackPanel Spacing="6">
                                            <Grid Width="38" Height="38" HorizontalAlignment="Center">
                                                <Image Source="{Binding IconImage}" IsVisible="{Binding HasIconImage}" Stretch="Uniform" />
                                                <TextBlock Text="{Binding IconGlyph}" FontSize="32" TextAlignment="Center"
                                                           IsVisible="{Binding !HasIconImage}" />
                                            </Grid>
                                            <TextBlock Classes="primary" Text="{Binding DisplayName}" FontSize="12" MaxLines="2"
                                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="0,1,0,0"
                            CornerRadius="{DynamicResource OverlayBottomCornerRadius}" Padding="36,14">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Width="32" Height="32" CornerRadius="{DynamicResource OverlayCornerRadius}" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="R" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Classes="primary" Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <Button Grid.Column="2" Classes="taskbar" Width="40" Command="{Binding ShowDesktopCommand}" ToolTip.Tip="{Binding ShowDesktop}">
                                <Path Data="{StaticResource IconPower}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" Fill="Transparent" Width="21" Height="21" Stretch="Uniform" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" IsVisible="{Binding IsQuickSettingsOpen}">
            <Button Command="{Binding CloseFlyoutsCommand}" Background="Transparent" BorderBrush="Transparent" />
            <Border Width="340" Margin="0,0,12,62" Padding="20" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{DynamicResource StartMenuBackgroundBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="{DynamicResource OverlayCornerRadius}"
                    BoxShadow="{DynamicResource ElevationShadow}">
                <StackPanel Spacing="16">
                    <UniformGrid Columns="3" Rows="1">
                        <Button Height="42" Margin="4" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" ToolTip.Tip="{Binding Wifi}"><Path Data="{StaticResource IconWifi}" Stroke="{DynamicResource TextOnAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" /></Button>
                        <Button Height="42" Margin="4" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" ToolTip.Tip="{Binding Bluetooth}"><Path Data="{StaticResource IconBluetooth}" Stroke="{DynamicResource TextOnAccentBrush}" StrokeThickness="1.8" Fill="Transparent" Width="20" Height="20" Stretch="Uniform" /></Button>
                        <Button Height="42" Margin="4" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" ToolTip.Tip="{Binding Focus}"><Path Data="{StaticResource IconMoon}" Fill="{DynamicResource TextPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" /></Button>
                    </UniformGrid>
                    <Grid ColumnDefinitions="28,*"><Path Data="{StaticResource IconSun}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="72" /></Grid>
                    <Grid ColumnDefinitions="28,*"><Path Data="{StaticResource IconVolume}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Fill="Transparent" Width="19" Height="19" Stretch="Uniform" /><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="48" /></Grid>
                    <Button Content="{Binding OpenSettings}" HorizontalAlignment="Right" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <Canvas x:Name="FullScreenHost" Grid.RowSpan="2" ZIndex="20" ClipToBounds="True" IsHitTestVisible="False" />
        <Canvas x:Name="ShellOverlayHost" Grid.RowSpan="2" ZIndex="30" ClipToBounds="True" IsHitTestVisible="False" />
    </Grid>
</UserControl>
