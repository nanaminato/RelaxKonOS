<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <Target Name="ValidateProxyContractBoundary" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <InvalidProxyContractFramework Include="@(FrameworkReference)" Condition="'%(FrameworkReference.Identity)' != 'Microsoft.NETCore.App' or '%(FrameworkReference.IsImplicitlyDefined)' != 'true'" />
    </ItemGroup>
    <Error Condition="'@(ProjectReference)' != '' or '@(Reference)' != '' or '@(PackageReference)' != '' or '@(InvalidProxyContractFramework)' != '' or '@(COMReference)' != ''"
           Text="Proxy shared contracts must depend only on the implicit .NET framework, never Host or implementation projects or private dependencies." />
  </Target>
</Project>
