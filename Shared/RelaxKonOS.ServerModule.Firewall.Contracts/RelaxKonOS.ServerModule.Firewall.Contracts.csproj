<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../RelaxKonOS.Protocol/RelaxKonOS.Protocol.csproj" /></ItemGroup>
  <Target Name="ValidateFirewallContractBoundary" BeforeTargets="PrepareForBuild">
    <PropertyGroup><FirewallProtocolProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../RelaxKonOS.Protocol/RelaxKonOS.Protocol.csproj'))</FirewallProtocolProjectPath></PropertyGroup>
    <ItemGroup>
      <InvalidFirewallContractProject Include="@(ProjectReference)" Condition="'%(ProjectReference.FullPath)' != '$(FirewallProtocolProjectPath)'" />
      <InvalidFirewallContractFramework Include="@(FrameworkReference)" Condition="'%(FrameworkReference.Identity)' != 'Microsoft.NETCore.App' or '%(FrameworkReference.IsImplicitlyDefined)' != 'true'" />
    </ItemGroup>
    <Error Condition="'@(InvalidFirewallContractProject)' != '' or '@(Reference)' != '' or '@(PackageReference)' != '' or '@(InvalidFirewallContractFramework)' != '' or '@(COMReference)' != ''"
           Text="Firewall contracts may reference only the canonical Protocol project and implicit .NET framework; Host and implementation dependencies are forbidden." />
  </Target>
</Project>
