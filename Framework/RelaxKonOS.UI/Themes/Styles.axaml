<Styles xmlns="https://github.com/avaloniaui">
  <!-- Keep scrollbars in their own layout cells. Fluent's auto-hide mode spans
       content beneath both tracks, obscuring stretched fields and edge actions. -->
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
  </Style>
  <!-- Shared state vocabulary: application pages reuse these states instead of inventing local colours. -->
  <!-- Wallpaper labels need their own contrast pair, independent of window surface text. -->
  <Style Selector="TextBlock.desktop-label">
    <Setter Property="Foreground" Value="{DynamicResource DesktopItemLabelForegroundBrush}" />
    <Setter Property="Effect">
      <DropShadowEffect Color="{DynamicResource DesktopItemLabelShadowColor}" BlurRadius="3" OffsetX="0" OffsetY="1" Opacity="1" />
    </Setter>
  </Style>
  <Style Selector="Button"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" /><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" /><Setter Property="FontFamily" Value="{DynamicResource ContentFont}" /><Setter Property="Template"><ControlTemplate><ContentPresenter Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" /></ControlTemplate></Setter></Style>
  <Style Selector="Button:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style>
  <Style Selector="Button:pressed"><Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" /><Setter Property="Opacity" Value="0.65" /></Style>
  <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource FocusRingThickness}" /></Style>
  <!-- Reserve the same border in every state: hover/focus/selection never moves desktop artwork. -->
  <Style Selector="Button.desktop-shortcut">
    <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="Button.desktop-shortcut:focus-visible"><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Button.desktop-shortcut:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DesktopIconHoverBrush}" />
    <Setter Property="BorderBrush" Value="#70FFFFFF" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.desktop-shortcut.selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DesktopIconSelectedBrush}" />
    <Setter Property="BorderBrush" Value="#A0FFFFFF" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" /><Setter Property="MinHeight" Value="{DynamicResource MinimumHitTarget}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /></Style><Style Selector="Button.primary:pressed"><Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" /></Style>
  <Style Selector="Button.danger"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextOnDangerBrush}" /></Style><Style Selector="Button.danger:pointerover"><Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" /></Style><Style Selector="Button.danger:pressed"><Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" /></Style>
  <!-- Persistent left-side navigation state.  The accent rail remains visible even when
       the selected item is hovered or pressed, so the current page is never confused
       with a transient pointer state. -->
  <Style Selector="Button.workspace-nav"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  <Style Selector="Button.workspace-nav:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
  <Style Selector="Button.workspace-nav:pressed"><Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" /></Style>
  <Style Selector="Button.workspace-nav.nav-selected"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.workspace-nav.nav-selected:pointerover"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.workspace-nav.nav-selected:pressed"><Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" /></Style>
  <Style Selector="Button.icon"><Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="{DynamicResource MinimumHitTarget}" /><Setter Property="MinHeight" Value="{DynamicResource MinimumHitTarget}" /><Setter Property="Width" Value="{DynamicResource MinimumHitTarget}" /><Setter Property="Height" Value="{DynamicResource MinimumHitTarget}" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <!-- Managed application-window controls take a platform caption's own measure rather than the
       height of whatever bar they happen to sit in: a button is `WindowControlWidth` by
       `WindowCaptionHeight` (Windows 11: 46x32), and the glyph inside it is drawn at
       `WindowCaptionGlyphSize` (Windows 11: a ~10px mark). Centring the glyph is what produces the
       whitespace the platform leaves around it - 18px either side and 11px above and below on that
       profile - so a fused bar can grow around a tab strip without stretching the buttons with it. -->
  <Style Selector="Button.caption"><Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="{DynamicResource WindowControlWidth}" /><Setter Property="Width" Value="{DynamicResource WindowControlWidth}" /><Setter Property="Height" Value="{DynamicResource WindowCaptionHeight}" /><Setter Property="MinHeight" Value="{DynamicResource WindowCaptionHeight}" /><Setter Property="CornerRadius" Value="0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <!-- A caption mark is stroked geometry sized by the style (WindowCaptionGlyphSize), not text: one
       hairline, which is what the platform's own marks are drawn with, and it keeps that weight at
       every caption size instead of inheriting a font's. The stroke follows the button's Foreground,
       so hover, pressed and traffic-light reveal states keep working untouched. -->
  <Style Selector="Path.caption-glyph"><Setter Property="StrokeThickness" Value="1" /></Style>
  <Style Selector="Button.caption.close:pointerover"><Setter Property="Background" Value="{DynamicResource DangerBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextOnDangerBrush}" /></Style><Style Selector="Button.caption.close:pressed"><Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" /></Style>
  <!-- Editable fields always need an outline, even when the system style makes ordinary
       controls borderless. Use a legible neutral palette colour rather than a subtle divider.
       Pin the unfocused template border too, so Fluent hover/disabled states retain it. -->
  <Style Selector="TextBox"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" /><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="TextBox:not(:focus) /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource FocusRingThickness}" /></Style>
  <!-- Selected text is painted behind the glyphs, not inverted with them, so it takes the palette's
       own text-selection role. Left to Fluent the highlight is the raw accent, which reads as a
       highlighter smear across a field or a diff instead of a selection. -->
  <Style Selector="TextBox"><Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" /></Style>
  <Style Selector="SelectableTextBlock"><Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" /></Style>
  <Style Selector="TextPresenter"><Setter Property="SelectionBrush" Value="{DynamicResource TextSelectionBrush}" /></Style>
  <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style><Style Selector="RadioButton"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style><Style Selector="ToggleSwitch"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
  <Style Selector="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /></Style><Style Selector="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style><Style Selector="ComboBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style><Style Selector="ComboBoxItem:selected"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" /></Style>
  <Style Selector="TabItem"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style><Style Selector="TabItem:selected"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style><Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSunkenBrush}" /></Style>
  <Style Selector="DataGrid"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /></Style><Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style><Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="{DynamicResource ControlPadding}" /><Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style><Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Style><Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource SelectionForegroundBrush}" /></Style>
  <!-- Trees take their row colours from the Fluent key bridge in Controls/ControlThemeOverrides.axaml:
       an application style cannot outrank the template's own selected-state setters, so the shared
       selection vocabulary is installed where the template actually reads it. Only the corner shape
       is a control-level property here. -->
  <Style Selector="TreeViewItem"><Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
  <Style Selector="Border.surface"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" /></Style><Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" /><Setter Property="BorderThickness" Value="{DynamicResource ControlBorderThickness}" /><Setter Property="Padding" Value="16" /><Setter Property="BoxShadow" Value="{DynamicResource ElevationShadow}" /></Style>
  <Style Selector="TextBlock.subtle"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style><Style Selector="TextBlock.title"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="15" /></Style><Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Auto" /><Setter Property="VerticalScrollBarVisibility" Value="Auto" /></Style>

  <!-- ── Command menus, tooltips and flyouts ──
       Avalonia's Fluent templates already resolve every part of a ContextMenu, submenu, tooltip
       and flyout through dynamic resource keys. The host bridges those keys onto the semantic
       palette and the system-style menu tokens in Controls/ControlThemeOverrides.axaml and
       SystemStyleResourceBuilder, so one style switch changes menu density, corners and colours
       for every application without any application participating. The setters below only add the
       properties Fluent does not expose as a resource. -->
  <Style Selector="MenuItem"><Setter Property="MinHeight" Value="{DynamicResource MenuItemHeight}" /><Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
  <!-- A separator is structural, so it uses the weakest border role rather than a text colour. -->
  <Style Selector="Separator"><Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}" /></Style>
  <Style Selector="ToolTip"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
  <Style Selector="ContextMenu"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
</Styles>
