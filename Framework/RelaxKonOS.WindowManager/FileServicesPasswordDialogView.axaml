<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelaxKonOS.WindowManager.FileServicesPasswordDialogView" Classes="builtin-app">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" />
        <TextBox x:Name="PasswordBox" PasswordChar="•" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CancelButton" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
