<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RelaxKonOS.App.SDK/RelaxKonOS.App.SDK.csproj" />
    <ProjectReference Include="../RelaxKonOS.UI/RelaxKonOS.UI.csproj" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <EmbeddedResource Include="../../Applications/RelaxKonOS.App.SshFiles/Localization/*.json"
                      LogicalName="SshFiles.Localization.%(Filename).json" />
    <InternalsVisibleTo Include="RelaxKonOS.App.SshFiles" />
    <InternalsVisibleTo Include="RelaxKonOS.Client" />
    <InternalsVisibleTo Include="RelaxKonOS.WindowPreviews.Tests" />
  </ItemGroup>
</Project>
