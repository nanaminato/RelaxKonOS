<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PrebuiltServerAssemblyPath Condition="'$(PrebuiltServerAssemblyPath)' == ''">../RelaxKonOS.Server/bin/Debug/net10.0/RelaxKonOS.Server.dll</PrebuiltServerAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <Compile Include="../Client/RelaxKonOS.Client/Apps/ApplicationDeployments/DeploymentUploadContent.cs" Link="DeploymentUploadContent.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/SambaShareConfiguration.cs" Link="SambaShareConfiguration.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/SambaMainConfiguration.cs" Link="SambaMainConfiguration.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/SambaCredentialCommand.cs" Link="SambaCredentialCommand.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/SambaUserStatus.cs" Link="SambaUserStatus.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/LinuxDistributionSupport.cs" Link="LinuxDistributionSupport.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/LinuxUserFileOperations.cs" Link="LinuxUserFileOperations.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/WindowsSmbShareSecurity.cs" Link="WindowsSmbShareSecurity.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/DeveloperUserSidAllowList.cs" Link="DeveloperUserSidAllowList.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/WindowsPrivilegedPipeSecurity.cs" Link="WindowsPrivilegedPipeSecurity.cs" />
    <Compile Include="../RelaxKonOS.PrivilegedHelper/WindowsFeatureInstallationState.cs" Link="WindowsFeatureInstallationState.cs" />
    <Compile Include="../Client/RelaxKonOS.Client/Apps/Git/GitConflictBlock.cs" Link="GitConflictBlock.cs" />
    <ProjectReference Include="../Framework/RelaxKonOS.Core/RelaxKonOS.Core.csproj" Condition="'$(UsePrebuiltServerAssembly)' != 'true'" />
    <ProjectReference Include="../RelaxKonOS.Server/RelaxKonOS.Server.csproj" Condition="'$(UsePrebuiltServerAssembly)' != 'true'" />
    <!-- The local desktop SDK currently lacks workload locator SDKs. This opt-in path permits
         the smoke test to run against a just-built Server assembly without weakening CI's normal
         project-reference build. -->
    <Reference Include="RelaxKonOS.Server" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>$(PrebuiltServerAssemblyPath)</HintPath>
    </Reference>
    <Reference Include="Microsoft.Data.Sqlite" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/SQLitePCLRaw.batteries_v2.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.core" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/SQLitePCLRaw.core.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/SQLitePCLRaw.provider.e_sqlite3.dll</HintPath>
    </Reference>
    <None Include="../RelaxKonOS.Server/bin/Debug/net10.0/runtimes/linux-x64/native/libe_sqlite3.so"
          Link="libe_sqlite3.so" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(UsePrebuiltServerAssembly)' == 'true' and '$(OS)' == 'Unix'" />
    <!-- Prebuilt mode must also expose the Server's compile-time API surface, not merely its
         implementation assembly. This keeps the local smoke suite runnable on SDKs where
         project-reference workload resolution is unavailable. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(UsePrebuiltServerAssembly)' == 'true'" />
    <Reference Include="RelaxKonOS.Protocol" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../Shared/RelaxKonOS.Protocol/bin/Debug/net10.0/RelaxKonOS.Protocol.dll</HintPath>
    </Reference>
    <Reference Include="RelaxKonOS.Core" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../Framework/RelaxKonOS.Core/bin/Debug/net10.0/RelaxKonOS.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/Microsoft.EntityFrameworkCore.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Sqlite" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/Microsoft.EntityFrameworkCore.Sqlite.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Relational" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/Microsoft.EntityFrameworkCore.Relational.dll</HintPath>
    </Reference>
    <Reference Include="System.IdentityModel.Tokens.Jwt" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/System.IdentityModel.Tokens.Jwt.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/Microsoft.AspNetCore.Authentication.JwtBearer.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.IdentityModel.Tokens" Condition="'$(UsePrebuiltServerAssembly)' == 'true'">
      <HintPath>../RelaxKonOS.Server/bin/Debug/net10.0/Microsoft.IdentityModel.Tokens.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
