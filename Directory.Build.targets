<Project>
  <PropertyGroup>
    <!-- 统一在根目录关闭遥测，子项目里就不需要再写了 -->
    <AvaloniaBuildTelemetryOptOut>true</AvaloniaBuildTelemetryOptOut>
  </PropertyGroup>

  <!-- 核心修复：强行拦截并修正项目间引用的 TargetFramework 协商逻辑 -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <!-- 仅为普通 .NET 项目补齐协商值。平台 TFM 必须让 SDK 选择其兼容的
           net10.0 项目引用；将平台 TFM 强制传给纯库会使其 assets 缺少目标。 -->
      <SetTargetFramework Condition="'%(ProjectReference.SetTargetFramework)' == '' and '$(TargetFramework)' != '' and '$(TargetPlatformIdentifier)' == ''">TargetFramework=$(TargetFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemDefinitionGroup>

  <!-- 兼容修复：防止 Avalonia 12 编译器在 .NET 10 下因内部评估顺序导致 TargetFramework 被意外清空 -->
  <Target Name="EnsureTargetFrameworkNotNull" BeforeTargets="_GetTargetFrameworksOutput">
    <PropertyGroup>
      <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    </PropertyGroup>
  </Target>
</Project>
