<Project>
  <PropertyGroup>
    <!-- 统一在根目录关闭遥测，子项目里就不需要再写了 -->
    <AvaloniaBuildTelemetryOptOut>true</AvaloniaBuildTelemetryOptOut>
  </PropertyGroup>

  <!-- 核心修复：强行拦截并修正项目间引用的 TargetFramework 协商逻辑 -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <!-- 如果 MSBuild 没能正确推导并传递 TargetFramework，则强制将当前项目的 net10.0 作为协商值传递过去，绝不允许空值出现 -->
      <SetTargetFramework Condition="'%(ProjectReference.SetTargetFramework)' == '' and '$(TargetFramework)' != ''">TargetFramework=$(TargetFramework)</SetTargetFramework>
    </ProjectReference>
  </ItemDefinitionGroup>

  <!-- 兼容修复：防止 Avalonia 12 编译器在 .NET 10 下因内部评估顺序导致 TargetFramework 被意外清空 -->
  <Target Name="EnsureTargetFrameworkNotNull" BeforeTargets="_GetTargetFrameworksOutput">
    <PropertyGroup>
      <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    </PropertyGroup>
  </Target>
</Project>