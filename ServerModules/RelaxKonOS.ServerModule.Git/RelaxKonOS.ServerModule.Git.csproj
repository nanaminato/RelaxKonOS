<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Shared/RelaxKonOS.ServerModule.Git.Contracts/RelaxKonOS.ServerModule.Git.Contracts.csproj" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <InternalsVisibleTo Include="RelaxKonOS.ServerModules.Tests" />
    <InternalsVisibleTo Include="RelaxKonOS.Server.Tests" />
  </ItemGroup>
  <Target Name="ValidateGitModuleBoundary" BeforeTargets="ResolveReferences">
    <ItemGroup>
      <InvalidGitImplementationProject Include="@(ProjectReference)" Condition="'%(ProjectReference.Filename)' != 'RelaxKonOS.ServerModule.Git.Contracts' and '%(ProjectReference.Filename)' != 'RelaxKonOS.Protocol' and '%(ProjectReference.Filename)' != 'RelaxKonOS.ServerModule.Abstractions'" />
    </ItemGroup>
    <Error Condition="'@(InvalidGitImplementationProject)' != ''" Text="Git execution may reference only its shared contracts, never Server or another implementation." />
  </Target>
</Project>
