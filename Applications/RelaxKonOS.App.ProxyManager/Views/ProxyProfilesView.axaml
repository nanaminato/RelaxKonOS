<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.App.ProxyManager.Views"
             xmlns:proxy="clr-namespace:RelaxKonOS.App.ProxyManager"
             xmlns:dto="clr-namespace:RelaxKonOS.Protocol.Proxy;assembly=RelaxKonOS.Protocol"
             x:Class="RelaxKonOS.App.ProxyManager.Views.ProxyProfilesView"
             x:DataType="proxy:ProxyManagerViewModel" Classes="builtin-app">
  <UserControl.Styles>
    <StyleInclude Source="avares://RelaxKonOS.App.ProxyManager/ProxyStyles.axaml" />
    <Style Selector="Path.subscription-refreshing">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
    <StackPanel Spacing="10">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Loc proxy.subscriptions}" Classes="page-title" />
        <TextBlock Text="{loc:Loc proxy.subscriptions_hint}" Classes="page-hint" />
      </StackPanel>
      <WrapPanel ItemSpacing="8" LineSpacing="8">
        <Button Classes="ghost-action" Content="{loc:Loc proxy.subscription_update_all}" Command="{Binding UpdateAllSubscriptionsCommand}" />
        <Button Classes="primary" Content="{loc:Loc proxy.subscription_view_runtime}" Command="{Binding ViewRuntimeSubscriptionsCommand}" />
      </WrapPanel>
    </StackPanel>

    <!-- The runtime is installed from the component center, so the notice names that path instead
         of offering an install command this application no longer owns. -->
    <Border Grid.Row="1" Classes="notice warn" IsVisible="{Binding RuntimeIsNotInstalled}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Path Classes="glyph" Width="18" Height="18" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.6" Data="M12 3 L22 20 H2 Z M12 9 V14 M12 17 V17.5" />
        <TextBlock Grid.Column="1" Text="{loc:Loc proxy.subscription_runtime_required}" Classes="section-hint" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding RuntimeIsInstalled}">
      <TextBox Text="{Binding SubscriptionLink, Mode=TwoWay}" PlaceholderText="{loc:Loc proxy.subscription_link}" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="primary" Content="{loc:Loc proxy.subscription_import}" Command="{Binding ImportSubscriptionCommand}" />
    </Grid>

    <!-- Keep the cards in the page viewport. Without this, a long subscription list grows beyond
         the workspace's final star row and is clipped by its parent. -->
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding VisibleSubscriptions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="dto:ProxySubscriptionDto">
            <Button Classes="card-tile" Width="268" Height="118" Margin="0,0,12,12" Classes.active="{Binding IsActive}"
                    Command="{Binding $parent[ItemsControl].DataContext.ActivateSubscriptionCommand}"
                    CommandParameter="{Binding}"
                    ToolTip.Tip="{loc:Loc proxy.subscription_reactivate}">
              <Grid>
                <Border Classes="tile-rail" IsVisible="{Binding IsActive}" />
                <Grid Margin="14,12" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Path Classes="glyph small" Stroke="{DynamicResource TextSecondaryBrush}"
                          Data="M10 13 A4 4 0 0 0 16 13 L19 10 A4 4 0 0 0 13 4 L11.6 5.4 M14 11 A4 4 0 0 0 8 11 L5 14 A4 4 0 0 0 11 20 L12.4 18.6" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Grid Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center" ToolTip.Tip="{loc:Loc proxy.subscription_reactivate}">
                      <Path Classes="glyph small subscription-refreshing" Stroke="{DynamicResource AccentBrush}"
                            IsVisible="{Binding $parent[ItemsControl].DataContext.IsSubscriptionRefreshActive}" RenderTransformOrigin="50%,50%"
                            Data="M20 10 A8 8 0 0 0 6 6 L3 9 M3 4 V9 H8 M4 14 A8 8 0 0 0 18 18 L21 15 M16 15 H21 V20">
                        <Path.RenderTransform><RotateTransform Angle="0" /></Path.RenderTransform>
                      </Path>
                      <Path Classes="glyph small" Stroke="{DynamicResource TextSecondaryBrush}"
                            IsVisible="{Binding !$parent[ItemsControl].DataContext.IsSubscriptionRefreshActive}"
                            Data="M20 10 A8 8 0 0 0 6 6 L3 9 M3 4 V9 H8 M4 14 A8 8 0 0 0 18 18 L21 15 M16 15 H21 V20" />
                    </Grid>
                  </Grid>
                  <TextBlock Grid.Row="1" Text="{loc:Loc proxy.subscription_source_configured}" Classes="section-hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding LastUpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Classes="section-hint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Classes="pill ok" IsVisible="{Binding IsActive}"><TextBlock Text="{loc:Loc proxy.subscription_active}" /></Border>
                    <Border Grid.Column="1" Classes="pill" IsVisible="{Binding !IsActive}"><TextBlock Text="{loc:Loc proxy.subscription_inactive}" /></Border>
                  </Grid>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
