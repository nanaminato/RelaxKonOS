<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:RelaxKonOS.App.ProxyManager.Views" xmlns:proxy="clr-namespace:RelaxKonOS.App.ProxyManager" x:Class="RelaxKonOS.App.ProxyManager.Views.ProxyConnectionsView" x:DataType="proxy:ProxyManagerViewModel" Classes="builtin-app">
  <UserControl.Styles>
    <StyleInclude Source="avares://RelaxKonOS.App.ProxyManager/ProxyStyles.axaml" />
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Loc proxy.connections}" Classes="page-title" />
        <TextBlock Text="{loc:Loc proxy.connections_hint}" Classes="page-hint" />
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost-action" Content="{loc:Loc common.refresh}" Command="{Binding RefreshConnectionsCommand}" VerticalAlignment="Center" />
    </Grid>

    <Border Grid.Row="1" Classes="panel" Padding="14">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
          <Button Classes="ghost-action destructive" Content="{loc:Loc proxy.close_connection}" Command="{Binding CloseConnectionCommand}" VerticalAlignment="Center" />
          <!-- One line states either the measured count or why the controller read failed, so the
               table never has to stand in for a status message. -->
          <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" Classes="section-hint" HorizontalAlignment="Right" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConnectionStatus}" />
        </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MinHeight="160"
                  BorderThickness="0" Classes="resource-table">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc proxy.source}" Binding="{ReflectionBinding Source}" Width="190" CanUserResize="True" />
            <DataGridTextColumn Header="{loc:Loc proxy.destination}" Binding="{ReflectionBinding Destination}" Width="*" CanUserResize="True" />
            <DataGridTextColumn Header="{loc:Loc proxy.rule}" Binding="{ReflectionBinding Rule}" Width="180" CanUserResize="True" />
            <DataGridTextColumn Header="{loc:Loc proxy.chain}" Binding="{ReflectionBinding Chains}" Width="180" CanUserResize="True" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
