<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Framework/RelaxKonOS.App.SDK/RelaxKonOS.App.SDK.csproj" />
    <ProjectReference Include="../../Framework/RelaxKonOS.UI/RelaxKonOS.UI.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <EmbeddedResource Include="Localization/*.json" LogicalName="Notepad.Localization.%(Filename).json" />
    <EmbeddedResource Include="Assets/notepad.png" LogicalName="Notepad.Icon.png" />
    <EmbeddedResource Include="manifest.json" LogicalName="Notepad.Manifest.json" />
  </ItemGroup>
</Project>
