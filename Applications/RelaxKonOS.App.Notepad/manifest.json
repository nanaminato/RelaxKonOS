{
  "id": "relaxkonos.notepad",
  "displayName": "Notebook",
  "version": "1.0.0",
  "permissionModelVersion": 2,
  "entryAssembly": "lib/net10.0/RelaxKonOS.App.Notepad.dll",
  "entryType": "RelaxKonOS.App.Notepad.NotepadApp",
  "iconGlyph": "📝",
  "iconPath": "Assets/notepad.png",
  "description": "Text editor for remote files",
  "localizedMetadata": {
    "zh-CN": {
      "displayName": "记事本",
      "description": "用于编辑远程文件的文本编辑器"
    },
    "ja-JP": {
      "displayName": "メモ帳",
      "description": "リモートファイル用テキストエディター"
    }
  },
  "requestedPermissions": [
    "server.files.read",
    "server.files.write"
  ],
  "supportedFileExtensions": [
    ".txt",
    ".text",
    ".md",
    ".markdown",
    ".mdx",
    ".rst",
    ".adoc",
    ".asciidoc",
    ".log",
    ".nfo",
    ".csv",
    ".tsv",
    ".tab",
    ".ini",
    ".cfg",
    ".conf",
    ".config",
    ".properties",
    ".yaml",
    ".yml",
    ".toml",
    ".xml",
    ".xsd",
    ".xsl",
    ".xslt",
    ".json",
    ".jsonc",
    ".json5",
    ".html",
    ".htm",
    ".xhtml",
    ".css",
    ".scss",
    ".sass",
    ".less",
    ".tex",
    ".bib",
    ".srt",
    ".vtt",
    ".ics",
    ".vcf",
    ".diff",
    ".patch",
    ".asc",
    ".pem",
    ".crt",
    ".cer",
    ".pub"
  ],
  "supportsExtensionlessFiles": true,
  "supportsTextFiles": true,
  "instancePolicy": "MultiWindow"
}
