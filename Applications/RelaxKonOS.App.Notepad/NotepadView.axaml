<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notepad="clr-namespace:RelaxKonOS.App.Notepad"
             x:Class="RelaxKonOS.App.Notepad.NotepadView"
             x:Name="Root"
             x:DataType="notepad:NotepadViewModel"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="HeaderHost" Grid.Row="0" ColumnDefinitions="Auto,*">
            <StackPanel x:Name="HeaderLeading" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="18" Height="18" Margin="0,0,6,0" x:Name="HeaderIcon" VerticalAlignment="Center" />
                <Menu x:Name="HeaderMenu" Background="Transparent" BorderThickness="0" IsEnabled="{Binding CanEditDocument}">
                    <MenuItem Header="{ReflectionBinding Labels[common.file]}">
                        <MenuItem Header="{ReflectionBinding Labels[common.new]}" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="{ReflectionBinding Labels[common.open_ellipsis]}" Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="{ReflectionBinding Labels[common.save]}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                        <MenuItem Header="{ReflectionBinding Labels[common.save_as_ellipsis]}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                    </MenuItem>
                    <MenuItem Header="{ReflectionBinding Labels[common.settings]}">
                        <MenuItem Header="{ReflectionBinding Labels[common.preferences_ellipsis]}" Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>
                </Menu>
                <Button x:Name="CompactMenu" Classes="header-action" Content="☰" IsVisible="False" IsEnabled="{Binding CanEditDocument}" ToolTip.Tip="{ReflectionBinding Labels[common.file]}" AutomationProperties.Name="{ReflectionBinding Labels[common.file]}">
                    <Button.Flyout><MenuFlyout>
                    <MenuItem Header="{ReflectionBinding Labels[common.file]}">
                        <MenuItem Header="{ReflectionBinding Labels[common.new]}" Command="{Binding NewDocumentCommand}" InputGesture="Ctrl+N" />
                        <MenuItem Header="{ReflectionBinding Labels[common.open_ellipsis]}" Command="{Binding OpenDocumentCommand}" InputGesture="Ctrl+O" />
                        <Separator />
                        <MenuItem Header="{ReflectionBinding Labels[common.save]}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                        <MenuItem Header="{ReflectionBinding Labels[common.save_as_ellipsis]}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                    </MenuItem>
                    <MenuItem Header="{ReflectionBinding Labels[common.settings]}">
                        <MenuItem Header="{ReflectionBinding Labels[common.preferences_ellipsis]}" Command="{Binding OpenSettingsCommand}" />
                    </MenuItem>
                    </MenuFlyout></Button.Flyout>
                </Button>
            </StackPanel>
            <TextBlock x:Name="HeaderCenter" Grid.Column="1" Text="{Binding DocumentName}" ToolTip.Tip="{Binding DocumentName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </Grid>

        <TextBox Grid.Row="1"
                 Text="{Binding Text}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 BorderThickness="0"
                 CornerRadius="0"
                 Padding="12,10"
                 FontFamily="Consolas, Cascadia Mono, monospace"
                 FontSize="{Binding FontSize}"
                 IsReadOnly="{Binding IsSaving}"
                 CaretBrush="{DynamicResource AccentBrush}" />

        <Border Grid.Row="2" Classes="app-statusbar">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="14">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="{Binding EncodingName}" FontSize="12" Padding="4,0"
                        IsVisible="{Binding HasOpenFile}" ToolTip.Tip="{ReflectionBinding Labels[common.file_encoding]}"
                        IsEnabled="{Binding CanEditDocument}"
                        Command="{Binding ChooseEncodingCommand}" />
                <TextBlock Grid.Column="2" Text="{Binding LineCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding CharacterCountText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
