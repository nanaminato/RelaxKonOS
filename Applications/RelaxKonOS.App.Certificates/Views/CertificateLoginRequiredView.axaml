<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.App.Certificates"
             x:Class="RelaxKonOS.App.Certificates.Views.CertificateLoginRequiredView" Classes="builtin-app">
    <TextBlock Margin="24" Text="{loc:Loc certificates.login_required}" TextWrapping="Wrap" />
</UserControl>
