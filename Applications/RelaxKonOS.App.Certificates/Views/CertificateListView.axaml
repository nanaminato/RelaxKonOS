<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.App.Certificates"
             xmlns:certificateApp="clr-namespace:RelaxKonOS.App.Certificates"
             x:Name="CertificateList" x:Class="RelaxKonOS.App.Certificates.Views.CertificateListView"
             x:DataType="certificateApp:CertificateManagerViewModel" Classes="builtin-app">
    <Border Padding="20" Classes="app-panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{loc:Loc certificates.list}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Loc certificates.refresh}" Command="{Binding RefreshCommand}" />
                    <Button Classes="primary" Content="{loc:Loc certificates.request.title}" Click="RequestCertificate_Click" />
                    <Button Content="{loc:Loc certificates.self_signed.title}" Click="CreateSelfSignedCertificate_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="{loc:Loc certificates.list_hint}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <DataGrid x:Name="CertificatesGrid" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          ItemsSource="{Binding Certificates}"
                          SelectedItem="{Binding SelectedCertificate, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserReorderColumns="False"
                          SelectionMode="Single"
                          HorizontalScrollBarVisibility="Disabled"
                          MinWidth="900" Classes="resource-table">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{ReflectionBinding #CertificateList.DataContext.CurrentLanguage, Converter={x:Static loc:LocExtension.Converter}, ConverterParameter=certificates.column.domain}" Binding="{ReflectionBinding PrimaryDomain}" Width="220" />
                        <DataGridTextColumn Header="{ReflectionBinding #CertificateList.DataContext.CurrentLanguage, Converter={x:Static loc:LocExtension.Converter}, ConverterParameter=certificates.column.kind}" SortMemberPath="Kind" Width="120" />
                        <DataGridTextColumn Header="{ReflectionBinding #CertificateList.DataContext.CurrentLanguage, Converter={x:Static loc:LocExtension.Converter}, ConverterParameter=certificates.column.status}" SortMemberPath="Status" Width="110" />
                        <DataGridTextColumn Header="{ReflectionBinding #CertificateList.DataContext.CurrentLanguage, Converter={x:Static loc:LocExtension.Converter}, ConverterParameter=certificates.column.challenge}" SortMemberPath="ChallengeType" Width="130" />
                        <DataGridTextColumn Header="{ReflectionBinding #CertificateList.DataContext.CurrentLanguage, Converter={x:Static loc:LocExtension.Converter}, ConverterParameter=certificates.column.issuer}" Binding="{ReflectionBinding Issuer}" Width="180" />
                        <DataGridTextColumn Header="{ReflectionBinding #CertificateList.DataContext.CurrentLanguage, Converter={x:Static loc:LocExtension.Converter}, ConverterParameter=certificates.column.not_before}" Binding="{ReflectionBinding NotBefore}" Width="180" />
                        <DataGridTextColumn Header="{ReflectionBinding #CertificateList.DataContext.CurrentLanguage, Converter={x:Static loc:LocExtension.Converter}, ConverterParameter=certificates.column.not_after}" Binding="{ReflectionBinding NotAfter}" Width="180" />
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
            <WrapPanel Grid.Row="3" ItemHeight="34" HorizontalAlignment="Left">
                <Button Content="{loc:Loc certificates.action.renew}" Command="{Binding RenewCommand}" Margin="0,0,8,8" />
                <Button Content="{loc:Loc certificates.action.revoke}" Command="{Binding RevokeCommand}" Margin="0,0,8,8" />
                <Button Content="{loc:Loc certificates.renewal.title}" IsEnabled="{Binding HasSelectedCertificate}" Click="RenewalHistory_Click" Margin="0,0,8,8" />
                <Button Content="{loc:Loc certificates.delete}" Command="{Binding DeleteCommand}" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,8" />
            </WrapPanel>
            <Border Grid.Row="4" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="8" Padding="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Loc certificates.fingerprint.sha256}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBox Text="{Binding SelectedCertificate.FingerprintSha256}" IsReadOnly="True" PlaceholderText="{loc:Loc certificates.fingerprint.select_hint}" />
                    <TextBlock Text="{loc:Loc certificates.fingerprint.help}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="5" Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
    </Border>
</UserControl>
