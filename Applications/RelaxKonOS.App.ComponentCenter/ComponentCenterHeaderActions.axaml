<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:sdk="using:RelaxKonOS.AppSDK"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:RelaxKonOS.App.ComponentCenter"
 x:Class="RelaxKonOS.App.ComponentCenter.ComponentCenterHeaderActions"
 x:DataType="sdk:IComponentCenterHeaderActions" VerticalAlignment="Center">
 <UserControl.Styles>
  <!-- The task entry borrows the header's secondary-command shape so the two read as one row. The
       trailing ellipsis is part of the label ("opens a dialog"), so the button keeps a floor width. -->
  <Style Selector="Button.header-tasks">
   <Setter Property="MinWidth" Value="86" />
   <Setter Property="Height" Value="30" />
   <Setter Property="FontSize" Value="12" />
  </Style>
 </UserControl.Styles>
 <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
  <Button Classes="ghost-action header-tasks" Command="{Binding OpenTasksCommand}"
          AutomationProperties.Name="{local:Loc component_center.task_dialog.title}"
          ToolTip.Tip="{local:Loc component_center.task_dialog.scope}">
   <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
    <Path Width="13" Height="13" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}"
          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
          Data="M3 6 L5 8 L9 4 M3 12 L5 14 L9 10 M3 18 L5 20 L9 16 M13 6 H21 M13 12 H21 M13 18 H21" />
    <TextBlock Text="{local:Loc component_center.task_dialog.open}" VerticalAlignment="Center" />
   </StackPanel>
  </Button>
  <Button Classes="header-refresh" Height="30" Command="{Binding RefreshCommand}" ToolTip.Tip="{local:Loc proxy_server.refresh}"
          AutomationProperties.Name="{local:Loc proxy_server.refresh}" IsEnabled="{Binding Runtime.CanRefreshSources}" />
 </StackPanel>
</UserControl>
