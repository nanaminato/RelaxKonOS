<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:RelaxKonOS.App.ComponentCenter"
 xmlns:sdk="using:RelaxKonOS.AppSDK"
 xmlns:p="using:RelaxKonOS.Protocol.Common"
 x:Class="RelaxKonOS.App.ComponentCenter.ServerModulePackagesView" x:DataType="sdk:IServerModulePackages">
  <StackPanel Spacing="16">
   <!-- A validated upload is not installed until its plan is confirmed; closing the review keeps
        the plan (and the uploaded artifact), so this row is how it is found again. -->
   <Border Classes="plan-card" Padding="14,12" IsVisible="{Binding HasPackagePlan}">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
     <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
           Data="M12 2 L21 7 V17 L12 22 L3 17 V7 Z M3 7 L12 12 L21 7 M12 12 V22" />
     <TextBlock Grid.Column="1" Text="{Binding PackagePlanPendingText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
      <Button Classes="ghost-action" Content="{local:Loc server_modules.plan.review}" Command="{Binding ReopenPackagePlanCommand}" />
      <Button Classes="ghost-action" Content="{local:Loc server_modules.plan.discard}" Command="{Binding DiscardPackagePlanCommand}" />
     </StackPanel>
    </Grid>
   </Border>

   <Border Classes="panel-card">
    <StackPanel Spacing="12">
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
       <TextBlock Classes="section-title" Text="{local:Loc server_modules.packages}" />
       <TextBlock Classes="section-hint" Text="{local:Loc server_modules.packages_hint}" />
      </StackPanel>
      <!-- Two ways to install, both stated at the top of the tab: a local file, or the store page. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
       <Button Classes="ghost-action" Content="{local:Loc server_modules.install_package}" Click="InstallPackage_Click"
               IsEnabled="{Binding CanManage}" />
       <Button Classes="ghost-action" Content="{local:Loc server_modules.store_open}"
               Command="{Binding OpenStorePageCommand}" />
      </StackPanel>
     </Grid>
     <TextBlock Text="{Binding PackageStatusText}" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding HasPackageStatus}"
                Foreground="{DynamicResource TextSecondaryBrush}" />
     <ItemsControl ItemsSource="{Binding InstalledPackages}" IsVisible="{Binding HasInstalledPackages}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="p:ServerInstalledModuleDto">
        <Border Classes="list-row">
         <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
           <TextBlock Text="{Binding ModuleId}" FontSize="13" FontWeight="SemiBold" />
           <TextBlock Text="{Binding ReleaseId}" Classes="mono" FontSize="10"
                      Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding Version}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
           <Border Classes="pill ok" IsVisible="{Binding Active}">
            <TextBlock Text="{local:Loc server_modules.package.active}" />
           </Border>
           <Border Classes="pill" IsVisible="{Binding !Active}">
            <TextBlock Text="{local:Loc server_modules.package.installed}" />
           </Border>
           <Border Classes="pill bad" IsVisible="{Binding Quarantined}">
            <TextBlock Text="{local:Loc server_modules.package.quarantined}" />
           </Border>
          </StackPanel>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{local:Loc server_modules.packages_empty}" FontSize="12" IsVisible="{Binding !HasInstalledPackages}"
                Foreground="{DynamicResource TextTertiaryBrush}" />
    </StackPanel>
   </Border>

   <Border Classes="panel-card">
    <StackPanel Spacing="12">
     <TextBlock Classes="section-title" Text="{local:Loc server_modules.package_versions}" />
     <TextBlock Classes="section-hint" Text="{local:Loc server_modules.package_versions_hint}" />
     <ListBox Classes="compact-list" ItemsSource="{Binding SelectedVersions}" SelectedItem="{Binding SelectedPackageVersion, Mode=TwoWay}"
              MaxHeight="220" IsVisible="{Binding HasSelectedVersions}">
      <ListBox.ItemTemplate>
       <DataTemplate x:DataType="p:ServerInstalledModuleDto">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
         <TextBlock Text="{Binding Version}" Classes="mono" FontSize="12" VerticalAlignment="Center" />
         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Border Classes="pill ok" IsVisible="{Binding Active}">
           <TextBlock Text="{local:Loc server_modules.package.active}" />
          </Border>
          <Border Classes="pill" IsVisible="{Binding !Active}">
           <TextBlock Text="{local:Loc server_modules.package.installed}" />
          </Border>
          <Border Classes="pill bad" IsVisible="{Binding Quarantined}">
           <TextBlock Text="{local:Loc server_modules.package.quarantined}" />
          </Border>
         </StackPanel>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="{local:Loc server_modules.package_no_versions}" FontSize="12" IsVisible="{Binding !HasSelectedVersions}"
                Foreground="{DynamicResource TextTertiaryBrush}" />
     <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="8"
           IsVisible="{Binding HasSelectedVersion}">
      <StackPanel Spacing="2">
       <TextBlock Classes="field-label" Text="{local:Loc server_modules.package_plan.release}" />
       <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding SelectedVersionReleaseText}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2">
       <TextBlock Classes="field-label" Text="{local:Loc server_modules.package_plan.digest}" />
       <TextBlock Classes="field-value mono" FontSize="12" Text="{Binding SelectedVersionDigestText}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="2">
       <TextBlock Classes="field-label" Text="{local:Loc server_modules.package.state}" />
       <TextBlock Classes="field-value" Text="{Binding SelectedVersionStateText}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="2">
       <TextBlock Classes="field-label" Text="{local:Loc server_modules.package.installed_at}" />
       <TextBlock Classes="field-value" FontSize="12" Text="{Binding SelectedVersionInstalledAtText}" />
      </StackPanel>
     </Grid>
     <WrapPanel ItemSpacing="8" LineSpacing="8">
      <Button Classes="ghost-action" Content="{local:Loc server_modules.rollback_version}"
              Command="{Binding RollbackPackageCommand}" />
     </WrapPanel>
    </StackPanel>
   </Border>

   <Border Classes="panel-card">
    <StackPanel Spacing="12">
     <TextBlock Classes="section-title" Text="{local:Loc server_modules.package_operations}" />
     <ItemsControl ItemsSource="{Binding PackageOperationRows}" IsVisible="{Binding HasPackageOperations}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="sdk:IServerPackageOperationRow">
        <Border Classes="list-row">
         <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
           <TextBlock Text="{Binding Title}" FontSize="12" TextWrapping="Wrap" />
           <TextBlock Text="{Binding ProblemText}" FontSize="11" TextWrapping="Wrap"
                      Foreground="{DynamicResource TextTertiaryBrush}" IsVisible="{Binding HasProblem}" />
          </StackPanel>
          <Border Grid.Column="1" Classes="pill" Classes.ok="{Binding ToneOk}" Classes.warn="{Binding ToneWarn}"
                  Classes.bad="{Binding ToneBad}" VerticalAlignment="Center">
           <TextBlock Text="{Binding StateText}" />
          </Border>
          <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="{local:Loc server_modules.package_no_operations}" FontSize="12" IsVisible="{Binding !HasPackageOperations}"
                Foreground="{DynamicResource TextTertiaryBrush}" />
    </StackPanel>
   </Border>
  </StackPanel>

  <!-- ── Module store ──
       A store is browse-then-read: search, scan releases, read one, install it. That is not a
       subsection of "what this host has installed", so it owns a page-level tab and the whole
       body width instead of sitting below three fact cards the user has to scroll past. -->
</UserControl>
