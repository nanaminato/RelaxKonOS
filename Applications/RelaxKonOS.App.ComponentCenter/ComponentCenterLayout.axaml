<UserControl xmlns="https://github.com/avaloniaui"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:component="using:RelaxKonOS.App.ComponentCenter"
 x:Class="RelaxKonOS.App.ComponentCenter.ComponentCenterLayout"
 x:Name="Layout" x:DataType="component:IComponentCenterLayout"
 Classes="builtin-app" Background="{DynamicResource AppBackgroundBrush}">
 <UserControl.Styles>
  <StyleInclude Source="avares://RelaxKonOS.App.ComponentCenter/ComponentCenterStyles.axaml" />
 </UserControl.Styles>
 <Grid RowDefinitions="Auto,*">
  <Border Classes="app-header" Padding="20,13">
   <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
    <Image Width="34" Height="34" VerticalAlignment="Center"
           Source="avares://RelaxKonOS.App.ComponentCenter/Assets/component-center.png" />
    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
     <TextBlock Text="{component:Loc application.relaxkonos.component-center.display_name}" FontSize="17" FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
     <WrapPanel ItemSpacing="8" LineSpacing="4">
      <TextBlock Text="{Binding HostIdentity}" FontSize="12" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
      <Border Classes="pill"><TextBlock Text="{Binding ConnectionText}" /></Border>
      <Border Classes="pill" IsVisible="{Binding HasTargetText}"><TextBlock Classes="mono" Text="{Binding HostTargetText}" /></Border>
     </WrapPanel>
     <TextBlock Text="{Binding HeaderOutcomeText}" TextWrapping="Wrap" IsVisible="{Binding HasHeaderOutcome}"
                FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
    <component:ComponentCenterHeaderActions Grid.Column="2" />
   </Grid>
  </Border>

  <Grid Grid.Row="1" ColumnDefinitions="288,*" RowDefinitions="Auto,*" x:Name="WorkspaceBody">
   <ToggleButton x:Name="NavigationToggle" Grid.ColumnSpan="2" Classes="nav-toggle"
                 Content="{component:Loc component_center.navigation_toggle}"
                 IsVisible="False" IsCheckedChanged="NavigationToggle_Changed" Margin="14,10,14,6" HorizontalAlignment="Left" />
   <Border x:Name="NavigationPane" Classes="app-sidebar" Padding="0" Grid.RowSpan="2">
    <component:ComponentCenterNavigationView x:Name="Navigation" />
   </Border>

   <ScrollViewer x:Name="DetailsScroll" Grid.Column="1" Grid.RowSpan="2" Padding="24,20" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <Border IsVisible="{Binding ShowServerModules}"><ContentControl Content="{Binding #Layout.ModulesView}" /></Border>
      <Border IsVisible="{Binding ShowCatalogSources}"><component:CatalogSourcesView DataContext="{Binding CatalogSources}" /></Border>
      <StackPanel Spacing="16" IsVisible="{Binding ShowComponentBrowser}">
       <component:ComponentIdentityView IsVisible="{Binding HasComponentDetails}" OpenApplicationRequested="OpenApplication_Click" />
       <component:ComponentDesktopPackageView IsVisible="{Binding ShowDesktopPackage}" />
       <Border Classes="panel-card" IsVisible="{Binding ShowNginxSelection}">
        <ContentControl Content="{Binding #Layout.NginxView}" />
       </Border>

       <component:ComponentGitInstallationView IsVisible="{Binding ShowGitInstallation}" />
       <component:ComponentApplicationNoticeView IsVisible="{Binding ShowNotIntegrated}" OpenApplicationRequested="OpenApplication_Click" />
       <component:ComponentHostObservationView IsVisible="{Binding ShowHostObservation}" />
       <component:ComponentOfficialDownloadsView IsVisible="{Binding ShowOfficialDownloads}" />
       <component:ComponentPackageCandidateView IsVisible="{Binding ShowPackageFreeze}" />
       <!-- Domain runtime page: sources, versions, actions, uninstall, recovery. -->
       <StackPanel IsVisible="{Binding HasRuntimeDetails}">
        <ContentControl Content="{Binding #Layout.RuntimeView}" />
       </StackPanel>
       <component:ComponentCenterEmptyView IsVisible="{Binding !HasResults}" />
      </StackPanel>
     </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
