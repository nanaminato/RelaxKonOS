<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:cert="clr-namespace:RelaxKonOS.Protocol.Certificates;assembly=RelaxKonOS.Protocol"
 xmlns:p="clr-namespace:RelaxKonOS.Protocol.Databases;assembly=RelaxKonOS.Protocol"
 xmlns:loc="clr-namespace:RelaxKonOS.App.Databases.Views" xmlns:db="clr-namespace:RelaxKonOS.App.Databases"
 x:Class="RelaxKonOS.App.Databases.Views.MySqlOverview" x:DataType="db:MySqlViewModel">
 <ScrollViewer><StackPanel Spacing="14">
  <TextBlock Text="{Binding VersionLabel}" FontSize="24" />
  <TextBlock Text="{DynamicResource database.mysql_scope}" TextWrapping="Wrap" />
  <loc:DatabaseStatusText Status="{Binding Status}" TextWrapping="Wrap" />
  <loc:DatabaseStatusText Status="{Binding Notice}" TextWrapping="Wrap" />
  <WrapPanel>
   <Button Content="{DynamicResource database.mysql_install}" Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.initialize}" Command="{Binding InitializeCommand}" IsEnabled="{Binding CanInitialize}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.start}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.stop}" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.verify}" Command="{Binding VerifyCommand}" IsEnabled="{Binding CanStop}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.workspace.refresh}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
  </WrapPanel>
  <Button Content="{DynamicResource database.admin_recovery}" Command="{Binding RecoverAdministratorCommand}" IsEnabled="{Binding CanRecoverAdministrator}" />
  <TextBlock Text="{Binding AdministratorInstallation.SummaryText}" TextWrapping="Wrap" />
  <Button Content="{DynamicResource database.recover}" Command="{Binding RecoverCommand}" IsEnabled="{Binding CanRecover}" />
  <Button Content="{DynamicResource database.resume}" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}" />
  <TextBlock Text="{Binding Installation.SummaryText}" TextWrapping="Wrap" />
  <TextBlock Text="{DynamicResource database.remote_title}" FontSize="18" />
  <TextBlock Text="{DynamicResource database.mysql_remote_scope}" TextWrapping="Wrap" />
  <TextBlock Text="{Binding RemoteConnectionInfo}" TextWrapping="Wrap" />
  <TextBox Text="{Binding RemoteListenAddress}" Watermark="{DynamicResource database.remote_listen}" />
  <TextBox Text="{Binding RemoteSourceAddress}" Watermark="{DynamicResource database.mysql_remote_source}" />
  <TextBox Text="{Binding RemoteServerName}" Watermark="{DynamicResource database.remote_name}" />
  <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding RemoteAccount}">
   <ComboBox.ItemTemplate><DataTemplate x:DataType="p:MySqlAccount"><TextBlock Text="{Binding Identity}" /></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <Button Content="{DynamicResource database.remote_certificates}" Command="{Binding LoadRemoteCertificatesCommand}" />
  <ComboBox ItemsSource="{Binding RemoteCertificateChoices}" SelectedItem="{Binding RemoteCertificate}">
   <ComboBox.ItemTemplate><DataTemplate x:DataType="cert:CertificateDto"><TextBlock Text="{Binding PrimaryDomain}" /></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <WrapPanel>
   <Button Content="{DynamicResource database.remote_enable}" Command="{Binding OpenRemoteCommand}" IsEnabled="{Binding CanOpenRemote}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.remote_close}" Command="{Binding CloseRemoteCommand}" IsEnabled="{Binding CanCloseRemote}" Margin="0,0,8,8" />
  </WrapPanel>
  <TextBlock Text="{Binding RemoteInstallation.SummaryText}" TextWrapping="Wrap" />
  <TextBlock Text="{DynamicResource database.accounts}" FontSize="18" />
  <TextBlock Text="{DynamicResource database.mysql_accounts_scope}" TextWrapping="Wrap" />
  <StackPanel Spacing="8" IsEnabled="{Binding CanManageAccounts}">
   <TextBox Text="{Binding DatabaseName}" Watermark="{DynamicResource database.account_action.CreateDatabase}" />
   <Button Content="{DynamicResource database.account_action.CreateDatabase}" Command="{Binding CreateDatabaseCommand}" />
   <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" />
   <TextBox Text="{Binding UserName}" Watermark="user@localhost" />
   <ComboBox ItemsSource="{Binding Grants}" SelectedItem="{Binding SelectedGrant}">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="db:MySqlGrantChoice"><loc:DatabaseStatusText Status="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <TextBox Text="{Binding AccountPassword}" PasswordChar="•" Watermark="{DynamicResource database.mysql_password_hint}" />
   <Button Content="{DynamicResource database.account_action.CreateAccount}" Command="{Binding CreateAccountCommand}" />
   <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
    <ComboBox.ItemTemplate><DataTemplate x:DataType="p:MySqlAccount"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Identity}" /><TextBlock Text="{Binding Database}" /></StackPanel></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <WrapPanel>
    <Button Content="{DynamicResource database.account_action.SetGrant}" Command="{Binding SetGrantCommand}" Margin="0,0,8,8" />
    <Button Content="{DynamicResource database.account_action.ChangePassword}" Command="{Binding ChangePasswordCommand}" Margin="0,0,8,8" />
   </WrapPanel>
  </StackPanel>
  <TextBlock Text="{Binding AccountInstallation.SummaryText}" TextWrapping="Wrap" />
  <TextBlock Text="{DynamicResource database.maintenance}" FontSize="18" />
  <TextBlock Text="{DynamicResource database.mysql_maintenance_scope}" TextWrapping="Wrap" />
  <WrapPanel>
   <Button Content="{DynamicResource database.maintenance_action.Backup}" Command="{Binding BackupCommand}" IsEnabled="{Binding CanBackup}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.maintenance_action.Update}" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.maintenance_action.Repair}" Command="{Binding RepairCommand}" IsEnabled="{Binding CanRepair}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.maintenance_action.UninstallKeepData}" Command="{Binding UninstallKeepCommand}" IsEnabled="{Binding CanBackup}" Margin="0,0,8,8" />
   <Button Content="{DynamicResource database.maintenance_action.Reinstall}" Command="{Binding ReinstallCommand}" IsEnabled="{Binding CanReinstall}" Margin="0,0,8,8" />
  </WrapPanel>
  <ComboBox ItemsSource="{Binding MaintenanceBackups}" SelectedItem="{Binding SelectedBackup}">
   <ComboBox.ItemTemplate><DataTemplate x:DataType="p:MySqlBackup"><TextBlock Text="{Binding CreatedAt}" /></DataTemplate></ComboBox.ItemTemplate>
  </ComboBox>
  <Button Content="{DynamicResource database.maintenance_action.Restore}" Command="{Binding RestoreBackupCommand}" IsEnabled="{Binding CanRestore}" />
  <StackPanel Spacing="8" IsEnabled="{Binding CanBackup}">
   <TextBlock Text="{DynamicResource database.mysql_delete_scope}" TextWrapping="Wrap" />
   <SelectableTextBlock Text="{Binding DeleteInstanceId}" />
   <TextBox Text="{Binding DeleteConfirmation}" />
   <Button Content="{DynamicResource database.maintenance_action.UninstallDeleteData}" Command="{Binding UninstallDeleteCommand}" IsEnabled="{Binding CanDeleteData}" />
  </StackPanel>
  <TextBlock Text="{Binding MaintenanceInstallation.SummaryText}" TextWrapping="Wrap" />
 </StackPanel></ScrollViewer>
</UserControl>
