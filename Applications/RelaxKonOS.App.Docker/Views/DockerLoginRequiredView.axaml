<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.App.Docker"
             x:Class="RelaxKonOS.App.Docker.Views.DockerLoginRequiredView" Classes="builtin-app">
    <TextBlock Margin="24" Text="{loc:Loc docker.login_required}" TextWrapping="Wrap" />
</UserControl>
