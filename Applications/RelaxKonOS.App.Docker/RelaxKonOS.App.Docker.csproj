<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Resource pages are constructed with their action callbacks by the workspace. -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../Framework/RelaxKonOS.App.SDK/RelaxKonOS.App.SDK.csproj" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <AvaloniaResource Include="Assets/docker.png" />
        <EmbeddedResource Include="Localization/*.json" LogicalName="Docker.Localization.%(Filename).json" />
        <EmbeddedResource Include="Localization/Package/*.json" LogicalName="Docker.PackageLocalization.%(Filename).json" />
    </ItemGroup>
</Project>
