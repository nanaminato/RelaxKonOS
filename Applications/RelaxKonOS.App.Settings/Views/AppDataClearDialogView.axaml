<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RelaxKonOS.App.Settings.Views"
             x:Class="RelaxKonOS.App.Settings.Views.AppDataClearDialogView"
             x:DataType="loc:AppDataClearDialogViewModel"
             Background="{DynamicResource SurfaceBrush}" Width="520" Classes="builtin-app">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="5">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc settings.apps.clear_data_description}" TextWrapping="Wrap" Opacity="0.72" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="12">
            <CheckBox Content="{loc:Loc settings.apps.clear_data.local}" IsChecked="True" IsEnabled="False" />
            <TextBlock Text="{loc:Loc settings.apps.clear_data.local_hint}" FontSize="12" Opacity="0.62" Margin="24,-8,0,0" TextWrapping="Wrap" />
            <CheckBox Content="{loc:Loc settings.apps.clear_data.permissions}" IsChecked="{Binding ClearPermissionDecisions, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc settings.apps.clear_data.permissions_hint}" FontSize="12" Opacity="0.62" Margin="24,-8,0,0" TextWrapping="Wrap" />
            <CheckBox Content="{loc:Loc settings.apps.clear_data.server}" IsChecked="{Binding ClearServerData, Mode=TwoWay}" />
            <TextBlock Text="{loc:Loc settings.apps.clear_data.server_hint}" FontSize="12" Opacity="0.62" Margin="24,-8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Loc common.cancel}" Command="{Binding CancelCommand}" Padding="16,6" />
            <Button Classes="primary" Content="{loc:Loc settings.apps.clear_data.action}" Command="{Binding ClearCommand}" Padding="16,6" />
        </StackPanel>
    </Grid>
</UserControl>
