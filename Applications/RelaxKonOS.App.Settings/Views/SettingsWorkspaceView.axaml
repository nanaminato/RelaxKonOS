<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settingsApp="clr-namespace:RelaxKonOS.App.Settings.Views"
             xmlns:vm="clr-namespace:RelaxKonOS.App.Settings"
             x:Class="RelaxKonOS.App.Settings.Views.SettingsWorkspaceView"
             x:DataType="settingsApp:ISettingsWorkspace"
             x:CompileBindings="True"
             Background="{DynamicResource SurfaceBrush}" Classes="builtin-app">

    <UserControl.Styles>
        <Style Selector="Border.settings-search-target">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:SettingsHomePageContent">
            <settingsApp:SettingsHomePageView VerticalAlignment="Top" RouteRequested="OnPageRouteRequested" />
        </DataTemplate>
        <DataTemplate DataType="vm:DefaultAppsPageContent">
            <settingsApp:DefaultAppsPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:AccessibilityPageContent">
            <settingsApp:AccessibilityPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:DailySettingsPageContent">
            <settingsApp:DailySettingsPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="vm:AboutPageContent">
            <settingsApp:AboutPageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="settingsApp:AppPermissionEditor">
            <settingsApp:AppPermissionDialogView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="settingsApp:ITimeLanguagePage">
            <settingsApp:TimeLanguagePageView VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="settingsApp:IPersonalizationOverview">
            <settingsApp:PersonalizationPageView VerticalAlignment="Top" RouteRequested="OnPageRouteRequested" />
        </DataTemplate>
        <DataTemplate DataType="settingsApp:IPersonalizationBackgroundPage">
            <settingsApp:PersonalizationBackgroundView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="settingsApp:IPersonalizationLayoutPage">
            <settingsApp:PersonalizationLayoutView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="settingsApp:IPersonalizationStylePage">
            <settingsApp:PersonalizationStyleView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
        <DataTemplate DataType="settingsApp:IPersonalizationColorsPage">
            <settingsApp:PersonalizationColorsView DataContext="{Binding Editor}" VerticalAlignment="Top" />
        </DataTemplate>
    </UserControl.DataTemplates>



    <Grid RowDefinitions="Auto,*">
        <!-- Fallback presentation for a Settings view that has not been attached to a managed window.
             Once it is, both blocks move into the host title bar's leading and centre role slots and
             this row collapses. Nothing here states a height or an inset for the fused bar: those
             belong to the host template and follow the active window-chrome recipe. -->
        <Grid x:Name="HeaderHost" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,4">
            <settingsApp:SettingsHeaderView x:Name="SettingsHeader" VerticalAlignment="Center"
                                            BackCommand="{Binding BackCommand}"
                                            BackLabel="{settingsApp:Loc settings.navigation.back}"
                                            Title="{settingsApp:Loc settings.title}" />
            <settingsApp:SettingsSearchBarView x:Name="SettingsSearchBar" Grid.Column="1"
                                               Query="{Binding SearchQuery, Mode=TwoWay}"
                                               Prompt="{settingsApp:Loc settings.search.placeholder}" />
        </Grid>
    <Grid Grid.Row="1" x:Name="NavigationLayout" ColumnDefinitions="250,*">
        <Border x:Name="Sidebar" Grid.Column="0" Classes="app-sidebar" Padding="16" BorderThickness="0">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding ConnectionSummary}" TextWrapping="Wrap" FontSize="12" Classes="subtle" />
                    <SelectableTextBlock Text="{Binding ConnectionAddress}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding NavigationPages}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         AutomationProperties.Name="{settingsApp:Loc settings.search.category}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsPageModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,6">
                                <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{Binding Icon}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{Binding LocalizedDisplayName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Content="{settingsApp:Loc settings.about_page.title}" Command="{Binding OpenPageCommand}" CommandParameter="about" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="16,16,16,0" RowSpacing="12">
            <Grid x:Name="CompactNavigation" Grid.Row="0" IsVisible="False" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Button x:Name="NavigationMenuButton" Content="☰" Click="OnOpenNavigationClick"
                        AutomationProperties.Name="{settingsApp:Loc settings.navigation.open_menu}" ToolTip.Tip="{settingsApp:Loc settings.navigation.open_menu}" />
            </Grid>
            <ScrollViewer x:Name="SettingsPageScroll" Grid.Row="1" IsVisible="{Binding !HasSearch}" HorizontalScrollBarVisibility="Disabled" Padding="0,0,24,24">
                <StackPanel x:Name="SettingsContentColumn" Spacing="12" MaxWidth="1040" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
<StackPanel IsVisible="{Binding HasDeviceSaveFailure}" Spacing="8">
                    <TextBlock Text="{settingsApp:Loc settings.device.save_failed}" TextWrapping="Wrap" />
                    <Button Content="{settingsApp:Loc settings.save.retry}" Command="{Binding RetryDeviceSaveCommand}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <WrapPanel VerticalAlignment="Center">
                        <Button x:Name="GrandparentBreadcrumb" Content="{Binding GrandparentTitle}" IsVisible="{Binding HasGrandparentPage}"
                                Command="{Binding OpenPageCommand}" CommandParameter="apps" FontSize="28" FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" />
                        <TextBlock Text="›" IsVisible="{Binding HasGrandparentPage}" FontSize="28" Margin="14,0" VerticalAlignment="Center" Classes="subtle" />
                        <Button x:Name="ParentBreadcrumb" Content="{Binding ParentTitle}" IsVisible="{Binding HasParentPage}"
                                Command="{Binding OpenPageCommand}" CommandParameter="{Binding ParentRoute}"
                                FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" />
                        <TextBlock Text="›" IsVisible="{Binding HasParentPage}" FontSize="28" Margin="14,0" VerticalAlignment="Center" Classes="subtle" />
                        <TextBlock x:Name="PageHeading" Focusable="True" AutomationProperties.Name="{Binding SelectedPage.LocalizedDisplayName}"
                                   Text="{Binding SelectedPage.LocalizedDisplayName}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </WrapPanel>
                    <ToggleButton x:Name="PinCurrentPageButton" Grid.Column="1" IsVisible="{Binding CanPinCurrentPage}" IsChecked="{Binding IsCurrentPagePinned, Mode=TwoWay}" Content="{settingsApp:Loc settings.home.pin}" ToolTip.Tip="{settingsApp:Loc settings.home.pin_hint}" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="{Binding PageScopeDescription}" IsVisible="{Binding HasPageScopeDescription}" TextWrapping="Wrap" Classes="subtle" />
                <Button Content="{settingsApp:Loc settings.page.default_apps}" IsVisible="{Binding IsAppsCategory}" Command="{Binding OpenPageCommand}" CommandParameter="default-apps" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding SearchLocationStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />

            </StackPanel>

                    <ContentControl x:Name="PageContent" Content="{Binding SelectedPage.Presentation}" />
                </StackPanel>
            </ScrollViewer>
            <settingsApp:SettingsSearchResultsView Grid.Row="1" IsVisible="{Binding HasSearch}"
                                                   Results="{Binding SearchResults}"
                                                   OpenResultCommand="{Binding OpenSearchResultCommand}"
                                                   CatalogProblem="{Binding CatalogProblem}"
                                                   HasNoResults="{Binding HasNoResults}"
                                                   NoResultsLabel="{settingsApp:Loc settings.search.no_results}"
                                                   ResultsLabel="{settingsApp:Loc settings.search.results}" />
        </Grid>
    </Grid>
        <Border Grid.Row="1" IsVisible="{Binding HasFailureToast}" Classes="card" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="24" Padding="16,12" MaxWidth="380" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding FailureToast}" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="{settingsApp:Loc settings.save.retry}" Command="{Binding RetrySaveCommand}" IsVisible="{Binding CanRetry}" Margin="0,0,8,0" />
                    <Button Content="{settingsApp:Loc settings.save.discard}" Command="{Binding DiscardDraftCommand}" IsVisible="{Binding CanDiscard}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" x:Name="NavigationDrawer" IsVisible="False">
            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource TextPrimaryBrush}" Opacity="0.18"
                    Click="OnCloseNavigationClick" AutomationProperties.Name="{settingsApp:Loc settings.navigation.close_menu}" />
            <Border Width="280" HorizontalAlignment="Left" Background="{DynamicResource SurfaceBrush}" Padding="16"
                    KeyboardNavigation.TabNavigation="Cycle">
                <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{settingsApp:Loc settings.title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="CloseNavigationButton" Grid.Column="1" Content="×" Click="OnCloseNavigationClick"
                                AutomationProperties.Name="{settingsApp:Loc settings.navigation.close_menu}" />
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <TextBlock Text="{Binding ConnectionSummary}" TextWrapping="Wrap" Classes="subtle" />
                        <SelectableTextBlock Text="{Binding ConnectionAddress}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListBox x:Name="DrawerNavigationList" Grid.Row="2" ItemsSource="{Binding NavigationPages}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" AutomationProperties.Name="{settingsApp:Loc settings.search.category}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsPageModel">
                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinHeight="40" Tag="{Binding Route}" Click="OnQuickLinkClick">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{Binding Icon}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{Binding LocalizedDisplayName}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="{settingsApp:Loc settings.about_page.title}" Tag="about" Click="OnQuickLinkClick" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
