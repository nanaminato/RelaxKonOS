<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RelaxKonOS.App.Settings.Views.SettingsHeaderView"
             x:Name="Header">
    <!-- The leading block of the window's fused title bar: the back action and the window's own
         identity. It holds no placement of its own - the host template decides which column it lands
         in, how far it is inset from the caption buttons and how tall the bar is - so the same block
         follows every window-chrome recipe without knowing which one is active. -->
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="HeaderBackButton" Command="{Binding #Header.BackCommand}" Background="Transparent" BorderThickness="0"
                Padding="10" AutomationProperties.Name="{Binding #Header.BackLabel}" ToolTip.Tip="{Binding #Header.BackLabel}">
            <Path Data="M15,3 L6,12 L15,21 M6,12 L24,12" Stroke="{DynamicResource TextPrimaryBrush}"
                  StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" />
        </Button>
        <TextBlock x:Name="HeaderTitle" Text="{Binding #Header.Title}" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
