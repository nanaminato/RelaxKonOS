<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RelaxKonOS.PrivilegedHelper</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RelaxKonOS.WindowsGit.Tests" />
    <Compile Include="../RelaxKonOS.Server/Files/FileArchiveService*.cs;../RelaxKonOS.Server/Files/LocalArchiveFileSystem.cs;../RelaxKonOS.Server/Files/IArchiveReader.cs;../RelaxKonOS.Server/Files/SevenZipArchiveProvider.cs;../RelaxKonOS.Server/Files/ArchivePasswordException.cs" Link="Files/%(Filename)%(Extension)" />
    <None Include="../RelaxKonOS.Server/Assets/SevenZip/**/*" Link="Assets/SevenZip/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../RelaxKonOS.Server/Assets/Mihomo/GeoData/geoip.metadb;../RelaxKonOS.Server/Assets/Mihomo/GeoData/geoip.dat;../RelaxKonOS.Server/Assets/Mihomo/GeoData/geosite.dat;../RelaxKonOS.Server/Assets/Mihomo/GeoData/country.mmdb;../RelaxKonOS.Server/Assets/Mihomo/GeoData/GeoLite2-ASN.mmdb"
          Link="Assets/Mihomo/GeoData/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../RelaxKonOS.Server/Terminal/ConPty.cs" Link="Terminal/ConPty.cs" />
    <Compile Include="../RelaxKonOS.Server/Terminal/TerminalUserEnvironment.cs" Link="Terminal/TerminalUserEnvironment.cs" />
    <Compile Include="../RelaxKonOS.Server/SystemMonitor/ProcessInstanceTermination.cs" Link="SystemMonitor/ProcessInstanceTermination.cs" />
    <Compile Include="../RelaxKonOS.Server/SystemPerformance/ProcessTreeMetadata.cs" Link="SystemPerformance/ProcessTreeMetadata.cs" />
    <Compile Include="../RelaxKonOS.Server/SystemPerformance/ProcessIconProvider.cs" Link="SystemPerformance/ProcessIconProvider.cs" />
    <Compile Include="../RelaxKonOS.Server/SystemPerformance/IProcessService.cs" Link="SystemPerformance/IProcessService.cs" />
    <Compile Include="../RelaxKonOS.Server/SystemPerformance/HostProcessSnapshotCollector.cs" Link="SystemPerformance/HostProcessSnapshotCollector.cs" />
    <Compile Include="../RelaxKonOS.Server/SystemMonitor/LinuxProcessMetadata.cs" Link="SystemMonitor/LinuxProcessMetadata.cs" />
    <ProjectReference Include="..\Shared\RelaxKonOS.Protocol\RelaxKonOS.Protocol.csproj" />
    <ProjectReference Include="../Shared/RelaxKonOS.ManagedRuntimes/RelaxKonOS.ManagedRuntimes.csproj" />
    <PackageReference Include="RoyalApps.RoyalTerminal.Terminal.Pty.Platform" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
  <Target Name="SetArchiveDecoderBuildPermissions" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="chmod 755 &quot;$(TargetDir)Assets/SevenZip/linux-x64/7zz&quot; &quot;$(TargetDir)Assets/SevenZip/linux-arm64/7zz&quot; &quot;$(TargetDir)Assets/SevenZip/osx-x64/7zz&quot; &quot;$(TargetDir)Assets/SevenZip/osx-arm64/7zz&quot;" />
  </Target>
  <Target Name="SetArchiveDecoderPublishPermissions" AfterTargets="Publish" Condition="'$(OS)' != 'Windows_NT'">
    <Exec Command="chmod 755 &quot;$(PublishDir)Assets/SevenZip/linux-x64/7zz&quot; &quot;$(PublishDir)Assets/SevenZip/linux-arm64/7zz&quot; &quot;$(PublishDir)Assets/SevenZip/osx-x64/7zz&quot; &quot;$(PublishDir)Assets/SevenZip/osx-arm64/7zz&quot;" />
  </Target>
</Project>
